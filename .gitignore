# Build output
/build/

# Frozen Rust oracle (rust-old/): keep its sources AND its Cargo.lock (the oracle must rebuild
# against its exact pins); ignore only what cargo builds inside it.
/rust-old/target/
/rust-old/**/__pycache__/

# Golden-value generator (scripts/oracle/, a cargo crate): its Cargo.lock is committed too
/scripts/oracle/target/
/scripts/**/__pycache__/

# Editor / IDE
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db

# Debugging
*.pdb
core
core.*
*.core

# Coverage
/coverage/
*.profraw
*.profdata

# Claude Code
.claude/

# Environment / secrets
.env
.env.*
*.pem
*.key
