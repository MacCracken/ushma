# bayan 1.11.1: the JSON integer `-0` parses as JTAG_INT 0, so a reader that wants an f64 gets +0.0 where serde_json
# (and Python, JavaScript) give −0.0 (ushma 2.0.0 port, M0 probe 11: 20 documents). `-0.0` is fine: it is a FLOAT.
# Exits 1 while the sign is lost.
#
#   cyrius build <this file> build/r && ./build/r

fn main(): i64 {
    alloc_init();
    var v = bayan_json_v_parse(str_from("{\"x\":-0,\"y\":-0.0}"));
    if (v == 0) { println("parse refused"); return 2; }
    var x = bayan_json_v_obj_get_by_cstr(v, "x");
    var y = bayan_json_v_obj_get_by_cstr(v, "y");
    print("-0   tag ", 9);
    println_int(bayan_json_v_tag(x));
    print("-0   f64 bits negative (1 = sign kept): ", 40);
    var xs = 0;
    if (bayan_json_v_float(x) < 0) { xs = 1; }
    println_int(xs);
    print("-0.0 f64 bits negative (1 = sign kept): ", 40);
    var ys = 0;
    if (bayan_json_v_float(y) < 0) { ys = 1; }
    println_int(ys);
    if (xs == 0) { return 1; }
    return 0;
}

var r = main();
sys_exit_group(r);
