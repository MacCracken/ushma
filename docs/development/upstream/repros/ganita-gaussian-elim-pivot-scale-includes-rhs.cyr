# ganita 1.2.15: ganita_mat_gaussian_elim scales its singularity threshold by the largest entry of [A|b], so the
# right-hand side's magnitude decides whether A is singular (ushma 2.0.0 port, M0 probe 9). One 2×2 system, row-scaled
# as a thermal network's is (unit diagonal), with its smallest pivot 1e-10 (cond ≈ 4e10):
# - ganita_mat_lu + _lu_solve solve it (threshold 1e-12 · max|A| = 1e-12);
# - ganita_mat_gaussian_elim solves it with b in kilokelvin, and refuses the same system with b in kelvin.
# Exits 1 while the verdict depends on b's units.
#
#   cyrius build <this file> build/r && ./build/r

# [A | b] with b = (t, 0): A = [[1, −(1 − 1e-10)], [−1, 1]].
fn aug_with(t: f64): i64 {
    var a = ganita_mat_new(2, 3);
    var off: f64 = 0.0 - 0.9999999999;
    ganita_mat_set(a, 0, 0, 1.0);
    ganita_mat_set(a, 0, 1, off);
    ganita_mat_set(a, 0, 2, t);
    ganita_mat_set(a, 1, 0, -1.0);
    ganita_mat_set(a, 1, 1, 1.0);
    ganita_mat_set(a, 1, 2, 0.0);
    return a;
}

fn main(): i64 {
    alloc_init();
    var m = ganita_mat_new(2, 2);
    var off: f64 = 0.0 - 0.9999999999;
    ganita_mat_set(m, 0, 0, 1.0);
    ganita_mat_set(m, 0, 1, off);
    ganita_mat_set(m, 1, 0, -1.0);
    ganita_mat_set(m, 1, 1, 1.0);
    var lu = ganita_mat_new(2, 2);
    var piv = alloc(16);
    var lu_ok = 0;
    if (ganita_mat_lu(m, lu, piv) != 0) { lu_ok = 1; }
    var kk = ganita_mat_gaussian_elim(aug_with(1.0));
    var k = ganita_mat_gaussian_elim(aug_with(1000.0));
    print("ganita_mat_lu factors A: ", 25);
    println_int(lu_ok);
    print("ganita_mat_gaussian_elim, b = (1, 0) (kK): ", 43);
    println_int(kk);
    print("ganita_mat_gaussian_elim, b = (1000, 0) (K): ", 45);
    println_int(k);
    if (kk != k) { return 1; }
    return 0;
}

var r = main();
sys_exit_group(r);
