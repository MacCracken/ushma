# sakshi 2.5.10: sakshi_span_enter / _exit take no level and never test one. With the level at SK_ERROR, a span still
# reads the clock, pushes the stack and emits an ENTER and an EXIT event. A library instrumented the way Rust's
# `#[tracing::instrument(level = "debug")]` is pays that on every call (ushma 2.0.0 port, M0 probe 8: 192 ns per call
# into the ring buffer, sakshi's cheapest output, around an 8.1 ns function), and floods the output at the default
# INFO level. Exits 1 while a filtered-out span still emits.
#
#   cyrius build <this file> build/r && ./build/r

fn main(): i64 {
    alloc_init();
    sakshi_output_buffer();
    sakshi_set_level(SK_ERROR);
    sakshi_ring_clear();
    var k = 0;
    while (k < 10) {
        sakshi_span_enter("ideal_gas_volume", 16);
        sakshi_span_exit();
        k = k + 1;
    }
    var events = sakshi_ring_event_count();
    print("events in the ring after 10 spans at level SK_ERROR: ", 53);
    println_int(events);
    if (events > 0) { return 1; }
    return 0;
}

var r = main();
sys_exit_group(r);
