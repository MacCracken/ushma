# ushma benchmarks, recorded against Rust 1.4.0's (docs/benchmarks-rust-v-cyrius.md). Each name is Rust's criterion
# name where Rust has one; the JSON ones are Cyrius-only (Rust benches no serde path).
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report. Every sub-1 µs operation
# runs in batches of 10^6 to amortize the clock (~240 ns per start/stop pair on x86_64 Linux; lib/bench.cyr's header).

include "src/constants.cyr"
include "src/error.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/validate.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/material_data.cyr"
include "src/material.cyr"
include "src/transfer.cyr"

# Keeps results observable, so no call can be dropped.
var _bn_sink = 0;

# Empty benchmark body: the harness floor the real benchmarks are compared against.
fn bench_noop(): i64 { return 0; }

# Times `n` calls of loop body `f(arg)` under `name`.
fn bn_run(name, f, arg, n) {
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        _bn_sink = _bn_sink + fncall1(f, arg);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# One call of each benchmarked function on material *m.
fn b_diffusivity(m: *UsMaterial): i64 {
    var r: f64 = us_material_diffusivity(m);
    return r;
}

# volumetric heat capacity of *m.
fn b_volumetric(m: *UsMaterial): i64 {
    var r: f64 = us_material_volumetric_heat_capacity(m);
    return r;
}

var _bn_sb = 0;
var _bn_arena = 0;
var _bn_doc = 0;
var _bn_doc_n = 0;

# Writes *m's document into the shared builder.
fn b_to_json(m: *UsMaterial): i64 {
    store64(_bn_sb + 8, 0);
    us_material_to_json(_bn_sb, m);
    return load64(_bn_sb + 8);
}

# Reads Copper's document into *m on an arena reset per call.
fn b_from_json(m: *UsMaterial): i64 {
    reset_via(_bn_arena);
    var t, v = us_material_from_json_a(_bn_arena, _bn_doc, _bn_doc_n, m);
    return t;
}

# transfer, with Rust's benchmark arguments (rust-old/benches/benchmarks.rs).
var _bn_series = 0;
var _bn_parallel = 0;

# conduction(401, 0.01, 373.15, 293.15, 0.1).
fn b_conduction(x): i64 {
    var t, v = us_conduction(401.0, 0.01, 373.15, 293.15, 0.1);
    return v;
}

# convection(25, 1, 373.15, 293.15).
fn b_convection(x): i64 {
    var q: f64 = us_convection(25.0, 1.0, 373.15, 293.15);
    return q;
}

# radiation(0.9, 1, 473.15, 293.15).
fn b_radiation(x): i64 {
    var t, v = us_radiation(0.9, 1.0, 473.15, 293.15);
    return v;
}

# series of [0.5, 1, 2, 0.3, 1.5].
fn b_series(x): i64 {
    var r: f64 = us_thermal_resistance_series(_bn_series, 5);
    return r;
}

# parallel of [2, 3, 6].
fn b_parallel(x): i64 {
    var t, v = us_thermal_resistance_parallel(_bn_parallel, 3);
    return v;
}

# heat_stored(1, 4186, 10).
fn b_heat_stored(x): i64 {
    var q: f64 = us_heat_stored(1.0, 4186.0, 10.0);
    return q;
}

# thermal_diffusivity(401, 8960, 385).
fn b_tr_diffusivity(x): i64 {
    var t, v = us_thermal_diffusivity(401.0, 8960.0, 385.0);
    return v;
}

# biot_number(25, 0.01, 401).
fn b_biot(x): i64 {
    var t, v = us_biot_number(25.0, 0.01, 401.0);
    return v;
}

# lumped_capacitance(373.15, 293.15, 60, 100).
fn b_lumped(x): i64 {
    var r: f64 = us_lumped_capacitance(373.15, 293.15, 60.0, 100.0);
    return r;
}

# reynolds_number(1, 0.1, 1e-6).
fn b_reynolds(x): i64 {
    var t, v = us_reynolds_number(1.0, 0.1, 0.000001);
    return v;
}

# nusselt_dittus_boelter(50000, 0.7).
fn b_nusselt_db(x): i64 {
    var t, v = us_nusselt_dittus_boelter(50000.0, 0.7);
    return v;
}

# fin_rectangular_heat(25, 0.02, 237, 1e-4, 0.05, 373.15, 293.15).
fn b_fin_heat(x): i64 {
    var t, v = us_fin_rectangular_heat(25.0, 0.02, 237.0, 0.0001, 0.05, 373.15, 293.15);
    return v;
}

# lmtd_counter(400, 350, 300, 330).
fn b_lmtd_counter(x): i64 {
    var t, v = us_lmtd_counter(400.0, 350.0, 300.0, 330.0);
    return v;
}

# effectiveness_counter(2, 0.5).
fn b_eff_counter(x): i64 {
    var t, v = us_effectiveness_counter(2.0, 0.5);
    return v;
}

# view_factor_coaxial_disks(0.5, 0.5, 1).
fn b_vf_disks(x): i64 {
    var t, v = us_view_factor_coaxial_disks(0.5, 0.5, 1.0);
    return v;
}

# view_factor_perpendicular_plates(1, 1, 2).
fn b_vf_perpendicular(x): i64 {
    var t, v = us_view_factor_perpendicular_plates(1.0, 1.0, 2.0);
    return v;
}

# Fills the two resistance lists the benchmarks use.
fn bn_lists() {
    _bn_series = alloc(40);
    _bn_parallel = alloc(24);
    var a: f64 = 0.5;
    var b: f64 = 1.0;
    var c: f64 = 2.0;
    var d: f64 = 0.3;
    var e: f64 = 1.5;
    store64(_bn_series, a);
    store64(_bn_series + 8, b);
    store64(_bn_series + 16, c);
    store64(_bn_series + 24, d);
    store64(_bn_series + 32, e);
    var p: f64 = 2.0;
    var q: f64 = 3.0;
    var r: f64 = 6.0;
    store64(_bn_parallel, p);
    store64(_bn_parallel + 8, q);
    store64(_bn_parallel + 16, r);
    return 0;
}

# The level test a span costs with DEBUG off (sakshi at INFO).
fn b_span(m): i64 {
    _us_span_enter("us_bench", 8);
    _us_span_exit();
    return 0;
}

# Benchmark entry point: runs every benchmark and reports each one.
fn main(): i64 {
    alloc_init();
    var m: UsMaterial;
    var t, v = us_material_preset(US_MATERIAL_COPPER, &m);
    _bn_sb = str_builder_new();
    _bn_arena = arena_allocator_growable(65536);
    us_material_to_json(_bn_sb, &m);
    _bn_doc_n = load64(_bn_sb + 8);
    _bn_doc = alloc(_bn_doc_n + 1);
    memcpy(_bn_doc, load64(_bn_sb), _bn_doc_n);
    sakshi_set_level(SK_INFO);
    bn_run("noop", &bench_noop, 0, 1000000);
    bn_run("material/diffusivity", &b_diffusivity, &m, 1000000);
    bn_run("material/volumetric_cp", &b_volumetric, &m, 1000000);
    bn_run("material/to_json (Cyrius only)", &b_to_json, &m, 100000);
    bn_run("material/from_json (Cyrius only)", &b_from_json, &m, 100000);
    bn_run("span, DEBUG off (Cyrius only)", &b_span, 0, 1000000);
    bn_lists();
    bn_run("transfer/conduction", &b_conduction, 0, 1000000);
    bn_run("transfer/convection", &b_convection, 0, 1000000);
    bn_run("transfer/radiation", &b_radiation, 0, 1000000);
    bn_run("transfer/resistance_series", &b_series, 0, 1000000);
    bn_run("transfer/resistance_parallel", &b_parallel, 0, 1000000);
    bn_run("transfer/heat_stored", &b_heat_stored, 0, 1000000);
    bn_run("transfer/diffusivity", &b_tr_diffusivity, 0, 1000000);
    bn_run("transfer/biot_number", &b_biot, 0, 1000000);
    bn_run("transfer/lumped_capacitance", &b_lumped, 0, 1000000);
    bn_run("transfer/reynolds", &b_reynolds, 0, 1000000);
    bn_run("transfer/nusselt_db", &b_nusselt_db, 0, 1000000);
    bn_run("transfer/fin_rect_heat", &b_fin_heat, 0, 1000000);
    bn_run("transfer/lmtd_counter", &b_lmtd_counter, 0, 1000000);
    bn_run("transfer/eff_counter", &b_eff_counter, 0, 1000000);
    bn_run("transfer/view_factor_disks", &b_vf_disks, 0, 1000000);
    bn_run("transfer/view_factor_perpendicular", &b_vf_perpendicular, 0, 1000000);
    return 0;
}

var r = main();
sys_exit_group(r);
