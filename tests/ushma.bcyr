var _bn_prod = 0;
var _bn_react = 0;
var _bn_fprod = 0;
var _bn_freact = 0;

# Species `i` as a fresh UsSpecies.
fn bn_species(i): i64 {
    var x = alloc(sizeof(UsSpecies));
    var t, v = us_species_preset(i, x);
    return x;
}

# Term k of a term list: coefficient `c` of species `i`.
fn bn_term(terms, k, c: f64, i) {
    store64(terms + (16 * k), c);
    store64(terms + (16 * k) + 8, bn_species(i));
    return 0;
}

# Methane's combustion, and the same in air, as term lists.
fn bn_reactions() {
    _bn_prod = alloc(32);
    _bn_react = alloc(32);
    bn_term(_bn_prod, 0, 1.0, US_SPECIES_CO2);
    bn_term(_bn_prod, 1, 2.0, US_SPECIES_H2O_GAS);
    bn_term(_bn_react, 0, 1.0, US_SPECIES_CH4);
    bn_term(_bn_react, 1, 2.0, US_SPECIES_O2);
    _bn_fprod = alloc(48);
    _bn_freact = alloc(48);
    bn_term(_bn_freact, 0, 1.0, US_SPECIES_CH4);
    bn_term(_bn_freact, 1, 2.0, US_SPECIES_O2);
    bn_term(_bn_freact, 2, 7.52, US_SPECIES_N2);
    bn_term(_bn_fprod, 0, 1.0, US_SPECIES_CO2);
    bn_term(_bn_fprod, 1, 2.0, US_SPECIES_H2O_GAS);
    bn_term(_bn_fprod, 2, 7.52, US_SPECIES_N2);
    return 0;
}

# reaction_enthalpy of methane's combustion.
fn b_reaction_enthalpy(x): i64 {
    var h: f64 = us_reaction_enthalpy(_bn_prod, 2, _bn_react, 2);
    return h;
}

