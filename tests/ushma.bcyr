include "src/chem.cyr"
include "src/stat.cyr"
include "src/numerical.cyr"

# Keeps results observable, so no call can be dropped.
var _bn_sink = 0;
var _bn_mix = 0;
var _bn_h_mid: f64 = 0.0;

# Empty benchmark body: the harness floor the real benchmarks are compared against.
fn bench_noop(): i64 { return 0; }

# Times `n` calls of loop body `f(arg)` under `name`.
fn bn_run(name, f, arg, n) {
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < n) {
        _bn_sink = _bn_sink + fncall1(f, arg);
        i = i + 1;
    }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# One call of each benchmarked function on material *m.
fn b_diffusivity(m: *UsMaterial): i64 {
    var r: f64 = us_material_diffusivity(m);
    return r;
}

# volumetric heat capacity of *m.
fn b_volumetric(m: *UsMaterial): i64 {
    var r: f64 = us_material_volumetric_heat_capacity(m);
    return r;
}

var _bn_sb = 0;
var _bn_arena = 0;
var _bn_doc = 0;
var _bn_doc_n = 0;

# Writes *m's document into the shared builder.
fn b_to_json(m: *UsMaterial): i64 {
    store64(_bn_sb + 8, 0);
    us_material_to_json(_bn_sb, m);
    return load64(_bn_sb + 8);
}

# Reads Copper's document into *m on an arena reset per call.
fn b_from_json(m: *UsMaterial): i64 {
    reset_via(_bn_arena);
    var t, v = us_material_from_json_a(_bn_arena, _bn_doc, _bn_doc_n, m);
    return t;
}

