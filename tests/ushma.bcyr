var _bn_g1 = 0;
var _bn_g1_dt: f64 = 0.0;

# One explicit step of the 100-node grid at Fo = 0.4.
fn b_explicit(g: *UsGrid1D): i64 {
    var t, v = us_grid1d_step_explicit(g, _bn_g1_dt);
    return 0;
}

# One Crank–Nicolson step of the 100-node grid at dt = 1 s.
fn b_cn(g: *UsGrid1D): i64 {
    var t, v = us_grid1d_step_crank_nicolson(g, 1.0);
    return 0;
}

# One adaptive step of the 51-node convective grid at 4× the stable step (4 explicit sub-steps).
fn b_adaptive(g: *UsGrid1D): i64 {
    var t, v = us_grid1d_step_adaptive(g, _bn_g1_dt);
    return v;
}

var _bn_g2_nodes = 0;

# Rust's bench clones the 20×20 grid (left 400 K, right 300 K) and solves the copy to 1e-4: the port copies the 400
# nodes into a reused grid, then solves it.
fn b_gauss_seidel(g: *UsGrid2D): i64 {
    var d = slice_ptr(g.nodes);
    var s = slice_ptr(_bn_g2_nodes);
    var k = 0;
    while (k < 400) {
        store64(d + (8 * k), load64(s + (8 * k)));
        k = k + 1;
    }
    var t, v = us_grid2d_solve_steady_state(g, 0.0001, 10000);
    return v;
}

# Fills the two resistance lists the benchmarks use.
fn bn_lists() {
    _bn_series = alloc(40);
    _bn_parallel = alloc(24);
    var a: f64 = 0.5;
    var b: f64 = 1.0;
    var c: f64 = 2.0;
    var d: f64 = 0.3;
    var e: f64 = 1.5;
    store64(_bn_series, a);
    store64(_bn_series + 8, b);
    store64(_bn_series + 16, c);
    store64(_bn_series + 24, d);
    store64(_bn_series + 32, e);
    var p: f64 = 2.0;
    var q: f64 = 3.0;
    var r: f64 = 6.0;
    store64(_bn_parallel, p);
    store64(_bn_parallel + 8, q);
    store64(_bn_parallel + 16, r);
    _bn_mix = alloc(24);
    var x1: f64 = 0.3;
    var x3: f64 = 0.4;
    store64(_bn_mix, x1);
    store64(_bn_mix + 8, x1);
    store64(_bn_mix + 16, x3);
    return 0;
}

# The level test a span costs with DEBUG off (sakshi at INFO).
fn b_span(m): i64 {
    _us_span_enter("us_bench", 8);
    _us_span_exit();
    return 0;
}

# Benchmark entry point: runs every benchmark and reports each one.
fn main(): i64 {
    alloc_init();
    var m: UsMaterial;
    var t, v = us_material_preset(US_MATERIAL_COPPER, &m);
    _bn_sb = str_builder_new();
    _bn_arena = arena_allocator_growable(65536);
    us_material_to_json(_bn_sb, &m);
    _bn_doc_n = load64(_bn_sb + 8);
    _bn_doc = alloc(_bn_doc_n + 1);
    memcpy(_bn_doc, load64(_bn_sb), _bn_doc_n);
    sakshi_set_level(SK_INFO);
    bn_run("noop", &bench_noop, 0, 1000000);
    bn_run("material/diffusivity", &b_diffusivity, &m, 1000000);
    bn_run("material/volumetric_cp", &b_volumetric, &m, 1000000);
    bn_run("material/to_json (Cyrius only)", &b_to_json, &m, 100000);
    bn_run("material/from_json (Cyrius only)", &b_from_json, &m, 100000);
    bn_run("span, DEBUG off (Cyrius only)", &b_span, 0, 1000000);
    bn_lists();
    bn_run("transfer/conduction", &b_conduction, 0, 1000000);
    bn_run("transfer/convection", &b_convection, 0, 1000000);
    bn_run("transfer/radiation", &b_radiation, 0, 1000000);
    bn_run("transfer/resistance_series", &b_series, 0, 1000000);
    bn_run("transfer/resistance_parallel", &b_parallel, 0, 1000000);
    bn_run("transfer/heat_stored", &b_heat_stored, 0, 1000000);
    bn_run("transfer/diffusivity", &b_tr_diffusivity, 0, 1000000);
    bn_run("transfer/biot_number", &b_biot, 0, 1000000);
    bn_run("transfer/lumped_capacitance", &b_lumped, 0, 1000000);
    bn_run("transfer/reynolds", &b_reynolds, 0, 1000000);
    bn_run("transfer/nusselt_db", &b_nusselt_db, 0, 1000000);
    bn_run("transfer/fin_rect_heat", &b_fin_heat, 0, 1000000);
    bn_run("transfer/lmtd_counter", &b_lmtd_counter, 0, 1000000);
    bn_run("transfer/eff_counter", &b_eff_counter, 0, 1000000);
    bn_run("transfer/view_factor_disks", &b_vf_disks, 0, 1000000);
    bn_run("transfer/view_factor_perpendicular", &b_vf_perpendicular, 0, 1000000);
    bn_run("state/ideal_gas_pressure", &b_ig_pressure, 0, 1000000);
    bn_run("state/ideal_gas_volume", &b_ig_volume, 0, 1000000);
    bn_run("state/van_der_waals", &b_vdw, 0, 1000000);
    bn_run("state/isothermal_work", &b_iso_work, 0, 1000000);
    bn_run("state/adiabatic_temperature", &b_adiabatic, 0, 1000000);
    bn_run("state/compressibility_factor", &b_z, 0, 1000000);
    bn_run("state/redlich_kwong", &b_rk, 0, 1000000);
    bn_run("state/peng_robinson", &b_pr, 0, 1000000);
    bn_run("entropy/carnot_efficiency", &b_carnot, 0, 1000000);
    bn_run("entropy/carnot_cop", &b_cop, 0, 1000000);
    bn_run("entropy/helmholtz", &b_helmholtz, 0, 1000000);
    bn_run("entropy/gibbs", &b_gibbs, 0, 1000000);
    bn_run("entropy/mixing", &b_mixing, 0, 1000000);
    bn_run("entropy/ideal_gas_ds", &b_ig_ds, 0, 1000000);
    var water: UsSubstance;
    var tw, vw = us_substance_preset(US_SUBSTANCE_WATER_PHASE, &water);
    bn_run("phase/clausius_clapeyron_slope", &b_cc_slope, 0, 1000000);
    bn_run("phase/clausius_clapeyron_pressure", &b_cc_pressure, 0, 1000000);
    bn_run("phase/phase_lookup", &b_phase_at, &water, 1000000);
    bn_run("phase/heat_of_fusion", &b_fusion, &water, 1000000);
    bn_run("phase/heat_of_vaporization", &b_vaporization, &water, 1000000);
    bn_run("phase/heat_for_phase_change", &b_phase_change, &water, 1000000);
    var se: UsSaturated;
    var ts, vs = us_saturated_by_temperature(373.15, &se);
    var hf: f64 = se.h_f;
    var hfg: f64 = se.h_fg;
    _bn_h_mid = hf + 0.5 * hfg;
    bn_run("steam/saturated_by_temp", &b_sat_t, 0, 1000000);
    bn_run("steam/saturated_by_pressure", &b_sat_p, 0, 1000000);
    bn_run("steam/quality_from_enthalpy", &b_quality_h, &se, 1000000);
    bn_run("steam/wet_steam_properties", &b_wet, &se, 1000000);
    bn_run("steam/saturation_pressure", &b_sat_pressure, 0, 1000000);
    bn_run("steam/superheated_lookup", &b_sh_lookup, 0, 1000000);
    bn_run("steam/superheated_between_tiers", &b_sh_between, 0, 1000000);
    bn_run("steam/superheated_by_entropy", &b_sh_by_s, 0, 100000);
    var cr: UsCycleResult;
    var tci, vci = us_cycle_result_init(&cr);
    bn_run("cycle/otto", &b_otto, &cr, 1000000);
    bn_run("cycle/diesel", &b_diesel, &cr, 1000000);
    bn_run("cycle/brayton", &b_brayton, &cr, 1000000);
    bn_run("cycle/rankine", &b_rankine, &cr, 1000000);
    var rr: UsRefrigerationResult;
    var trr, vrr = us_refrigeration_result_init(&rr);
    bn_run("cycle/refrigeration", &b_refrigeration, &rr, 100000);
    _bn_diag = alloc(16 * 200);
    var ttd, vtd = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &cr);
    bn_run("cycle/ts_diagram, 200 points (Cyrius only)", &b_ts_diagram, &cr, 100000);
    bn_run("cycle/pv_diagram, 200 points (Cyrius only)", &b_pv_diagram, &cr, 100000);
    bn_run("cycle/compare, one entry (Cyrius only)", &b_compare, &cr, 1000000);
    bn_reactions();
    bn_run("chem/reaction_enthalpy", &b_reaction_enthalpy, 0, 1000000);
    bn_run("chem/equilibrium_constant", &b_equilibrium_constant, 0, 1000000);
    bn_run("chem/adiabatic_flame", &b_flame, 0, 1000000);
    bn_run("stat/rms_speed", &b_rms_speed, 0, 1000000);
    bn_run("stat/einstein_cv", &b_einstein, 0, 1000000);
    bn_run("stat/debye_cv", &b_debye, 0, 100000);
    bn_run("stat/debye_cv_low_t", &b_debye_low, 0, 1000000);
    var bcl: UsBoundaryCondition;
    var bcr: UsBoundaryCondition;
    us_boundary_fixed(&bcl, 400.0);
    us_boundary_fixed(&bcr, 300.0);
    var g1: UsGrid1D;
    var tg1, vg1 = us_grid1d_new(&g1, 100, 1.0, 0.0001, 300.0, &bcl, &bcr);
    var gdx: f64 = g1.dx;
    var gal: f64 = g1.alpha;
    _bn_g1_dt = 0.4 * gdx * gdx / gal;
    bn_run("numerical/explicit_1d", &b_explicit, &g1, 100000);
    var g2: UsGrid1D;
    var tg2, vg2 = us_grid1d_new(&g2, 100, 1.0, 0.0001, 300.0, &bcl, &bcr);
    bn_run("numerical/crank_nicolson_1d", &b_cn, &g2, 100000);
    var bcc: UsBoundaryCondition;
    us_boundary_convective(&bcc, 50.0, 290.0, 15.0);
    var g3: UsGrid1D;
    var tg3, vg3 = us_grid1d_new(&g3, 51, 0.1, 0.00001, 300.0, &bcl, &bcc);
    var ms: f64 = us_grid1d_max_stable_dt(&g3);
    _bn_g1_dt = 4.0 * ms;
    bn_run("numerical/adaptive_1d_4substeps", &b_adaptive, &g3, 100000);
    var gsrc: UsGrid2D;
    var tgs, vgs = us_grid2d_new(&gsrc, 20, 20, 1.0, 1.0, 300.0);
    var bcf: UsBoundaryCondition;
    us_boundary_fixed(&bcf, 400.0);
    var tsb, vsb = us_grid2d_set_boundary(&gsrc, US_SIDE_LEFT, &bcf);
    us_boundary_fixed(&bcf, 300.0);
    var tsc, vsc = us_grid2d_set_boundary(&gsrc, US_SIDE_RIGHT, &bcf);
    _bn_g2_nodes = gsrc.nodes;
    var gw: UsGrid2D;
    var tgw, vgw = us_grid2d_new(&gw, 20, 20, 1.0, 1.0, 300.0);
    var tsd, vsd = us_grid2d_set_boundary(&gw, US_SIDE_LEFT, us_grid2d_bc(&gsrc, US_SIDE_LEFT));
    var tse, vse = us_grid2d_set_boundary(&gw, US_SIDE_RIGHT, us_grid2d_bc(&gsrc, US_SIDE_RIGHT));
    bn_run("numerical/gauss_seidel_2d_20x20", &b_gauss_seidel, &gw, 100);
    return 0;
}

var r = main();
sys_exit_group(r);
