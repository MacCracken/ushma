# ushma benchmarks, recorded against Rust 1.4.0's (docs/benchmarks-rust-v-cyrius.md). Each name is Rust's criterion
# name where Rust has one; the JSON ones are Cyrius-only (Rust benches no serde path).
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report. Every sub-1 µs operation
# runs in batches of 10^6 to amortize the clock (~240 ns per start/stop pair on x86_64 Linux; lib/bench.cyr's header).

include "src/constants.cyr"
include "src/error.cyr"
include "src/mathx_data.cyr"
