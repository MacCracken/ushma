# ushma fuzz harness: every reader of untrusted input (port plan §6). Run with `cyrius fuzz --poison --bounds`.
#
# The targets so far: USHMA_LOG parsing (`us_log_parse`), and the `ThermalMaterial`, `GasData`, `SubstanceData`,
# `Phase`, `SaturatedEntry`, `WetSteamProperties`, `SuperheatedEntry`, `StatePoint`, `ProcessKind`, `CycleKind`,
# `CycleResult`, `RefrigerationResult`, `DiagramPoint`, `CycleComparisonEntry` and `Species` decoders, which must
# also round-trip: what one accepts re-encodes, reads
# back, and re-encodes to the same bytes. The other JSON decoders and the daimon response
# handling join as they port. Each target must accept any bytes: return a defined result, never crash, never write
# outside its buffers (the poisoning allocator and --bounds check that).
#
# Inputs are seeded and deterministic: mutations (flips, inserts, deletes, truncations, case changes) of the valid
# forms, and random strings of 0 … 40 bytes.

include "src/constants.cyr"
include "src/error.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/validate.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/material_data.cyr"
include "src/material.cyr"
include "src/state_data.cyr"
include "src/state.cyr"
include "src/phase_data.cyr"
include "src/phase.cyr"
include "src/steam_data.cyr"
include "src/steam.cyr"
include "src/cycle.cyr"
include "src/chem_data.cyr"
include "src/chem.cyr"

var _fz_state = 0x2545F4914F6CDD1D;
var _fz_bad = 0;
var _fz_arena = 0;
var _fz_sb = 0;
var _fz_sb2 = 0;
var _fz_read = 0;
var _fz_gas_read = 0;
var _fz_sub_read = 0;
var _fz_enum_read = 0;
var _fz_f64_read = 0;
var _fz_cycle_read = 0;
var _fz_refr_read = 0;
var _fz_cmp_read = 0;

# xorshift64*: the next pseudo-random word.
fn fz_next(): i64 {
    var x = _fz_state;
    x = x ^ ((x >> 12) & 0x000FFFFFFFFFFFFF);
    x = x ^ (x << 25);
    x = x ^ ((x >> 27) & 0x0000001FFFFFFFFF);
    _fz_state = x;
    return x * 0x2545F4914F6CDD1D;
}

# A pseudo-random integer in 0 .. n - 1.
fn fz_below(n): i64 {
    var r = fz_next() & 0x7FFFFFFFFFFFFFFF;
    return r % n;
}

# The material decoder on one input: any result is fine, but an accepted document must round-trip.
fn fz_material(data, len) {
    var m: UsMaterial;
    reset_via(_fz_arena);
    var t, v = us_material_from_json_a(_fz_arena, data, len, &m);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_read = _fz_read + 1;
    store64(_fz_sb + 8, 0);
    us_material_to_json(_fz_sb, &m);
    var m2: UsMaterial;
    var t2, v2 = us_material_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &m2);
    if (is_ok(t2) == 0) {
        # A document holding NaN or ±∞ writes them as null, which reads back as no f64: serde_json's behaviour too.
        var k: f64 = m.conductivity;
        var c: f64 = m.specific_heat;
        var d: f64 = m.density;
        var mp: f64 = m.melting_point;
        var bp: f64 = m.boiling_point;
        if (_us_is_finite(k) + _us_is_finite(c) + _us_is_finite(d) + _us_is_finite(mp) + _us_is_finite(bp) == 5) {
            _fz_bad = _fz_bad + 1;
        }
        return 0;
    }
    store64(_fz_sb2 + 8, 0);
    us_material_to_json(_fz_sb2, &m2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# A named document of three f64 (`kind` 1 a GasData, 2 a Species; both a name and length then the three) decoded into
# the 40 bytes at `w`: Ok's tag, its code into *code.
fn fz_named_decode(kind, data, len, w, code): i64 {
    if (kind == 1) {
        var t, v = us_gas_from_json_a(_fz_arena, data, len, w);
        store64(code, v);
        return is_ok(t);
    }
    var t2, v2 = us_species_from_json_a(_fz_arena, data, len, w);
    store64(code, v2);
    return is_ok(t2);
}

# The 40 bytes at `w` re-encoded into builder `sb`, as `kind`'s document.
fn fz_named_encode(kind, sb, w) {
    store64(sb + 8, 0);
    if (kind == 1) { us_gas_to_json(sb, w); }
    if (kind == 2) { us_species_to_json(sb, w); }
    return 0;
}

# A named decoder on one input: any result is fine, but an accepted document must round-trip.
fn fz_named(kind, data, len) {
    var w[40];
    var w2[40];
    var code[8];
    reset_via(_fz_arena);
    if (fz_named_decode(kind, data, len, &w, &code) == 0) {
        if (load64(&code) != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_gas_read = _fz_gas_read + 1;
    fz_named_encode(kind, _fz_sb, &w);
    if (fz_named_decode(kind, load64(_fz_sb), load64(_fz_sb + 8), &w2, &code) == 0) {
        # NaN and ±∞ write as null, which reads back as no f64 (as fz_material).
        var a: f64 = load64(&w + 16);
        var b: f64 = load64(&w + 24);
        var c: f64 = load64(&w + 32);
        if (_us_is_finite(a) + _us_is_finite(b) + _us_is_finite(c) == 3) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    fz_named_encode(kind, _fz_sb2, &w2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# The SubstanceData decoder on one input: any result is fine, but an accepted document must round-trip.
fn fz_substance(data, len) {
    var s: UsSubstance;
    reset_via(_fz_arena);
    var t, v = us_substance_from_json_a(_fz_arena, data, len, &s);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_sub_read = _fz_sub_read + 1;
    store64(_fz_sb + 8, 0);
    us_substance_to_json(_fz_sb, &s);
    var s2: UsSubstance;
    var t2, v2 = us_substance_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &s2);
    if (is_ok(t2) == 0) {
        # A non-finite field writes as null, which reads back as no f64 (as fz_material).
        var fin = 0;
        var base = &s;
        var k = 0;
        while (k < 10) {
            var x: f64 = load64(base + 16 + (8 * k));
            fin = fin + _us_is_finite(x);
            k = k + 1;
        }
        if (fin == 10) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    store64(_fz_sb2 + 8, 0);
    us_substance_to_json(_fz_sb2, &s2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# A unit-enum document (`kind` 1 a Phase, 2 a ProcessKind, 3 a CycleKind) decoded: Ok's tag, its value or code into
# *out.
fn fz_enum_decode(kind, data, len, out): i64 {
    if (kind == 1) {
        var t, v = us_phase_from_json_a(_fz_arena, data, len);
        store64(out, v);
        return is_ok(t);
    }
    if (kind == 2) {
        var t2, v2 = us_process_from_json_a(_fz_arena, data, len);
        store64(out, v2);
        return is_ok(t2);
    }
    var t3, v3 = us_cycle_from_json_a(_fz_arena, data, len);
    store64(out, v3);
    return is_ok(t3);
}

# A unit-enum decoder on one input: a refusal is Deserialize, an accepted value is one of the enum's and round-trips.
fn fz_enum(kind, data, len) {
    var count = US_PHASE_COUNT;
    if (kind == 2) { count = US_PROCESS_COUNT; }
    if (kind == 3) { count = US_CYCLE_COUNT; }
    var w[8];
    var w2[8];
    reset_via(_fz_arena);
    if (fz_enum_decode(kind, data, len, &w) == 0) {
        if (load64(&w) != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_enum_read = _fz_enum_read + 1;
    var v = load64(&w);
    if (v < 0 || v >= count) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    store64(_fz_sb + 8, 0);
    if (kind == 1) { us_phase_to_json(_fz_sb, v); }
    if (kind == 2) { us_process_to_json(_fz_sb, v); }
    if (kind == 3) { us_cycle_to_json(_fz_sb, v); }
    if (fz_enum_decode(kind, load64(_fz_sb), load64(_fz_sb + 8), &w2) == 0 || load64(&w2) != v) {
        _fz_bad = _fz_bad + 1;
    }
    return 0;
}

# An all-f64 struct document (`kind` 1 a SaturatedEntry of 9 fields, 2 a WetSteamProperties of 4, 3 a
# SuperheatedEntry of 5, 4 a StatePoint of 5, 5 a DiagramPoint of 2) decoded into *w: Ok's tag, its code into *code.
fn fz_f64_decode(kind, data, len, w, code): i64 {
    if (kind == 5) {
        var t5, v5 = us_diagram_point_from_json_a(_fz_arena, data, len, w);
        store64(code, v5);
        return is_ok(t5);
    }
    if (kind == 4) {
        var t4, v4 = us_state_point_from_json_a(_fz_arena, data, len, w);
        store64(code, v4);
        return is_ok(t4);
    }
    if (kind == 3) {
        var t3, v3 = us_superheated_from_json_a(_fz_arena, data, len, w);
        store64(code, v3);
        return is_ok(t3);
    }
    if (kind == 1) {
        var t, v = us_saturated_from_json_a(_fz_arena, data, len, w);
        store64(code, v);
        return is_ok(t);
    }
    var t2, v2 = us_wet_steam_from_json_a(_fz_arena, data, len, w);
    store64(code, v2);
    return is_ok(t2);
}

# The words at `w` re-encoded into builder `sb`, as `kind`'s document.
fn fz_f64_encode(kind, sb, w) {
    store64(sb + 8, 0);
    if (kind == 1) { us_saturated_to_json(sb, w); }
    if (kind == 2) { us_wet_steam_to_json(sb, w); }
    if (kind == 3) { us_superheated_to_json(sb, w); }
    if (kind == 4) { us_state_point_to_json(sb, w); }
    if (kind == 5) { us_diagram_point_to_json(sb, w); }
    return 0;
}

# An all-f64 struct decoder on one input: any result is fine, but an accepted document must round-trip.
fn fz_f64(kind, data, len) {
    var n = 9;
    if (kind == 2) { n = 4; }
    if (kind == 3 || kind == 4) { n = 5; }
    if (kind == 5) { n = 2; }
    var w[72];
    var w2[72];
    var code[8];
    reset_via(_fz_arena);
    if (fz_f64_decode(kind, data, len, &w, &code) == 0) {
        if (load64(&code) != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_f64_read = _fz_f64_read + 1;
    fz_f64_encode(kind, _fz_sb, &w);
    if (fz_f64_decode(kind, load64(_fz_sb), load64(_fz_sb + 8), &w2, &code) == 0) {
        # A non-finite field writes as null, which reads back as no f64 (as fz_material).
        var fin = 0;
        var k = 0;
        while (k < n) {
            var x: f64 = load64(&w + (8 * k));
            fin = fin + _us_is_finite(x);
            k = k + 1;
        }
        if (fin == n) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    fz_f64_encode(kind, _fz_sb2, &w2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# The finite count of a decoded result's numbers and state-point words, against their total: 1 when all are finite.
fn fz_cycle_finite(r: *UsCycleResult): i64 {
    var base = r;
    var k = 0;
    while (k < 6) {
        var x: f64 = load64(base + _US_CR_NUMS + (8 * k));
        if (_us_is_finite(x) == 0) { return 0; }
        k = k + 1;
    }
    var n = vec_len(r.states);
    k = 0;
    while (k < n) {
        var y: f64 = vec_get(r.states, k);
        if (_us_is_finite(y) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# The CycleResult decoder on one input: a refusal is Deserialize; an accepted result has whole state points, a cycle
# kind and process codes in range, and round-trips.
fn fz_cycle(data, len) {
    var r: UsCycleResult;
    reset_via(_fz_arena);
    var t, v = us_cycle_result_from_json_a(_fz_arena, data, len, &r);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_cycle_read = _fz_cycle_read + 1;
    var ok = 1;
    if (r.kind < 0 || r.kind >= US_CYCLE_COUNT || vec_len(r.states) % 5 != 0) { ok = 0; }
    var k = 0;
    while (k < us_cycle_process_count(&r)) {
        var pk = us_cycle_process(&r, k);
        if (pk < 0 || pk >= US_PROCESS_COUNT) { ok = 0; }
        k = k + 1;
    }
    if (ok == 0) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    store64(_fz_sb + 8, 0);
    us_cycle_result_to_json(_fz_sb, &r);
    var r2: UsCycleResult;
    var t2, v2 = us_cycle_result_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &r2);
    if (is_ok(t2) == 0) {
        # A non-finite number writes as null, which reads back as no f64 (as fz_material).
        if (fz_cycle_finite(&r) == 1) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    store64(_fz_sb2 + 8, 0);
    us_cycle_result_to_json(_fz_sb2, &r2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# The RefrigerationResult decoder on one input: a refusal is Deserialize; an accepted result has a cycle as
# fz_cycle's, and round-trips.
fn fz_refr(data, len) {
    var rr: UsRefrigerationResult;
    reset_via(_fz_arena);
    var t, v = us_refrigeration_result_from_json_a(_fz_arena, data, len, &rr);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_refr_read = _fz_refr_read + 1;
    var c: *UsCycleResult = us_refrigeration_result_cycle(&rr);
    if (c.kind < 0 || c.kind >= US_CYCLE_COUNT || vec_len(c.states) % 5 != 0) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    store64(_fz_sb + 8, 0);
    us_refrigeration_result_to_json(_fz_sb, &rr);
    var r2: UsRefrigerationResult;
    var t2, v2 = us_refrigeration_result_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &r2);
    if (is_ok(t2) == 0) {
        # A non-finite number writes as null, which reads back as no f64 (as fz_material).
        var cr: f64 = rr.cop_refrigeration;
        var ch: f64 = rr.cop_heat_pump;
        if (fz_cycle_finite(c) == 1 && _us_is_finite(cr) == 1 && _us_is_finite(ch) == 1) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    store64(_fz_sb2 + 8, 0);
    us_refrigeration_result_to_json(_fz_sb2, &r2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# The CycleComparisonEntry decoder on one input: a refusal is Deserialize; an accepted entry has a cycle kind in range
# and round-trips.
fn fz_comparison(data, len) {
    var c: UsCycleComparison;
    reset_via(_fz_arena);
    var t, v = us_cycle_comparison_from_json_a(_fz_arena, data, len, &c);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_cmp_read = _fz_cmp_read + 1;
    if (c.kind < 0 || c.kind >= US_CYCLE_COUNT) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    store64(_fz_sb + 8, 0);
    us_cycle_comparison_to_json(_fz_sb, &c);
    var c2: UsCycleComparison;
    var t2, v2 = us_cycle_comparison_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &c2);
    if (is_ok(t2) == 0) {
        # A non-finite number writes as null, which reads back as no f64 (as fz_material).
        var fin = 0;
        var base = &c;
        var k = 1;
        while (k < 6) {
            var x: f64 = load64(base + (8 * k));
            fin = fin + _us_is_finite(x);
            k = k + 1;
        }
        if (fin == 5) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    store64(_fz_sb2 + 8, 0);
    us_cycle_comparison_to_json(_fz_sb2, &c2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# A builder's text as a fresh C string.
fn fz_text(sb): i64 {
    var n = load64(sb + 8);
    var c = alloc(n + 1);
    memcpy(c, load64(sb), n);
    store8(c + n, 0);
    return c;
}

# Fuzz target: one input of `len` bytes at `data`, through every reader.
fn fuzz_main(data, len) {
    var lv = us_log_parse(data, len);
    if (lv < 0 - 1 || lv > LOG_FATAL + 1) { _fz_bad = _fz_bad + 1; }
    fz_material(data, len);
    fz_named(1, data, len);
    fz_named(2, data, len);
    fz_substance(data, len);
    fz_enum(1, data, len);
    fz_enum(2, data, len);
    fz_enum(3, data, len);
    fz_f64(1, data, len);
    fz_f64(2, data, len);
    fz_f64(3, data, len);
    fz_f64(4, data, len);
    fz_f64(5, data, len);
    fz_cycle(data, len);
    fz_refr(data, len);
    fz_comparison(data, len);
    return 0;
}

# A fresh C string: `a` then `b`.
fn fz_cat(a, b): i64 {
    var na = strlen(a);
    var nb = strlen(b);
    var p = alloc(na + nb + 1);
    memcpy(p, a, na);
    memcpy(p + na, b, nb + 1);
    return p;
}

# Copies seed `s` into `buf` (its first `cap` bytes, at most) and mutates it in place; returns the new length (at most
# `cap`).
fn fz_mutate(buf, cap, s): i64 {
    var n = strlen(s);
    if (n > cap) { n = cap; }
    memcpy(buf, s, n);
    var edits = fz_below(4);
    var k = 0;
    while (k < edits) {
        var op = fz_below(5);
        if (op == 0 && n > 0) { store8(buf + fz_below(n), fz_below(256)); }
        if (op == 1 && n < cap) {
            var at = fz_below(n + 1);
            var j = n;
            while (j > at) { store8(buf + j, load8(buf + j - 1)); j = j - 1; }
            store8(buf + at, fz_below(256));
            n = n + 1;
        }
        if (op == 2 && n > 0) {
            var at2 = fz_below(n);
            var j2 = at2;
            while (j2 + 1 < n) { store8(buf + j2, load8(buf + j2 + 1)); j2 = j2 + 1; }
            n = n - 1;
        }
        if (op == 3) { n = fz_below(n + 1); }
        if (op == 4 && n > 0) {
            var at3 = fz_below(n);
            var c = load8(buf + at3);
            if (c >= 97 && c <= 122) { store8(buf + at3, c - 32); }
        }
        k = k + 1;
    }
    return n;
}

# Runs the targets over 50,000 seeded inputs and reports.
fn main() {
    alloc_init();
    _fz_arena = arena_allocator_growable(65536);
    _fz_sb = str_builder_new();
    _fz_sb2 = str_builder_new();
    var cap = 2048;
    var buf = alloc(cap + 1);
    var seeds = alloc(8 * 42);
    store64(seeds, "trace");
    store64(seeds + 8, "debug");
    store64(seeds + 16, "info");
    store64(seeds + 24, "warn");
    store64(seeds + 32, "error");
    store64(seeds + 40, "off");
    store64(seeds + 48, "ushma=debug");
    store64(seeds + 56, " ushma=Warn\t");
    store64(seeds + 64, "ushma=");
    store64(seeds + 72, "debug,info");
    var cu = "{\"name\":\"Copper\",\"conductivity\":401.0,\"specific_heat\":385.0,";
    store64(seeds + 80, fz_cat(cu, "\"density\":8960.0,\"melting_point\":1358.0,\"boiling_point\":2835.0}"));
