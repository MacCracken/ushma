# ushma fuzz harness

# Fuzz target: receives one input of len bytes at data. The JSON decoders, USHMA_LOG parsing and
# daimon response handling are added here as they port (port plan §6).
fn fuzz_main(data, len) {
    if (len == 0) { return 0; }
    return 0;
}

# Fuzz entry point: runs the target once on a fixed seed input.
fn main() {
    alloc_init();
    fuzz_main("test", 4);
    println("fuzz: ok");
    return 0;
}

var r = main();
sys_exit_group(r);
