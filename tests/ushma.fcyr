# ushma fuzz harness: every reader of untrusted input (port plan §6). Run with `cyrius fuzz --poison --bounds`.
#
# The targets so far: USHMA_LOG parsing (`us_log_parse`), and the `ThermalMaterial`, `GasData`, `SubstanceData`,
# `Phase`, `SaturatedEntry`, `WetSteamProperties` and `SuperheatedEntry` decoders, which must also round-trip: what
# one accepts re-encodes, reads back, and re-encodes to the same bytes. The other JSON decoders and the daimon response
# handling join as they port. Each target must accept any bytes: return a defined result, never crash, never write
# outside its buffers (the poisoning allocator and --bounds check that).
#
# Inputs are seeded and deterministic: mutations (flips, inserts, deletes, truncations, case changes) of the valid
# forms, and random strings of 0 … 40 bytes.

include "src/constants.cyr"
include "src/error.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/validate.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/material_data.cyr"
include "src/material.cyr"
include "src/state_data.cyr"
include "src/state.cyr"
include "src/phase_data.cyr"
include "src/phase.cyr"
include "src/steam_data.cyr"
include "src/steam.cyr"

var _fz_state = 0x2545F4914F6CDD1D;
var _fz_bad = 0;
var _fz_arena = 0;
var _fz_sb = 0;
var _fz_sb2 = 0;
var _fz_read = 0;
var _fz_gas_read = 0;
var _fz_sub_read = 0;
var _fz_phase_read = 0;
var _fz_steam_read = 0;

# xorshift64*: the next pseudo-random word.
fn fz_next(): i64 {
    var x = _fz_state;
    x = x ^ ((x >> 12) & 0x000FFFFFFFFFFFFF);
    x = x ^ (x << 25);
    x = x ^ ((x >> 27) & 0x0000001FFFFFFFFF);
    _fz_state = x;
    return x * 0x2545F4914F6CDD1D;
}

# A pseudo-random integer in 0 .. n - 1.
fn fz_below(n): i64 {
    var r = fz_next() & 0x7FFFFFFFFFFFFFFF;
    return r % n;
}

# The material decoder on one input: any result is fine, but an accepted document must round-trip.
fn fz_material(data, len) {
    var m: UsMaterial;
    reset_via(_fz_arena);
    var t, v = us_material_from_json_a(_fz_arena, data, len, &m);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_read = _fz_read + 1;
    store64(_fz_sb + 8, 0);
    us_material_to_json(_fz_sb, &m);
    var m2: UsMaterial;
    var t2, v2 = us_material_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &m2);
    if (is_ok(t2) == 0) {
        # A document holding NaN or ±∞ writes them as null, which reads back as no f64: serde_json's behaviour too.
        var k: f64 = m.conductivity;
        var c: f64 = m.specific_heat;
        var d: f64 = m.density;
        var mp: f64 = m.melting_point;
        var bp: f64 = m.boiling_point;
        if (_us_is_finite(k) + _us_is_finite(c) + _us_is_finite(d) + _us_is_finite(mp) + _us_is_finite(bp) == 5) {
            _fz_bad = _fz_bad + 1;
        }
        return 0;
    }
    store64(_fz_sb2 + 8, 0);
    us_material_to_json(_fz_sb2, &m2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# The GasData decoder on one input: any result is fine, but an accepted document must round-trip.
fn fz_gas(data, len) {
    var g: UsGas;
    reset_via(_fz_arena);
    var t, v = us_gas_from_json_a(_fz_arena, data, len, &g);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_gas_read = _fz_gas_read + 1;
    store64(_fz_sb + 8, 0);
    us_gas_to_json(_fz_sb, &g);
    var g2: UsGas;
    var t2, v2 = us_gas_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &g2);
    if (is_ok(t2) == 0) {
        # NaN and ±∞ write as null, which reads back as no f64 (as fz_material).
        var tc: f64 = g.critical_t;
        var pc: f64 = g.critical_p;
        var om: f64 = g.acentric_factor;
        if (_us_is_finite(tc) + _us_is_finite(pc) + _us_is_finite(om) == 3) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    store64(_fz_sb2 + 8, 0);
    us_gas_to_json(_fz_sb2, &g2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# The SubstanceData decoder on one input: any result is fine, but an accepted document must round-trip.
fn fz_substance(data, len) {
    var s: UsSubstance;
    reset_via(_fz_arena);
    var t, v = us_substance_from_json_a(_fz_arena, data, len, &s);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_sub_read = _fz_sub_read + 1;
    store64(_fz_sb + 8, 0);
    us_substance_to_json(_fz_sb, &s);
    var s2: UsSubstance;
    var t2, v2 = us_substance_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8), &s2);
    if (is_ok(t2) == 0) {
        # A non-finite field writes as null, which reads back as no f64 (as fz_material).
        var fin = 0;
        var k = 0;
        while (k < 10) {
            var x: f64 = load64(&s + 16 + (8 * k));
            fin = fin + _us_is_finite(x);
            k = k + 1;
        }
        if (fin == 10) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    store64(_fz_sb2 + 8, 0);
    us_substance_to_json(_fz_sb2, &s2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# The Phase decoder on one input: a refusal is Deserialize, an accepted phase is a phase and round-trips.
fn fz_phase(data, len) {
    reset_via(_fz_arena);
    var t, v = us_phase_from_json_a(_fz_arena, data, len);
    if (is_ok(t) == 0) {
        if (v != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_phase_read = _fz_phase_read + 1;
    if (v < 0 || v >= US_PHASE_COUNT) {
        _fz_bad = _fz_bad + 1;
        return 0;
    }
    store64(_fz_sb + 8, 0);
    us_phase_to_json(_fz_sb, v);
    var t2, v2 = us_phase_from_json_a(_fz_arena, load64(_fz_sb), load64(_fz_sb + 8));
    if (is_ok(t2) == 0 || v2 != v) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# An all-f64 steam document (`kind` 1 a SaturatedEntry of 9 fields, 2 a WetSteamProperties of 4, 3 a SuperheatedEntry
# of 5) decoded into *w: Ok's tag, its code into *code.
fn fz_steam_decode(kind, data, len, w, code): i64 {
    if (kind == 3) {
        var t3, v3 = us_superheated_from_json_a(_fz_arena, data, len, w);
        store64(code, v3);
        return is_ok(t3);
    }
    if (kind == 1) {
        var t, v = us_saturated_from_json_a(_fz_arena, data, len, w);
        store64(code, v);
        return is_ok(t);
    }
    var t2, v2 = us_wet_steam_from_json_a(_fz_arena, data, len, w);
    store64(code, v2);
    return is_ok(t2);
}

# The words at `w` (`n` fields) re-encoded into builder `sb`, as `kind`'s document.
fn fz_steam_encode(kind, sb, w) {
    store64(sb + 8, 0);
    if (kind == 1) { us_saturated_to_json(sb, w); }
    if (kind == 2) { us_wet_steam_to_json(sb, w); }
    if (kind == 3) { us_superheated_to_json(sb, w); }
    return 0;
}

# A steam decoder on one input: any result is fine, but an accepted document must round-trip.
fn fz_steam(kind, data, len) {
    var n = 9;
    if (kind == 2) { n = 4; }
    if (kind == 3) { n = 5; }
    var w[72];
    var w2[72];
    var code[8];
    reset_via(_fz_arena);
    if (fz_steam_decode(kind, data, len, &w, &code) == 0) {
        if (load64(&code) != US_ERR_DESERIALIZE) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    _fz_steam_read = _fz_steam_read + 1;
    fz_steam_encode(kind, _fz_sb, &w);
    if (fz_steam_decode(kind, load64(_fz_sb), load64(_fz_sb + 8), &w2, &code) == 0) {
        # A non-finite field writes as null, which reads back as no f64 (as fz_material).
        var fin = 0;
        var k = 0;
        while (k < n) {
            var x: f64 = load64(&w + (8 * k));
            fin = fin + _us_is_finite(x);
            k = k + 1;
        }
        if (fin == n) { _fz_bad = _fz_bad + 1; }
        return 0;
    }
    fz_steam_encode(kind, _fz_sb2, &w2);
    var n1 = load64(_fz_sb + 8);
    if (n1 != load64(_fz_sb2 + 8) || memeq(load64(_fz_sb), load64(_fz_sb2), n1) == 0) { _fz_bad = _fz_bad + 1; }
    return 0;
}

# Fuzz target: one input of `len` bytes at `data`, through every reader.
fn fuzz_main(data, len) {
    var lv = us_log_parse(data, len);
    if (lv < 0 - 1 || lv > LOG_FATAL + 1) { _fz_bad = _fz_bad + 1; }
    fz_material(data, len);
    fz_gas(data, len);
    fz_substance(data, len);
    fz_phase(data, len);
    fz_steam(1, data, len);
    fz_steam(2, data, len);
    fz_steam(3, data, len);
    return 0;
}

# A fresh C string: `a` then `b`.
fn fz_cat(a, b): i64 {
    var na = strlen(a);
    var nb = strlen(b);
    var p = alloc(na + nb + 1);
    memcpy(p, a, na);
    memcpy(p + na, b, nb + 1);
    return p;
}

# Copies seed `s` into `buf` (its first `cap` bytes, at most) and mutates it in place; returns the new length (at most
# `cap`).
fn fz_mutate(buf, cap, s): i64 {
    var n = strlen(s);
    if (n > cap) { n = cap; }
    memcpy(buf, s, n);
    var edits = fz_below(4);
    var k = 0;
    while (k < edits) {
        var op = fz_below(5);
        if (op == 0 && n > 0) { store8(buf + fz_below(n), fz_below(256)); }
        if (op == 1 && n < cap) {
            var at = fz_below(n + 1);
            var j = n;
            while (j > at) { store8(buf + j, load8(buf + j - 1)); j = j - 1; }
            store8(buf + at, fz_below(256));
            n = n + 1;
        }
        if (op == 2 && n > 0) {
            var at2 = fz_below(n);
            var j2 = at2;
            while (j2 + 1 < n) { store8(buf + j2, load8(buf + j2 + 1)); j2 = j2 + 1; }
            n = n - 1;
        }
        if (op == 3) { n = fz_below(n + 1); }
        if (op == 4 && n > 0) {
            var at3 = fz_below(n);
            var c = load8(buf + at3);
            if (c >= 97 && c <= 122) { store8(buf + at3, c - 32); }
        }
        k = k + 1;
    }
    return n;
}

# Runs the targets over 50,000 seeded inputs and reports.
fn main() {
    alloc_init();
    _fz_arena = arena_allocator_growable(65536);
    _fz_sb = str_builder_new();
    _fz_sb2 = str_builder_new();
    var cap = 512;
    var buf = alloc(cap + 1);
    var seeds = alloc(8 * 26);
    store64(seeds, "trace");
    store64(seeds + 8, "debug");
    store64(seeds + 16, "info");
    store64(seeds + 24, "warn");
    store64(seeds + 32, "error");
    store64(seeds + 40, "off");
    store64(seeds + 48, "ushma=debug");
    store64(seeds + 56, " ushma=Warn\t");
    store64(seeds + 64, "ushma=");
    store64(seeds + 72, "debug,info");
    var cu = "{\"name\":\"Copper\",\"conductivity\":401.0,\"specific_heat\":385.0,";
    store64(seeds + 80, fz_cat(cu, "\"density\":8960.0,\"melting_point\":1358.0,\"boiling_point\":2835.0}"));
    store64(seeds + 88, "[\"Air\",0.0263,1007.0,1.1614,0.0,0.0]");
    var un = "{\"name\":\"a\\u00e9\\n\",\"conductivity\":1e-5,\"specific_heat\":2,\"density\":-0.0,";
    store64(seeds + 96, fz_cat(un, "\"melting_point\":1e16,\"boiling_point\":5,\"x\":[1,{\"y\":null}]}"));
    var rv = "{\"boiling_point\":5,\"melting_point\":4,\"density\":3,";
    store64(seeds + 104, fz_cat(rv, "\"specific_heat\":2,\"conductivity\":1,\"name\":\"r\"}"));
    var n2 = "{\"name\":\"Nitrogen\",\"critical_t\":126.19,";
    store64(seeds + 112, fz_cat(n2, "\"critical_p\":3390000.0,\"acentric_factor\":0.037}"));
    store64(seeds + 120, "[\"Water\",647.096,22064000.0,0.344]");
    store64(seeds + 128, "{\"acentric_factor\":-0.0,\"critical_p\":1e-5,\"critical_t\":1e16,\"name\":\"\\u00e9\"}");
    var w1 = "{\"name\":\"Water\",\"triple_point_t\":273.16,\"triple_point_p\":611.657,\"critical_t\":647.096,";
    var w2 = "\"critical_p\":22064000.0,\"critical_density\":322.0,\"latent_heat_fusion\":334000.0,";
    var w3 = "\"latent_heat_vaporization\":2260000.0,\"melting_point\":273.15,\"boiling_point\":373.15,";
    store64(seeds + 136, fz_cat(fz_cat(w1, w2), fz_cat(w3, "\"molar_mass\":0.018015}")));
    store64(seeds + 144, "[\"N2\",63.15,12520,126.19,3390000,313,25700,199000,63.15,77.36,0.028]");
    store64(seeds + 152, "\"Liquid\"");
    store64(seeds + 160, "{\"SupercriticalFluid\":null}");
    store64(seeds + 168, "\"Gas\"");
    var s1 = "{\"temperature\":373.15,\"pressure\":101418.0,\"v_f\":0.001043,\"v_g\":1.6718,\"h_f\":419100.0,";
    store64(seeds + 176, fz_cat(s1, "\"h_fg\":2256400.0,\"h_g\":2675500.0,\"s_f\":1307.0,\"s_g\":7354.0}"));
    store64(seeds + 184, "[273.16,611.657,0.0010002,206.0,0.0,2500900.0,2500900.0,0.0,9155.5]");
    var q1 = "{\"quality\":0.5,\"specific_volume\":0.8,";
    store64(seeds + 192, fz_cat(q1, "\"specific_enthalpy\":1.5e6,\"specific_entropy\":4e3}"));
    store64(seeds + 200, "[573.15,500000.0,0.5226,3064600.0,7461.4]");
    var i = 0;
    while (i < 50000) {
        var n = 0;
        if (fz_below(4) == 0) {
            n = fz_below(41);
            var k = 0;
            while (k < n) { store8(buf + k, fz_below(256)); k = k + 1; }
        } else {
            n = fz_mutate(buf, cap, load64(seeds + 8 * fz_below(26)));
        }
        fuzz_main(buf, n);
        i = i + 1;
    }
    if (_fz_bad != 0) {
        print("fuzz: out-of-range results: ", 28);
        println_int(_fz_bad);
        return 1;
    }
    print("fuzz: ok (50000 inputs; material documents read: ", 49);
    fmt_int(_fz_read);
    print(", gas documents read: ", 22);
    fmt_int(_fz_gas_read);
    print(", substance documents read: ", 28);
    fmt_int(_fz_sub_read);
    print(", phase documents read: ", 24);
    fmt_int(_fz_phase_read);
    print(", steam documents read: ", 24);
    fmt_int(_fz_steam_read);
    println(")");
    return 0;
}

var r = main();
sys_exit_group(r);
