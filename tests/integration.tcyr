# |a − b| as an f64.
fn absdiff(a: f64, b: f64): f64 {
    var d: f64 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    return d;
}

# The Ok value of a Result (asserting it is Ok).
fn okv(t, v, name): i64 {
    assert_eq(is_ok(t), 1, name);
    return v;
}

# Fourier's law through a 10 cm copper wall, 1 m², 100 °C to 20 °C: 320,800 W.
# rust tests/integration.rs: heat_conduction_through_copper_wall
fn heat_conduction_through_copper_wall() {
    test_group("heat conduction through a copper wall");
    var cu: UsMaterial;
    var tp, vp = us_material_preset(US_MATERIAL_COPPER, &cu);
    var k: f64 = cu.conductivity;
    var t, v = us_conduction(k, 1.0, 373.15, 293.15, 0.1);
    var q: f64 = okv(t, v, "conduction is Ok");
    var d: f64 = absdiff(q, 320800.0);
    assert(d < 1.0, "q = 401 x 1 x 80 / 0.1 = 320,800 W");
}

# Lumped-capacitance cooling falls monotonically to the environment.
# rust tests/integration.rs: thermal_equilibrium_lumped_capacitance
fn thermal_equilibrium_lumped_capacitance() {
    test_group("lumped-capacitance equilibrium");
    var t1: f64 = us_lumped_capacitance(500.0, 293.15, 60.0, 60.0);
    var t5: f64 = us_lumped_capacitance(500.0, 293.15, 300.0, 60.0);
    var t30: f64 = us_lumped_capacitance(500.0, 293.15, 1800.0, 60.0);
    assert(t1 < 500.0, "cooler after a minute");
    assert(t5 < t1, "cooler after five");
    assert(t30 < t5, "cooler after thirty");
    var d: f64 = absdiff(t30, 293.15);
    assert(d < 0.01, "after 30 time constants, at the environment");
}

# Copper's diffusivity three ways: by hand, by the material, by transfer.
# rust tests/integration.rs: material_thermal_diffusivity_matches_manual
fn material_thermal_diffusivity_matches_manual() {
    test_group("material diffusivity matches the hand formula");
    var cu: UsMaterial;
    var tp, vp = us_material_preset(US_MATERIAL_COPPER, &cu);
    var k: f64 = cu.conductivity;
    var rho: f64 = cu.density;
    var cp: f64 = cu.specific_heat;
    var manual: f64 = k / (rho * cp);
    var method: f64 = us_material_diffusivity(&cu);
    var d: f64 = absdiff(manual, method);
    assert(d < 0.000000000000001, "the material's diffusivity is k / (rho cp)");
    var t, v = us_thermal_diffusivity(k, rho, cp);
    var byfn: f64 = okv(t, v, "transfer's diffusivity is Ok");
    var d2: f64 = absdiff(byfn, method);
    assert(d2 < 0.000000000000001, "and transfer's agrees");
}

# Dittus–Boelter → Nu → h → convection for air over a 0.1 m plate.
# rust tests/integration.rs: nusselt_to_h_to_convection_chain
fn nusselt_to_h_to_convection_chain() {
    test_group("Nusselt to h to convection");
    var t, v = us_nusselt_dittus_boelter(50000.0, 0.7);
    var nu: f64 = okv(t, v, "Dittus-Boelter is Ok");
    var h: f64 = nu * 0.026 / 0.1;
    var q: f64 = us_convection(h, 0.1, 373.15, 293.15);
    assert(q > 0.0, "heat flows to the cooler air");
    assert(h > 1.0 && h < 1000.0, "h is reasonable for forced convection");
}

# One counter-flow exchanger by LMTD and by ε-NTU: the same heat within 1 %.
# rust tests/integration.rs: lmtd_vs_ntu_same_heat_exchanger
fn lmtd_vs_ntu_same_heat_exchanger() {
    test_group("LMTD and e-NTU agree");
    var t, v = us_lmtd_counter(400.0, 350.0, 300.0, 330.0);
    var lmtd: f64 = okv(t, v, "LMTD is Ok");
    var q_lmtd: f64 = us_heat_exchanger_lmtd(500.0, 2.0, lmtd);
    var c_h: f64 = q_lmtd / (400.0 - 350.0);
    var c_c: f64 = q_lmtd / (330.0 - 300.0);
    var c_min: f64 = _us_min(c_h, c_c);
    var c_max: f64 = _us_max(c_h, c_c);
    var cr: f64 = c_min / c_max;
    var t2, v2 = us_ntu(500.0, 2.0, c_min);
    var n: f64 = okv(t2, v2, "NTU is Ok");
    var t3, v3 = us_effectiveness_counter(n, cr);
    var eff: f64 = okv(t3, v3, "effectiveness is Ok");
    var q_ntu: f64 = us_heat_exchanger_ntu(eff, c_min, 400.0, 300.0);
    var d: f64 = absdiff(q_lmtd, q_ntu);
    var rel: f64 = d / q_lmtd;
    assert(rel < 0.01, "Q by LMTD = Q by e-NTU within 1%");
}

# Coaxial disks obey reciprocity A₁F₁₂ = A₂F₂₁.
# rust tests/integration.rs: view_factor_reciprocity
fn view_factor_reciprocity() {
    test_group("view-factor reciprocity");
    var t, v = us_view_factor_coaxial_disks(0.3, 0.5, 0.4);
    var f12: f64 = okv(t, v, "F12 is Ok");
    var t2, v2 = us_view_factor_coaxial_disks(0.5, 0.3, 0.4);
    var f21: f64 = okv(t2, v2, "F21 is Ok");
    var pi: f64 = F64_PI;
    var a1: f64 = pi * 0.3 * 0.3;
    var a2: f64 = pi * 0.5 * 0.5;
    var a1f: f64 = a1 * f12;
    var a2f: f64 = a2 * f21;
    var d: f64 = absdiff(a1f, a2f);
    var rel: f64 = d / a1f;
    assert(rel < 0.01, "A1 F12 = A2 F21");
}

# |p − 1 atm| / 1 atm.
fn atm_rel(p: f64): f64 {
    var d: f64 = absdiff(p, US_ATM);
    var r: f64 = d / US_ATM;
    return r;
}

# The ideal gas law round trip: V(P), then P(V), then T(P, V).
# rust tests/integration.rs: ideal_gas_law_roundtrip
fn ideal_gas_law_roundtrip() {
    test_group("ideal gas round trip");
    var t, v = us_ideal_gas_volume(2.0, 350.0, US_ATM);
    var vol: f64 = okv(t, v, "V is Ok");
    var t2, v2 = us_ideal_gas_pressure(2.0, 350.0, vol);
    var p: f64 = okv(t2, v2, "P is Ok");
    var rp: f64 = atm_rel(p);
    assert(rp < 0.0000000001, "P back within 1e-10");
    var t3, v3 = us_ideal_gas_temperature(p, vol, 2.0);
    var tb: f64 = okv(t3, v3, "T is Ok");
    var dt: f64 = absdiff(tb, 350.0);
    assert(dt < 0.0000000001, "T back within 1e-10 K");
}

# Adiabatic compression heats; expanding back recovers T₁.
# rust tests/integration.rs: energy_conservation_adiabatic_process
fn energy_conservation_adiabatic_process() {
    test_group("adiabatic round trip");
    var t, v = us_adiabatic_temperature(300.0, 0.02, 0.01, 1.4);
    var t2: f64 = okv(t, v, "compression is Ok");
    assert(t2 > 300.0, "compression heats");
    var tb, vb = us_adiabatic_temperature(t2, 0.01, 0.02, 1.4);
    var back: f64 = okv(tb, vb, "expansion is Ok");
    var d: f64 = absdiff(back, 300.0);
    var rel: f64 = d / 300.0;
    assert(rel < 0.0000000001, "T1 recovered within 1e-10");
}

# Van der Waals CO₂ at STP sits a little below the ideal gas.
# rust tests/integration.rs: van_der_waals_vs_ideal_gas
fn van_der_waals_vs_ideal_gas() {
    test_group("van der Waals vs ideal");
    var t, v = us_ideal_gas_pressure(1.0, US_STANDARD_TEMP, 0.02241);
    var pi: f64 = okv(t, v, "ideal is Ok");
    var t2, v2 = us_van_der_waals_pressure(1.0, US_STANDARD_TEMP, 0.02241, 0.3658, 0.00004286);
    var pv: f64 = okv(t2, v2, "vdW is Ok");
    assert(pv < pi, "attraction lowers the pressure");
    var d: f64 = absdiff(pi, pv);
    var rel: f64 = d / pi;
    assert(rel < 0.05, "by under 5% at STP");
}

# CO₂ at STP: ideal, van der Waals, Redlich–Kwong and Peng–Robinson all within 5 % of 1 atm.
# rust tests/integration.rs: eos_comparison_co2_stp
fn eos_comparison_co2_stp() {
    test_group("equations of state at STP");
    var t, v = us_ideal_gas_pressure(1.0, US_STANDARD_TEMP, 0.02241);
    var pi: f64 = okv(t, v, "ideal is Ok");
    var t2, v2 = us_van_der_waals_pressure(1.0, US_STANDARD_TEMP, 0.02241, 0.3658, 0.00004286);
    var pv: f64 = okv(t2, v2, "vdW is Ok");
    var t3, v3 = us_redlich_kwong_pressure(US_STANDARD_TEMP, 0.02241, 304.13, 7375000.0);
    var pk: f64 = okv(t3, v3, "RK is Ok");
    var t4, v4 = us_peng_robinson_pressure(US_STANDARD_TEMP, 0.02241, 304.13, 7375000.0, 0.224);
    var pp: f64 = okv(t4, v4, "PR is Ok");
    var ri: f64 = atm_rel(pi);
    var rv: f64 = atm_rel(pv);
    var rk: f64 = atm_rel(pk);
    var rp: f64 = atm_rel(pp);
    assert(ri < 0.05, "ideal near 1 atm");
    assert(rv < 0.05, "vdW near 1 atm");
    assert(rk < 0.05, "RK near 1 atm");
    assert(rp < 0.05, "PR near 1 atm");
}

# At 1 m³/mol the virial pressure is the ideal gas's within 0.1 %.
# rust tests/integration.rs: virial_approaches_ideal_at_low_density
fn virial_approaches_ideal_at_low_density() {
    test_group("virial at low density");
    var b: f64 = us_pitzer_second_virial(300.0, 304.13, 7375000.0, 0.224);
    var t, v = us_virial_pressure_2nd(300.0, 1.0, b);
    var pv: f64 = okv(t, v, "virial is Ok");
    var pi: f64 = US_GAS_CONSTANT * 300.0 / 1.0;
    var d: f64 = absdiff(pv, pi);
    var rel: f64 = d / pi;
    assert(rel < 0.001, "within 0.1% of ideal");
}

# 70 % N₂ + 30 % CO₂ at 300 K, 5 MPa: Kay's rules, the reduced coordinates, then Pitzer's Z.
# rust tests/integration.rs: mixture_z_factor_kays_rule
fn mixture_z_factor_kays_rule() {
    test_group("mixture Z by Kay's rules");
    var ys[16];
    var tcs[16];
    var pcs[16];
    var oms[16];
    var y1: f64 = 0.7;
    var y2: f64 = 0.3;
    var a1: f64 = 126.19;
    var a2: f64 = 304.13;
    var b1: f64 = 3390000.0;
    var b2: f64 = 7375000.0;
    var c1: f64 = 0.037;
    var c2: f64 = 0.224;
    store64(&ys, y1);
    store64(&ys + 8, y2);
    store64(&tcs, a1);
    store64(&tcs + 8, a2);
    store64(&pcs, b1);
    store64(&pcs + 8, b2);
    store64(&oms, c1);
    store64(&oms + 8, c2);
    var t, v = us_kays_rule_tc(&ys, 2, &tcs, 2);
    var tc: f64 = okv(t, v, "Tc mix is Ok");
    var t2, v2 = us_kays_rule_pc(&ys, 2, &pcs, 2);
    var pc: f64 = okv(t2, v2, "Pc mix is Ok");
    var t3, v3 = us_kays_rule_omega(&ys, 2, &oms, 2);
    var om: f64 = okv(t3, v3, "omega mix is Ok");
    var tr: f64 = us_reduced_temperature(300.0, tc);
    var pr: f64 = us_reduced_pressure(5000000.0, pc);
    var t4, v4 = us_compressibility_pitzer(pr, tr, om);
    var z: f64 = okv(t4, v4, "Z is Ok");
    assert(z > 0.5 && z < 1.5, "a physical Z");
}

# The Carnot limit at 500 K / 300 K is 40 %, above any real engine's.
# rust tests/integration.rs: carnot_engine_efficiency
fn carnot_engine_efficiency() {
    test_group("Carnot engine");
    var t, v = us_carnot_efficiency(500.0, 300.0);
    var eta: f64 = okv(t, v, "Carnot is Ok");
    var d: f64 = absdiff(eta, 0.4);
    assert(d < 0.0000000001, "eta = 40%");
    assert(0.35 < eta, "a real engine's 35% is below it");
}

# 1 kJ from 500 K to 300 K: the cold body gains more entropy than the hot one loses.
# rust tests/integration.rs: entropy_increase_irreversible_heat_transfer
fn entropy_increase_irreversible_heat_transfer() {
    test_group("irreversible heat transfer");
    var t, v = us_heat_transfer_entropy(0.0 - 1000.0, 500.0);
    var dh: f64 = okv(t, v, "the hot body's change is Ok");
    var t2, v2 = us_heat_transfer_entropy(1000.0, 300.0);
    var dc: f64 = okv(t2, v2, "the cold body's change is Ok");
    var total: f64 = dh + dc;
    assert(total > 0.0, "total entropy rises");
    assert_eq(us_is_spontaneous(total), 1, "spontaneous");
}

# material's Water and phase's Water agree on the boiling point.
# rust tests/integration.rs: water_boiling_point_consistency
fn water_boiling_point_consistency() {
    test_group("water's boiling point, two tables");
    var m: UsMaterial;
    var tm, vm = us_material_preset(US_MATERIAL_WATER, &m);
    var s: UsSubstance;
    var ts, vs = us_substance_preset(US_SUBSTANCE_WATER_PHASE, &s);
    var bm: f64 = m.boiling_point;
    var bs: f64 = s.boiling_point;
    var d: f64 = absdiff(bm, bs);
    assert(d < 0.01, "within 0.01 K");
}

# Clausius–Clapeyron from water's boiling point predicts the steam table's 120 °C pressure within 5 %.
# rust tests/integration.rs: clausius_clapeyron_vs_steam_table
fn clausius_clapeyron_vs_steam_table() {
    test_group("Clausius-Clapeyron against the steam table");
    var w: UsSubstance;
    var tw, vw = us_substance_preset(US_SUBSTANCE_WATER_PHASE, &w);
    var lv: f64 = w.latent_heat_vaporization;
    var mm: f64 = w.molar_mass;
    var bp: f64 = w.boiling_point;
    var lm: f64 = lv * mm;
    var t, v = us_clausius_clapeyron_pressure(US_ATM, bp, 393.15, lm);
    var pcc: f64 = okv(t, v, "Clausius-Clapeyron is Ok");
    var e: UsSaturated;
    var te, ve = us_saturated_by_temperature(393.15, &e);
    assert_eq(is_ok(te), 1, "the steam table at 120 C is Ok");
    var ps: f64 = e.pressure;
    var d: f64 = absdiff(pcc, ps);
    var rel: f64 = d / ps;
    assert(rel < 0.05, "within 5%");
}

# Quality from v, h and s of one mixture all give x = 0.6.
# rust tests/integration.rs: quality_consistency_across_methods
fn quality_consistency_across_methods() {
    test_group("quality three ways");
    var e: UsSaturated;
    var te, ve = us_saturated_by_temperature(373.15, &e);
    var w: UsWetSteam;
    var tw, vw = us_wet_steam_properties(0.6, &e, &w);
    assert_eq(is_ok(tw), 1, "the mixture is Ok");
    var sv: f64 = w.specific_volume;
    var sh: f64 = w.specific_enthalpy;
    var ss: f64 = w.specific_entropy;
    var t1, v1 = us_quality_from_volume(sv, &e);
    var xv: f64 = okv(t1, v1, "x from v is Ok");
    var t2, v2 = us_quality_from_enthalpy(sh, &e);
    var xh: f64 = okv(t2, v2, "x from h is Ok");
    var t3, v3 = us_quality_from_entropy(ss, &e);
    var xs: f64 = okv(t3, v3, "x from s is Ok");
    var dv: f64 = absdiff(xv, 0.6);
    var dh: f64 = absdiff(xh, 0.6);
    var ds: f64 = absdiff(xs, 0.6);
    assert(dv < 0.01, "from v: 0.6");
    assert(dh < 0.01, "from h: 0.6");
    assert(ds < 0.01, "from s: 0.6");
}

# The phase lookup agrees with the steam table: liquid at 300 K, and liquid just above P_sat at 100 °C.
# rust tests/integration.rs: phase_lookup_agrees_with_steam_table
fn phase_lookup_agrees_with_steam_table() {
    test_group("phase lookup against the steam table");
    var w: UsSubstance;
    var tw, vw = us_substance_preset(US_SUBSTANCE_WATER_PHASE, &w);
    var t, v = us_substance_phase_at(&w, 300.0, US_ATM);
    assert_eq(is_ok(t), 1, "300 K is Ok");
    assert_eq(v, US_PHASE_LIQUID, "300 K, 1 atm: liquid");
    var e: UsSaturated;
    var te, ve = us_saturated_by_temperature(373.15, &e);
    var ps: f64 = e.pressure;
    var above: f64 = ps * 1.1;
    var t2, v2 = us_substance_phase_at(&w, 373.15, above);
    assert_eq(is_ok(t2), 1, "100 C above P_sat is Ok");
    assert_eq(v2, US_PHASE_LIQUID, "100 C, 1.1 P_sat: liquid");
}

# A simple Rankine cycle at 2 MPa / 10 kPa from the steam tables: the first law closes within 5 kJ/kg, and the
# efficiency is 15–40 %.
# rust tests/integration.rs: simple_rankine_cycle_energy_balance
fn simple_rankine_cycle_energy_balance() {
    test_group("Rankine energy balance");
    var cond: UsSaturated;
    var tc, vc = us_saturated_by_pressure(10000.0, &cond);
    assert_eq(is_ok(tc), 1, "the condenser state is Ok");
    var h1: f64 = cond.h_f;
    var vf: f64 = cond.v_f;
    var hf: f64 = cond.h_f;
    var hfg: f64 = cond.h_fg;
    var w_pump: f64 = vf * (2000000.0 - 10000.0);
    var h2: f64 = h1 + w_pump;
    var sh: UsSuperheated;
    var ts, vs = us_superheated_lookup(573.15, 2000000.0, &sh);
    assert_eq(is_ok(ts), 1, "the boiler exit is Ok");
    var h3: f64 = sh.specific_enthalpy;
    var s3: f64 = sh.specific_entropy;
    var tq, vq = us_quality_from_entropy(s3, &cond);
    var x4: f64 = okv(tq, vq, "the turbine exit's quality is Ok");
    var h4: f64 = hf + x4 * hfg;
    var q_in: f64 = h3 - h2;
    var w_turbine: f64 = h3 - h4;
    var q_out: f64 = h4 - h1;
    var w_net: f64 = w_turbine - w_pump;
    var bal: f64 = absdiff(q_in - w_net, q_out);
    assert(bal < 5000.0, "q_in = w_net + q_out within 5 kJ/kg");
    var eta: f64 = w_net / q_in;
    assert(eta > 0.15 && eta < 0.4, "efficiency 15-40%");
}

# The Rankine cycle at 10 kPa / 2 MPa superheated to 573.15 K: four state points, 15 % or better, net work out, and
# below the Carnot efficiency between its hottest and coldest states.
# rust tests/integration.rs: rankine_with_steam_tables_end_to_end
fn rankine_with_steam_tables_end_to_end() {
    test_group("Rankine end to end");
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var t, v = us_rankine_cycle(10000.0, 2000000.0, 1, 573.15, &r);
    assert_eq(is_ok(t), 1, "Ok");
    assert_eq(us_cycle_state_count(&r), 4, "four state points");
    var eta: f64 = r.efficiency;
    var w: f64 = r.net_work;
    assert(eta > 0.15 && w > 0.0, "15 % or better, net work out");
    var hot: UsStatePoint;
    var cold: UsStatePoint;
    us_cycle_state(&r, 2, &hot);
    us_cycle_state(&r, 0, &cold);
    var th: f64 = hot.temperature;
    var tc: f64 = cold.temperature;
    var tcar, vcar = us_carnot_efficiency(th, tc);
    var carnot: f64 = okv(tcar, vcar, "Carnot between the same limits");
    assert(eta < carnot, "below Carnot");
}

# The refrigeration cycle at 7.384 / 47.39 kPa: its COP is below the Carnot COP between the evaporator and the
# condenser.
# rust tests/integration.rs: refrigeration_vs_carnot_cop
fn refrigeration_vs_carnot_cop() {
    test_group("refrigeration against Carnot");
    var rr: UsRefrigerationResult;
    var ti, vi = us_refrigeration_result_init(&rr);
    var t, v = us_refrigeration_cycle(7384.0, 47390.0, &rr);
    assert_eq(is_ok(t), 1, "Ok");
    var c = us_refrigeration_result_cycle(&rr);
    var cold: UsStatePoint;
    var hot: UsStatePoint;
    us_cycle_state(c, 0, &cold);
    us_cycle_state(c, 2, &hot);
    var th: f64 = hot.temperature;
    var tc: f64 = cold.temperature;
    var tcar, vcar = us_carnot_cop_refrigeration(th, tc);
    var carnot: f64 = okv(tcar, vcar, "the Carnot COP");
    var cop: f64 = rr.cop_refrigeration;
    assert(cop < carnot, "COP below Carnot's");
}

# Runs every test and returns the failure count.
fn main() {
    alloc_init();
    heat_conduction_through_copper_wall();
    thermal_equilibrium_lumped_capacitance();
    material_thermal_diffusivity_matches_manual();
    nusselt_to_h_to_convection_chain();
    lmtd_vs_ntu_same_heat_exchanger();
    view_factor_reciprocity();
    ideal_gas_law_roundtrip();
    energy_conservation_adiabatic_process();
    van_der_waals_vs_ideal_gas();
    eos_comparison_co2_stp();
    virial_approaches_ideal_at_low_density();
    mixture_z_factor_kays_rule();
    carnot_engine_efficiency();
    entropy_increase_irreversible_heat_transfer();
    water_boiling_point_consistency();
    clausius_clapeyron_vs_steam_table();
    quality_consistency_across_methods();
    phase_lookup_agrees_with_steam_table();
    simple_rankine_cycle_energy_balance();
    rankine_with_steam_tables_end_to_end();
    refrigeration_vs_carnot_cop();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
