        return 1;
    }
    return 0;
}

# ── steam ───────────────────────────────────────────────────────────────────────────

# Copies the `n` f64 input tokens k … k + n − 1 into the words at `p` (an all-f64 struct).
fn _par_in_words(k, n, p) {
    var j = 0;
    while (j < n) {
        store64(p + (8 * j), _par_in(k + j));
        j = j + 1;
    }
    return 0;
}

# Appends the `n` f64 words at `p` (an all-f64 struct's fields).
fn _par_got_words(p, n) {
    var j = 0;
    while (j < n) {
        _par_got_f(load64(p + (8 * j)));
        j = j + 1;
    }
    return 0;
}

