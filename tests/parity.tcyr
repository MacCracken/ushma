# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §4 step 7, adapted from kimiya's tests/parity.tcyr (itself tanmatra's). Format and comparison rules:
# scripts/oracle/README.md. The module list is tests/golden/modules.txt, which the generator writes. The replay
# machinery is tests/parity_core.cyr; this file holds the dispatchers.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first 10 per module are printed with the row's note and both bit patterns;
# - measured: class C, with no bound set yet for its function. The ulp distance is recorded but not gated
#   (M0 step 8, docs/development/port-parity.md §2);
# - accepted: a divergence an ADR accepts (_par_accepted), or a pass against the ADR 0004 corrected oracle;
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram, which is the step-8 baseline. Shadow lines
# (`fn ~ candidate`) compare the same rows against another Cyrius candidate and are never gated. The exit code is
# the number of modules with a failure (at most a handful, so the 8-bit exit status can't wrap).

include "tests/ulp.cyr"
include "src/constants.cyr"
include "src/error.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/validate.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/material_data.cyr"
include "src/material.cyr"
include "src/transfer.cyr"
include "src/state_data.cyr"
include "src/state.cyr"
include "src/entropy.cyr"
include "src/phase_data.cyr"
include "src/phase.cyr"
include "src/chem_data.cyr"
include "src/steam_data.cyr"
include "src/steam.cyr"

alloc_init();

include "tests/parity_core.cyr"

# The Rust variant name of an error code (src/error.cyr).
#must_use
fn _par_error_name(code): i64 {
    return us_error_name(code);
}

# ── constants ───────────────────────────────────────────────────────────────────────
# `const` rows (input `s:<module>::<NAME>`): src/constants.cyr's US_ consts. Any other name is a defect.
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0 - 1; }
    var np = load64(_par_in_v);
    var nl = load64(_par_in_l);
    if (_par_eq(np, nl, "numerical::MAX_ADAPTIVE_SUBSTEPS") == 1) {
        _par_got_i(US_MAX_ADAPTIVE_SUBSTEPS);
        return 1;
    }
    var x: f64 = 0.0;
    if (_par_eq(np, nl, "chem::STANDARD_T") == 1) { x = US_STANDARD_T; }
    elif (_par_eq(np, nl, "stat::PLANCK") == 1) { x = US_PLANCK; }
    elif (_par_eq(np, nl, "stat::AVOGADRO") == 1) { x = US_AVOGADRO; }
    elif (_par_eq(np, nl, "state::GAS_CONSTANT") == 1) { x = US_GAS_CONSTANT; }
    elif (_par_eq(np, nl, "state::ATM") == 1) { x = US_ATM; }
    elif (_par_eq(np, nl, "state::STANDARD_TEMP") == 1) { x = US_STANDARD_TEMP; }
    elif (_par_eq(np, nl, "transfer::STEFAN_BOLTZMANN") == 1) { x = US_STEFAN_BOLTZMANN; }
    elif (_par_eq(np, nl, "transfer::BOLTZMANN_K") == 1) { x = US_BOLTZMANN_K; }
    else { return 0 - 1; }
    _par_got_f(x);
    return 1;
}

# ── the public tables ───────────────────────────────────────────────────────────────
# Each table's presets by Rust name, with their index constants, as a vec of (name, index) pairs. A preset row
# `<module>::<PRESET>` is answered from the data columns at that index; the `<module>::<ALL>` row names, for each row
# r of the table, the preset whose index constant is r. So every index constant, name, cell and the count are
# compared against the oracle's API.
var _par_tab_material = 0;
var _par_tab_gas = 0;
var _par_tab_substance = 0;
var _par_tab_species = 0;

# Appends one (Rust name, index constant) pair.
fn _par_tab_add(t, name, idx) {
    vec_push(t, name);
    vec_push(t, idx);
    return 0;
}

# Builds the four preset tables.
fn _par_tables_init(): i64 {
    var m = vec_new();
    _par_tab_add(m, "COPPER", US_MATERIAL_COPPER);
    _par_tab_add(m, "ALUMINUM", US_MATERIAL_ALUMINUM);
    _par_tab_add(m, "IRON", US_MATERIAL_IRON);
    _par_tab_add(m, "STEEL", US_MATERIAL_STEEL);
    _par_tab_add(m, "GLASS", US_MATERIAL_GLASS);
    _par_tab_add(m, "WATER", US_MATERIAL_WATER);
    _par_tab_add(m, "AIR", US_MATERIAL_AIR);
    _par_tab_add(m, "WOOD_OAK", US_MATERIAL_WOOD_OAK);
    _par_tab_add(m, "CONCRETE", US_MATERIAL_CONCRETE);
    _par_tab_add(m, "DIAMOND", US_MATERIAL_DIAMOND);
    _par_tab_material = m;
    var g = vec_new();
    _par_tab_add(g, "GAS_NITROGEN", US_GAS_NITROGEN);
    _par_tab_add(g, "GAS_OXYGEN", US_GAS_OXYGEN);
    _par_tab_add(g, "GAS_CO2", US_GAS_CO2);
    _par_tab_add(g, "GAS_METHANE", US_GAS_METHANE);
    _par_tab_add(g, "GAS_WATER", US_GAS_WATER);
    _par_tab_add(g, "GAS_AMMONIA", US_GAS_AMMONIA);
    _par_tab_add(g, "GAS_ETHANE", US_GAS_ETHANE);
    _par_tab_add(g, "GAS_PROPANE", US_GAS_PROPANE);
    _par_tab_gas = g;
    var s = vec_new();
    _par_tab_add(s, "WATER_PHASE", US_SUBSTANCE_WATER_PHASE);
    _par_tab_add(s, "NITROGEN", US_SUBSTANCE_NITROGEN);
    _par_tab_add(s, "OXYGEN", US_SUBSTANCE_OXYGEN);
    _par_tab_add(s, "CARBON_DIOXIDE", US_SUBSTANCE_CARBON_DIOXIDE);
    _par_tab_add(s, "AMMONIA", US_SUBSTANCE_AMMONIA);
    _par_tab_add(s, "METHANE", US_SUBSTANCE_METHANE);
    _par_tab_add(s, "ETHANOL", US_SUBSTANCE_ETHANOL);
    _par_tab_add(s, "MERCURY", US_SUBSTANCE_MERCURY);
    _par_tab_substance = s;
    var c = vec_new();
    _par_tab_add(c, "H2", US_SPECIES_H2);
    _par_tab_add(c, "O2", US_SPECIES_O2);
    _par_tab_add(c, "N2", US_SPECIES_N2);
    _par_tab_add(c, "H2O_GAS", US_SPECIES_H2O_GAS);
    _par_tab_add(c, "H2O_LIQUID", US_SPECIES_H2O_LIQUID);
    _par_tab_add(c, "CO2", US_SPECIES_CO2);
    _par_tab_add(c, "CO", US_SPECIES_CO);
    _par_tab_add(c, "CH4", US_SPECIES_CH4);
    _par_tab_add(c, "C2H6", US_SPECIES_C2H6);
    _par_tab_add(c, "C3H8", US_SPECIES_C3H8);
    _par_tab_add(c, "NH3", US_SPECIES_NH3);
    _par_tab_add(c, "NO", US_SPECIES_NO);
    _par_tab_species = c;
    return 0;
}

# The index constant of preset [np, np + nl) in table t, or -1.
fn _par_tab_index(t, np, nl): i64 {
    var k = 0;
    while (k < vec_len(t)) {
        if (_par_eq(np, nl, vec_get(t, k)) == 1) { return vec_get(t, k + 1); }
        k = k + 2;
    }
    return 0 - 1;
}

# The Rust name of the preset at row r of table t, or 0.
fn _par_tab_name(t, r): i64 {
    var k = 0;
    while (k < vec_len(t)) {
        if (vec_get(t, k + 1) == r) { return vec_get(t, k); }
        k = k + 2;
    }
    return 0;
}

# The table row: `<module>::<ALL>` (all = its name) answers the count and each row's preset name; `<module>::<P>`
# answers the preset's name and fields through `fill(index)`. Returns the dispatcher's result.
fn _par_table(fp, fl, modn, all, t, count, fill): i64 {
    var pre = strlen(modn) + 2;
    if (fl <= pre || memeq(fp, modn, pre - 2) != 1) { return 0 - 1; }
    var np = fp + pre;
    var nl = fl - pre;
    if (_par_eq(np, nl, all) == 1) {
        _par_got_seq(count);
        var r = 0;
        while (r < count) {
            var n = _par_tab_name(t, r);
            if (n == 0) { return 0 - 1; }
            _par_got_text(n, strlen(n));
            r = r + 1;
        }
        return 1;
    }
    var idx = _par_tab_index(t, np, nl);
    if (idx < 0 || idx >= count) { return 0 - 1; }
    fncall1(fill, idx);
    return 1;
}

# Appends name `p` (a NUL-terminated blob entry) as a golden `s:` token.
fn _par_got_name(p) {
    _par_got_text(p, strlen(p));
    return 0;
}

# One material row's name and fields, in ThermalMaterial's declaration order.
fn _par_fill_material(i) {
    _par_got_name(&_US_MATERIAL_NAME_BYTES + _US_MATERIAL_NAME_OFF[i]);
    var x: f64 = US_MATERIAL_CONDUCTIVITY[i];
    _par_got_f(x);
    x = US_MATERIAL_SPECIFIC_HEAT[i];
    _par_got_f(x);
    x = US_MATERIAL_DENSITY[i];
    _par_got_f(x);
    x = US_MATERIAL_MELTING_POINT[i];
    _par_got_f(x);
    x = US_MATERIAL_BOILING_POINT[i];
    _par_got_f(x);
    return 0;
}

# One gas row (GasData order).
fn _par_fill_gas(i) {
    _par_got_name(&_US_GAS_NAME_BYTES + _US_GAS_NAME_OFF[i]);
    var x: f64 = US_GAS_CRITICAL_T[i];
    _par_got_f(x);
    x = US_GAS_CRITICAL_P[i];
    _par_got_f(x);
    x = US_GAS_ACENTRIC_FACTOR[i];
    _par_got_f(x);
    return 0;
}

# One substance row (SubstanceData order).
fn _par_fill_substance(i) {
    _par_got_name(&_US_SUBSTANCE_NAME_BYTES + _US_SUBSTANCE_NAME_OFF[i]);
    var x: f64 = US_SUBSTANCE_TRIPLE_POINT_T[i];
    _par_got_f(x);
    x = US_SUBSTANCE_TRIPLE_POINT_P[i];
    _par_got_f(x);
    x = US_SUBSTANCE_CRITICAL_T[i];
    _par_got_f(x);
    x = US_SUBSTANCE_CRITICAL_P[i];
    _par_got_f(x);
    x = US_SUBSTANCE_CRITICAL_DENSITY[i];
    _par_got_f(x);
    x = US_SUBSTANCE_LATENT_HEAT_FUSION[i];
    _par_got_f(x);
    x = US_SUBSTANCE_LATENT_HEAT_VAPORIZATION[i];
    _par_got_f(x);
    x = US_SUBSTANCE_MELTING_POINT[i];
    _par_got_f(x);
    x = US_SUBSTANCE_BOILING_POINT[i];
    _par_got_f(x);
    x = US_SUBSTANCE_MOLAR_MASS[i];
    _par_got_f(x);
    return 0;
}

# One species row (Species order).
fn _par_fill_species(i) {
    _par_got_name(&_US_SPECIES_NAME_BYTES + _US_SPECIES_NAME_OFF[i]);
    var x: f64 = US_SPECIES_DELTA_HF[i];
    _par_got_f(x);
    x = US_SPECIES_DELTA_GF[i];
    _par_got_f(x);
    x = US_SPECIES_CP[i];
    _par_got_f(x);
    return 0;
}

# ── math ────────────────────────────────────────────────────────────────────────────
# `f64::` rows: the port's counterpart of each Rust std method (port plan §7.1, port-parity.md §1, §2).
# - Class A: sqrt, abs, ceil (builtins); clamp (f64_clamp, which has Rust's semantics for valid bounds); min, max,
#   is_finite, is_nan (src/mathx.cyr's `_us_*` helpers, with Rust's NaN semantics where f64_min / f64_max differ).
# - Class B: powi (`_us_powi`, compiler-builtins' square-and-multiply order).
# - Class C (ADR 0004): exp, exp_m1, ln, powf, atan on src/mathx.cyr's correctly rounded primitives, compared at
#   0 ulp against the corrected oracle (tests/golden/math.cr.tsv): a row glibc misrounds passes as "accepted (ADR
#   4)", and one that matches glibc's misrounding instead fails. tanh is ushma's own correctly rounded primitive
#   (M0 part 2c-3), the rest are vendored from kimiya.
fn _par_math(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ceil") == 1) { var r: f64 = f64_ceil(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_us_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_us_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _us_cr_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { var r: f64 = _us_cr_expm1(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { var r: f64 = _us_cr_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { var r: f64 = _us_cr_atan2(x, 1.0); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::tanh") == 1) { var r: f64 = _us_cr_tanh(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    if (_par_eq(fp, fl, "f64::powi") == 1) {
        var r: f64 = _us_powi(x, _par_in(1));
        _par_got_f(r);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _us_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _us_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _us_cr_pow(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::clamp") == 1) {
        var hi: f64 = _par_in(2);
        var r: f64 = f64_clamp(x, y, hi);
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# ── fmtf ────────────────────────────────────────────────────────────────────────────
# `fmtf::display` / `fmtf::json` rows: src/fmtf.cyr's two forms of one f64, against Rust's `{}` and serde_json's text.

var _par_fmtf_sb = 0;

# One fmtf row: 1 when handled, 0 for a function fmtf has no counterpart for (a defect).
fn _par_fmtf(fp, fl): i64 {
    if (_par_fmtf_sb == 0) { _par_fmtf_sb = str_builder_new(); }
    store64(_par_fmtf_sb + 8, 0);
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "fmtf::display") == 1) {
        _us_fmt_f64_display(_par_fmtf_sb, x);
    } else {
        if (_par_eq(fp, fl, "fmtf::json") != 1) { return 0; }
        _us_fmt_f64_json(_par_fmtf_sb, x);
    }
    _par_got_s(load64(_par_fmtf_sb), load64(_par_fmtf_sb + 8));
    return 1;
}

# ── material ────────────────────────────────────────────────────────────────────────
# `material::diffusivity` / `volumetric_heat_capacity` / `to_json` (inputs: the six fields, `s:name` first) and
# `material::from_json` (input: the document).

var _par_mat_sb = 0;
var _par_mat_arena = 0;
# 1 when the current row's port result is one ADR 0005 maps (set by the dispatcher, read by _par_accepted).
var _par_adr5 = 0;

# Input token k (`s:`) with its %XX escapes decoded, NUL bytes kept: a fresh buffer, its length in *lenp; 0 if the
# token is no `s:` token or an escape is malformed.
fn _par_in_text(k, lenp): i64 {
    var at = k * 8;
    if (k >= _par_in_n || load64(_par_in_k + at) != 115) { return 0; }
    var p = load64(_par_in_v + at);
    var len = load64(_par_in_l + at);
    var out = alloc(len + 1);
    var n = 0;
    var j = 0;
    while (j < len) {
        var c = load8(p + j);
        if (c == 37) {
            if (j + 2 >= len) { return 0; }
            var hi = _par_hex_upper(load8(p + j + 1));
            var lo = _par_hex_upper(load8(p + j + 2));
            if (hi < 0 || lo < 0) { return 0; }
            c = hi * 16 + lo;
            j = j + 3;
        } else {
            j = j + 1;
        }
        store8(out + n, c);
        n = n + 1;
    }
    store8(out + n, 0);
    store64(lenp, n);
    return out;
}

# 1 when the `n`-byte document at `p` holds the integer token `-0` (after `:`, `[` or `,`), which serde_json reads
# into an f64 as −0.0 and bayan as +0 (ADR 0005's open divergence).
fn _par_has_int_neg_zero(p, n): i64 {
    var i = 0;
    while (i + 1 < n) {
        if (load8(p + i) == 45 && load8(p + i + 1) == 48) {
            var nx = 0;
            if (i + 2 < n) { nx = load8(p + i + 2); }
            var tail_ok = 1;
            if (nx >= 48 && nx <= 57) { tail_ok = 0; }
            if (nx == 46 || nx == 101 || nx == 69) { tail_ok = 0; }
            var b = i - 1;
            while (b >= 0 && (load8(p + b) == 32 || load8(p + b) == 9 || load8(p + b) == 10 || load8(p + b) == 13)) {
                b = b - 1;
            }
            var lead_ok = 0;
            if (b >= 0) {
                var pc = load8(p + b);
                if (pc == 58 || pc == 91 || pc == 44) { lead_ok = 1; }
            }
            if (tail_ok == 1 && lead_ok == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# 1 when bayan itself refuses the `n`-byte document at `p` for one of the reasons ADR 0005 maps: a duplicate key,
# nesting past 128, an integer ≥ 2^63.
fn _par_bayan_mapped_refusal(p, n): i64 {
    if (bayan_json_v_parse_buf(p, n) != 0) { return 0; }
    var e = bayan_json_last_error();
    if (streq(e, "duplicate key") == 1) { return 1; }
    if (streq(e, "nesting too deep") == 1) { return 1; }
    if (streq(e, "integer is out of range for i64") == 1) { return 1; }
    return 0;
}

# The material fields of the row's six input tokens into *m: 1, or 0 when the tokens aren't those.
fn _par_mat_in(m: *UsMaterial): i64 {
    if (_par_in_n != 6) { return 0; }
    var nw[8];
    var name = _par_in_text(0, &nw);
    if (name == 0) { return 0; }
    var k: f64 = _par_in(1);
    var cp: f64 = _par_in(2);
    var rho: f64 = _par_in(3);
    var mp: f64 = _par_in(4);
    var bp: f64 = _par_in(5);
    m.name = name;
    m.name_len = load64(&nw);
    m.conductivity = k;
    m.specific_heat = cp;
    m.density = rho;
    m.melting_point = mp;
    m.boiling_point = bp;
    return 1;
}

# One material row: 1 when handled, 0 for a function with no counterpart, -1 for unusable inputs.
fn _par_material(fp, fl): i64 {
    if (_par_mat_sb == 0) {
        _par_mat_sb = str_builder_new();
        _par_mat_arena = arena_allocator_growable(65536);
    }
    var m: UsMaterial;
    if (_par_eq(fp, fl, "material::from_json") == 1) {
        var dn[8];
        var doc = _par_in_text(0, &dn);
        if (doc == 0) { return 0 - 1; }
        var n = load64(&dn);
        reset_via(_par_mat_arena);
        var t, v = us_material_from_json_a(_par_mat_arena, doc, n, &m);
        if (is_err_result(t) == 1) {
            _par_got_err(v);
            if (_par_bayan_mapped_refusal(doc, n) == 1) { _par_adr5 = 1; }
            return 1;
        }
        if (_par_has_int_neg_zero(doc, n) == 1) { _par_adr5 = 1; }
        _par_got_text(m.name, m.name_len);
        var k: f64 = m.conductivity;
        var cp: f64 = m.specific_heat;
        var rho: f64 = m.density;
        var mp: f64 = m.melting_point;
        var bp: f64 = m.boiling_point;
        _par_got_f(k);
        _par_got_f(cp);
        _par_got_f(rho);
        _par_got_f(mp);
        _par_got_f(bp);
        return 1;
    }
    if (_par_mat_in(&m) == 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "material::diffusivity") == 1) {
        var r: f64 = us_material_diffusivity(&m);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "material::volumetric_heat_capacity") == 1) {
        var r2: f64 = us_material_volumetric_heat_capacity(&m);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "material::to_json") == 1) {
        store64(_par_mat_sb + 8, 0);
        us_material_to_json(_par_mat_sb, &m);
        _par_got_text(load64(_par_mat_sb), load64(_par_mat_sb + 8));
        return 1;
    }
    return 0;
}

# ── state ───────────────────────────────────────────────────────────────────────────

# A UsGas from the row's four input tokens (s:name, critical_t, critical_p, acentric_factor): 1, or 0.
fn _par_gas_in(g: *UsGas): i64 {
    if (_par_in_n != 4) { return 0; }
    var nw[8];
    var name = _par_in_text(0, &nw);
    if (name == 0) { return 0; }
    var tc: f64 = _par_in(1);
    var pc: f64 = _par_in(2);
    var om: f64 = _par_in(3);
    g.name = name;
    g.name_len = load64(&nw);
    g.critical_t = tc;
    g.critical_p = pc;
    g.acentric_factor = om;
    return 1;
}

# One GasData JSON row: 1 when handled, 0 for none, -1 for unusable inputs.
fn _par_gas_json(fp, fl): i64 {
    if (_par_mat_sb == 0) {
        _par_mat_sb = str_builder_new();
        _par_mat_arena = arena_allocator_growable(65536);
    }
    var g: UsGas;
    if (_par_eq(fp, fl, "state::GasData::from_json") == 1) {
        var dn[8];
        var doc = _par_in_text(0, &dn);
        if (doc == 0) { return 0 - 1; }
        var n = load64(&dn);
        reset_via(_par_mat_arena);
        var t, v = us_gas_from_json_a(_par_mat_arena, doc, n, &g);
        if (is_err_result(t) == 1) {
            _par_got_err(v);
            if (_par_bayan_mapped_refusal(doc, n) == 1) { _par_adr5 = 1; }
            return 1;
        }
        if (_par_has_int_neg_zero(doc, n) == 1) { _par_adr5 = 1; }
        _par_got_text(g.name, g.name_len);
        var tc: f64 = g.critical_t;
        var pc: f64 = g.critical_p;
        var om: f64 = g.acentric_factor;
        _par_got_f(tc);
        _par_got_f(pc);
        _par_got_f(om);
        return 1;
    }
    if (_par_eq(fp, fl, "state::GasData::to_json") == 1) {
        if (_par_gas_in(&g) == 0) { return 0 - 1; }
        store64(_par_mat_sb + 8, 0);
        us_gas_to_json(_par_mat_sb, &g);
        _par_got_text(load64(_par_mat_sb), load64(_par_mat_sb + 8));
        return 1;
    }
    return 0;
}

var _par_list = 0;
var _par_list2 = 0;

# One row of state's part 2 (the cubic equations, virial forms, Pitzer, Kay's rules): 1 when handled, 0 for none.
fn _par_state2(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var d: f64 = _par_in(3);
    var e: f64 = _par_in(4);
    if (_par_eq(fp, fl, "state::redlich_kwong_params") == 1) {
        var ra, rb = us_redlich_kwong_params(a, b);
        _par_got_f(ra);
        _par_got_f(rb);
        return 1;
    }
    if (_par_eq(fp, fl, "state::peng_robinson_params") == 1) {
        var pa, pb, pk = us_peng_robinson_params(a, b, c);
        _par_got_f(pa);
        _par_got_f(pb);
        _par_got_f(pk);
        return 1;
    }
    if (_par_eq(fp, fl, "state::redlich_kwong_pressure") == 1) {
        var t, v = us_redlich_kwong_pressure(a, b, c, d);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "state::peng_robinson_pressure") == 1) {
        var t1, v1 = us_peng_robinson_pressure(a, b, c, d, e);
        _par_got_res(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "state::pitzer_second_virial") == 1) {
        var bv: f64 = us_pitzer_second_virial(a, b, c, d);
        _par_got_f(bv);
        return 1;
    }
    if (_par_eq(fp, fl, "state::virial_pressure_2nd") == 1) {
        var t2, v2 = us_virial_pressure_2nd(a, b, c);
        _par_got_res(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "state::virial_pressure_3rd") == 1) {
        var t3, v3 = us_virial_pressure_3rd(a, b, c, d);
        _par_got_res(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "state::compressibility_pitzer") == 1) {
        var t4, v4 = us_compressibility_pitzer(a, b, c);
        _par_got_res(t4, v4);
        return 1;
    }
    var kind = 0;
    if (_par_eq(fp, fl, "state::kays_rule_tc") == 1) { kind = 1; }
    if (_par_eq(fp, fl, "state::kays_rule_pc") == 1) { kind = 2; }
    if (_par_eq(fp, fl, "state::kays_rule_omega") == 1) { kind = 3; }
    if (kind == 0) { return 0; }
    if (_par_list == 0) { _par_list = alloc(8 * 64); }
    if (_par_list2 == 0) { _par_list2 = alloc(8 * 64); }
    var ny = _par_in_f64s(0, _par_list);
    var nv = _par_in_f64s(1 + ny, _par_list2);
    if (kind == 1) {
        var t5, v5 = us_kays_rule_tc(_par_list, ny, _par_list2, nv);
        _par_got_res(t5, v5);
    }
    if (kind == 2) {
        var t6, v6 = us_kays_rule_pc(_par_list, ny, _par_list2, nv);
        _par_got_res(t6, v6);
    }
    if (kind == 3) {
        var t7, v7 = us_kays_rule_omega(_par_list, ny, _par_list2, nv);
        _par_got_res(t7, v7);
    }
    return 1;
}

# One state row: 1 when handled, 0 for a function with no counterpart yet, -1 for unusable inputs.
fn _par_state(fp, fl): i64 {
    var j = _par_gas_json(fp, fl);
    if (j != 0) { return j; }
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var d: f64 = _par_in(3);
    var e: f64 = _par_in(4);
    if (_par_eq(fp, fl, "state::ideal_gas_pressure") == 1) {
        var t, v = us_ideal_gas_pressure(a, b, c);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "state::ideal_gas_volume") == 1) {
        var t1, v1 = us_ideal_gas_volume(a, b, c);
        _par_got_res(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "state::ideal_gas_temperature") == 1) {
        var t2, v2 = us_ideal_gas_temperature(a, b, c);
        _par_got_res(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "state::van_der_waals_pressure") == 1) {
        var t3, v3 = us_van_der_waals_pressure(a, b, c, d, e);
        _par_got_res(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "state::isothermal_work") == 1) {
        var t4, v4 = us_isothermal_work(a, b, c, d);
        _par_got_res(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "state::isobaric_work") == 1) {
        var w: f64 = us_isobaric_work(a, b, c);
        _par_got_f(w);
        return 1;
    }
    if (_par_eq(fp, fl, "state::adiabatic_temperature") == 1) {
        var t5, v5 = us_adiabatic_temperature(a, b, c, d);
        _par_got_res(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "state::compressibility_factor") == 1) {
        var t6, v6 = us_compressibility_factor(a, b, c, d);
        _par_got_res(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "state::reduced_temperature") == 1) {
        var tr: f64 = us_reduced_temperature(a, b);
        _par_got_f(tr);
        return 1;
    }
    if (_par_eq(fp, fl, "state::reduced_pressure") == 1) {
        var pr: f64 = us_reduced_pressure(a, b);
        _par_got_f(pr);
        return 1;
    }
    return _par_state2(fp, fl);
}

# ── phase ───────────────────────────────────────────────────────────────────────────

# A UsSubstance from input tokens k … k + 10 (s:name, then the ten f64 in declaration order): 1, or 0.
fn _par_sub_in(k, s: *UsSubstance): i64 {
    if (_par_in_n < k + 11) { return 0; }
    var nw[8];
    var name = _par_in_text(k, &nw);
    if (name == 0) { return 0; }
    var a: f64 = _par_in(k + 1);
    var b: f64 = _par_in(k + 2);
    var c: f64 = _par_in(k + 3);
    var d: f64 = _par_in(k + 4);
    var e: f64 = _par_in(k + 5);
    var f: f64 = _par_in(k + 6);
    var g: f64 = _par_in(k + 7);
    var h: f64 = _par_in(k + 8);
    var m: f64 = _par_in(k + 9);
    var q: f64 = _par_in(k + 10);
    s.name = name;
    s.name_len = load64(&nw);
    s.triple_point_t = a;
    s.triple_point_p = b;
    s.critical_t = c;
    s.critical_p = d;
    s.critical_density = e;
    s.latent_heat_fusion = f;
    s.latent_heat_vaporization = g;
    s.melting_point = h;
    s.boiling_point = m;
    s.molar_mass = q;
    return 1;
}

# Appends the substance *s as its eleven golden tokens.
fn _par_got_sub(s: *UsSubstance) {
    _par_got_text(s.name, s.name_len);
    var a: f64 = s.triple_point_t;
    var b: f64 = s.triple_point_p;
    var c: f64 = s.critical_t;
    var d: f64 = s.critical_p;
    var e: f64 = s.critical_density;
    var f: f64 = s.latent_heat_fusion;
    var g: f64 = s.latent_heat_vaporization;
    var h: f64 = s.melting_point;
    var m: f64 = s.boiling_point;
    var q: f64 = s.molar_mass;
    _par_got_f(a);
    _par_got_f(b);
    _par_got_f(c);
    _par_got_f(d);
    _par_got_f(e);
    _par_got_f(f);
    _par_got_f(g);
    _par_got_f(h);
    _par_got_f(m);
    _par_got_f(q);
    return 0;
}

# A phase's golden text ("Phase.Liquid"), or 0.
fn _par_phase_text(ph): i64 {
    if (ph == US_PHASE_SOLID) { return "Phase.Solid"; }
    if (ph == US_PHASE_LIQUID) { return "Phase.Liquid"; }
    if (ph == US_PHASE_GAS) { return "Phase.Gas"; }
    if (ph == US_PHASE_SUPERCRITICAL_FLUID) { return "Phase.SupercriticalFluid"; }
    return 0;
}

# The phase input token 0 names (`e:Phase.Liquid`), or -1.
fn _par_in_phase(): i64 {
    if (_par_in_n != 1 || load64(_par_in_k) != 101) { return 0 - 1; }
    var k = 0;
    while (k < US_PHASE_COUNT) {
        if (_par_eq(load64(_par_in_v), load64(_par_in_l), _par_phase_text(k)) == 1) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

# Appends a Result whose Ok payload is a phase.
fn _par_got_phase_res(t, v) {
    if (is_ok(t) == 1) { _par_got_e(_par_phase_text(v)); } else { _par_got_err(v); }
}

# The phase module's JSON rows: 1 when handled, 0 for none, -1 for unusable inputs.
fn _par_phase_json(fp, fl): i64 {
    if (_par_mat_sb == 0) {
