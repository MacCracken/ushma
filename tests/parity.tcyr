        store64(_par_mat_sb + 8, 0);
        us_phase_to_json(_par_mat_sb, ph);
        _par_got_text(load64(_par_mat_sb), load64(_par_mat_sb + 8));
        return 1;
    }
    var dn[8];
    if (_par_eq(fp, fl, "phase::Phase::from_json") == 1) {
        var doc = _par_in_text(0, &dn);
        if (doc == 0) { return 0 - 1; }
        reset_via(_par_mat_arena);
        var t, v = us_phase_from_json_a(_par_mat_arena, doc, load64(&dn));
        _par_got_phase_res(t, v);
        return 1;
    }
    var s: UsSubstance;
    if (_par_eq(fp, fl, "phase::SubstanceData::from_json") == 1) {
        var doc2 = _par_in_text(0, &dn);
        if (doc2 == 0) { return 0 - 1; }
        var n = load64(&dn);
        reset_via(_par_mat_arena);
        var t2, v2 = us_substance_from_json_a(_par_mat_arena, doc2, n, &s);
        if (is_err_result(t2) == 1) {
            _par_got_err(v2);
            if (_par_bayan_mapped_refusal(doc2, n) == 1) { _par_adr5 = 1; }
            return 1;
        }
        if (_par_has_int_neg_zero(doc2, n) == 1) { _par_adr5 = 1; }
        _par_got_sub(&s);
        return 1;
    }
    if (_par_eq(fp, fl, "phase::SubstanceData::to_json") == 1) {
        if (_par_in_n != 11 || _par_sub_in(0, &s) == 0) { return 0 - 1; }
        store64(_par_mat_sb + 8, 0);
        us_substance_to_json(_par_mat_sb, &s);
        _par_got_text(load64(_par_mat_sb), load64(_par_mat_sb + 8));
        return 1;
    }
    return 0;
}

# One phase row: 1 when handled, 0 for a function with no counterpart yet, -1 for unusable inputs.
fn _par_phase(fp, fl): i64 {
    var j = _par_phase_json(fp, fl);
