    }
    if (is_err_result(t) == 1 && _par_bayan_mapped_refusal(doc, n) == 1) { _par_adr5 = 1; }
    if (is_ok(t) == 1 && _par_has_int_neg_zero(doc, n) == 1) { _par_adr5 = 1; }
