        return 1;
    }
    if (_par_eq(fp, fl, "steam::wet_steam_properties") == 1) {
        var w: UsWetSteam;
        var t7, v7 = us_wet_steam_properties(x, &e, &w);
        if (is_ok(t7) == 1) { _par_got_words(&w, 4); } else { _par_got_err(v7); }
        return 1;
    }
    return 0;
}

# ── entropy ─────────────────────────────────────────────────────────────────────────

# One entropy row: 1 when handled, 0 for a function with no counterpart yet.
fn _par_entropy(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var d: f64 = _par_in(3);
    var e: f64 = _par_in(4);
    var g: f64 = _par_in(5);
    if (_par_eq(fp, fl, "entropy::ideal_gas_entropy_change") == 1) {
        var t, v = us_ideal_gas_entropy_change(a, b, c, d, e, g);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "entropy::isothermal_entropy_change") == 1) {
        var t1, v1 = us_isothermal_entropy_change(a, b, c);
        _par_got_res(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "entropy::heat_transfer_entropy") == 1) {
        var t2, v2 = us_heat_transfer_entropy(a, b);
        _par_got_res(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "entropy::carnot_efficiency") == 1) {
        var t3, v3 = us_carnot_efficiency(a, b);
        _par_got_res(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "entropy::carnot_cop_refrigeration") == 1) {
        var t4, v4 = us_carnot_cop_refrigeration(a, b);
        _par_got_res(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "entropy::helmholtz") == 1) {
        var h: f64 = us_helmholtz(a, b, c);
        _par_got_f(h);
        return 1;
    }
    if (_par_eq(fp, fl, "entropy::gibbs") == 1) {
        var gb: f64 = us_gibbs(a, b, c);
        _par_got_f(gb);
        return 1;
    }
    if (_par_eq(fp, fl, "entropy::is_spontaneous") == 1) {
        _par_got_i(us_is_spontaneous(a));
        return 1;
    }
    if (_par_eq(fp, fl, "entropy::entropy_of_mixing") == 1) {
        if (_par_list == 0) { _par_list = alloc(8 * 64); }
        var n = _par_in_f64s(1, _par_list);
        var t5, v5 = us_entropy_of_mixing(a, _par_list, n);
        _par_got_res(t5, v5);
        return 1;
    }
    return 0;
}

# ── transfer ────────────────────────────────────────────────────────────────────────

# Appends a Result: the f64 payload of Ok, or `E:Variant` for Err.
fn _par_got_res(t, v) {
    if (is_ok(t) == 1) { _par_got_f(v); } else { _par_got_err(v); }
}

# One row of transfer's part 2 (fins, heat exchangers, view factors): 1 when handled, 0 for a function with no
# counterpart.
fn _par_transfer2(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var d: f64 = _par_in(3);
    var e: f64 = _par_in(4);
    if (_par_eq(fp, fl, "transfer::fin_parameter") == 1) {
        var t, v = us_fin_parameter(a, b, c, d);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::fin_rectangular_heat") == 1) {
        var g5: f64 = _par_in(5);
        var g6: f64 = _par_in(6);
        var t1, v1 = us_fin_rectangular_heat(a, b, c, d, e, g5, g6);
        _par_got_res(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::fin_efficiency_rectangular") == 1) {
        var t2, v2 = us_fin_efficiency_rectangular(a, b);
        _par_got_res(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::fin_effectiveness") == 1) {
        var t3, v3 = us_fin_effectiveness(a, b, c, d, e);
        _par_got_res(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::lmtd_parallel") == 1) {
        var t4, v4 = us_lmtd_parallel(a, b, c, d);
        _par_got_res(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::lmtd_counter") == 1) {
        var t5, v5 = us_lmtd_counter(a, b, c, d);
        _par_got_res(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::heat_exchanger_lmtd") == 1) {
        var q: f64 = us_heat_exchanger_lmtd(a, b, c);
        _par_got_f(q);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::ntu") == 1) {
        var t6, v6 = us_ntu(a, b, c);
        _par_got_res(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::effectiveness_parallel") == 1) {
        var t7, v7 = us_effectiveness_parallel(a, b);
        _par_got_res(t7, v7);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::effectiveness_counter") == 1) {
        var t8, v8 = us_effectiveness_counter(a, b);
        _par_got_res(t8, v8);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::heat_exchanger_ntu") == 1) {
        var qn: f64 = us_heat_exchanger_ntu(a, b, c, d);
        _par_got_f(qn);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::view_factor_parallel_plates") == 1) {
        var t9, v9 = us_view_factor_parallel_plates(a, b, c);
        _par_got_res(t9, v9);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::view_factor_perpendicular_plates") == 1) {
        var ta, va = us_view_factor_perpendicular_plates(a, b, c);
        _par_got_res(ta, va);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::view_factor_coaxial_disks") == 1) {
        var tb, vb = us_view_factor_coaxial_disks(a, b, c);
        _par_got_res(tb, vb);
        return 1;
    }
    return 0;
}

# One transfer row: 1 when handled, 0 for a function with no counterpart yet.
fn _par_transfer(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var d: f64 = _par_in(3);
    var e: f64 = _par_in(4);
    if (_par_eq(fp, fl, "transfer::conduction") == 1) {
        var t, v = us_conduction(a, b, c, d, e);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::convection") == 1) {
        var q: f64 = us_convection(a, b, c, d);
        _par_got_f(q);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::radiation") == 1) {
        var t1, v1 = us_radiation(a, b, c, d);
        _par_got_res(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::thermal_resistance_conduction") == 1) {
        var t2, v2 = us_thermal_resistance_conduction(a, b, c);
        _par_got_res(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::thermal_resistance_convection") == 1) {
        var t3, v3 = us_thermal_resistance_convection(a, b);
        _par_got_res(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::thermal_resistance_series") == 1) {
        if (_par_list == 0) { _par_list = alloc(8 * 64); }
        var n = _par_in_f64s(0, _par_list);
        var rs: f64 = us_thermal_resistance_series(_par_list, n);
        _par_got_f(rs);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::thermal_resistance_parallel") == 1) {
        if (_par_list == 0) { _par_list = alloc(8 * 64); }
        var n2 = _par_in_f64s(0, _par_list);
        var t4, v4 = us_thermal_resistance_parallel(_par_list, n2);
        _par_got_res(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::heat_stored") == 1) {
        var hs: f64 = us_heat_stored(a, b, c);
        _par_got_f(hs);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::thermal_diffusivity") == 1) {
        var t5, v5 = us_thermal_diffusivity(a, b, c);
        _par_got_res(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::biot_number") == 1) {
        var t6, v6 = us_biot_number(a, b, c);
        _par_got_res(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::lumped_capacitance") == 1) {
        var lc: f64 = us_lumped_capacitance(a, b, c, d);
        _par_got_f(lc);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::reynolds_number") == 1) {
        var t7, v7 = us_reynolds_number(a, b, c);
        _par_got_res(t7, v7);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::prandtl_number") == 1) {
        var t8, v8 = us_prandtl_number(a, b);
        _par_got_res(t8, v8);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::nusselt_number") == 1) {
        var t9, v9 = us_nusselt_number(a, b, c);
        _par_got_res(t9, v9);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::nusselt_dittus_boelter") == 1) {
        var ta, va = us_nusselt_dittus_boelter(a, b);
        _par_got_res(ta, va);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::nusselt_natural_vertical") == 1) {
        var tb, vb = us_nusselt_natural_vertical(a, b);
        _par_got_res(tb, vb);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::boundary_layer_thickness") == 1) {
        var tc, vc = us_boundary_layer_thickness(a, b);
        _par_got_res(tc, vc);
        return 1;
    }
    if (_par_eq(fp, fl, "transfer::thermal_boundary_layer") == 1) {
        var td, vd = us_thermal_boundary_layer(a, b, c);
        _par_got_res(td, vd);
        return 1;
    }
    return _par_transfer2(fp, fl);
}

# ── routing and hooks ───────────────────────────────────────────────────────────────

# Routes a row to its module's dispatcher. 0 (pending) for a module or function with none yet: the module rows of
# chem, material, phase and state other than their presets arrive at M1–M5.
fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "fmtf") == 1) { return _par_fmtf(fp, fl); }
    if (_par_eq(mp, ml, "transfer") == 1) { return _par_transfer(fp, fl); }
    if (_par_eq(mp, ml, "entropy") == 1) { return _par_entropy(fp, fl); }
    if (_par_eq(mp, ml, "steam") == 1) { return _par_steam(fp, fl); }
    _par_adr5 = 0;
    if (_par_eq(mp, ml, "material") == 1 && _par_in_n != 0) { return _par_material(fp, fl); }
    if (_par_eq(mp, ml, "state") == 1 && _par_in_n != 0) { return _par_state(fp, fl); }
    if (_par_eq(mp, ml, "phase") == 1 && _par_in_n != 0) { return _par_phase(fp, fl); }
    if (_par_in_n != 0) { return 0; }   # a preset row has no inputs; anything else is a module function
    if (_par_eq(mp, ml, "material") == 1) {
        return _par_table(fp, fl, "material", "ALL_MATERIALS", _par_tab_material, US_MATERIAL_COUNT,
            &_par_fill_material);
    }
    if (_par_eq(mp, ml, "state") == 1) {
        return _par_table(fp, fl, "state", "ALL_GASES", _par_tab_gas, US_GAS_COUNT, &_par_fill_gas);
    }
    if (_par_eq(mp, ml, "phase") == 1) {
        return _par_table(fp, fl, "phase", "ALL_SUBSTANCES", _par_tab_substance, US_SUBSTANCE_COUNT,
            &_par_fill_substance);
    }
    if (_par_eq(mp, ml, "chem") == 1) {
        return _par_table(fp, fl, "chem", "ALL_SPECIES", _par_tab_species, US_SPECIES_COUNT, &_par_fill_species);
    }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through the stdlib candidates the correctly rounded
# primitives replace (ADR 0004), against the same reference (the corrected oracle where it has the row):
# - exp / ln / atan: the builtins (x87 on x86_64, the polyfills on aarch64) and the polyfills (the same bits on every
#   target); atan also as ganita's atan2(x, 1); powf as ganita's pow;
# - the stdlib min / max that `_us_min` / `_us_max` replace, to show where their NaN semantics differ from Rust's.
fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        _par_got_n = 0;
        var rb: f64 = f64_exp(x);
        _par_got_f(rb);
        _par_shadow_record("f64::exp ~ f64_exp builtin", cls);
        _par_got_n = 0;
        var r: f64 = _f64_exp_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp ~ _f64_exp_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        _par_got_n = 0;
        var rb: f64 = f64_ln(x);
        _par_got_f(rb);
        _par_shadow_record("f64::ln ~ f64_ln builtin", cls);
        _par_got_n = 0;
        var r: f64 = _f64_ln_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::ln ~ _f64_ln_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::atan") == 1) {
        _par_got_n = 0;
        var rb: f64 = f64_atan(x);
        _par_got_f(rb);
        _par_shadow_record("f64::atan ~ f64_atan builtin", cls);
        _par_got_n = 0;
        var r: f64 = _f64_atan_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::atan ~ _f64_atan_polyfill", cls);
        _par_got_n = 0;
        var r2: f64 = ganita_f64_atan2(x, 1.0);
        _par_got_f(r2);
        _par_shadow_record("f64::atan ~ ganita_f64_atan2(x, 1)", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::tanh") == 1) {
        _par_got_n = 0;
        var rt: f64 = ganita_f64_tanh(x);
        _par_got_f(rt);
        _par_shadow_record("f64::tanh ~ ganita_f64_tanh", cls);
        return 0;
    }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::powf") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_pow(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::powf ~ ganita_f64_pow", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::max") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_max(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::max ~ f64_max", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_min(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::min ~ f64_min", cls);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set yet (the rows are measured). Under ADR 0004 every
# class-C function on a correctly rounded primitive is compared at 0 ulp against the corrected oracle. A shadow line
# is measured (its name has no bound).
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::tanh") == 1) { return 0; }
    # Every class-C transfer, state, entropy, phase and steam function computes on the _us_cr_* primitives.
    if (fl > 10 && _par_eq(fp, 10, "transfer::") == 1) { return 0; }
    if (fl > 7 && _par_eq(fp, 7, "state::") == 1) { return 0; }
    if (fl > 9 && _par_eq(fp, 9, "entropy::") == 1) { return 0; }
    if (fl > 7 && _par_eq(fp, 7, "phase::") == 1) { return 0; }
    if (fl > 7 && _par_eq(fp, 7, "steam::") == 1) { return 0; }
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. ADR 0005: a JSON document bayan refuses for
# a mapped reason, or an integer `-0` read as +0 (the dispatcher checks which, per row). The ADR 0002 rows arrive with
# their modules (port plan §3.3).
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    if (_par_adr5 == 1) { return 5; }
    return 0;
}

# No ADR's accepted rows are summarised quietly yet.
#must_use
fn _par_accepted_quiet(adr): i64 {
    return 0;
}

# Every printed accepted row gets its bit pair.
#must_use
fn _par_accepted_bits(adr): i64 {
    return 1;
}

# No module-specific summary lines yet.
fn _par_module_done(mp, ml) {
    return 0;
}

# ushma has one harness: no module is skipped.
#must_use
fn _par_skip(mp, ml): i64 {
    return 0;
}

_par_tables_init();
var exit_code = _par_main();
sys_exit_group(exit_code);
