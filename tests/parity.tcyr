        _par_got_res(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "phase::SubstanceData::sublimation_pressure") == 1) {
        var t4, v4 = us_substance_sublimation_pressure(&s, p11);
        _par_got_res(t4, v4);
