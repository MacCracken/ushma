# cycle tests (M4a: the types, the process helpers, the Otto, Diesel and Brayton cycles; M4b: the Rankine and
# refrigeration cycles, the heat-pump COP; M4c: the comparison and the diagrams).
#
# Rust 1.4.0's cycle.rs tests, all 59, one for one, each also checking the refusal's code. Then reference tests of the
# results' documents, of the five cycles' spans, of results reused across calls (their vecs refilled, no allocation
# after the first), and of every allocation refused in turn.

include "src/constants.cyr"
include "src/error.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/validate.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/steam_data.cyr"
include "src/steam.cyr"
include "src/cycle.cyr"

# |a − b| as an f64.
fn absdiff(a: f64, b: f64): f64 {
    var d: f64 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    return d;
}

# Asserts a Result is Err(code).
fn errc(t, v, code, name) {
    assert_eq(is_err_result(t), 1, name);
    if (is_err_result(t) == 1) { assert_streq(us_error_name(v), us_error_name(code), name); }
    return 0;
}

# The ring's raw bytes contain the C string `s`: 1 or 0.
fn ring_has(s): i64 {
    var cap = 8192;
    var buf = alloc(cap);
    var n = sakshi_ring_read_raw(buf, cap);
    var sl = strlen(s);
    var k = 0;
    while (k + sl <= n) {
        if (memeq(buf + k, s, sl) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

# The types: a state point, the process and cycle kinds, and their JSON round trips.
# rust src/cycle.rs: test_state_point_construction, test_process_kind_traits, test_cycle_kind_traits
# rust src/cycle.rs: test_state_point_serde_roundtrip, test_cycle_kind_serde_roundtrip
# rust src/cycle.rs: test_process_kind_serde_roundtrip
fn test_types() {
    test_group("types");
    var sp: UsStatePoint;
    sp.temperature = 300.0;
    sp.pressure = 101325.0;
    sp.volume = 0.02241;
    sp.entropy = 150.0;
    sp.enthalpy = 6000.0;
    var t0: f64 = sp.temperature;
    var d0: f64 = absdiff(t0, 300.0);
    assert(d0 < 0.0000000001, "a state point holds its temperature");
    assert(US_PROCESS_ISENTROPIC != US_PROCESS_ISOCHORIC, "Isentropic is not Isochoric");
    assert_streq(us_process_name(US_PROCESS_ISENTROPIC), "Isentropic", "the Debug name");
    assert(US_CYCLE_OTTO != US_CYCLE_DIESEL, "Otto is not Diesel");
    assert_streq(us_cycle_name(US_CYCLE_DIESEL), "Diesel", "a cycle's name");
    assert_eq(us_process_name(US_PROCESS_COUNT), 0, "no name past the last process");
    sp.temperature = 500.0;
    sp.pressure = 200000.0;
    sp.volume = 0.05;
    sp.entropy = 200.0;
    sp.enthalpy = 10000.0;
    var sb = str_builder_new();
    us_state_point_to_json(sb, &sp);
    var back: UsStatePoint;
    var t, v = us_state_point_from_json(load64(sb), load64(sb + 8), &back);
    assert_eq(is_ok(t), 1, "a state point's document reads back");
    var bt: f64 = back.temperature;
    var d1: f64 = absdiff(bt, 500.0);
    assert(d1 < 0.0000000001, "its temperature");
    var sb2 = str_builder_new();
    us_cycle_to_json(sb2, US_CYCLE_BRAYTON);
    var t2, v2 = us_cycle_from_json(load64(sb2), load64(sb2 + 8));
    assert_eq(v2, US_CYCLE_BRAYTON, "a cycle kind's document reads back");
    var sb3 = str_builder_new();
    us_process_to_json(sb3, US_PROCESS_ISENTHALPIC);
    var t3, v3 = us_process_from_json(load64(sb3), load64(sb3 + 8));
    assert_eq(v3, US_PROCESS_ISENTHALPIC, "a process's document reads back");
}

# The process heats and works, and the isentropic temperature from a pressure ratio.
# rust src/cycle.rs: test_isochoric_heat, test_isobaric_heat, test_adiabatic_work_expansion
# rust src/cycle.rs: test_adiabatic_work_compression, test_adiabatic_temp_from_pressure_roundtrip
# rust src/cycle.rs: test_adiabatic_temp_from_pressure_invalid
fn test_helpers() {
    test_group("process helpers");
    var q: f64 = us_isochoric_heat(1.0, 20.8, 300.0, 400.0);
    var d: f64 = absdiff(q, 2080.0);
    assert(d < 0.0000000001, "isochoric: 2080 J");
    var q2: f64 = us_isobaric_heat(1.0, 29.1, 300.0, 400.0);
    var d2: f64 = absdiff(q2, 2910.0);
    assert(d2 < 0.0000000001, "isobaric: 2910 J");
    var w: f64 = us_adiabatic_work(1.0, 20.8, 500.0, 300.0);
    var want: f64 = 20.8 * 200.0;
    var d3: f64 = absdiff(w, want);
    assert(w > 0.0 && d3 < 0.0000000001, "an adiabatic expansion does positive work");
    var w2: f64 = us_adiabatic_work(1.0, 20.8, 300.0, 500.0);
    assert(w2 < 0.0, "a compression, negative");
    var t, v = us_adiabatic_temp_from_pressure(300.0, 100000.0, 1000000.0, 1.4);
    var t2v: f64 = v;
    var tb, vb = us_adiabatic_temp_from_pressure(t2v, 1000000.0, 100000.0, 1.4);
    var back: f64 = vb;
    var d4: f64 = absdiff(back, 300.0);
    assert(is_ok(t) == 1 && is_ok(tb) == 1 && d4 < 0.0000000001, "up and back down: 300 K");
    var e1, f1 = us_adiabatic_temp_from_pressure(0.0, 100000.0, 200000.0, 1.4);
    errc(e1, f1, US_ERR_INVALID_TEMPERATURE, "T1 = 0");
    var e2, f2 = us_adiabatic_temp_from_pressure(300.0, 0.0, 200000.0, 1.4);
    errc(e2, f2, US_ERR_INVALID_PRESSURE, "P1 = 0");
    var e3, f3 = us_adiabatic_temp_from_pressure(300.0, 100000.0, 0.0, 1.4);
    errc(e3, f3, US_ERR_INVALID_PRESSURE, "P2 = 0");
    var e4, f4 = us_adiabatic_temp_from_pressure(300.0, 100000.0, 200000.0, 1.0);
    errc(e4, f4, US_ERR_INVALID_PARAMETER, "gamma = 1");
}

# State point `i`'s field at byte offset `off` (0 T, 8 P, 16 V, 24 S, 32 H) of *r.
fn spf(r: *UsCycleResult, i, off): f64 {
    var sp: UsStatePoint;
    us_cycle_state(r, i, &sp);
    var base = &sp;
    var x: f64 = load64(base + off);
    return x;
}

# |heat_in − net_work − heat_out| of *r.
fn balance(r: *UsCycleResult): f64 {
    var qi: f64 = r.heat_in;
    var w: f64 = r.net_work;
    var qo: f64 = r.heat_out;
    var b: f64 = absdiff(qi - w, qo);
    return b;
}

# The Otto cycle: its analytical efficiency, the first law, four states and processes, the temperature order, the
# isochores, the isentropes, compression ratio against efficiency, and the refusals.
# rust src/cycle.rs: test_otto_efficiency_analytical, test_otto_energy_conservation, test_otto_four_state_points
# rust src/cycle.rs: test_otto_temperature_ordering, test_otto_isochoric_volumes, test_otto_isentropic_entropy
# rust src/cycle.rs: test_otto_higher_compression_higher_efficiency, test_otto_invalid_inputs
fn test_otto() {
    test_group("Otto");
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var t, v = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &r);
    assert_eq(is_ok(t), 1, "r = 8 is Ok");
    var e8: f64 = r.efficiency;
    var p: f64 = _us_cr_pow(8.0, 0.4);
    var want: f64 = 1.0 - 1.0 / p;
    var d: f64 = absdiff(e8, want);
    assert(d < 0.000001, "eta = 1 - 1/r^(gamma-1)");
    assert_eq(us_cycle_state_count(&r), 4, "four state points");
    assert_eq(us_cycle_process_count(&r), 4, "four processes");
    var t1: f64 = spf(&r, 0, 0);
    var t2: f64 = spf(&r, 1, 0);
    var t3: f64 = spf(&r, 2, 0);
    var t4: f64 = spf(&r, 3, 0);
    assert(t2 > t1 && t3 > t2 && t4 < t3, "compression heats, heat addition heats, expansion cools");
    var v1: f64 = spf(&r, 0, 16);
    var v2: f64 = spf(&r, 1, 16);
    var v3: f64 = spf(&r, 2, 16);
    var v4: f64 = spf(&r, 3, 16);
    var dv23: f64 = absdiff(v2, v3);
    var dv41: f64 = absdiff(v4, v1);
    assert(dv23 < 0.0000000001 && dv41 < 0.0000000001, "V2 = V3 and V4 = V1");
    var s1: f64 = spf(&r, 0, 24);
    var s2: f64 = spf(&r, 1, 24);
    var s3: f64 = spf(&r, 2, 24);
    var s4: f64 = spf(&r, 3, 24);
    var ds12: f64 = absdiff(s1, s2);
    var ds34: f64 = absdiff(s3, s4);
    assert(ds12 < 0.0000000001 && ds34 < 0.0000000001, "S1 = S2 and S3 = S4");
    var t5, v5 = us_otto_cycle(300.0, 101325.0, 10.0, 40000.0, 1.4, 1.0, &r);
    var b: f64 = balance(&r);
    assert(b < 0.000001, "the first law: q_in = w + q_out");
    var e10: f64 = r.efficiency;
    assert(e10 > e8, "a higher compression ratio, a higher efficiency");
    var t6, v6 = us_otto_cycle(0.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &r);
    errc(t6, v6, US_ERR_INVALID_TEMPERATURE, "T1 = 0");
    var t7, v7 = us_otto_cycle(300.0, 0.0, 8.0, 50000.0, 1.4, 1.0, &r);
    errc(t7, v7, US_ERR_INVALID_PRESSURE, "P1 = 0");
    var t8, v8 = us_otto_cycle(300.0, 101325.0, 1.0, 50000.0, 1.4, 1.0, &r);
    errc(t8, v8, US_ERR_INVALID_COMPRESSION_RATIO, "r = 1");
    var t9, v9 = us_otto_cycle(300.0, 101325.0, 0.5, 50000.0, 1.4, 1.0, &r);
    errc(t9, v9, US_ERR_INVALID_COMPRESSION_RATIO, "r = 0.5");
    var ta, va = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.0, 1.0, &r);
    errc(ta, va, US_ERR_INVALID_PARAMETER, "gamma = 1");
    var tb, vb = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 0.0, &r);
    errc(tb, vb, US_ERR_INVALID_PARAMETER, "n = 0");
    var tc, vc = us_otto_cycle(300.0, 101325.0, 8.0, 0.0, 1.4, 1.0, &r);
    errc(tc, vc, US_ERR_INVALID_PARAMETER, "heat_in = 0");
    var td, vd = us_otto_cycle(300.0, 101325.0, 8.0, -100.0, 1.4, 1.0, &r);
    errc(td, vd, US_ERR_INVALID_PARAMETER, "negative heat_in");
    var b2: f64 = balance(&r);
    assert(b2 < 0.000001, "a refusal leaves the result as it was");
}

# The Diesel cycle: its analytical efficiency, the first law, the isobar, and the refusals.
# rust src/cycle.rs: test_diesel_efficiency_analytical, test_diesel_energy_conservation
# rust src/cycle.rs: test_diesel_isobaric_pressures, test_diesel_invalid_inputs
fn test_diesel() {
    test_group("Diesel");
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var t, v = us_diesel_cycle(300.0, 101325.0, 20.0, 2.0, 1.4, 1.0, &r);
    assert_eq(is_ok(t), 1, "r = 20, rc = 2 is Ok");
    var eta: f64 = r.efficiency;
    var rcg: f64 = _us_cr_pow(2.0, 1.4);
    var rg: f64 = _us_cr_pow(20.0, 0.4);
    var want: f64 = 1.0 - (rcg - 1.0) / (1.4 * (2.0 - 1.0) * rg);
    var d: f64 = absdiff(eta, want);
    assert(d < 0.000001, "eta = 1 - (rc^g - 1)/(g (rc - 1) r^(g-1))");
    var p2: f64 = spf(&r, 1, 8);
    var p3: f64 = spf(&r, 2, 8);
    var dp: f64 = absdiff(p2, p3);
    var rel: f64 = dp / p2;
    assert(rel < 0.0000000001, "P2 = P3");
    var t2, v2 = us_diesel_cycle(300.0, 101325.0, 18.0, 2.5, 1.4, 1.0, &r);
    var b: f64 = balance(&r);
    assert(b < 0.000001, "the first law");
    var t3, v3 = us_diesel_cycle(300.0, 101325.0, 1.0, 2.0, 1.4, 1.0, &r);
    errc(t3, v3, US_ERR_INVALID_COMPRESSION_RATIO, "r = 1");
    var t4, v4 = us_diesel_cycle(300.0, 101325.0, 20.0, 1.0, 1.4, 1.0, &r);
    errc(t4, v4, US_ERR_INVALID_CUTOFF_RATIO, "rc = 1");
    var t5, v5 = us_diesel_cycle(300.0, 101325.0, 20.0, 25.0, 1.4, 1.0, &r);
    errc(t5, v5, US_ERR_INVALID_CYCLE_PARAMETER, "rc >= r");
}

# The Brayton cycle: its analytical efficiency, the first law, the back-work ratio, T3 > T2, and the refusals; then the
# first law of all three cycles.
# rust src/cycle.rs: test_brayton_efficiency_analytical, test_brayton_energy_conservation
# rust src/cycle.rs: test_brayton_back_work_ratio, test_brayton_t3_must_exceed_t2, test_brayton_invalid_inputs
# rust src/cycle.rs: test_ideal_gas_cycles_first_law
fn test_brayton() {
    test_group("Brayton");
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var t, v = us_brayton_cycle(300.0, 101325.0, 10.0, 1400.0, 1.4, 1.0, &r);
    assert_eq(is_ok(t), 1, "rp = 10 is Ok");
    var eta: f64 = r.efficiency;
    var e: f64 = 0.4 / 1.4;
    var p: f64 = _us_cr_pow(10.0, e);
    var want: f64 = 1.0 - 1.0 / p;
    var d: f64 = absdiff(eta, want);
    assert(d < 0.000001, "eta = 1 - 1/rp^((g-1)/g)");
    var b: f64 = balance(&r);
    assert(b < 0.000001, "the first law");
    var bwr: f64 = r.back_work_ratio;
    assert(bwr > 0.3 && bwr < 0.9, "a back-work ratio of 30-90%");
    var t2, v2 = us_brayton_cycle(300.0, 101325.0, 10.0, 500.0, 1.4, 1.0, &r);
    errc(t2, v2, US_ERR_INVALID_CYCLE_PARAMETER, "T3 = 500 K < T2 = 579 K");
    var t3, v3 = us_brayton_cycle(300.0, 101325.0, 1.0, 1400.0, 1.4, 1.0, &r);
    errc(t3, v3, US_ERR_INVALID_PRESSURE_RATIO, "rp = 1");
    var t4, v4 = us_brayton_cycle(300.0, 101325.0, 0.5, 1400.0, 1.4, 1.0, &r);
    errc(t4, v4, US_ERR_INVALID_PRESSURE_RATIO, "rp = 0.5");
    var t5, v5 = us_brayton_cycle(300.0, 101325.0, 10.0, -100.0, 1.4, 1.0, &r);
    errc(t5, v5, US_ERR_INVALID_TEMPERATURE, "a negative T3 is a temperature refusal");
    var ok = 1;
    var t6, v6 = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &r);
    var b1: f64 = balance(&r);
    var q1: f64 = r.heat_in;
    if (b1 >= 0.000001 * q1) { ok = 0; }
    var t7, v7 = us_diesel_cycle(300.0, 101325.0, 18.0, 2.0, 1.4, 1.0, &r);
    var b2: f64 = balance(&r);
    var q2: f64 = r.heat_in;
    if (b2 >= 0.000001 * q2) { ok = 0; }
    var t8, v8 = us_brayton_cycle(300.0, 101325.0, 10.0, 1400.0, 1.4, 1.0, &r);
    var b3: f64 = balance(&r);
    var q3: f64 = r.heat_in;
    if (b3 >= 0.000001 * q3) { ok = 0; }
    assert_eq(ok, 1, "Otto, Diesel and Brayton close the first law within 1e-6");
}

# A whole result's document reads back on the global heap: the same kind, points, processes and numbers, and the same
# bytes when written again.
fn test_result_json() {
    test_group("a result's document");
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var t, v = us_diesel_cycle(300.0, 101325.0, 20.0, 2.0, 1.4, 1.0, &r);
    var sb = str_builder_new();
    us_cycle_result_to_json(sb, &r);
    var back: UsCycleResult;
    var tb, vb = us_cycle_result_from_json(load64(sb), load64(sb + 8), &back);
    assert_eq(is_ok(tb), 1, "a Diesel result's document reads back");
    assert_eq(back.kind, US_CYCLE_DIESEL, "its kind");
    assert_eq(us_cycle_state_count(&back), 4, "its four state points");
    assert_eq(us_cycle_process(&back, 1), US_PROCESS_ISOBARIC, "its isobaric heat addition");
    var e1: f64 = r.efficiency;
    var e2: f64 = back.efficiency;
    assert(e1 == e2, "its efficiency, exactly");
    var p1: f64 = spf(&r, 2, 8);
    var p2: f64 = spf(&back, 2, 8);
    assert(p1 == p2, "state 3's pressure, exactly");
    var sb2 = str_builder_new();
    us_cycle_result_to_json(sb2, &back);
    var n = load64(sb + 8);
    assert(n == load64(sb2 + 8) && memeq(load64(sb), load64(sb2), n) == 1, "written again, the same bytes");
}

# The Rankine cycle: its efficiency and net work, the first law, superheat against saturated, the back-work ratio, the
# refusals, the superheated turbine exhaust (IAPWS-IF97: T₄ 391.95 K, h₄ 2714.2 kJ/kg, η 13.22 %, the port plan's
# 13.2 % reference case), and a boiler state on an exact tier row.
# rust src/cycle.rs: test_rankine_basic, test_rankine_energy_conservation
# rust src/cycle.rs: test_rankine_superheated_better_than_saturated, test_rankine_low_back_work_ratio
# rust src/cycle.rs: test_rankine_invalid_pressures, test_rankine_superheated_turbine_exhaust
# rust src/cycle.rs: test_rankine_at_exact_tier_pressure
fn test_rankine() {
    test_group("Rankine");
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var t, v = us_rankine_cycle(10000.0, 2000000.0, 1, 573.15, &r);
    assert_eq(is_ok(t), 1, "10 kPa / 2 MPa / 573.15 K is Ok");
    var eta: f64 = r.efficiency;
    var w: f64 = r.net_work;
    assert(eta > 0.15 && eta < 0.4 && w > 0.0, "15-40 %, net work out");
    var bwr: f64 = r.back_work_ratio;
    assert(bwr < 0.05, "a back-work ratio under 5 %");
    var t1, v1 = us_rankine_cycle(10000.0, 1000000.0, 1, 573.15, &r);
    var b: f64 = balance(&r);
    var qi: f64 = r.heat_in;
    assert(b / qi < 0.01, "the first law within 1 %");
    var sup: f64 = r.efficiency;
    var t2, v2 = us_rankine_cycle(10000.0, 1000000.0, 0, 0.0, &r);
    var sat: f64 = r.efficiency;
    assert(is_ok(t2) == 1 && sup > sat, "superheat beats saturated vapor");
    var e1, f1 = us_rankine_cycle(0.0, 1000000.0, 0, 0.0, &r);
    errc(e1, f1, US_ERR_INVALID_PRESSURE, "condenser 0");
    var e2, f2 = us_rankine_cycle(10000.0, 0.0, 0, 0.0, &r);
    errc(e2, f2, US_ERR_INVALID_PRESSURE, "boiler 0");
    var e3, f3 = us_rankine_cycle(1000000.0, 10000.0, 0, 0.0, &r);
    errc(e3, f3, US_ERR_INVALID_CYCLE_PARAMETER, "boiler below condenser");
    var t3, v3 = us_rankine_cycle(100000.0, 500000.0, 1, 573.15, &r);
    var t4: f64 = spf(&r, 3, 0);
    var h4: f64 = spf(&r, 3, 32);
    var e4: f64 = r.efficiency;
    var dt: f64 = absdiff(t4, 391.95);
    var dh: f64 = absdiff(h4, 2714200.0);
    var de: f64 = absdiff(e4, 0.1322);
    assert(is_ok(t3) == 1 && dt < 1.0, "a superheated exhaust: T4 = 391.95 K within 1 K");
    assert(dh < 3000.0 && de < 0.002, "h4 = 2714.2 kJ/kg within 3, eta = 13.22 % within 0.2");
    var t5, v5 = us_rankine_cycle(10000.0, 2000000.0, 1, 523.15, &r);
    var e5: f64 = r.efficiency;
    assert(is_ok(t5) == 1 && e5 > 0.25 && e5 < 0.4, "a boiler state on a tier row: 25-40 %");
}

# The refrigeration cycle: positive COPs, COP_hp = COP_ref + 1, the first law with negative net work, the refusals, the
# Carnot limit (IAPWS-IF97: T₂ 677.0 K, COP 2.877), and the heat-pump COP.
# rust src/cycle.rs: test_refrigeration_basic, test_refrigeration_cop_hp_identity, test_refrigeration_energy_balance
# rust src/cycle.rs: test_refrigeration_invalid, test_refrigeration_respects_carnot_limit
# rust src/cycle.rs: test_heat_pump_cop_identity
fn test_refrigeration() {
    test_group("refrigeration");
    var rr: UsRefrigerationResult;
    var ti, vi = us_refrigeration_result_init(&rr);
    var c: *UsCycleResult = us_refrigeration_result_cycle(&rr);
    var t, v = us_refrigeration_cycle(7384.0, 47390.0, &rr);
    assert_eq(is_ok(t), 1, "7.384 / 47.39 kPa is Ok");
    var cr: f64 = rr.cop_refrigeration;
    var ch: f64 = rr.cop_heat_pump;
    assert(cr > 0.0 && ch > cr, "COP_ref > 0, COP_hp above it");
    var di: f64 = absdiff(ch, cr + 1.0);
    assert(di < 0.1, "COP_hp = COP_ref + 1 within 0.1");
    var w: f64 = c.net_work;
    var qi: f64 = c.heat_in;
    var qo: f64 = c.heat_out;
    var bal: f64 = absdiff(qi - qo, w);
    assert(w < 0.0 && bal / qo < 0.000000001, "work consumed, and Q_in - Q_out = W_net within 1e-9");
    var e1, f1 = us_refrigeration_cycle(0.0, 47390.0, &rr);
    errc(e1, f1, US_ERR_INVALID_PRESSURE, "evaporator 0");
    var e2, f2 = us_refrigeration_cycle(47390.0, 7384.0, &rr);
    errc(e2, f2, US_ERR_INVALID_CYCLE_PARAMETER, "condenser below evaporator");
    var t3, v3 = us_refrigeration_cycle(3169.0, 100000.0, &rr);
    var t2: f64 = spf(c, 1, 0);
    var cop: f64 = rr.cop_refrigeration;
    var d2: f64 = absdiff(t2, 677.0);
    var dc: f64 = absdiff(cop, 2.877);
    assert(is_ok(t3) == 1 && d2 < 2.0 && dc < 0.03, "T2 = 677.0 K within 2, COP = 2.877 within 0.03");
    var tc: f64 = spf(c, 0, 0);
    var th: f64 = spf(c, 2, 0);
    var carnot: f64 = tc / (th - tc);
    assert(cop < carnot, "below the Carnot COP");
    var h3: f64 = us_heat_pump_cop(3.0);
    var h0: f64 = us_heat_pump_cop(0.0);
    var d3: f64 = absdiff(h3, 4.0);
    var d0: f64 = absdiff(h0, 1.0);
    assert(d3 < 0.0000000001 && d0 < 0.0000000001, "heat_pump_cop: 3 -> 4, 0 -> 1");
}

# Every cycle refuses NaN and infinite inputs, with the code of the input's own check.
# rust src/cycle.rs: test_cycles_reject_nan_and_inf, test_steam_cycles_reject_nan
fn test_nan_inf() {
    test_group("NaN and infinity");
    var nan: f64 = 0.0 / 0.0;
    var inf: f64 = 1.0 / 0.0;
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var e1, f1 = us_otto_cycle(nan, 101325.0, 8.0, 50000.0, 1.4, 1.0, &r);
    errc(e1, f1, US_ERR_INVALID_TEMPERATURE, "Otto, T1 NaN");
    var e2, f2 = us_otto_cycle(300.0, 101325.0, inf, 50000.0, 1.4, 1.0, &r);
    errc(e2, f2, US_ERR_INVALID_COMPRESSION_RATIO, "Otto, r infinite");
    var e3, f3 = us_diesel_cycle(300.0, 101325.0, 18.0, nan, 1.4, 1.0, &r);
    errc(e3, f3, US_ERR_INVALID_CUTOFF_RATIO, "Diesel, rc NaN");
    var e4, f4 = us_brayton_cycle(300.0, 101325.0, 10.0, 1400.0, nan, 1.0, &r);
    errc(e4, f4, US_ERR_INVALID_PARAMETER, "Brayton, gamma NaN");
    var e5, f5 = us_rankine_cycle(nan, 1000000.0, 0, 0.0, &r);
    errc(e5, f5, US_ERR_INVALID_PRESSURE, "Rankine, condenser NaN");
    var e6, f6 = us_rankine_cycle(10000.0, 1000000.0, 1, nan, &r);
    errc(e6, f6, US_ERR_INVALID_TEMPERATURE, "Rankine, superheat NaN (the lookup's refusal)");
    var rr: UsRefrigerationResult;
    var tr, vr = us_refrigeration_result_init(&rr);
    var e7, f7 = us_refrigeration_cycle(nan, 100000.0, &rr);
    errc(e7, f7, US_ERR_INVALID_PRESSURE, "refrigeration, evaporator NaN");
}

# A refrigeration result's document reads back on the global heap, and the same bytes come out again.
fn test_refrigeration_json() {
    test_group("a refrigeration result's document");
    var rr: UsRefrigerationResult;
    var ti, vi = us_refrigeration_result_init(&rr);
    var t, v = us_refrigeration_cycle(3169.0, 100000.0, &rr);
    var sb = str_builder_new();
    us_refrigeration_result_to_json(sb, &rr);
    var back: UsRefrigerationResult;
    var tb, vb = us_refrigeration_result_from_json(load64(sb), load64(sb + 8), &back);
    assert_eq(is_ok(tb), 1, "it reads back");
    var c1: f64 = rr.cop_refrigeration;
    var c2: f64 = back.cop_refrigeration;
    assert(c1 == c2, "its COP, exactly");
    var bc: *UsCycleResult = us_refrigeration_result_cycle(&back);
    assert_eq(bc.kind, US_CYCLE_REFRIGERATION, "its cycle's kind");
    assert_eq(us_cycle_process(bc, 2), US_PROCESS_ISENTHALPIC, "the throttle");
    var sb2 = str_builder_new();
    us_refrigeration_result_to_json(sb2, &back);
    var n = load64(sb + 8);
    assert(n == load64(sb2 + 8) && memeq(load64(sb), load64(sb2), n) == 1, "written again, the same bytes");
}

# A diagram point's and a comparison's documents read back on the global heap, and the same bytes come out again.
fn test_point_and_comparison_json() {
    test_group("a point's and a comparison's documents");
    var dp: UsDiagramPoint;
    dp.x = 0.0246;
    dp.y = 101325.0;
    var sb = str_builder_new();
    us_diagram_point_to_json(sb, &dp);
    assert_streq(load64(sb), "{\"x\":0.0246,\"y\":101325.0}", "a point's document");
    var dq: UsDiagramPoint;
    var t1, v1 = us_diagram_point_from_json(load64(sb), load64(sb + 8), &dq);
    var qx: f64 = dq.x;
    var qy: f64 = dq.y;
    assert(is_ok(t1) == 1 && qx == 0.0246 && qy == 101325.0, "it reads back");
    var otto: UsCycleResult;
    var ti, vi = us_cycle_result_init(&otto);
    var t, v = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &otto);
    var c: UsCycleComparison;
    us_compare_cycle(US_CYCLE_OTTO, &otto, 1800.0, 300.0, &c);
    var sb2 = str_builder_new();
    us_cycle_comparison_to_json(sb2, &c);
    var c2: UsCycleComparison;
    var t2, v2 = us_cycle_comparison_from_json(load64(sb2), load64(sb2 + 8), &c2);
    var sb3 = str_builder_new();
    us_cycle_comparison_to_json(sb3, &c2);
    var n = load64(sb2 + 8);
    assert(is_ok(t2) == 1 && c2.kind == US_CYCLE_OTTO, "a comparison reads back, its kind Otto");
    assert(n == load64(sb3 + 8) && memeq(load64(sb2), load64(sb3), n) == 1, "written again, the same bytes");
}

# The steam cycles' spans: each opens under Rust's name, around the superheated inversion's own, and closes on a
# refusal too.
fn test_steam_spans() {
    test_group("steam-cycle spans");
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var rr: UsRefrigerationResult;
    var tr, vr = us_refrigeration_result_init(&rr);
    sakshi_output_buffer();
    sakshi_set_level(SK_DEBUG);
    sakshi_ring_clear();
    var t1, v1 = us_rankine_cycle(100000.0, 500000.0, 1, 573.15, &r);
    assert_eq(ring_has("rankine_cycle"), 1, "rankine_cycle's span");
    assert_eq(ring_has("superheated_by_entropy"), 1, "the exhaust's inversion inside it");
    sakshi_ring_clear();
    var t2, v2 = us_refrigeration_cycle(7384.0, 47390.0, &rr);
    assert_eq(ring_has("refrigeration_cycle"), 1, "refrigeration_cycle's span");
    assert_eq(sakshi_ring_event_count(), 4, "its pair around the compressor exit's");
    sakshi_ring_clear();
    var t3, v3 = us_rankine_cycle(0.0, 500000.0, 0, 0.0, &r);
    assert_eq(ring_has("rankine_cycle"), 1, "a refused Rankine's span");
    assert_eq(sakshi_span_depth(), 0, "every span closed");
    sakshi_set_level(SK_INFO);
    sakshi_ring_clear();
    var before = alloc_used();
    var k = 0;
    while (k < 1000) {
        var tk, vk = us_rankine_cycle(10000.0, 2000000.0, 1, 573.15, &r);
        var tj, vj = us_refrigeration_cycle(7384.0, 47390.0, &rr);
        k = k + 1;
    }
    assert_eq(alloc_used() - before, 0, "1,000 of each into reused results: 0 heap bytes");
}

# The x of point k in a diagram buffer.
fn px(buf, k): f64 {
    var x: f64 = load64(buf + (16 * k));
    return x;
}

# The y of point k in a diagram buffer.
fn py(buf, k): f64 {
    var y: f64 = load64(buf + (16 * k) + 8);
    return y;
}

# The T-s and P-v diagrams: their point counts, the isentropes vertical in T-s, the isochores vertical and the isobars
# horizontal in P-v, the closed loop, a point's fields, the isochoric T-s path exponential, the steam isentropes through
# both end states, the ideal-gas isentrope's exponent γ, and a short process list; then the caller buffer's refusal.
# rust src/cycle.rs: test_ts_diagram_point_count, test_pv_diagram_point_count, test_ts_diagram_isentropic_vertical
# rust src/cycle.rs: test_pv_diagram_isochoric_vertical, test_pv_diagram_isobaric_horizontal
# rust src/cycle.rs: test_pv_diagram_closed_loop, test_diagram_point, test_ts_diagram_isochoric_is_exponential
# rust src/cycle.rs: test_pv_diagram_steam_isentropes_hit_both_endpoints
# rust src/cycle.rs: test_pv_diagram_ideal_gas_isentrope_matches_gamma, test_diagrams_tolerate_short_process_list
fn test_diagrams() {
    test_group("diagrams");
    var cap = 400;
    var buf = alloc(16 * cap);
    var otto: UsCycleResult;
    var ti, vi = us_cycle_result_init(&otto);
    var t, v = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &otto);
    var bray: UsCycleResult;
    var tj, vj = us_cycle_result_init(&bray);
    var tb, vb = us_brayton_cycle(300.0, 101325.0, 10.0, 1400.0, 1.4, 1.0, &bray);
    var t1, n1 = us_cycle_ts_diagram(&otto, 10, buf, cap);
    assert_eq(n1, 40, "T-s: 4 processes x 10 points");
    assert_eq(us_cycle_diagram_len(&otto, 10), 40, "us_cycle_diagram_len agrees");
    var s0: f64 = px(buf, 0);
    var vert = 1;
    var k = 0;
    while (k < 10) {
        var sk: f64 = px(buf, k);
        var dk: f64 = absdiff(sk, s0);
        if (dk >= 0.0000000001) { vert = 0; }
        k = k + 1;
    }
    assert_eq(vert, 1, "the isentrope 1-2 is vertical in T-s");
    var t2, n2 = us_cycle_ts_diagram(&otto, 3, buf, cap);
    var mid: f64 = py(buf, 4);
    var ta: f64 = spf(&otto, 1, 0);
    var tc: f64 = spf(&otto, 2, 0);
    var geo: f64 = f64_sqrt(ta * tc);
    var dm: f64 = absdiff(mid, geo);
    assert(dm < 0.000001, "the isochore's midpoint in T-s is sqrt(T2 T3)");
    var t3, n3 = us_cycle_pv_diagram(&bray, 20, buf, cap);
    assert_eq(n3, 80, "P-v: 4 processes x 20 points");
    var t4, n4 = us_cycle_pv_diagram(&otto, 10, buf, cap);
    var v10: f64 = px(buf, 10);
    var isoch = 1;
    k = 10;
    while (k < 20) {
        var vk: f64 = px(buf, k);
        var dv: f64 = absdiff(vk, v10);
        if (dv >= 0.0000000001) { isoch = 0; }
        k = k + 1;
    }
    assert_eq(isoch, 1, "the isochore 2-3 is vertical in P-v");
    var fx: f64 = px(buf, 0);
    var fy: f64 = py(buf, 0);
    var lx: f64 = px(buf, n4 - 1);
    var ly: f64 = py(buf, n4 - 1);
    var cx: f64 = absdiff(fx, lx);
    var cy: f64 = absdiff(fy, ly);
    assert(cx / fx < 0.0000000001 && cy / fy < 0.0000000001, "the P-v loop closes");
    var a1: f64 = spf(&otto, 0, 8);
    var av: f64 = spf(&otto, 0, 16);
    var t5, n5 = us_cycle_pv_diagram(&otto, 5, buf, cap);
    var gam = 1;
    k = 0;
    while (k < 5) {
        var xk: f64 = px(buf, k);
        var yk: f64 = py(buf, k);
        var pw: f64 = _us_cr_pow(av / xk, 1.4);
        var want: f64 = a1 * pw;
        var dr: f64 = absdiff(yk / want, 1.0);
        if (dr >= 0.000000001) { gam = 0; }
        k = k + 1;
    }
    assert_eq(gam, 1, "the ideal-gas isentrope is P V^1.4 = const");
    var t6, n6 = us_cycle_pv_diagram(&bray, 10, buf, cap);
    var p10: f64 = py(buf, 10);
    var isob = 1;
    k = 10;
    while (k < 20) {
        var pk: f64 = py(buf, k);
        var dp: f64 = absdiff(pk, p10);
        if (dp / p10 >= 0.0000000001) { isob = 0; }
        k = k + 1;
    }
    assert_eq(isob, 1, "the isobar 2-3 is horizontal in P-v");
    var rk: UsCycleResult;
    var tk, vk2 = us_cycle_result_init(&rk);
    var t7, v7 = us_rankine_cycle(10000.0, 2000000.0, 1, 623.15, &rk);
    var t8, n8 = us_cycle_pv_diagram(&rk, 10, buf, cap);
    var p3: f64 = spf(&rk, 2, 8);
    var p4: f64 = spf(&rk, 3, 8);
    var y20: f64 = py(buf, 20);
    var y29: f64 = py(buf, 29);
    var e3: f64 = absdiff(y20 / p3, 1.0);
    var e4: f64 = absdiff(y29 / p4, 1.0);
    var down = 1;
    k = 21;
    while (k < 30) {
        var yk1: f64 = py(buf, k);
        var yk0: f64 = py(buf, k - 1);
        if (yk1 > yk0) { down = 0; }
        k = k + 1;
    }
    assert(e3 < 0.000000001 && e4 < 0.000000001 && down == 1, "steam's turbine isentrope runs P3 to P4, falling");
    var dpt: UsDiagramPoint;
    dpt.x = 1.0;
    dpt.y = 2.0;
    var dx: f64 = dpt.x;
    var dy: f64 = dpt.y;
    assert(dx == 1.0 && dy == 2.0, "a diagram point holds x and y");
    vec_truncate(otto.processes, 1);
    var t9, n9 = us_cycle_pv_diagram(&otto, 4, buf, cap);
    var ta2, na = us_cycle_ts_diagram(&otto, 4, buf, cap);
    assert(n9 == 16 && na == 16, "one process code for four states: 16 points each");
    var e1, f1 = us_cycle_ts_diagram(&otto, 10, buf, 39);
    errc(e1, f1, US_ERR_INVALID_PARAMETER, "a buffer one point short is refused");
    var e2, f2 = us_cycle_pv_diagram(&otto, 1000000000000000000, buf, cap);
    errc(e2, f2, US_ERR_INVALID_PARAMETER, "a huge point count is refused, not overflowed");
    var t0, n0 = us_cycle_ts_diagram(&otto, 1, buf, 8);
    assert_eq(n0, 8, "fewer than 2 points a process is 2");
}

# The comparison with the Carnot limits: Otto and Brayton below theirs, a refrigeration result against the Carnot
# COP, and non-physical limits giving 0.
# rust src/cycle.rs: test_compare_cycles_second_law, test_compare_cycles_refrigeration_uses_carnot_cop
# rust src/cycle.rs: test_compare_cycles_rejects_nonphysical_limits
fn test_compare() {
    test_group("comparison");
    var otto: UsCycleResult;
    var ti, vi = us_cycle_result_init(&otto);
    var t, v = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &otto);
    var bray: UsCycleResult;
    var tj, vj = us_cycle_result_init(&bray);
    var tb, vb = us_brayton_cycle(300.0, 101325.0, 10.0, 1400.0, 1.4, 1.0, &bray);
    var kinds[16];
    var res[16];
    var ths[16];
    var tls[16];
    store64(&kinds, US_CYCLE_OTTO);
    store64(&kinds + 8, US_CYCLE_BRAYTON);
    store64(&res, &otto);
    store64(&res + 8, &bray);
    var h1: f64 = spf(&otto, 2, 0);
    var l1: f64 = spf(&otto, 0, 0);
    var h2: f64 = spf(&bray, 2, 0);
    var l2: f64 = spf(&bray, 0, 0);
    store64(&ths, h1);
    store64(&ths + 8, h2);
    store64(&tls, l1);
    store64(&tls + 8, l2);
    var out[96];
    var n = us_compare_cycles(&kinds, &res, &ths, &tls, 2, &out);
    assert_eq(n, 2, "two entries");
    var ok = 1;
    var k = 0;
    while (k < 2) {
        var c = &out + (48 * k);
        var eff: f64 = load64(c + 8);
        var car: f64 = load64(c + 32);
        var sec: f64 = load64(c + 40);
        if ((sec <= 1.0 && sec > 0.0 && car > eff) == 0) { ok = 0; }
        k = k + 1;
    }
    assert_eq(ok, 1, "0 < eta_II <= 1 and eta < eta_Carnot for each");
    otto.kind = US_CYCLE_REFRIGERATION;
    otto.efficiency = 5.0;
    var cc: UsCycleComparison;
    us_compare_cycle(US_CYCLE_REFRIGERATION, &otto, 300.0, 250.0, &cc);
    var car5: f64 = cc.carnot_efficiency;
    var sec1: f64 = cc.second_law_efficiency;
    var d5: f64 = absdiff(car5, 5.0);
    var d1: f64 = absdiff(sec1, 1.0);
    assert(d5 < 0.000000000001 && d1 < 0.000000000001, "refrigeration: COP_Carnot 250/50 = 5, eta_II 1");
    otto.kind = US_CYCLE_OTTO;
    var nan: f64 = 0.0 / 0.0;
    var zeros = 1;
    var hs: f64[4];
    var ls: f64[4];
    hs[0] = 300.0;
    ls[0] = 0.0 - 100.0;
    hs[1] = 300.0;
    ls[1] = 0.0;
    hs[2] = 250.0;
    ls[2] = 300.0;
    hs[3] = nan;
    ls[3] = 300.0;
    k = 0;
    while (k < 4) {
        var hk: f64 = hs[k];
        var lk: f64 = ls[k];
        us_compare_cycle(US_CYCLE_OTTO, &otto, hk, lk, &cc);
        var ck: f64 = cc.carnot_efficiency;
        var sk: f64 = cc.second_law_efficiency;
        if ((ck == 0.0 && sk == 0.0) == 0) { zeros = 0; }
        k = k + 1;
    }
    assert_eq(zeros, 1, "T_L < 0, T_L = 0, T_H < T_L and NaN limits: 0 and 0");
    assert_eq(us_compare_cycles(&kinds, &res, &ths, &tls, 0, &out), 0, "no entries, none written");
}

# A result reused across calls refills its vecs: no heap after the first; and the three cycles' spans.
fn test_reuse_and_spans() {
    test_group("reuse and spans");
    var r: UsCycleResult;
    var ti, vi = us_cycle_result_init(&r);
    var t, v = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &r);
    var before = alloc_used();
    var k = 0;
    while (k < 1000) {
        var tk, vk = us_brayton_cycle(300.0, 101325.0, 10.0, 1400.0, 1.4, 1.0, &r);
        k = k + 1;
    }
    assert_eq(alloc_used() - before, 0, "1,000 analyses into one result: 0 heap bytes");
    sakshi_output_buffer();
    sakshi_set_level(SK_DEBUG);
    sakshi_ring_clear();
    var t1, v1 = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &r);
    assert_eq(ring_has("otto_cycle"), 1, "otto_cycle's span");
    var t2, v2 = us_diesel_cycle(300.0, 101325.0, 20.0, 2.0, 1.4, 1.0, &r);
    assert_eq(ring_has("diesel_cycle"), 1, "diesel_cycle's span");
    var t3, v3 = us_brayton_cycle(300.0, 101325.0, 10.0, 500.0, 1.4, 1.0, &r);
    assert_eq(ring_has("brayton_cycle"), 1, "brayton_cycle's span, refused");
    assert_eq(sakshi_span_depth(), 0, "every span closed");
    assert_eq(sakshi_ring_event_count(), 7, "three pairs and one refusal");
    sakshi_set_level(SK_INFO);
    sakshi_ring_clear();
}

# A refused allocation, at each point in turn: the result's init, an analysis's first grow, the push accessors and the
# decoder return Err(US_ERR_OUT_OF_MEMORY) (the decoder Err(US_ERR_DESERIALIZE) where bayan's parser was refused), and
# nothing aborts. Rust aborts the process instead.
fn test_out_of_memory() {
    test_group("refused allocations");
    var ta = test_allocator();
    var r: UsCycleResult;
    test_allocator_fail_after(ta, 0);
    var t0, v0 = us_cycle_result_init_a(ta, &r);
    errc(t0, v0, US_ERR_OUT_OF_MEMORY, "init, its first vec refused");
    test_allocator_fail_after(ta, 0 - 1);
    var n0 = test_allocator_alloc_count(ta);
    var t1, v1 = us_cycle_result_init_a(ta, &r);
    assert_eq(test_allocator_alloc_count(ta) - n0, 4, "init: two vecs, two allocations each");
    test_allocator_fail_after(ta, test_allocator_alloc_count(ta));
    var t2, v2 = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &r);
    errc(t2, v2, US_ERR_OUT_OF_MEMORY, "Otto, its 20 state words past the vec's 16 refused");
    assert_eq(us_cycle_state_count(&r) + us_cycle_process_count(&r), 0, "which leaves the result empty");
    test_allocator_fail_after(ta, 0 - 1);
    var t3, v3 = us_otto_cycle(300.0, 101325.0, 8.0, 50000.0, 1.4, 1.0, &r);
    assert(is_ok(t3) == 1 && us_cycle_state_count(&r) == 4, "allowed, the same result fills");
    var r2: UsCycleResult;
    var t4, v4 = us_cycle_result_init_a(ta, &r2);
    var sp: UsStatePoint;
    us_cycle_state(&r, 0, &sp);
    test_allocator_fail_after(ta, test_allocator_alloc_count(ta));
    var k = 0;
    var oks = 0;
    while (k < 3) {
        var tk, vk = us_cycle_push_state(&r2, &sp);
        if (is_ok(tk) == 1) { oks = oks + 1; }
        k = k + 1;
    }
    var t5, v5 = us_cycle_push_state(&r2, &sp);
    assert_eq(oks, 3, "three state points fit the vec's 16 words");
    errc(t5, v5, US_ERR_OUT_OF_MEMORY, "a fourth needs a grow");
    assert_eq(us_cycle_state_count(&r2), 3, "which leaves the three");
    k = 0;
    oks = 0;
    while (k < 16) {
        var tp, vp = us_cycle_push_process(&r2, US_PROCESS_ISOBARIC);
        if (is_ok(tp) == 1) { oks = oks + 1; }
        k = k + 1;
    }
    var t6, v6 = us_cycle_push_process(&r2, US_PROCESS_ISOBARIC);
    var tq, vq = us_cycle_push_process(&r2, US_PROCESS_COUNT);
    errc(tq, vq, US_ERR_INVALID_PARAMETER, "a code past the processes is refused");
    var tm, vm = us_cycle_push_process(&r2, 0 - 1);
    errc(tm, vm, US_ERR_INVALID_PARAMETER, "a negative code too");
    assert_eq(oks, 16, "sixteen processes fit");
    errc(t6, v6, US_ERR_OUT_OF_MEMORY, "a seventeenth needs a grow");
    assert_eq(us_cycle_process_count(&r2), 16, "which leaves the sixteen");
    test_allocator_fail_after(ta, 0 - 1);
    var sb = str_builder_new();
    us_cycle_result_to_json(sb, &r);
    var doc = load64(sb);
    var dn = load64(sb + 8);
    var out: UsCycleResult;
    var c0 = test_allocator_alloc_count(ta);
    var t7, v7 = us_cycle_result_from_json_a(ta, doc, dn, &out);
    var total = test_allocator_alloc_count(ta) - c0;
    assert(is_ok(t7) == 1 && total > 0, "the decoder allocates");
    var clean = 1;
    var ooms = 0;
    k = 0;
    while (k < total) {
        test_allocator_fail_after(ta, test_allocator_alloc_count(ta) + k);
        var tj, vj = us_cycle_result_from_json_a(ta, doc, dn, &out);
        var known = 0;
        if (is_err_result(tj) == 1 && vj == US_ERR_OUT_OF_MEMORY) {
            ooms = ooms + 1;
            known = 1;
        }
        if (is_err_result(tj) == 1 && vj == US_ERR_DESERIALIZE) { known = 1; }
        if (known == 0) { clean = 0; }
        k = k + 1;
    }
    test_allocator_fail_after(ta, 0 - 1);
    assert_eq(clean, 1, "the decoder, each of its allocations refused in turn: an Err every time");
    assert_eq(ooms, 5, "its two vecs and the state vec's grow: OutOfMemory");
    var t8, v8 = us_cycle_result_from_json_a(ta, doc, dn, &out);
    assert(is_ok(t8) == 1 && us_cycle_state_count(&out) == 4, "allowed again, the document reads");
    var r3: UsCycleResult;
    var t9, v9 = us_cycle_result_init_a(ta, &r3);
    test_allocator_fail_after(ta, test_allocator_alloc_count(ta));
    var ta1, va1 = us_rankine_cycle(10000.0, 2000000.0, 1, 573.15, &r3);
    errc(ta1, va1, US_ERR_OUT_OF_MEMORY, "Rankine, its first grow refused");
    var rr: UsRefrigerationResult;
    var ta2, va2 = us_refrigeration_result_init_a(ta, &rr);
    errc(ta2, va2, US_ERR_OUT_OF_MEMORY, "a refrigeration result's init refused");
    test_allocator_fail_after(ta, 0 - 1);
    var ta3, va3 = us_refrigeration_result_init_a(ta, &rr);
    test_allocator_fail_after(ta, test_allocator_alloc_count(ta));
    var ta4, va4 = us_refrigeration_cycle(7384.0, 47390.0, &rr);
    errc(ta4, va4, US_ERR_OUT_OF_MEMORY, "refrigeration, its first grow refused");
    test_allocator_fail_after(ta, 0 - 1);
    var ta5, va5 = us_refrigeration_cycle(7384.0, 47390.0, &rr);
    assert(is_ok(ta5) == 1 && us_cycle_state_count(us_refrigeration_result_cycle(&rr)) == 4, "allowed, it fills");
}

# Runs every group and returns the failure count.
fn main() {
    alloc_init();
    test_types();
    test_helpers();
    test_otto();
    test_diesel();
    test_brayton();
    test_rankine();
    test_refrigeration();
    test_nan_inf();
    test_diagrams();
    test_compare();
    test_result_json();
    test_refrigeration_json();
    test_point_and_comparison_json();
    test_reuse_and_spans();
    test_steam_spans();
    test_out_of_memory();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
