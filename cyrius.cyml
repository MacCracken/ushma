[package]
name = "ushma"
version = "${file:VERSION}"
description = "ushma — thermodynamics simulation (heat transfer, entropy, equations of state, phase change, steam, cycles, numerical conduction, chemical and statistical thermodynamics)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/ushma"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/ushma"
dce = true

# Bundles (port plan §3.2, ADR 0001 P5), below:
#   [lib]     every module except the HTTP client (dist/ushma.cyr)
#   [lib.ai]  [lib] + src/ai.cyr, the daimon/hoosh client on sandhi (dist/ushma-ai.cyr)
# Order = dependency order (port plan §4 step 3): constants → error → mathx → fmtf →
# validate → logging → json → material_data → material → transfer → state_data → state →
# entropy → phase_data → phase → steam_data → steam → cycle → chem_data → chem → stat →
# numerical → bridge → soorat (→ ai in [lib.ai]).

[deps]
# Every leaf the library calls (6.6.18 rule). sandhi, sakshi and bayan are folds, so they are
# stdlib leaves, never [deps.x]. sandhi's companions (tls, async, random, fdlopen, dynlib) are
# listed as sandhi's README asks; only [lib.ai]'s src/ai.cyr reaches them.
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "io",
    "vec",
    "slice",
    "math",
    "ganita",
    "tagged",
    "result",
    "boxed",
    "overflow",
    "fnptr",
    "freelist",
    "sakshi",
    "log",
    "bayan",
    "sandhi",
    "tls",
    "async",
    "random",
    "fdlopen",
    "dynlib",
]

# hisab — calc_lerp (steam) and calc_integral_simpson (stat). A production dependency because
# bundled modules call it (ADR 0001, Consequences).
# ⚠ hisab 3.4.1 also declares a [deps.sakshi] package that its bundle never calls. With sakshi
# a stdlib leaf here, `cyrius deps` warns "refusing to overwrite stdlib leaf 'sakshi'". The
# stdlib copy wins and the two are byte-identical at sakshi 2.5.10. Only hisab can retire the
# warning (port plan §2.7, §8).
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.4.1"
modules = ["dist/hisab.cyr"]

# The physics bundle, dist/ushma.cyr, in dependency order (M1 onward; each module joins at its milestone).
[lib]
modules = [
    "src/constants.cyr",
    "src/constants_private.cyr",
    "src/error.cyr",
    "src/mathx_data.cyr",
    "src/mathx.cyr",
    "src/fmtf.cyr",
    "src/validate.cyr",
    "src/logging.cyr",
    "src/json.cyr",
    "src/material_data.cyr",
    "src/material.cyr",
    "src/transfer.cyr",
    "src/state_data.cyr",
    "src/state.cyr",
    "src/entropy.cyr",
    "src/phase_data.cyr",
    "src/phase.cyr",
    "src/chem_data.cyr",
    "src/steam_data.cyr",
    "src/steam.cyr",
    "src/cycle.cyr",
    "src/chem.cyr",
    "src/stat.cyr",
]

# The physics bundle plus the daimon client (src/ai.cyr from M7, on sandhi): dist/ushma-ai.cyr. Until M7 it holds
# the same modules as [lib].
[lib.ai]
modules = [
    "src/constants.cyr",
    "src/constants_private.cyr",
    "src/error.cyr",
    "src/mathx_data.cyr",
    "src/mathx.cyr",
    "src/fmtf.cyr",
    "src/validate.cyr",
    "src/logging.cyr",
    "src/json.cyr",
    "src/material_data.cyr",
    "src/material.cyr",
    "src/transfer.cyr",
    "src/state_data.cyr",
    "src/state.cyr",
    "src/entropy.cyr",
    "src/phase_data.cyr",
    "src/phase.cyr",
    "src/chem_data.cyr",
    "src/steam_data.cyr",
    "src/steam.cyr",
    "src/cycle.cyr",
    "src/chem.cyr",
    "src/stat.cyr",
]

[test]
stdlib = ["assert", "bench"]
