# cycle.cyr — thermodynamic cycles (Rust 1.4.0 `cycle`): the ideal-gas process heats and works; the Otto, Diesel and
# Brayton cycles; the Rankine and vapor-compression refrigeration cycles on the steam tables (src/steam.cyr); the
# heat-pump COP; the comparison of cycles with their Carnot limits; and the T-s and P-v diagrams. All SI: kelvins,
# pascals, joules, moles; the ideal-gas cycles use the calorically perfect gas, and the steam cycles work per kilogram
# of water.
#
# Each function computes in the order Rust 1.4.0 writes, so its arithmetic is bit-identical (class B), and its ln, exp
# and pow are correctly rounded (ADR 0004, class C). A refusal returns Err(US_ERR_*) and reports its value at DEBUG
# (src/validate.cyr); a steam-table refusal inside a steam cycle is returned as Rust's `?` returns it. The five
# cycles open a DEBUG span under Rust's span name.
#
# A process is a UsProcess code and a cycle kind a UsCycle code (Rust's variant order; append-only). A state point is
# a UsStatePoint. A cycle's result is a UsCycleResult that the caller owns and the analyses fill: its state points
# and processes are two stdlib vecs (five f64 words per point, flat, and the process codes) that grow on the
# allocator the result was made with and are overwritten in place on every call, so a result reused across calls
# allocates nothing after its first (ADR 0002 row 10). us_cycle_result_init makes one; us_cycle_state /
# us_cycle_process read it, us_cycle_push_state / us_cycle_push_process build one by hand. A refused analysis leaves
# the result unchanged; a refused allocation is Err(US_ERR_OUT_OF_MEMORY), where Rust would abort the process. A
# diagram is a list of UsDiagramPoint records written into the caller's buffer, and a comparison a list of
# UsCycleComparison records into the caller's (ADR 0002 row 12). JSON
# is serde_json's: the enums as their variant names, the structs as their documents (ADR 0005; src/json.cyr has the
# rules).

enum UsProcess {
    US_PROCESS_ISENTROPIC = 0;
    US_PROCESS_ISOCHORIC = 1;
    US_PROCESS_ISOBARIC = 2;
    US_PROCESS_ISOTHERMAL = 3;
    US_PROCESS_ISENTHALPIC = 4;
}

# The number of process kinds.
const US_PROCESS_COUNT = 5;

enum UsCycle {
    US_CYCLE_OTTO = 0;
    US_CYCLE_DIESEL = 1;
    US_CYCLE_BRAYTON = 2;
    US_CYCLE_RANKINE = 3;
    US_CYCLE_REFRIGERATION = 4;
}

# The number of cycle kinds.
const US_CYCLE_COUNT = 5;

struct UsStatePoint {
    temperature: f64;
    pressure: f64;
    volume: f64;
    entropy: f64;
    enthalpy: f64;
}

struct UsCycleResult {
    kind;
    alloc;
    states;
    processes;
    heat_in: f64;
    heat_out: f64;
    net_work: f64;
    efficiency: f64;
    back_work_ratio: f64;
    gamma: f64;
}

# A point of a T-s or P-v diagram.
struct UsDiagramPoint {
    x: f64;
    y: f64;
}

# One cycle against its Carnot limit (Rust's CycleComparisonEntry).
struct UsCycleComparison {
    kind;
    efficiency: f64;
    net_work: f64;
    back_work_ratio: f64;
    carnot_efficiency: f64;
    second_law_efficiency: f64;
}

# A refrigeration cycle's result: its cycle (the first field, so a *UsRefrigerationResult is also the address of its
# UsCycleResult: us_refrigeration_result_cycle) and its two coefficients of performance.
struct UsRefrigerationResult {
    cycle: UsCycleResult;
    cop_refrigeration: f64;
    cop_heat_pump: f64;
}

# The byte offset of a UsCycleResult's six numbers (heat_in … gamma), after its kind, allocator and two vecs. Add it
# to an untyped address: `p + n` on a `*UsCycleResult` steps n results, not n bytes.
const _US_CR_NUMS = 32;

# --- Names ---

# The Rust name of process `k` ("Isentropic" …), or 0 when `k` is no process.
#must_use
#pure
fn us_process_name(k): cstring {
    match k {
        US_PROCESS_ISENTROPIC => { return "Isentropic"; }
        US_PROCESS_ISOCHORIC => { return "Isochoric"; }
        US_PROCESS_ISOBARIC => { return "Isobaric"; }
        US_PROCESS_ISOTHERMAL => { return "Isothermal"; }
        US_PROCESS_ISENTHALPIC => { return "Isenthalpic"; }
        _ => { return 0; }
    }
    return 0;
}

# The Rust name of cycle kind `k` ("Otto" …), or 0 when `k` is no cycle kind.
#must_use
#pure
fn us_cycle_name(k): cstring {
    match k {
        US_CYCLE_OTTO => { return "Otto"; }
        US_CYCLE_DIESEL => { return "Diesel"; }
        US_CYCLE_BRAYTON => { return "Brayton"; }
        US_CYCLE_RANKINE => { return "Rankine"; }
        US_CYCLE_REFRIGERATION => { return "Refrigeration"; }
        _ => { return 0; }
    }
    return 0;
}

# --- The cycle result ---

# Makes *r an empty result (no state points, no processes, every number 0) whose two vecs grow on the global heap:
# Ok(0), or Err(US_ERR_OUT_OF_MEMORY) when a vec was refused (*r is then not usable).
#must_use
fn us_cycle_result_init(r: *UsCycleResult): Result {
    return us_cycle_result_init_a(default_alloc(), r);
}

# us_cycle_result_init with the vecs on allocator `a`, which *r keeps and grows them on.
#must_use
fn us_cycle_result_init_a(a, r: *UsCycleResult): Result {
    r.kind = US_CYCLE_OTTO;
    r.alloc = a;
    r.states = vec_new_a(a);
    r.processes = vec_new_a(a);
    r.heat_in = 0.0;
    r.heat_out = 0.0;
    r.net_work = 0.0;
    r.efficiency = 0.0;
    r.back_work_ratio = 0.0;
    r.gamma = 0.0;
    if (r.states == 0 || r.processes == 0) { return Err(_us_fail(US_ERR_OUT_OF_MEMORY, "us_cycle_result_init")); }
    return Ok(0);
}

# Makes *rr an empty refrigeration result (its cycle as us_cycle_result_init makes one, both COPs 0), its vecs on the
# global heap: Ok(0), or Err(US_ERR_OUT_OF_MEMORY) (*rr is then not usable).
#must_use
fn us_refrigeration_result_init(rr: *UsRefrigerationResult): Result {
    return us_refrigeration_result_init_a(default_alloc(), rr);
}

# us_refrigeration_result_init with the cycle's vecs on allocator `a`.
#must_use
fn us_refrigeration_result_init_a(a, rr: *UsRefrigerationResult): Result {
    rr.cop_refrigeration = 0.0;
    rr.cop_heat_pump = 0.0;
    return us_cycle_result_init_a(a, us_refrigeration_result_cycle(rr));
}

# The address of *rr's cycle, for the UsCycleResult accessors (`&rr.cycle` is no Cyrius expression; the cycle is the
# struct's first field, so it is *rr's own address).
#must_use
fn us_refrigeration_result_cycle(rr: *UsRefrigerationResult): *UsCycleResult {
    var c = rr;
    return c;
}

# The number of state points in *r.
#must_use
fn us_cycle_state_count(r: *UsCycleResult): i64 {
    return vec_len(r.states) / 5;
}

# Copies state point `i` of *r into *out: 1, or 0 when there is none.
fn us_cycle_state(r: *UsCycleResult, i, out: *UsStatePoint): i64 {
    if (i < 0 || i >= us_cycle_state_count(r)) { return 0; }
    var o = out;
    var k = 0;
    while (k < 5) {
        store64(o + (8 * k), vec_get(r.states, 5 * i + k));
        k = k + 1;
    }
    return 1;
}

# Appends state point *sp to *r: Ok(0), or Err(US_ERR_OUT_OF_MEMORY) when a grow was refused (*r is then unchanged).
#must_use
fn us_cycle_push_state(r: *UsCycleResult, sp: *UsStatePoint): Result {
    var n = vec_len(r.states);
    var q = sp;
    var k = 0;
    while (k < 5) {
        if (vec_push_a(r.alloc, r.states, load64(q + (8 * k))) < 0) {
            vec_truncate(r.states, n);
            return Err(_us_fail(US_ERR_OUT_OF_MEMORY, "us_cycle_push_state"));
        }
        k = k + 1;
    }
    return Ok(0);
}

# The number of processes in *r.
#must_use
fn us_cycle_process_count(r: *UsCycleResult): i64 {
    return vec_len(r.processes);
}

# Process `i` of *r (a US_PROCESS_* code), or -1 when there is none.
#must_use
fn us_cycle_process(r: *UsCycleResult, i): i64 {
    if (i < 0 || i >= vec_len(r.processes)) { return 0 - 1; }
    return vec_get(r.processes, i);
}

# Appends process `kind` to *r: Ok(0), Err(US_ERR_INVALID_PARAMETER) unless `kind` is a US_PROCESS_* code (Rust's
# enum holds no other value, and no other would read back from JSON), or Err(US_ERR_OUT_OF_MEMORY) when a grow was
# refused. *r is unchanged on a refusal.
#must_use
fn us_cycle_push_process(r: *UsCycleResult, kind): Result {
    if (kind < 0 || kind >= US_PROCESS_COUNT) {
        var kf: f64 = f64_from(kind);
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_cycle_push_process", "kind", kf));
    }
    if (vec_push_a(r.alloc, r.processes, kind) < 0) {
        return Err(_us_fail(US_ERR_OUT_OF_MEMORY, "us_cycle_push_process"));
    }
    return Ok(0);
}

# Sizes vec `v` to `n` words, growing it on allocator `a` (new words 0): 1, or 0 when a grow was refused (`v` is then
# empty). A vec that holds n words or more already, as a reused result's do, is only truncated.
fn _us_vec_size(a, v, n): i64 {
    if (vec_len(v) >= n) {
        vec_truncate(v, n);
        return 1;
    }
    while (vec_len(v) < n) {
        if (vec_push_a(a, v, 0) < 0) {
            vec_truncate(v, 0);
            return 0;
        }
    }
    return 1;
}

# Readies *r for a four-state cycle of kind `kind` and processes p0 … p3: sizes its state vec to 20 words, for the
# caller to store the four points into in place (_us_sp_store), and fills its processes. The state words' address, or
# 0 when a grow was refused (*r then has no state points or processes).
fn _us_cycle_begin(r: *UsCycleResult, kind, p0, p1, p2, p3): i64 {
    var ok = _us_vec_size(r.alloc, r.states, 20);
    if (ok == 1) { ok = _us_vec_size(r.alloc, r.processes, 4); }
    if (ok == 0) {
        vec_truncate(r.states, 0);
        vec_truncate(r.processes, 0);
        return 0;
    }
    var pp = slice_ptr(r.processes);
    store64(pp, p0);
    store64(pp + 8, p1);
    store64(pp + 16, p2);
    store64(pp + 24, p3);
    r.kind = kind;
    return slice_ptr(r.states);
}

# Sets *r's six numbers.
fn _us_cycle_nums(r: *UsCycleResult, q_in: f64, q_out: f64, w: f64, eff: f64, bwr: f64, gamma: f64) {
    r.heat_in = q_in;
    r.heat_out = q_out;
    r.net_work = w;
    r.efficiency = eff;
    r.back_work_ratio = bwr;
    r.gamma = gamma;
    return 0;
}

# Stores state point i (T, P, V, S, H) into the state words at `st`.
fn _us_sp_store(st, i, t: f64, p: f64, v: f64, s: f64, h: f64) {
    var at = st + (40 * i);
    store64(at, t);
    store64(at + 8, p);
    store64(at + 16, v);
    store64(at + 24, s);
    store64(at + 32, h);
    return 0;
}

# --- Ideal-gas process heats and works ---

# Heat at constant volume, Q = n·C_v·(T₂ − T₁) (J).
#must_use
#pure
fn us_isochoric_heat(moles: f64, cv: f64, t1: f64, t2: f64): f64 {
    var q: f64 = moles * cv * (t2 - t1);
    return q;
}

# Heat at constant pressure, Q = n·C_p·(T₂ − T₁) (J).
#must_use
#pure
fn us_isobaric_heat(moles: f64, cp: f64, t1: f64, t2: f64): f64 {
    var q: f64 = moles * cp * (t2 - t1);
    return q;
}

# Work of an adiabatic process, W = n·C_v·(T₁ − T₂) (J): positive for an expansion, negative for a compression.
#must_use
#pure
fn us_adiabatic_work(moles: f64, cv: f64, t1: f64, t2: f64): f64 {
    var w: f64 = moles * cv * (t1 - t2);
    return w;
}

# The isentropic temperature after a pressure change, T₂ = T₁·(P₂/P₁)^((γ−1)/γ) (K). Err(US_ERR_INVALID_TEMPERATURE)
# unless T₁ > 0, Err(US_ERR_INVALID_PRESSURE) unless P₁ > 0 and P₂ > 0, Err(US_ERR_INVALID_PARAMETER) unless γ > 1.
#must_use
fn us_adiabatic_temp_from_pressure(t1: f64, p1: f64, p2: f64, gamma: f64): Result {
    if (_us_finite_gt(t1, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_adiabatic_temp_from_pressure", "t1", t1));
    }
    if (_us_finite_gt(p1, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_adiabatic_temp_from_pressure", "p1", p1));
    }
    if (_us_finite_gt(p2, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_adiabatic_temp_from_pressure", "p2", p2));
    }
    if (_us_finite_gt(gamma, 1.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_adiabatic_temp_from_pressure", "gamma", gamma));
    }
    var e: f64 = (gamma - 1.0) / gamma;
    var pw: f64 = _us_cr_pow(p2 / p1, e);
    var t2: f64 = t1 * pw;
    return Ok(t2);
}

# The checks the three ideal-gas cycles share, after their own: γ > 1 and n > 0, Err(US_ERR_INVALID_PARAMETER)
# reported by `fname`, or 0.
fn _us_gas_check(gamma: f64, moles: f64, fname): i64 {
    if (_us_finite_gt(gamma, 1.0) == 0) { return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, "gamma", gamma); }
    if (_us_finite_gt(moles, 0.0) == 0) { return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, "moles", moles); }
    return 0;
}

# --- The ideal-gas cycles ---

# Fills *r with the Otto cycle (a spark-ignition engine) on n mol of ideal gas: 1→2 isentropic compression by
# r = V₁/V₂, 2→3 isochoric heat addition of `heat_in` J/mol, 3→4 isentropic expansion, 4→1 isochoric rejection.
# Entropies are relative to state 1, enthalpies n·C_p·T. Ok(0), or Err(US_ERR_INVALID_TEMPERATURE) unless T₁ > 0,
# Err(US_ERR_INVALID_PRESSURE) unless P₁ > 0, Err(US_ERR_INVALID_COMPRESSION_RATIO) unless r > 1,
# Err(US_ERR_INVALID_PARAMETER) unless γ > 1, n > 0 and heat_in > 0, Err(US_ERR_OUT_OF_MEMORY) when *r's vecs
# could not grow.
#must_use
fn us_otto_cycle(t1: f64, p1: f64, compression_ratio: f64, heat_in: f64, gamma: f64, moles: f64,
  r: *UsCycleResult): Result {
    _us_span_enter("otto_cycle", 10);
    if (_us_finite_gt(t1, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_otto_cycle", "t1", t1));
    }
    if (_us_finite_gt(p1, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_otto_cycle", "p1", p1));
    }
    if (_us_finite_gt(compression_ratio, 1.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_COMPRESSION_RATIO, "us_otto_cycle", "compression_ratio",
            compression_ratio));
    }
    var code = _us_gas_check(gamma, moles, "us_otto_cycle");
    if (code != 0) {
        _us_span_exit();
        return Err(code);
    }
    if (_us_finite_gt(heat_in, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_otto_cycle", "heat_in", heat_in));
    }
    var rr: f64 = compression_ratio;
    var cv: f64 = US_GAS_CONSTANT / (gamma - 1.0);
    var cp: f64 = gamma * cv;
    var n: f64 = moles;
    var v1: f64 = n * US_GAS_CONSTANT * t1 / p1;
    var v2: f64 = v1 / rr;
    var pr: f64 = _us_cr_pow(rr, gamma - 1.0);
    var t2: f64 = t1 * pr;
    var p2: f64 = n * US_GAS_CONSTANT * t2 / v2;
    var v3: f64 = v2;
    var q_in: f64 = heat_in * n;
    var t3: f64 = t2 + q_in / (n * cv);
    var p3: f64 = n * US_GAS_CONSTANT * t3 / v3;
    var v4: f64 = v1;
    var pr4: f64 = _us_cr_pow(1.0 / rr, gamma - 1.0);
    var t4: f64 = t3 * pr4;
    var p4: f64 = n * US_GAS_CONSTANT * t4 / v4;
    var q_out: f64 = n * cv * (t4 - t1);
    var w: f64 = q_in - q_out;
    var eff: f64 = w / q_in;
    var s1: f64 = 0.0;
    var s2: f64 = s1;
    var lt: f64 = _us_cr_ln(t3 / t2);
    var s3: f64 = s2 + n * cv * lt;
    var s4: f64 = s3;
    var st = _us_cycle_begin(r, US_CYCLE_OTTO, US_PROCESS_ISENTROPIC, US_PROCESS_ISOCHORIC, US_PROCESS_ISENTROPIC,
      US_PROCESS_ISOCHORIC);
    if (st == 0) {
        _us_span_exit();
        return Err(_us_fail(US_ERR_OUT_OF_MEMORY, "us_otto_cycle"));
    }
    _us_sp_store(st, 0, t1, p1, v1, s1, n * cp * t1);
    _us_sp_store(st, 1, t2, p2, v2, s2, n * cp * t2);
    _us_sp_store(st, 2, t3, p3, v3, s3, n * cp * t3);
    _us_sp_store(st, 3, t4, p4, v4, s4, n * cp * t4);
    _us_cycle_nums(r, q_in, q_out, w, eff, 0.0, gamma);
    _us_span_exit();
    return Ok(0);
}

# Fills *r with the Diesel cycle (a compression-ignition engine): 1→2 isentropic compression by r, 2→3 isobaric heat
# addition to the cutoff ratio r_c = V₃/V₂, 3→4 isentropic expansion, 4→1 isochoric rejection. Ok(0), or
# Err(US_ERR_INVALID_TEMPERATURE) unless T₁ > 0, Err(US_ERR_INVALID_PRESSURE) unless P₁ > 0,
# Err(US_ERR_INVALID_COMPRESSION_RATIO) unless r > 1, Err(US_ERR_INVALID_CUTOFF_RATIO) unless r_c > 1,
# Err(US_ERR_INVALID_CYCLE_PARAMETER) unless r_c < r, Err(US_ERR_INVALID_PARAMETER) unless γ > 1 and n > 0,
# Err(US_ERR_OUT_OF_MEMORY) when *r's vecs could not grow.
#must_use
fn us_diesel_cycle(t1: f64, p1: f64, compression_ratio: f64, cutoff_ratio: f64, gamma: f64, moles: f64,
  r: *UsCycleResult): Result {
    _us_span_enter("diesel_cycle", 12);
    if (_us_finite_gt(t1, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_diesel_cycle", "t1", t1));
    }
    if (_us_finite_gt(p1, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_diesel_cycle", "p1", p1));
    }
    if (_us_finite_gt(compression_ratio, 1.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_COMPRESSION_RATIO, "us_diesel_cycle", "compression_ratio",
            compression_ratio));
    }
    if (_us_finite_gt(cutoff_ratio, 1.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_CUTOFF_RATIO, "us_diesel_cycle", "cutoff_ratio", cutoff_ratio));
    }
    if (cutoff_ratio >= compression_ratio) {
        _us_span_exit();
        return Err(_us_fail_ff(US_ERR_INVALID_CYCLE_PARAMETER, "us_diesel_cycle", "cutoff >= compression", "rc",
            cutoff_ratio, "r", compression_ratio));
    }
    var code = _us_gas_check(gamma, moles, "us_diesel_cycle");
    if (code != 0) {
        _us_span_exit();
        return Err(code);
    }
    var rr: f64 = compression_ratio;
    var rc: f64 = cutoff_ratio;
    var cv: f64 = US_GAS_CONSTANT / (gamma - 1.0);
    var cp: f64 = gamma * cv;
    var n: f64 = moles;
    var v1: f64 = n * US_GAS_CONSTANT * t1 / p1;
    var v2: f64 = v1 / rr;
    var pr: f64 = _us_cr_pow(rr, gamma - 1.0);
    var t2: f64 = t1 * pr;
    var p2: f64 = n * US_GAS_CONSTANT * t2 / v2;
    var p3: f64 = p2;
    var v3: f64 = v2 * rc;
    var t3: f64 = t2 * rc;
    var v4: f64 = v1;
    var pr4: f64 = _us_cr_pow(v3 / v4, gamma - 1.0);
    var t4: f64 = t3 * pr4;
    var p4: f64 = n * US_GAS_CONSTANT * t4 / v4;
    var q_in: f64 = n * cp * (t3 - t2);
    var q_out: f64 = n * cv * (t4 - t1);
    var w: f64 = q_in - q_out;
    var eff: f64 = w / q_in;
    var s1: f64 = 0.0;
    var s2: f64 = s1;
    var lt: f64 = _us_cr_ln(t3 / t2);
    var s3: f64 = s2 + n * cp * lt;
    var s4: f64 = s3;
    var st = _us_cycle_begin(r, US_CYCLE_DIESEL, US_PROCESS_ISENTROPIC, US_PROCESS_ISOBARIC, US_PROCESS_ISENTROPIC,
      US_PROCESS_ISOCHORIC);
    if (st == 0) {
        _us_span_exit();
        return Err(_us_fail(US_ERR_OUT_OF_MEMORY, "us_diesel_cycle"));
    }
    _us_sp_store(st, 0, t1, p1, v1, s1, n * cp * t1);
    _us_sp_store(st, 1, t2, p2, v2, s2, n * cp * t2);
    _us_sp_store(st, 2, t3, p3, v3, s3, n * cp * t3);
    _us_sp_store(st, 3, t4, p4, v4, s4, n * cp * t4);
    _us_cycle_nums(r, q_in, q_out, w, eff, 0.0, gamma);
    _us_span_exit();
    return Ok(0);
}

# Fills *r with the Brayton cycle (a gas turbine): 1→2 isentropic compression by r_p = P₂/P₁, 2→3 isobaric heat
# addition to the turbine inlet T₃, 3→4 isentropic expansion, 4→1 isobaric rejection; its back-work ratio is
# W_compressor / W_turbine. Ok(0), or Err(US_ERR_INVALID_TEMPERATURE) unless T₁ > 0 and T₃ > 0,
# Err(US_ERR_INVALID_PRESSURE) unless P₁ > 0, Err(US_ERR_INVALID_PRESSURE_RATIO) unless r_p > 1,
# Err(US_ERR_INVALID_PARAMETER) unless γ > 1 and n > 0, Err(US_ERR_INVALID_CYCLE_PARAMETER) unless T₃ > T₂,
# Err(US_ERR_OUT_OF_MEMORY) when *r's vecs could not grow.
#must_use
fn us_brayton_cycle(t1: f64, p1: f64, pressure_ratio: f64, t3: f64, gamma: f64, moles: f64,
  r: *UsCycleResult): Result {
    _us_span_enter("brayton_cycle", 13);
    if (_us_finite_gt(t1, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_brayton_cycle", "t1", t1));
    }
    if (_us_finite_gt(p1, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_brayton_cycle", "p1", p1));
    }
    if (_us_finite_gt(t3, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_brayton_cycle", "t3", t3));
    }
    if (_us_finite_gt(pressure_ratio, 1.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE_RATIO, "us_brayton_cycle", "pressure_ratio", pressure_ratio));
    }
    var code = _us_gas_check(gamma, moles, "us_brayton_cycle");
    if (code != 0) {
        _us_span_exit();
        return Err(code);
    }
    var rp: f64 = pressure_ratio;
    var cv: f64 = US_GAS_CONSTANT / (gamma - 1.0);
    var cp: f64 = gamma * cv;
    var n: f64 = moles;
    var e: f64 = (gamma - 1.0) / gamma;
    var v1: f64 = n * US_GAS_CONSTANT * t1 / p1;
    var p2: f64 = p1 * rp;
    var pr: f64 = _us_cr_pow(rp, e);
    var t2: f64 = t1 * pr;
    var v2: f64 = n * US_GAS_CONSTANT * t2 / p2;
    if (_us_finite_gt(t3, t2) == 0) {
        _us_span_exit();
        return Err(_us_fail_ff(US_ERR_INVALID_CYCLE_PARAMETER, "us_brayton_cycle", "T3 <= T2", "t3", t3, "t2", t2));
    }
    var p3: f64 = p2;
    var v3: f64 = n * US_GAS_CONSTANT * t3 / p3;
    var p4: f64 = p1;
    var pr4: f64 = _us_cr_pow(1.0 / rp, e);
    var t4: f64 = t3 * pr4;
    var v4: f64 = n * US_GAS_CONSTANT * t4 / p4;
    var q_in: f64 = n * cp * (t3 - t2);
    var q_out: f64 = n * cp * (t4 - t1);
    var w: f64 = q_in - q_out;
    var eff: f64 = w / q_in;
    var w_c: f64 = n * cp * (t2 - t1);
    var w_t: f64 = n * cp * (t3 - t4);
    var bwr: f64 = w_c / w_t;
    var s1: f64 = 0.0;
    var s2: f64 = s1;
    var lt: f64 = _us_cr_ln(t3 / t2);
    var s3: f64 = s2 + n * cp * lt;
    var s4: f64 = s3;
    var st = _us_cycle_begin(r, US_CYCLE_BRAYTON, US_PROCESS_ISENTROPIC, US_PROCESS_ISOBARIC, US_PROCESS_ISENTROPIC,
      US_PROCESS_ISOBARIC);
    if (st == 0) {
        _us_span_exit();
        return Err(_us_fail(US_ERR_OUT_OF_MEMORY, "us_brayton_cycle"));
    }
    _us_sp_store(st, 0, t1, p1, v1, s1, n * cp * t1);
    _us_sp_store(st, 1, t2, p2, v2, s2, n * cp * t2);
    _us_sp_store(st, 2, t3, p3, v3, s3, n * cp * t3);
    _us_sp_store(st, 3, t4, p4, v4, s4, n * cp * t4);
    _us_cycle_nums(r, q_in, q_out, w, eff, bwr, gamma);
    _us_span_exit();
    return Ok(0);
}

# --- The steam cycles ---

# Fills *r with the Rankine cycle (a steam power plant) per kilogram of water: 1→2 isentropic pumping of the condenser's
# saturated liquid to the boiler pressure (incompressible: w = v_f·ΔP, T and v unchanged), 2→3 isobaric heating to
# saturated vapor, or with `superheated` 1 to the superheated state at `t_superheat` K (Rust's `Option<f64>`, ADR
# 0002 row 11: `superheated` 0 is None, and `t_superheat` is then unread), 3→4 isentropic expansion to the condenser
# pressure (into the wet region, or superheated where s₃ > s_g there), 4→1 isobaric condensation. Ok(0), or
# Err(US_ERR_INVALID_PRESSURE) unless both pressures are > 0, Err(US_ERR_INVALID_CYCLE_PARAMETER) unless the boiler's
# is the higher, a steam lookup's refusal (US_ERR_STEAM_TABLE_OUT_OF_RANGE, US_ERR_SUPERHEAT_OUT_OF_RANGE,
# US_ERR_INVALID_TEMPERATURE, US_ERR_INVALID_QUALITY, …), or Err(US_ERR_OUT_OF_MEMORY) when *r's vecs could not grow.
#must_use
fn us_rankine_cycle(p_condenser: f64, p_boiler: f64, superheated, t_superheat: f64, r: *UsCycleResult): Result {
    _us_span_enter("rankine_cycle", 13);
    if (_us_finite_gt(p_condenser, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_rankine_cycle", "p_condenser", p_condenser));
    }
    if (_us_finite_gt(p_boiler, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_rankine_cycle", "p_boiler", p_boiler));
    }
    if (_us_finite_gt(p_boiler, p_condenser) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_CYCLE_PARAMETER, "us_rankine_cycle", "p_boiler", p_boiler));
    }
    var sc: UsSaturated;
    var tc, vc = us_saturated_by_pressure(p_condenser, &sc);
    if (is_err_result(tc) == 1) {
        _us_span_exit();
        return Err(vc);
    }
    var h1: f64 = sc.h_f;
    var s1: f64 = sc.s_f;
    var v1: f64 = sc.v_f;
    var t1: f64 = sc.temperature;
    var w_pump: f64 = v1 * (p_boiler - p_condenser);
    var h2: f64 = h1 + w_pump;
    var h3: f64 = 0.0;
    var s3: f64 = 0.0;
    var t3: f64 = 0.0;
    var v3: f64 = 0.0;
    if (superheated != 0) {
        var sh: UsSuperheated;
        var tsh, vsh = us_superheated_lookup(t_superheat, p_boiler, &sh);
        if (is_err_result(tsh) == 1) {
            _us_span_exit();
            return Err(vsh);
        }
        h3 = sh.specific_enthalpy;
        s3 = sh.specific_entropy;
        t3 = sh.temperature;
        v3 = sh.specific_volume;
    } else {
        var sb: UsSaturated;
        var tb, vb = us_saturated_by_pressure(p_boiler, &sb);
        if (is_err_result(tb) == 1) {
            _us_span_exit();
            return Err(vb);
        }
        h3 = sb.h_g;
        s3 = sb.s_g;
        t3 = sb.temperature;
        v3 = sb.v_g;
    }
    var s4: f64 = s3;
    var sg: f64 = sc.s_g;
    var h4: f64 = 0.0;
    var t4: f64 = 0.0;
    var v4: f64 = 0.0;
    if (s4 <= sg) {
        var tq, vq = us_quality_from_entropy(s4, &sc);
        if (is_err_result(tq) == 1) {
            _us_span_exit();
            return Err(vq);
        }
        var x4: f64 = vq;
        var w: UsWetSteam;
        var tw, vw = us_wet_steam_properties(x4, &sc, &w);
        if (is_err_result(tw) == 1) {
            _us_span_exit();
            return Err(vw);
        }
        h4 = w.specific_enthalpy;
        t4 = sc.temperature;
        v4 = w.specific_volume;
    } else {
        var sh4: UsSuperheated;
        var t5, v5 = us_superheated_by_entropy(p_condenser, s4, &sh4);
        if (is_err_result(t5) == 1) {
            _us_span_exit();
            return Err(v5);
        }
        h4 = sh4.specific_enthalpy;
        t4 = sh4.temperature;
        v4 = sh4.specific_volume;
    }
    var q_in: f64 = h3 - h2;
    var w_turbine: f64 = h3 - h4;
    var q_out: f64 = h4 - h1;
    var w_net: f64 = w_turbine - w_pump;
    var eff: f64 = w_net / q_in;
    var bwr: f64 = w_pump / w_turbine;
    var st = _us_cycle_begin(r, US_CYCLE_RANKINE, US_PROCESS_ISENTROPIC, US_PROCESS_ISOBARIC, US_PROCESS_ISENTROPIC,
      US_PROCESS_ISOBARIC);
    if (st == 0) {
        _us_span_exit();
        return Err(_us_fail(US_ERR_OUT_OF_MEMORY, "us_rankine_cycle"));
    }
    _us_sp_store(st, 0, t1, p_condenser, v1, s1, h1);
    _us_sp_store(st, 1, t1, p_boiler, v1, s1, h2);
    _us_sp_store(st, 2, t3, p_boiler, v3, s3, h3);
    _us_sp_store(st, 3, t4, p_condenser, v4, s4, h4);
    _us_cycle_nums(r, q_in, q_out, w_net, eff, bwr, 0.0);
    _us_span_exit();
    return Ok(0);
}

# Fills *out with the vapor-compression refrigeration cycle on water per kilogram: 1→2 isentropic compression of the
# evaporator's saturated vapor to the condenser pressure (its exit found by entropy in the superheated table), 2→3
# isobaric rejection to saturated liquid, 3→4 isenthalpic throttling back to the evaporator, 4→1 isobaric absorption.
# Its cycle's heat_in is Q_cold, heat_out Q_hot, net_work −W (work consumed), efficiency COP_ref, back_work_ratio 1 (no
# expander) and gamma 0; COP_ref = Q_cold / W and COP_hp = Q_hot / W. Ok(0), or Err(US_ERR_INVALID_PRESSURE) unless
# both pressures are > 0, Err(US_ERR_INVALID_CYCLE_PARAMETER) unless the condenser's is the higher, a steam lookup's
# refusal (the compressor exit off the superheated table is Err(US_ERR_SUPERHEAT_OUT_OF_RANGE)), or
# Err(US_ERR_OUT_OF_MEMORY) when the cycle's vecs could not grow.
#must_use
fn us_refrigeration_cycle(p_evaporator: f64, p_condenser: f64, out: *UsRefrigerationResult): Result {
    _us_span_enter("refrigeration_cycle", 19);
    if (_us_finite_gt(p_evaporator, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_refrigeration_cycle", "p_evaporator", p_evaporator));
    }
    if (_us_finite_gt(p_condenser, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_refrigeration_cycle", "p_condenser", p_condenser));
    }
    if (_us_finite_gt(p_condenser, p_evaporator) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_CYCLE_PARAMETER, "us_refrigeration_cycle", "p_condenser", p_condenser));
    }
    var se: UsSaturated;
    var te, ve = us_saturated_by_pressure(p_evaporator, &se);
    if (is_err_result(te) == 1) {
        _us_span_exit();
        return Err(ve);
    }
    var sc: UsSaturated;
    var tc, vc = us_saturated_by_pressure(p_condenser, &sc);
    if (is_err_result(tc) == 1) {
        _us_span_exit();
        return Err(vc);
    }
    var h1: f64 = se.h_g;
    var s1: f64 = se.s_g;
    var t1: f64 = se.temperature;
    var v1: f64 = se.v_g;
    var sh2: UsSuperheated;
    var t2r, v2r = us_superheated_by_entropy(p_condenser, s1, &sh2);
    if (is_err_result(t2r) == 1) {
        _us_span_exit();
        return Err(v2r);
    }
    var t2: f64 = sh2.temperature;
    var h2: f64 = sh2.specific_enthalpy;
    var v2: f64 = sh2.specific_volume;
    var h3: f64 = sc.h_f;
    var s3: f64 = sc.s_f;
    var t3: f64 = sc.temperature;
    var v3: f64 = sc.v_f;
    var h4: f64 = h3;
    var tq, vq = us_quality_from_enthalpy(h4, &se);
    if (is_err_result(tq) == 1) {
        _us_span_exit();
        return Err(vq);
    }
    var x4: f64 = vq;
    var w4: UsWetSteam;
    var tw, vw = us_wet_steam_properties(x4, &se, &w4);
    if (is_err_result(tw) == 1) {
        _us_span_exit();
        return Err(vw);
    }
    var t4: f64 = se.temperature;
    var v4: f64 = w4.specific_volume;
    var s4: f64 = w4.specific_entropy;
    var q_evap: f64 = h1 - h4;
    var q_cond: f64 = h2 - h3;
    var w_comp: f64 = h2 - h1;
    var cop_ref: f64 = q_evap / w_comp;
    var cop_hp: f64 = q_cond / w_comp;
    var c = us_refrigeration_result_cycle(out);
    var st = _us_cycle_begin(c, US_CYCLE_REFRIGERATION, US_PROCESS_ISENTROPIC, US_PROCESS_ISOBARIC,
      US_PROCESS_ISENTHALPIC, US_PROCESS_ISOBARIC);
    if (st == 0) {
        _us_span_exit();
        return Err(_us_fail(US_ERR_OUT_OF_MEMORY, "us_refrigeration_cycle"));
    }
    _us_sp_store(st, 0, t1, p_evaporator, v1, s1, h1);
    _us_sp_store(st, 1, t2, p_condenser, v2, s1, h2);
    _us_sp_store(st, 2, t3, p_condenser, v3, s3, h3);
    _us_sp_store(st, 3, t4, p_evaporator, v4, s4, h4);
    var neg_w: f64 = _us_neg(w_comp);
    _us_cycle_nums(c, q_evap, q_cond, neg_w, cop_ref, 1.0, 0.0);
    out.cop_refrigeration = cop_ref;
    out.cop_heat_pump = cop_hp;
    _us_span_exit();
    return Ok(0);
}

# A heat pump's COP from the refrigeration COP of the same cycle: COP_hp = COP_ref + 1 (Q_hot = Q_cold + W).
#must_use
#pure
fn us_heat_pump_cop(cop_refrigeration: f64): f64 {
    var c: f64 = cop_refrigeration + 1.0;
    return c;
}

# --- Comparison ---

# Fills *out with cycle *r (labelled `kind`) against its Carnot limit between `t_high` and `t_low` K: for a
# refrigeration result (by *r's own kind) the Carnot COP T_L/(T_H − T_L), for any other 1 − T_L/T_H, and 0 when the
# limits are not physical (T_L ≤ 0, T_H ≤ T_L, or not finite). The second-law efficiency is η / η_Carnot, or 0 when
# the limit is not positive. *out takes *r's efficiency, net work and back-work ratio.
fn us_compare_cycle(kind, r: *UsCycleResult, t_high: f64, t_low: f64, out: *UsCycleComparison) {
    var c: f64 = 0.0;
    if (_us_finite_gt(t_low, 0.0) == 1 && _us_finite_gt(t_high, t_low) == 1) {
        if (r.kind == US_CYCLE_REFRIGERATION) {
            c = t_low / (t_high - t_low);
        } else {
            c = 1.0 - t_low / t_high;
        }
    }
    var eff: f64 = r.efficiency;
    var second: f64 = 0.0;
    if (c > 0.0) { second = eff / c; }
    var w: f64 = r.net_work;
    var bwr: f64 = r.back_work_ratio;
    out.kind = kind;
    out.efficiency = eff;
    out.net_work = w;
    out.back_work_ratio = bwr;
    out.carnot_efficiency = c;
    out.second_law_efficiency = second;
    return 0;
}

# Compares `n` cycles with their Carnot limits, as us_compare_cycle does each, into the `n` UsCycleComparison records
# at `out`: entry k is labelled kinds[k] (a US_CYCLE_* code), is the result at results[k] (a *UsCycleResult) and has
# the limits t_highs[k], t_lows[k] (f64 K). Rust's `&[(CycleKind, &CycleResult, f64, f64)]` as four parallel lists.
# The number of records written (n, or 0 for n ≤ 0).
fn us_compare_cycles(kinds, results, t_highs, t_lows, n, out): i64 {
    if (n <= 0) { return 0; }
    var o = out;
    var k = 0;
    while (k < n) {
        var th: f64 = load64(t_highs + (8 * k));
        var tl: f64 = load64(t_lows + (8 * k));
        us_compare_cycle(load64(kinds + (8 * k)), load64(results + (8 * k)), th, tl, o + (48 * k));
        k = k + 1;
    }
    return n;
}

# --- Diagrams ---

# The number of points a diagram of *r has at `points_per_process` points a process (at least 2): one process per
# state point, the last closing the loop. Size a diagram's buffer with it: that many UsDiagramPoint records.
#must_use
fn us_cycle_diagram_len(r: *UsCycleResult, points_per_process): i64 {
    var pts = points_per_process;
    if (pts < 2) { pts = 2; }
    return us_cycle_state_count(r) * pts;
}

# The points a process (at least 2) when *r's diagram fits `cap` records, else -1. Compared by division, so a huge
# `points_per_process` cannot overflow the product.
fn _us_diagram_pts(r: *UsCycleResult, points_per_process, cap): i64 {
    var pts = points_per_process;
    if (pts < 2) { pts = 2; }
    var n = us_cycle_state_count(r);
    if (n > 0 && (cap < 0 || pts > cap / n)) { return 0 - 1; }
    return pts;
}

# Writes the T-s diagram of *r into the `cap` UsDiagramPoint records at `out` (x the entropy, J/K; y the temperature,
# K): `points_per_process` points (at least 2) along each process, the entropy linear between its state points. An
# isochoric or isobaric process on an ideal gas (γ > 0, both temperatures positive) follows its real path, T = T_a·
# (T_b/T_a)^f, since ds = C·dT/T; every other process, and every process of a steam cycle (γ = 0), is a straight line
# (the saturation dome is not traced). Ok(the number of points, us_cycle_diagram_len), or
# Err(US_ERR_INVALID_PARAMETER) when they would not fit in `cap`.
#must_use
fn us_cycle_ts_diagram(r: *UsCycleResult, points_per_process, out, cap): Result {
    var pts = _us_diagram_pts(r, points_per_process, cap);
    if (pts < 0) {
        var cf: f64 = f64_from(cap);
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_cycle_ts_diagram", "cap", cf));
    }
    var n = us_cycle_state_count(r);
    var g: f64 = r.gamma;
    var ideal = 0;
    if (g > 0.0) { ideal = 1; }
    var d = slice_ptr(r.states);
    var o = out;
    var last: f64 = f64_from(pts - 1);
    var k = 0;
    var i = 0;
    while (i < n) {
        var a = d + (40 * i);
        var b = d + (40 * ((i + 1) % n));
        var ta: f64 = load64(a);
        var tb: f64 = load64(b);
        var sa: f64 = load64(a + 24);
        var sb: f64 = load64(b + 24);
        var pk = us_cycle_process(r, i);
        var log_t = 0;
        if (ideal == 1 && (pk == US_PROCESS_ISOCHORIC || pk == US_PROCESS_ISOBARIC)) {
            log_t = _us_finite_gt(ta, 0.0) & _us_finite_gt(tb, 0.0);
        }
        var j = 0;
        while (j < pts) {
            var jf: f64 = f64_from(j);
            var frac: f64 = jf / last;
            var sv: f64 = sa + frac * (sb - sa);
            var t: f64 = ta + frac * (tb - ta);
            if (log_t == 1) {
                var pw: f64 = _us_cr_pow(tb / ta, frac);
                t = ta * pw;
            }
            store64(o + (16 * k), sv);
            store64(o + (16 * k) + 8, t);
            k = k + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return Ok(k);
}

# Writes the P-v diagram of *r into the `cap` UsDiagramPoint records at `out` (x the volume, m³; y the pressure, Pa):
# `points_per_process` points (at least 2) along each process, the volume linear between its state points. An
# isentropic process is the polytropic P = P_a·(V_a/V)^k through both state points, k = ln(P_b/P_a)/ln(V_a/V_b) (γ for
# an ideal gas, and steam's own; a straight line when V does not change, as in a liquid pump); an isochoric one a
# vertical line, an isobaric one a horizontal line, an isothermal one the hyperbola P = P_a·V_a/V, and any other a
# straight line. Ok(the number of points), or Err(US_ERR_INVALID_PARAMETER) when they would not fit in `cap`.
#must_use
fn us_cycle_pv_diagram(r: *UsCycleResult, points_per_process, out, cap): Result {
    var pts = _us_diagram_pts(r, points_per_process, cap);
    if (pts < 0) {
        var cf: f64 = f64_from(cap);
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_cycle_pv_diagram", "cap", cf));
    }
    var n = us_cycle_state_count(r);
    var d = slice_ptr(r.states);
    var o = out;
    var last: f64 = f64_from(pts - 1);
    var k = 0;
    var i = 0;
    while (i < n) {
        var a = d + (40 * i);
        var b = d + (40 * ((i + 1) % n));
        var pa: f64 = load64(a + 8);
        var pb: f64 = load64(b + 8);
        var va: f64 = load64(a + 16);
        var vb: f64 = load64(b + 16);
        var pos_v = _us_finite_gt(va, 0.0) & _us_finite_gt(vb, 0.0);
        var positive = pos_v & _us_finite_gt(pa, 0.0) & _us_finite_gt(pb, 0.0);
        var ln_v: f64 = 0.0;
        if (positive == 1) { ln_v = _us_cr_ln(va / vb); }
        var pk = us_cycle_process(r, i);
        # 1 isentropic (polytropic), 2 isochoric, 3 isobaric, 4 isothermal, 0 a straight line.
        var path = 0;
        var kexp: f64 = 0.0;
        var alv: f64 = f64_abs(ln_v);
        if (pk == US_PROCESS_ISENTROPIC && alv > 0.000000000001) {
            path = 1;
            var lp: f64 = _us_cr_ln(pb / pa);
            kexp = lp / ln_v;
        }
        if (pk == US_PROCESS_ISOCHORIC) { path = 2; }
        if (pk == US_PROCESS_ISOBARIC) { path = 3; }
        if (pk == US_PROCESS_ISOTHERMAL && positive == 1) { path = 4; }
        var j = 0;
        while (j < pts) {
            var jf: f64 = f64_from(j);
            var frac: f64 = jf / last;
            var v: f64 = va + frac * (vb - va);
            var p: f64 = pa + frac * (pb - pa);
            if (path == 1) {
                var pw: f64 = _us_cr_pow(va / v, kexp);
                p = pa * pw;
            }
            if (path == 2) { v = va; }
            if (path == 3) { p = pa; }
            if (path == 4) { p = pa * va / v; }
            store64(o + (16 * k), v);
            store64(o + (16 * k) + 8, p);
            k = k + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return Ok(k);
}

# --- JSON ---

# The field names of a StatePoint, in declaration order.
fn _us_sp_field(k): cstring {
    match k {
        0 => { return "temperature"; }
        1 => { return "pressure"; }
        2 => { return "volume"; }
        3 => { return "entropy"; }
        4 => { return "enthalpy"; }
        _ => { return 0; }
    }
    return 0;
}

# Appends *sp as serde_json writes a `StatePoint`.
fn us_state_point_to_json(sb, sp: *UsStatePoint) {
    return _us_jw_f64_struct(sb, sp, 5, &_us_sp_field);
}

# Reads a `StatePoint` document (`n` bytes at `buf`; its tree on allocator `a`) into *out: Ok(0), or
# Err(US_ERR_DESERIALIZE), leaving *out unchanged.
#must_use
fn us_state_point_from_json_a(a, buf, n, out: *UsStatePoint): Result {
    var w[40];
    if (_us_jr_f64_struct(a, buf, n, &w, 5, &_us_sp_field) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_state_point_from_json"));
    }
    memcpy(out, &w, 40);
    return Ok(0);
}

# us_state_point_from_json_a on the global heap.
#must_use
fn us_state_point_from_json(buf, n, out: *UsStatePoint): Result {
    return us_state_point_from_json_a(default_alloc(), buf, n, out);
}

# Appends process `k` as serde_json writes a `ProcessKind`: its name as a JSON string.
fn us_process_to_json(sb, k) {
    var name = us_process_name(k);
    if (name == 0) { name = ""; }
    _us_jw_str(sb, name, strlen(name));
    return 0;
}

# Reads a `ProcessKind` document (`n` bytes at `buf`; its tree on allocator `a`): Ok(US_PROCESS_*), or
# Err(US_ERR_DESERIALIZE).
#must_use
fn us_process_from_json_a(a, buf, n): Result {
    var k = _us_jr_unit_enum(_us_jr_parse(a, buf, n), &us_process_name, US_PROCESS_COUNT);
    if (k < 0) { return Err(_us_fail(US_ERR_DESERIALIZE, "us_process_from_json")); }
    return Ok(k);
}

# us_process_from_json_a on the global heap.
#must_use
fn us_process_from_json(buf, n): Result {
    return us_process_from_json_a(default_alloc(), buf, n);
}

# Appends cycle kind `k` as serde_json writes a `CycleKind`: its name as a JSON string.
fn us_cycle_to_json(sb, k) {
    var name = us_cycle_name(k);
    if (name == 0) { name = ""; }
    _us_jw_str(sb, name, strlen(name));
    return 0;
}

# Reads a `CycleKind` document (`n` bytes at `buf`; its tree on allocator `a`): Ok(US_CYCLE_*), or
# Err(US_ERR_DESERIALIZE).
#must_use
fn us_cycle_from_json_a(a, buf, n): Result {
    var k = _us_jr_unit_enum(_us_jr_parse(a, buf, n), &us_cycle_name, US_CYCLE_COUNT);
    if (k < 0) { return Err(_us_fail(US_ERR_DESERIALIZE, "us_cycle_from_json")); }
    return Ok(k);
}

# us_cycle_from_json_a on the global heap.
#must_use
fn us_cycle_from_json(buf, n): Result {
    return us_cycle_from_json_a(default_alloc(), buf, n);
}

# The six f64 fields of a CycleResult after its lists, in declaration order (indices 3 … 8 of its nine fields).
fn _us_cr_field(k): cstring {
    match k {
        0 => { return "kind"; }
        1 => { return "state_points"; }
        2 => { return "processes"; }
        3 => { return "heat_in"; }
        4 => { return "heat_out"; }
        5 => { return "net_work"; }
        6 => { return "efficiency"; }
        7 => { return "back_work_ratio"; }
        8 => { return "gamma"; }
        _ => { return 0; }
    }
    return 0;
}

# Appends *r as serde_json writes a `CycleResult`.
fn us_cycle_result_to_json(sb, r: *UsCycleResult) {
    str_builder_putc(sb, 123);
    _us_jw_key(sb, "kind", 1);
    us_cycle_to_json(sb, r.kind);
    _us_jw_key(sb, "state_points", 0);
    str_builder_putc(sb, 91);
    var n = us_cycle_state_count(r);
    var sp: UsStatePoint;
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_putc(sb, 44); }
        us_cycle_state(r, i, &sp);
        us_state_point_to_json(sb, &sp);
        i = i + 1;
    }
    str_builder_putc(sb, 93);
    _us_jw_key(sb, "processes", 0);
    str_builder_putc(sb, 91);
    var m = us_cycle_process_count(r);
    i = 0;
    while (i < m) {
        if (i > 0) { str_builder_putc(sb, 44); }
        us_process_to_json(sb, us_cycle_process(r, i));
        i = i + 1;
    }
    str_builder_putc(sb, 93);
    var base = r;
    var nums = base + _US_CR_NUMS;
    var k = 0;
    while (k < 6) {
        _us_jw_key(sb, _us_cr_field(k + 3), 0);
        var x: f64 = load64(nums + (8 * k));
        _us_jw_f64(sb, x);
        k = k + 1;
    }
    str_builder_putc(sb, 125);
    return 0;
}

# A StatePoint node `v` (object or 5-element sequence) into the five words at `w`: 1, or 0.
fn _us_jr_state_point(v, w): i64 {
    var form = _us_jr_form(v, 5);
    if (form == 0) { return 0; }
    var k = 0;
    while (k < 5) {
        if (_us_jr_f64(_us_jr_at(v, form, k, _us_sp_field(k)), w + (8 * k)) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# A CycleResult node `v` (object or 9-element sequence) into *out, its vecs on allocator `a`: 0, or the refusal's code
# (US_ERR_DESERIALIZE, or US_ERR_OUT_OF_MEMORY for a refused vec), leaving *out unchanged.
fn _us_jr_cycle_result(a, v, out: *UsCycleResult): i64 {
    var form = _us_jr_form(v, 9);
    if (form == 0) { return US_ERR_DESERIALIZE; }
    var kind = _us_jr_unit_enum(_us_jr_at(v, form, 0, "kind"), &us_cycle_name, US_CYCLE_COUNT);
    var sps = _us_jr_at(v, form, 1, "state_points");
    var prs = _us_jr_at(v, form, 2, "processes");
    if (kind < 0 || sps == 0 || prs == 0 || bayan_json_v_tag(sps) != JTAG_ARR || bayan_json_v_tag(prs) != JTAG_ARR) {
        return US_ERR_DESERIALIZE;
    }
    var nums[48];
    var k = 0;
    while (k < 6) {
        if (_us_jr_f64(_us_jr_at(v, form, k + 3, _us_cr_field(k + 3)), &nums + (8 * k)) == 0) {
            return US_ERR_DESERIALIZE;
        }
        k = k + 1;
    }
    var states = vec_new_a(a);
    var processes = vec_new_a(a);
    if (states == 0 || processes == 0) { return US_ERR_OUT_OF_MEMORY; }
    var w[40];
    var ns = bayan_json_v_arr_len(sps);
    var i = 0;
    while (i < ns) {
        if (_us_jr_state_point(bayan_json_v_arr_get(sps, i), &w) == 0) {
            return US_ERR_DESERIALIZE;
        }
        k = 0;
        while (k < 5) {
            if (vec_push_a(a, states, load64(&w + (8 * k))) < 0) {
                return US_ERR_OUT_OF_MEMORY;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    var np = bayan_json_v_arr_len(prs);
    i = 0;
    while (i < np) {
        var pk = _us_jr_unit_enum(bayan_json_v_arr_get(prs, i), &us_process_name, US_PROCESS_COUNT);
        if (pk < 0) { return US_ERR_DESERIALIZE; }
        if (vec_push_a(a, processes, pk) < 0) {
            return US_ERR_OUT_OF_MEMORY;
        }
        i = i + 1;
    }
    out.kind = kind;
    out.alloc = a;
    out.states = states;
    out.processes = processes;
    var ob = out;
    memcpy(ob + _US_CR_NUMS, &nums, 48);
    return 0;
}

# Reads a `CycleResult` document (`n` bytes at `buf`) into *out, its two vecs (which then grow on `a`) and the parse
# tree on allocator `a`: Ok(0), or Err(US_ERR_DESERIALIZE) for a malformed document (an allocation bayan's parser was
# refused included) and Err(US_ERR_OUT_OF_MEMORY) for a refused vec, leaving *out unchanged.
#must_use
fn us_cycle_result_from_json_a(a, buf, n, out: *UsCycleResult): Result {
    var code = _us_jr_cycle_result(a, _us_jr_parse(a, buf, n), out);
    if (code != 0) { return Err(_us_fail(code, "us_cycle_result_from_json")); }
    return Ok(0);
}

# us_cycle_result_from_json_a on the global heap: for a one-off read (its tree and vecs stay allocated).
#must_use
fn us_cycle_result_from_json(buf, n, out: *UsCycleResult): Result {
    return us_cycle_result_from_json_a(default_alloc(), buf, n, out);
}

# Appends *rr as serde_json writes a `RefrigerationResult`: its cycle's document, then the two COPs.
fn us_refrigeration_result_to_json(sb, rr: *UsRefrigerationResult) {
    str_builder_putc(sb, 123);
    _us_jw_key(sb, "cycle", 1);
    us_cycle_result_to_json(sb, us_refrigeration_result_cycle(rr));
    _us_jw_key(sb, "cop_refrigeration", 0);
    var cr: f64 = rr.cop_refrigeration;
    _us_jw_f64(sb, cr);
    _us_jw_key(sb, "cop_heat_pump", 0);
    var ch: f64 = rr.cop_heat_pump;
    _us_jw_f64(sb, ch);
    str_builder_putc(sb, 125);
    return 0;
}

# Reads a `RefrigerationResult` document (`n` bytes at `buf`; an object, or a 3-element sequence) into *out, its
# cycle's vecs (which then grow on `a`) and the parse tree on allocator `a`: Ok(0), Err(US_ERR_DESERIALIZE) or
# Err(US_ERR_OUT_OF_MEMORY) as us_cycle_result_from_json_a, leaving *out unchanged.
#must_use
fn us_refrigeration_result_from_json_a(a, buf, n, out: *UsRefrigerationResult): Result {
    var v = _us_jr_parse(a, buf, n);
    var form = _us_jr_form(v, 3);
    if (form == 0) { return Err(_us_fail(US_ERR_DESERIALIZE, "us_refrigeration_result_from_json")); }
    var cops[16];
    if (_us_jr_f64(_us_jr_at(v, form, 1, "cop_refrigeration"), &cops) == 0
      || _us_jr_f64(_us_jr_at(v, form, 2, "cop_heat_pump"), &cops + 8) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_refrigeration_result_from_json"));
    }
    var c: UsCycleResult;
    var code = _us_jr_cycle_result(a, _us_jr_at(v, form, 0, "cycle"), &c);
    if (code != 0) { return Err(_us_fail(code, "us_refrigeration_result_from_json")); }
    memcpy(out, &c, sizeof(UsCycleResult));
    var cr: f64 = load64(&cops);
    var ch: f64 = load64(&cops + 8);
    out.cop_refrigeration = cr;
    out.cop_heat_pump = ch;
    return Ok(0);
}

# us_refrigeration_result_from_json_a on the global heap: for a one-off read (its tree and vecs stay allocated).
#must_use
fn us_refrigeration_result_from_json(buf, n, out: *UsRefrigerationResult): Result {
    return us_refrigeration_result_from_json_a(default_alloc(), buf, n, out);
}

# The field names of a DiagramPoint.
fn _us_dp_field(k): cstring {
    match k {
        0 => { return "x"; }
        1 => { return "y"; }
        _ => { return 0; }
    }
    return 0;
}

# Appends *dp as serde_json writes a `DiagramPoint`.
fn us_diagram_point_to_json(sb, dp: *UsDiagramPoint) {
    return _us_jw_f64_struct(sb, dp, 2, &_us_dp_field);
}

# Reads a `DiagramPoint` document (`n` bytes at `buf`; its tree on allocator `a`) into *out: Ok(0), or
# Err(US_ERR_DESERIALIZE), leaving *out unchanged.
#must_use
fn us_diagram_point_from_json_a(a, buf, n, out: *UsDiagramPoint): Result {
    var w[16];
    if (_us_jr_f64_struct(a, buf, n, &w, 2, &_us_dp_field) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_diagram_point_from_json"));
    }
    var x: f64 = load64(&w);
    var y: f64 = load64(&w + 8);
    out.x = x;
    out.y = y;
    return Ok(0);
}

# us_diagram_point_from_json_a on the global heap.
#must_use
fn us_diagram_point_from_json(buf, n, out: *UsDiagramPoint): Result {
    return us_diagram_point_from_json_a(default_alloc(), buf, n, out);
}

# The fields of a CycleComparisonEntry, in declaration order.
fn _us_cc_field(k): cstring {
    match k {
        0 => { return "kind"; }
        1 => { return "efficiency"; }
        2 => { return "net_work"; }
        3 => { return "back_work_ratio"; }
        4 => { return "carnot_efficiency"; }
        5 => { return "second_law_efficiency"; }
        _ => { return 0; }
    }
    return 0;
}

# Appends *c as serde_json writes a `CycleComparisonEntry`.
fn us_cycle_comparison_to_json(sb, c: *UsCycleComparison) {
    str_builder_putc(sb, 123);
    _us_jw_key(sb, "kind", 1);
    us_cycle_to_json(sb, c.kind);
    var base = c;
    var k = 1;
    while (k < 6) {
        _us_jw_key(sb, _us_cc_field(k), 0);
        var x: f64 = load64(base + (8 * k));
        _us_jw_f64(sb, x);
        k = k + 1;
    }
    str_builder_putc(sb, 125);
    return 0;
}

# Reads a `CycleComparisonEntry` document (`n` bytes at `buf`; an object, or a 6-element sequence; its tree on
# allocator `a`) into *out: Ok(0), or Err(US_ERR_DESERIALIZE), leaving *out unchanged.
#must_use
fn us_cycle_comparison_from_json_a(a, buf, n, out: *UsCycleComparison): Result {
    var v = _us_jr_parse(a, buf, n);
    var form = _us_jr_form(v, 6);
    if (form == 0) { return Err(_us_fail(US_ERR_DESERIALIZE, "us_cycle_comparison_from_json")); }
    var w[48];
    var kind = _us_jr_unit_enum(_us_jr_at(v, form, 0, "kind"), &us_cycle_name, US_CYCLE_COUNT);
    if (kind < 0) { return Err(_us_fail(US_ERR_DESERIALIZE, "us_cycle_comparison_from_json")); }
    store64(&w, kind);
    var k = 1;
    while (k < 6) {
        if (_us_jr_f64(_us_jr_at(v, form, k, _us_cc_field(k)), &w + (8 * k)) == 0) {
            return Err(_us_fail(US_ERR_DESERIALIZE, "us_cycle_comparison_from_json"));
        }
        k = k + 1;
    }
    var o = out;
    k = 0;
    while (k < 6) {
        store64(o + (8 * k), load64(&w + (8 * k)));
        k = k + 1;
    }
    return Ok(0);
}

# us_cycle_comparison_from_json_a on the global heap.
#must_use
fn us_cycle_comparison_from_json(buf, n, out: *UsCycleComparison): Result {
    return us_cycle_comparison_from_json_a(default_alloc(), buf, n, out);
}
