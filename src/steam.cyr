# steam.cyr — steam tables: the IAPWS-IF97 Region 4 saturation line both ways, saturated properties by temperature or
# pressure, quality and wet steam (Rust 1.4.0 `steam`). All SI: kelvins, pascals, joules, kilograms.
#
# Each function computes in the order Rust 1.4.0 writes, so its arithmetic is bit-identical (class B: Region 4 is
# algebraic with √). The saturated table, Region 4's coefficients and the limits are generated from the Rust literals
# (src/steam_data.cyr, private). Between table rows each property is interpolated linearly in T with hisab's
# calc_lerp (Rust's hisab::calc::lerp, a + (b − a)·t), except v_g, whose ratio P·v_g/T is interpolated instead. A
# refusal returns Err(US_ERR_*) and reports its value at DEBUG (src/validate.cyr).
#
# A saturated state is a UsSaturated (Rust's SaturatedEntry), a wet-steam state a UsWetSteam (WetSteamProperties): the
# lookups fill the caller's struct and return Ok(0) (CLAUDE.md: wide results through out-pointers). Their JSON is
# serde_json's documents (ADR 0005; src/json.cyr has the rules).

struct UsSaturated {
    temperature: f64;
    pressure: f64;
    v_f: f64;
    v_g: f64;
    h_f: f64;
    h_fg: f64;
    h_g: f64;
    s_f: f64;
    s_g: f64;
}

struct UsWetSteam {
    quality: f64;
    specific_volume: f64;
    specific_enthalpy: f64;
    specific_entropy: f64;
}

# --- IAPWS-IF97 Region 4 ---

# The Region 4 saturation-pressure equation at T (Pa), with no range check.
fn _us_r4_pressure(t: f64): f64 {
    var n0: f64 = _US_STEAM_R4_N1;
    var n1: f64 = _US_STEAM_R4_N2;
    var n2: f64 = _US_STEAM_R4_N3;
    var n3: f64 = _US_STEAM_R4_N4;
    var n4: f64 = _US_STEAM_R4_N5;
    var n5: f64 = _US_STEAM_R4_N6;
    var n6: f64 = _US_STEAM_R4_N7;
    var n7: f64 = _US_STEAM_R4_N8;
    var n8: f64 = _US_STEAM_R4_N9;
    var n9: f64 = _US_STEAM_R4_N10;
    var th: f64 = t + n8 / (t - n9);
    var a: f64 = th * th + n0 * th + n1;
    var b: f64 = n2 * th * th + n3 * th + n4;
    var c: f64 = n5 * th * th + n6 * th + n7;
    var r: f64 = f64_sqrt(b * b - 4.0 * a * c);
    var x: f64 = 2.0 * c / ((0.0 - b) + r);
    # Rust's x.powi(4): (x·x)·(x·x), the products __powidf2 forms.
    var x2: f64 = x * x;
    var x4: f64 = x2 * x2;
    var p: f64 = x4 * 1000000.0;
    return p;
}

# The Region 4 saturation-temperature backward equation at P (K), with no range check.
fn _us_r4_temperature(p: f64): f64 {
    var n0: f64 = _US_STEAM_R4_N1;
    var n1: f64 = _US_STEAM_R4_N2;
    var n2: f64 = _US_STEAM_R4_N3;
    var n3: f64 = _US_STEAM_R4_N4;
    var n4: f64 = _US_STEAM_R4_N5;
    var n5: f64 = _US_STEAM_R4_N6;
    var n6: f64 = _US_STEAM_R4_N7;
    var n7: f64 = _US_STEAM_R4_N8;
    var n8: f64 = _US_STEAM_R4_N9;
    var n9: f64 = _US_STEAM_R4_N10;
    var q: f64 = f64_sqrt(p * 0.000001);
    var beta: f64 = f64_sqrt(q);
    var e: f64 = beta * beta + n2 * beta + n5;
    var f: f64 = n0 * beta * beta + n3 * beta + n6;
    var g: f64 = n1 * beta * beta + n4 * beta + n7;
    var r: f64 = f64_sqrt(f * f - 4.0 * e * g);
    var d: f64 = 2.0 * g / ((0.0 - f) - r);
    var s: f64 = n9 + d;
    var r2: f64 = f64_sqrt(s * s - 4.0 * (n8 + n9 * d));
    var t: f64 = 0.5 * (s - r2);
    return t;
}

# The saturation pressure of water at T (Pa), by the IF97 Region 4 equation (better than 1e-8 relative to IF97's
# verification values), capped at the critical pressure. Err(US_ERR_STEAM_TABLE_OUT_OF_RANGE) outside
# 273.15 K … 647.096 K (or NaN).
#must_use
fn us_saturation_pressure(temperature: f64): Result {
    if (_us_finite_ge(temperature, _US_STEAM_R4_T_MIN) == 0 || temperature > _US_STEAM_T_CRIT) {
        return Err(_us_fail_f(US_ERR_STEAM_TABLE_OUT_OF_RANGE, "us_saturation_pressure", "temperature", temperature));
    }
    var p: f64 = _us_r4_pressure(temperature);
    var pc: f64 = _us_min(p, _US_STEAM_P_CRIT);
    return Ok(pc);
}

# The saturation temperature of water at P (K), by the IF97 Region 4 backward equation, the exact algebraic inverse of
# us_saturation_pressure, clamped to 273.15 K … 647.096 K. Err(US_ERR_STEAM_TABLE_OUT_OF_RANGE) outside 611.213 Pa
# (saturation at 273.15 K) … 22.064 MPa (or NaN).
#must_use
fn us_saturation_temperature(pressure: f64): Result {
    var p_min: f64 = _us_r4_pressure(_US_STEAM_R4_T_MIN);
    if (_us_finite_ge(pressure, p_min) == 0 || pressure > _US_STEAM_P_CRIT) {
        return Err(_us_fail_f(US_ERR_STEAM_TABLE_OUT_OF_RANGE, "us_saturation_temperature", "pressure", pressure));
    }
    var t: f64 = _us_r4_temperature(pressure);
    var tc: f64 = f64_clamp(t, _US_STEAM_R4_T_MIN, _US_STEAM_T_CRIT);
    return Ok(tc);
}

# --- The saturated table ---

# The first row whose temperature exceeds T (Rust's partition_point on `temperature <= T`), clamped to 1 … 41 so the
# rows (k − 1, k) bracket T.
fn _us_sat_row(t: f64): i64 {
    var lo = 0;
    var hi = _US_STEAM_SATURATED_COUNT;
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        var tm: f64 = _US_STEAM_SAT_TEMPERATURE[mid];
        if (tm <= t) { lo = mid + 1; } else { hi = mid; }
    }
    if (lo < 1) { lo = 1; }
    if (lo > _US_STEAM_SATURATED_COUNT - 1) { lo = _US_STEAM_SATURATED_COUNT - 1; }
    return lo;
}

# Fills *out with the saturated table interpolated at T, where the saturation pressure is P (the caller has checked
# the range).
fn _us_sat_interpolate(t: f64, p: f64, out: *UsSaturated) {
    var k = _us_sat_row(t);
    var ta: f64 = _US_STEAM_SAT_TEMPERATURE[k - 1];
    var tb: f64 = _US_STEAM_SAT_TEMPERATURE[k];
    var pa: f64 = _US_STEAM_SAT_PRESSURE[k - 1];
    var pb: f64 = _US_STEAM_SAT_PRESSURE[k];
    var ga: f64 = _US_STEAM_SAT_V_G[k - 1];
    var gb: f64 = _US_STEAM_SAT_V_G[k];
    var frac: f64 = (t - ta) / (tb - ta);
    # P·v_g/T is smooth (about R/M·Z), unlike v_g itself.
    var za: f64 = ga * pa / ta;
    var zb: f64 = gb * pb / tb;
    var z: f64 = calc_lerp(za, zb, frac);
    var vfa: f64 = _US_STEAM_SAT_V_F[k - 1];
    var vfb: f64 = _US_STEAM_SAT_V_F[k];
    var hfa: f64 = _US_STEAM_SAT_H_F[k - 1];
    var hfb: f64 = _US_STEAM_SAT_H_F[k];
    var hga: f64 = _US_STEAM_SAT_H_FG[k - 1];
    var hgb: f64 = _US_STEAM_SAT_H_FG[k];
    var hha: f64 = _US_STEAM_SAT_H_G[k - 1];
    var hhb: f64 = _US_STEAM_SAT_H_G[k];
    var sfa: f64 = _US_STEAM_SAT_S_F[k - 1];
    var sfb: f64 = _US_STEAM_SAT_S_F[k];
    var sga: f64 = _US_STEAM_SAT_S_G[k - 1];
    var sgb: f64 = _US_STEAM_SAT_S_G[k];
    var vf: f64 = calc_lerp(vfa, vfb, frac);
    var vg: f64 = z * t / p;
    var hf: f64 = calc_lerp(hfa, hfb, frac);
    var hfg: f64 = calc_lerp(hga, hgb, frac);
    var hg: f64 = calc_lerp(hha, hhb, frac);
    var sf: f64 = calc_lerp(sfa, sfb, frac);
    var sg: f64 = calc_lerp(sga, sgb, frac);
    out.temperature = t;
    out.pressure = p;
    out.v_f = vf;
    out.v_g = vg;
    out.h_f = hf;
    out.h_fg = hfg;
    out.h_g = hg;
    out.s_f = sf;
    out.s_g = sg;
    return 0;
}

# Fills *out with saturated water and steam at T: the Region 4 saturation pressure, the other properties interpolated
# linearly in T between table rows (v_g through P·v_g/T). Ok(0), or Err(US_ERR_STEAM_TABLE_OUT_OF_RANGE) outside
# 273.16 K (the triple point) … 647.096 K (the critical point), *out unchanged.
#must_use
fn us_saturated_by_temperature(temperature: f64, out: *UsSaturated): Result {
    var t_min: f64 = _US_STEAM_SAT_TEMPERATURE[0];
    var t_max: f64 = _US_STEAM_SAT_TEMPERATURE[_US_STEAM_SATURATED_COUNT - 1];
    if (_us_finite_ge(temperature, t_min) == 0 || temperature > t_max) {
        return Err(_us_fail_f(US_ERR_STEAM_TABLE_OUT_OF_RANGE, "us_saturated_by_temperature", "temperature",
            temperature));
    }
    var p: f64 = _us_r4_pressure(temperature);
    var pc: f64 = _us_min(p, _US_STEAM_P_CRIT);
    _us_sat_interpolate(temperature, pc, out);
    return Ok(0);
}

# Fills *out with saturated water and steam at P: the Region 4 saturation temperature (clamped to the table), then the
# properties as us_saturated_by_temperature's. Ok(0), or Err(US_ERR_STEAM_TABLE_OUT_OF_RANGE) outside 611.657 Pa
# (the triple point) … 22.064 MPa (the critical point), *out unchanged.
#must_use
fn us_saturated_by_pressure(pressure: f64, out: *UsSaturated): Result {
    var p_min: f64 = _US_STEAM_SAT_PRESSURE[0];
    var p_max: f64 = _US_STEAM_SAT_PRESSURE[_US_STEAM_SATURATED_COUNT - 1];
    if (_us_finite_ge(pressure, p_min) == 0 || pressure > p_max) {
        return Err(_us_fail_f(US_ERR_STEAM_TABLE_OUT_OF_RANGE, "us_saturated_by_pressure", "pressure", pressure));
    }
    var t_lo: f64 = _US_STEAM_SAT_TEMPERATURE[0];
    var t: f64 = _us_r4_temperature(pressure);
    var tc: f64 = f64_clamp(t, t_lo, _US_STEAM_T_CRIT);
    _us_sat_interpolate(tc, pressure, out);
    return Ok(0);
}

# --- Quality and wet steam ---

# A computed quality within round-off of [0, 1] (1e-9 either side, as x(h_g) can be 1 + 2e-16), clamped to [0, 1]:
# Ok(x), or Err(US_ERR_INVALID_QUALITY) for anything else and NaN, reported by `fname`.
fn _us_quality_ok(x: f64, fname): Result {
    var lo: f64 = 0.0 - _US_STEAM_QUALITY_ROUNDOFF;
    var hi: f64 = 1.0 + _US_STEAM_QUALITY_ROUNDOFF;
    if ((x >= lo && x <= hi) == 0) { return Err(_us_fail_f(US_ERR_INVALID_QUALITY, fname, "quality", x)); }
    var c: f64 = f64_clamp(x, 0.0, 1.0);
    return Ok(c);
}

# The quality (dryness fraction) at specific volume v, x = (v − v_f) / (v_g − v_f). Err(US_ERR_DIVISION_BY_ZERO) when
# |v_g − v_f| < 1e-30 (the critical point), Err(US_ERR_INVALID_QUALITY) unless x is in [0, 1] within 1e-9.
#must_use
fn us_quality_from_volume(v: f64, entry: *UsSaturated): Result {
    var vf: f64 = entry.v_f;
    var vg: f64 = entry.v_g;
    var dv: f64 = vg - vf;
    var ad: f64 = f64_abs(dv);
    if (_us_finite_ge(ad, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_quality_from_volume", "v_g - v_f", dv));
    }
    var x: f64 = (v - vf) / dv;
    return _us_quality_ok(x, "us_quality_from_volume");
}

# The quality at specific enthalpy h, x = (h − h_f) / h_fg. Err(US_ERR_DIVISION_BY_ZERO) when |h_fg| < 1e-30,
# Err(US_ERR_INVALID_QUALITY) unless x is in [0, 1] within 1e-9.
#must_use
fn us_quality_from_enthalpy(h: f64, entry: *UsSaturated): Result {
    var hf: f64 = entry.h_f;
    var hfg: f64 = entry.h_fg;
    var ah: f64 = f64_abs(hfg);
    if (_us_finite_ge(ah, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_quality_from_enthalpy", "h_fg", hfg));
    }
    var x: f64 = (h - hf) / hfg;
    return _us_quality_ok(x, "us_quality_from_enthalpy");
}

# The quality at specific entropy s, x = (s − s_f) / (s_g − s_f). Err(US_ERR_DIVISION_BY_ZERO) when |s_g − s_f| < 1e-30,
# Err(US_ERR_INVALID_QUALITY) unless x is in [0, 1] within 1e-9.
#must_use
fn us_quality_from_entropy(s: f64, entry: *UsSaturated): Result {
    var sf: f64 = entry.s_f;
    var sg: f64 = entry.s_g;
    var ds: f64 = sg - sf;
    var ad: f64 = f64_abs(ds);
    if (_us_finite_ge(ad, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_quality_from_entropy", "s_g - s_f", ds));
    }
    var x: f64 = (s - sf) / ds;
    return _us_quality_ok(x, "us_quality_from_entropy");
}

# Fills *out with the wet-steam mixture at quality x: each property prop_f + x·(prop_g − prop_f). Ok(0), or
# Err(US_ERR_INVALID_QUALITY) unless 0 ≤ x ≤ 1 (NaN refused), *out unchanged.
#must_use
fn us_wet_steam_properties(quality: f64, entry: *UsSaturated, out: *UsWetSteam): Result {
    if ((quality >= 0.0 && quality <= 1.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_QUALITY, "us_wet_steam_properties", "quality", quality));
    }
    var vf: f64 = entry.v_f;
    var vg: f64 = entry.v_g;
    var hf: f64 = entry.h_f;
    var hfg: f64 = entry.h_fg;
    var sf: f64 = entry.s_f;
    var sg: f64 = entry.s_g;
    var v: f64 = vf + quality * (vg - vf);
    var h: f64 = hf + quality * hfg;
    var s: f64 = sf + quality * (sg - sf);
    out.quality = quality;
    out.specific_volume = v;
    out.specific_enthalpy = h;
    out.specific_entropy = s;
    return Ok(0);
}

# --- JSON ---

# The field names of a SaturatedEntry, in declaration order.
fn _us_sat_field(k): cstring {
    match k {
        0 => { return "temperature"; }
        1 => { return "pressure"; }
        2 => { return "v_f"; }
        3 => { return "v_g"; }
        4 => { return "h_f"; }
        5 => { return "h_fg"; }
        6 => { return "h_g"; }
        7 => { return "s_f"; }
        8 => { return "s_g"; }
        _ => { return 0; }
    }
    return 0;
}

# The field names of a WetSteamProperties, in declaration order.
fn _us_wet_field(k): cstring {
    match k {
        0 => { return "quality"; }
        1 => { return "specific_volume"; }
        2 => { return "specific_enthalpy"; }
        3 => { return "specific_entropy"; }
        _ => { return 0; }
    }
    return 0;
}

# Appends *e as serde_json writes a `SaturatedEntry`.
fn us_saturated_to_json(sb, e: *UsSaturated) {
    return _us_jw_f64_struct(sb, e, 9, &_us_sat_field);
}

# Reads a `SaturatedEntry` document (`n` bytes at `buf`; its tree on allocator `a`) into *out: Ok(0), or
# Err(US_ERR_DESERIALIZE), leaving *out unchanged.
#must_use
fn us_saturated_from_json_a(a, buf, n, out: *UsSaturated): Result {
    var w[72];
    if (_us_jr_f64_struct(a, buf, n, &w, 9, &_us_sat_field) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_saturated_from_json"));
    }
    memcpy(out, &w, 72);
    return Ok(0);
}

# us_saturated_from_json_a on the global heap.
#must_use
fn us_saturated_from_json(buf, n, out: *UsSaturated): Result {
    return us_saturated_from_json_a(default_alloc(), buf, n, out);
}

# Appends *s as serde_json writes a `WetSteamProperties`.
fn us_wet_steam_to_json(sb, s: *UsWetSteam) {
    return _us_jw_f64_struct(sb, s, 4, &_us_wet_field);
}

# Reads a `WetSteamProperties` document (`n` bytes at `buf`; its tree on allocator `a`) into *out: Ok(0), or
# Err(US_ERR_DESERIALIZE), leaving *out unchanged.
#must_use
fn us_wet_steam_from_json_a(a, buf, n, out: *UsWetSteam): Result {
    var w[32];
    if (_us_jr_f64_struct(a, buf, n, &w, 4, &_us_wet_field) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_wet_steam_from_json"));
    }
    memcpy(out, &w, 32);
    return Ok(0);
}

# us_wet_steam_from_json_a on the global heap.
#must_use
fn us_wet_steam_from_json(buf, n, out: *UsWetSteam): Result {
    return us_wet_steam_from_json_a(default_alloc(), buf, n, out);
}

# --- Superheated steam ---

struct UsSuperheated {
    temperature: f64;
    pressure: f64;
    specific_volume: f64;
    specific_enthalpy: f64;
    specific_entropy: f64;
}

# Fills *out with the linear interpolation in T between superheated states *a and *b (one tier) at T.
fn _us_sh_lerp(a: *UsSuperheated, b: *UsSuperheated, t: f64, out: *UsSuperheated) {
    var ta: f64 = a.temperature;
    var tb: f64 = b.temperature;
    var pa: f64 = a.pressure;
    var va: f64 = a.specific_volume;
    var vb: f64 = b.specific_volume;
    var ha: f64 = a.specific_enthalpy;
    var hb: f64 = b.specific_enthalpy;
    var sa: f64 = a.specific_entropy;
    var sb: f64 = b.specific_entropy;
    var frac: f64 = (t - ta) / (tb - ta);
    var v: f64 = calc_lerp(va, vb, frac);
    var h: f64 = calc_lerp(ha, hb, frac);
    var s: f64 = calc_lerp(sa, sb, frac);
    out.temperature = t;
    out.pressure = pa;
    out.specific_volume = v;
    out.specific_enthalpy = h;
    out.specific_entropy = s;
    return 0;
}

# Fills *out with row `k` of the generated superheated table.
fn _us_sh_row(k, out: *UsSuperheated) {
    var t: f64 = _US_STEAM_SH_TEMPERATURE[k];
    var p: f64 = _US_STEAM_SH_PRESSURE[k];
    var v: f64 = _US_STEAM_SH_SPECIFIC_VOLUME[k];
    var h: f64 = _US_STEAM_SH_SPECIFIC_ENTHALPY[k];
    var s: f64 = _US_STEAM_SH_SPECIFIC_ENTROPY[k];
    out.temperature = t;
    out.pressure = p;
    out.specific_volume = v;
    out.specific_enthalpy = h;
    out.specific_entropy = s;
    return 0;
}

# Fills *out with pressure tier `tier` interpolated at T, the saturated vapor at the tier pressure serving as its
# lowest point: 1, or 0 outside [T_sat, the tier's last temperature] (Rust's None).
fn _us_sh_tier(tier, t: f64, out: *UsSuperheated): i64 {
    var base = tier * _US_STEAM_TEMPS_PER_TIER;
    var t_first: f64 = _US_STEAM_SH_TEMPERATURE[base];
    var t_last: f64 = _US_STEAM_SH_TEMPERATURE[base + _US_STEAM_TEMPS_PER_TIER - 1];
    var a: UsSuperheated;
    var b: UsSuperheated;
    if (t > t_last) { return 0; }
    if (t < t_first) {
        var p_first: f64 = _US_STEAM_SH_PRESSURE[base];
        var sat: UsSaturated;
        var ts, vs = us_saturated_by_pressure(p_first, &sat);
        if (is_ok(ts) == 0) { return 0; }
        var tsat: f64 = sat.temperature;
        if (t < tsat) { return 0; }
        var vg: f64 = sat.v_g;
        var hg: f64 = sat.h_g;
        var sg: f64 = sat.s_g;
        a.temperature = tsat;
        a.pressure = p_first;
        a.specific_volume = vg;
        a.specific_enthalpy = hg;
        a.specific_entropy = sg;
        _us_sh_row(base, &b);
        _us_sh_lerp(&a, &b, t, out);
        return 1;
    }
    var lo = 0;
    var hi = _US_STEAM_TEMPS_PER_TIER;
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        var tm: f64 = _US_STEAM_SH_TEMPERATURE[base + mid];
        if (tm <= t) { lo = mid + 1; } else { hi = mid; }
    }
    if (lo < 1) { lo = 1; }
    if (lo > _US_STEAM_TEMPS_PER_TIER - 1) { lo = _US_STEAM_TEMPS_PER_TIER - 1; }
    _us_sh_row(base + lo - 1, &a);
    _us_sh_row(base + lo, &b);
    _us_sh_lerp(&a, &b, t, out);
    return 1;
}

# The first pressure tier at or above P (Rust's partition_point on `p < P`).
fn _us_sh_tier_at(pressure: f64): i64 {
    var k = 0;
    while (k < _US_STEAM_SUPERHEAT_TIER_COUNT) {
        var pk: f64 = _US_STEAM_SUPERHEAT_PRESSURES[k];
        if ((pk < pressure) == 0) { return k; }
        k = k + 1;
    }
    return k;
}

# Fills *out with superheated steam at (T, P): within a pressure tier linearly in T from the saturated-vapor state up;
# between tiers h and s linearly in ln P and v log-linearly in ln P. At a tier pressure T must be at or above
# saturation; between tiers at or above the higher tier's. Ok(0), or Err(US_ERR_INVALID_TEMPERATURE) unless T > 0,
# Err(US_ERR_INVALID_PRESSURE) unless P > 0, Err(US_ERR_SUPERHEAT_OUT_OF_RANGE) outside 10 kPa … 10 MPa or the tiers'
# temperatures; *out unchanged on a refusal.
#must_use
fn us_superheated_lookup(temperature: f64, pressure: f64, out: *UsSuperheated): Result {
    if (_us_finite_gt(temperature, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_superheated_lookup", "temperature", temperature));
    }
    if (_us_finite_gt(pressure, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_superheated_lookup", "pressure", pressure));
    }
    var p0: f64 = _US_STEAM_SUPERHEAT_PRESSURES[0];
    var pn: f64 = _US_STEAM_SUPERHEAT_PRESSURES[_US_STEAM_SUPERHEAT_TIER_COUNT - 1];
    if (pressure < p0 || pressure > pn) {
        return Err(_us_fail_ff(US_ERR_SUPERHEAT_OUT_OF_RANGE, "us_superheated_lookup", "state", "T", temperature,
            "P", pressure));
    }
    var hi = _us_sh_tier_at(pressure);
    var p_hi: f64 = _US_STEAM_SUPERHEAT_PRESSURES[hi];
    var e: UsSuperheated;
    if (p_hi <= pressure) {
        if (_us_sh_tier(hi, temperature, &e) == 0) {
            return Err(_us_fail_ff(US_ERR_SUPERHEAT_OUT_OF_RANGE, "us_superheated_lookup", "state", "T", temperature,
                "P", pressure));
        }
        e.pressure = pressure;
        memcpy(out, &e, 40);
        return Ok(0);
    }
    var lo = hi - 1;
    var p_lo: f64 = _US_STEAM_SUPERHEAT_PRESSURES[lo];
    var a: UsSuperheated;
    var b: UsSuperheated;
    if (_us_sh_tier(lo, temperature, &a) == 0 || _us_sh_tier(hi, temperature, &b) == 0) {
        return Err(_us_fail_ff(US_ERR_SUPERHEAT_OUT_OF_RANGE, "us_superheated_lookup", "state", "T", temperature,
            "P", pressure));
    }
    var ln1: f64 = _us_cr_ln(pressure / p_lo);
    var ln2: f64 = _us_cr_ln(p_hi / p_lo);
    var frac: f64 = ln1 / ln2;
    var va: f64 = a.specific_volume;
    var vb: f64 = b.specific_volume;
    var ha: f64 = a.specific_enthalpy;
    var hb: f64 = b.specific_enthalpy;
    var sa: f64 = a.specific_entropy;
    var sb: f64 = b.specific_entropy;
    var lva: f64 = _us_cr_ln(va);
    var lvb: f64 = _us_cr_ln(vb);
    var lv: f64 = calc_lerp(lva, lvb, frac);
    var v: f64 = _us_cr_exp(lv);
    var h: f64 = calc_lerp(ha, hb, frac);
    var s: f64 = calc_lerp(sa, sb, frac);
    out.temperature = temperature;
    out.pressure = pressure;
    out.specific_volume = v;
    out.specific_enthalpy = h;
    out.specific_entropy = s;
    return Ok(0);
}

# The entropy us_superheated_lookup(T, P) gives, into *s, for a P the caller has checked (> 0, within the tiers) whose
# tier `hi` and placement (`on_tier` 1 at a tier pressure) it has found, and, between tiers, whose ln P weight `frac`
# it computed once as the lookup computes it. Ok(0), or the lookup's refusal. The same bits as the lookup's
# specific_entropy, without its volume's two ln and exp or the weight's two ln: the inversion's bisection probes the
# entropy at one pressure about seven times (M4b's review).
fn _us_sh_s_at(t: f64, pressure: f64, hi, on_tier, frac: f64, s): Result {
    if (_us_finite_gt(t, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_superheated_lookup", "temperature", t));
    }
    var a: UsSuperheated;
    var x: f64 = 0.0;
    if (on_tier == 1) {
        if (_us_sh_tier(hi, t, &a) == 0) {
            return Err(_us_fail_ff(US_ERR_SUPERHEAT_OUT_OF_RANGE, "us_superheated_lookup", "state", "T", t, "P",
                pressure));
        }
        x = a.specific_entropy;
        store64(s, x);
        return Ok(0);
    }
    var b: UsSuperheated;
    if (_us_sh_tier(hi - 1, t, &a) == 0 || _us_sh_tier(hi, t, &b) == 0) {
        return Err(_us_fail_ff(US_ERR_SUPERHEAT_OUT_OF_RANGE, "us_superheated_lookup", "state", "T", t, "P",
            pressure));
    }
    var sa: f64 = a.specific_entropy;
    var sb: f64 = b.specific_entropy;
    x = calc_lerp(sa, sb, frac);
    store64(s, x);
    return Ok(0);
}

# Appends T to the breakpoints at `bps` (count at *nb) when T_min < T < T_max.
fn _us_sh_push(bps, nb, t: f64, t_min: f64, t_max: f64) {
    if (t > t_min && t < t_max) {
        var n = load64(nb);
        store64(bps + (8 * n), t);
        store64(nb, n + 1);
    }
    return 0;
}

# Fills *out with the superheated state at P whose specific entropy is s (an isentropic compressor's or turbine's
# exit). s(T) at constant P is piecewise linear in T, with breakpoints at the tabulated temperatures and the saturated
# anchor, so the inverse is exact for the table's model: bracket by bisection over the breakpoints (about 7 lookups),
# then solve the segment. Ok(0), or Err(US_ERR_INVALID_PRESSURE) unless P > 0, Err(US_ERR_INVALID_PARAMETER) unless
# s is finite, Err(US_ERR_SUPERHEAT_OUT_OF_RANGE) outside 10 kPa … 10 MPa or when s lies outside the range the lookup
# covers at P (below s_g, the state is wet), or the lookups' refusals.
#must_use
fn us_superheated_by_entropy(pressure: f64, entropy: f64, out: *UsSuperheated): Result {
    _us_span_enter("superheated_by_entropy", 22);
    if (_us_finite_gt(pressure, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_superheated_by_entropy", "pressure", pressure));
    }
    if (_us_is_finite(entropy) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_superheated_by_entropy", "entropy", entropy));
    }
    var p0: f64 = _US_STEAM_SUPERHEAT_PRESSURES[0];
    var pn: f64 = _US_STEAM_SUPERHEAT_PRESSURES[_US_STEAM_SUPERHEAT_TIER_COUNT - 1];
    if (pressure < p0 || pressure > pn) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_SUPERHEAT_OUT_OF_RANGE, "us_superheated_by_entropy", "pressure", pressure));
    }
    var hi = _us_sh_tier_at(pressure);
    var p_hi: f64 = _US_STEAM_SUPERHEAT_PRESSURES[hi];
    var on_tier = p_hi <= pressure;
    var sat: UsSaturated;
    var ts, vs = us_saturated_by_pressure(p_hi, &sat);
    if (is_err_result(ts) == 1) {
        _us_span_exit();
        return Err(vs);
    }
    var t_min: f64 = sat.temperature;
    var per = _US_STEAM_TEMPS_PER_TIER;
    var t_max: f64 = _US_STEAM_SH_TEMPERATURE[hi * per + per - 1];
    if (on_tier == 0) {
        var t_lo_max: f64 = _US_STEAM_SH_TEMPERATURE[(hi - 1) * per + per - 1];
        t_max = _us_min(t_max, t_lo_max);
    }
    var bps[144];
    var nbw[8];
    store64(&nbw, 0);
    var k = 0;
    while (k < per) {
        var th: f64 = _US_STEAM_SH_TEMPERATURE[hi * per + k];
        _us_sh_push(&bps, &nbw, th, t_min, t_max);
        k = k + 1;
    }
    if (on_tier == 0) {
        k = 0;
        while (k < per) {
            var tl: f64 = _US_STEAM_SH_TEMPERATURE[(hi - 1) * per + k];
            _us_sh_push(&bps, &nbw, tl, t_min, t_max);
            k = k + 1;
        }
    }
    var nb = load64(&nbw);
    store64(&bps + (8 * nb), t_min);
    store64(&bps + (8 * (nb + 1)), t_max);
    nb = nb + 2;
    # Insertion sort, ascending: the same order as Rust's sort by total_cmp for these finite positive temperatures.
    var i = 1;
    while (i < nb) {
        var x: f64 = load64(&bps + (8 * i));
        var j = i - 1;
        while (j >= 0) {
            var y: f64 = load64(&bps + (8 * j));
            if (y <= x) { break; }
            store64(&bps + (8 * (j + 1)), y);
            j = j - 1;
        }
        store64(&bps + (8 * (j + 1)), x);
        i = i + 1;
    }
    var on = 0;
    if (on_tier) { on = 1; }
    var frac: f64 = 0.0;
    if (on == 0) {
        var p_lo: f64 = _US_STEAM_SUPERHEAT_PRESSURES[hi - 1];
        var ln1: f64 = _us_cr_ln(pressure / p_lo);
        var ln2: f64 = _us_cr_ln(p_hi / p_lo);
        frac = ln1 / ln2;
    }
    var sw[8];
    var lo = 0;
    var hi_i = nb - 1;
    var b_lo: f64 = load64(&bps);
    var t1, v1 = _us_sh_s_at(b_lo, pressure, hi, on, frac, &sw);
    if (is_err_result(t1) == 1) {
        _us_span_exit();
        return Err(v1);
    }
    var s_lo: f64 = load64(&sw);
    var b_hi: f64 = load64(&bps + (8 * hi_i));
    var t2, v2 = _us_sh_s_at(b_hi, pressure, hi, on, frac, &sw);
    if (is_err_result(t2) == 1) {
        _us_span_exit();
        return Err(v2);
    }
    var s_hi: f64 = load64(&sw);
    if (entropy < s_lo || entropy > s_hi) {
        var bound: f64 = t_max;
        if (entropy < s_lo) { bound = t_min; }
        _us_span_exit();
        return Err(_us_fail_ff(US_ERR_SUPERHEAT_OUT_OF_RANGE, "us_superheated_by_entropy", "state", "T", bound, "P",
            pressure));
    }
    while (hi_i - lo > 1) {
        var mid = (lo + hi_i) / 2;
        var b_mid: f64 = load64(&bps + (8 * mid));
        var t3, v3 = _us_sh_s_at(b_mid, pressure, hi, on, frac, &sw);
        if (is_err_result(t3) == 1) {
            _us_span_exit();
            return Err(v3);
        }
        var s_mid: f64 = load64(&sw);
        if (s_mid <= entropy) {
            lo = mid;
            s_lo = s_mid;
        } else {
            hi_i = mid;
            s_hi = s_mid;
        }
    }
    var ds: f64 = s_hi - s_lo;
    var bl: f64 = load64(&bps + (8 * lo));
    var bh: f64 = load64(&bps + (8 * hi_i));
    var t: f64 = bl;
    if (ds > 0.0) { t = bl + (entropy - s_lo) / ds * (bh - bl); }
    var tc: f64 = f64_clamp(t, t_min, t_max);
    var tr, vr = us_superheated_lookup(tc, pressure, out);
    _us_span_exit();
    if (is_err_result(tr) == 1) { return Err(vr); }
    return Ok(0);
}

# The field names of a SuperheatedEntry, in declaration order.
fn _us_sh_field(k): cstring {
    match k {
        0 => { return "temperature"; }
        1 => { return "pressure"; }
        2 => { return "specific_volume"; }
        3 => { return "specific_enthalpy"; }
        4 => { return "specific_entropy"; }
        _ => { return 0; }
    }
    return 0;
}

# Appends *e as serde_json writes a `SuperheatedEntry`.
fn us_superheated_to_json(sb, e: *UsSuperheated) {
    return _us_jw_f64_struct(sb, e, 5, &_us_sh_field);
}

# Reads a `SuperheatedEntry` document (`n` bytes at `buf`; its tree on allocator `a`) into *out: Ok(0), or
# Err(US_ERR_DESERIALIZE), leaving *out unchanged.
#must_use
fn us_superheated_from_json_a(a, buf, n, out: *UsSuperheated): Result {
    var w[40];
    if (_us_jr_f64_struct(a, buf, n, &w, 5, &_us_sh_field) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_superheated_from_json"));
    }
    memcpy(out, &w, 40);
    return Ok(0);
}

# us_superheated_from_json_a on the global heap.
#must_use
fn us_superheated_from_json(buf, n, out: *UsSuperheated): Result {
    return us_superheated_from_json_a(default_alloc(), buf, n, out);
}
