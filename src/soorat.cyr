fn us_network_visualization_to_json(sb, v: *UsNetworkVisualization) {
    str_builder_putc(sb, 123);
    _us_jw_key(sb, "node_temperatures", 1);
    _us_jw_f64s(sb, slice_ptr(v.node_temperatures), vec_len(v.node_temperatures));
    _us_jw_key(sb, "edges", 0);
    _us_jw_pairs(sb, v.edges, 1);
    _us_jw_key(sb, "conductances", 0);
    _us_jw_f64s(sb, slice_ptr(v.conductances), vec_len(v.conductances));
    str_builder_putc(sb, 125);
    return 0;
}

# A ThermalNetworkVisualization node `v` (object or 3-element sequence) into *out, its vecs on allocator `a`: 0, 1 for
# a malformed document, or 3 for a refused vec. *out is unchanged unless 0.
fn _us_jr_network_visualization(a, v, out: *UsNetworkVisualization): i64 {
    var form = _us_jr_form(v, 3);
    if (form == 0) { return 1; }
    var x: UsNetworkVisualization;
    if (is_err_result(us_network_visualization_init_a(a, &x)) == 1) { return 3; }
    var c = _us_jr_f64_vec(a, _us_jr_at(v, form, 0, "node_temperatures"), x.node_temperatures);
    if (c != 0) { return c; }
    c = _us_jr_tuple_vec(a, _us_jr_at(v, form, 1, "edges"), 2, 2, x.edges);
    if (c != 0) { return c; }
    c = _us_jr_f64_vec(a, _us_jr_at(v, form, 2, "conductances"), x.conductances);
    if (c != 0) { return c; }
    memcpy(out, &x, sizeof(UsNetworkVisualization));
    return 0;
}

