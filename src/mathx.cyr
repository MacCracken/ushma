        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _US_CR_EXPM1_Q3;
        var k4: f64 = _US_CR_EXPM1_Q4;
        var k5: f64 = _US_CR_EXPM1_Q5;
        var k6: f64 = _US_CR_EXPM1_Q6;
        var k7: f64 = _US_CR_EXPM1_Q7;
        var k8: f64 = _US_CR_EXPM1_Q8;
        var k9: f64 = _US_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
