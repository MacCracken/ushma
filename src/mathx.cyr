# The fast path alone, for every x (as _us_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _us_cr_ln's inline path.
#must_use
fn _us_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
