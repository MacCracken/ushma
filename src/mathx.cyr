    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_US_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_US_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_US_CR_LN_ACC + 344);
    var sl: f64 = load64(&_US_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _us_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_US_CR_LN_ACC + off);
        var cm: f64 = load64(&_US_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_US_CR_LN_ACC + off + 16);
        var uh, um, ul = _us_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _us_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _us_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _us_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_US_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_US_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_US_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _US_CR_LN_LN2H;
    var ln2m: f64 = _US_CR_LN_LN2M;
    var ln2l: f64 = _US_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _us_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _us_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _us_two_sum(u0, a12);
    var bh, bm, bl = _us_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _us_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln by the accurate path alone, for every x.
#must_use
fn _us_cr_ln_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _us_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _US_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _us_ln_acc_td(x, &buf);
    var r: f64 = _us_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# (1 if y is an integer, 1 if y is an odd integer) for a finite y ≠ 0: y = M·2^(f − 1075) with the 53-bit
# significand M; integer when no set bit of M lies below 2^(1075 − f).
#must_use
fn _us_pow_yclass(y: f64): (i64, i64) {
    var uy = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    var f = uy >> 52;
    var m = (uy & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    if (f >= 1075) {
        if (f == 1075) { return (1, m & 1); }
        return (1, 0);                           # |y| ≥ 2^53: even
    }
    if (f < 1023) { return (0, 0); }             # 0 < |y| < 1
    var sh = 1075 - f;
    if ((m & ((1 << sh) - 1)) != 0) { return (0, 0); }
    return (1, (m >> sh) & 1);
}

# RN(mm·2^s) for an integer 1 ≤ mm < 2^62 and an integer |s| < 2^40, by integer rounding: ties to even,
# subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 below half of 2^-1074. Exact, so it rounds exact
# results and exact midpoints right.
#must_use
fn _us_cr_from_int(mm, s): f64 {
    var b = 0;
    var t = mm;
    while (t != 0) {
        t = t >> 1;
        b = b + 1;
    }
    var top = s + b - 1;                         # the exponent of mm·2^s's leading bit
    if (top > 1023) {
        var inf: f64 = _US_INF;
        return inf;
    }
    var lsb = top - 52;                          # the result's last bit, at most 53 bits and not below 2^-1074
    if (lsb < 0 - 1074) { lsb = 0 - 1074; }
    var sh = lsb - s;
    var q = mm;
    if (sh > 0) {
        if (sh > 62) { return 0.0; }
        q = mm >> sh;
        var rem = mm - (q << sh);
        var half = 1 << (sh - 1);
        if (rem > half || (rem == half && (q & 1) == 1)) { q = q + 1; }
    } else {
        lsb = s;
    }
    var qf: f64 = f64_from(q);                   # q ≤ 2^53: exact
    if (lsb >= 0 - 1022) {
        var sc: f64 = _us_cr_pow2(lsb);
        var r: f64 = qf * sc;                    # exact, or +∞ when q·2^lsb = 2^1024
        return r;
    }
    var s1: f64 = _us_cr_pow2(lsb + 1074);       # q·2^lsb = ((q·2^(lsb + 1074))·2^-52)·2^-1022: each step exact
    var s2: f64 = _us_cr_pow2(0 - 52);
    var s3: f64 = _us_cr_pow2(0 - 1022);
    var w: f64 = ((qf * s1) * s2) * s3;
    return w;
}

# M^n for odd integers M ≥ 3 and n ≥ 1, or 0 when it reaches 2^54.
#must_use
fn _us_pow_int54(mm, n): i64 {
    var acc = 1;
    var i = 0;
    while (i < n) {
        if (acc > (0x0040000000000000 / mm)) { return 0; }
        acc = acc * mm;
        i = i + 1;
    }
    if (acc >= 0x0040000000000000) { return 0; }
    return acc;
}

# (1, RN(x^y)) when x^y is an exact double or an exact midpoint (or another value known exactly), else (0, 0);
# x > 0 finite, y finite with 0 < |y| < 2^64. After Lauter and Lefèvre ("An efficient rounding boundary test for
# pow(x, y) in double precision", IEEE TC 2009) and CORE-MATH's pow. Write x = mx·2^ex and y = ±my·2^fy with mx,
# my odd. y is a double, so in lowest terms y = p/2^k (k = max(0, −fy)). If x^y = R is rational then
# R^(2^k) = x^p: when p > 0, unique factorisation makes mx a perfect 2^k-th power, mx = a^(2^k), with 2^k | ex,
# and R = a^p·2^(ex·p/2^k); when p < 0, R's odd part 1/a^|p| is dyadic only for a = 1, mx = 1. A double or a
# midpoint has an odd part below 2^54, so beyond these cases x^y is neither: mx = 1 gives a power of two
# 2^(ex·y) (exact, the tie 2^-1075, or out of range); mx ≥ 3 needs p > 0, a^p < 2^54 (so p ≤ 34) and
# a^(2^k) = mx < 2^53 (so k ≤ 5). In particular y = RN(1/3) has k = 54: x^y is never exact unless x = 1.
#must_use
fn _us_pow_exact(ax: f64, y: f64): (i64, f64) {
    var ux = load64(&ax);
    var mx = ux & 0x000FFFFFFFFFFFFF;
    var ex = 0 - 1074;
    if ((ux >> 52) != 0) {
        mx = mx | 0x0010000000000000;
        ex = (ux >> 52) - 1075;
    }
    while ((mx & 1) == 0) {
        mx = mx >> 1;
        ex = ex + 1;
    }
    var uy = load64(&y);
    var sy = 1;
    if (uy < 0) { sy = 0 - 1; }
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var my = ay & 0x000FFFFFFFFFFFFF;
    var fy = 0 - 1074;
    if ((ay >> 52) != 0) {
        my = my | 0x0010000000000000;
        fy = (ay >> 52) - 1075;
    }
    while ((my & 1) == 0) {
        my = my >> 1;
        fy = fy + 1;
    }
    if (fy >= 0) {                               # y an integer: |y| = my·2^fy
        if (fy >= 12 || my >= 4096) { return (0, 0.0); }   # |y| ≥ 4096: 2^(ex·y) and mx^y are out of reach
        var yi = my << fy;
        if (yi >= 4096) { return (0, 0.0); }
        if (mx == 1) {
            var r1: f64 = _us_cr_from_int(1, ex * yi * sy);
            return (1, r1);
        }
        if (sy < 0) { return (0, 0.0); }
        if (yi > 34) { return (0, 0.0); }
        var mm = _us_pow_int54(mx, yi);
        if (mm == 0) { return (0, 0.0); }
        var r2: f64 = _us_cr_from_int(mm, ex * yi);
        return (1, r2);
    }
    var k = 0 - fy;                              # y = ±my/2^k, k ≥ 1
    var q = 0;
    if (k >= 11) {
        if (ex != 0) { return (0, 0.0); }        # |ex| < 2^11: 2^k ∤ ex
    } else {
        if ((ex & ((1 << k) - 1)) != 0) { return (0, 0.0); }
        q = ex >>> k;
    }
    if (mx == 1) {
        if (q == 0) { return (1, 1.0); }         # x = 1
        if (my >= 4096) { return (0, 0.0); }     # |ex·y| ≥ my: out of range
        var r3: f64 = _us_cr_from_int(1, q * my * sy);
        return (1, r3);
    }
    if (k > 5 || sy < 0 || my > 34) { return (0, 0.0); }
    var a = mx;
    var i = 0;
    while (i < k) {                              # a = mx^(1/2^k), each root exact or none
        var af: f64 = f64_from(a);
        var sf: f64 = f64_sqrt(af);
        var si = f64_to(sf);
        if (si * si != a) { return (0, 0.0); }
        a = si;
        i = i + 1;
    }
    var m2 = _us_pow_int54(a, my);
    if (m2 == 0) { return (0, 0.0); }
    var r4: f64 = _us_cr_from_int(m2, q * my);
    return (1, r4);
}

# The fast kernel for x > 0 finite (bits ux, a subnormal included) and finite y with 0 < |y| < 2^64:
# (RN(x^y), 1), or (0, 0) when the rounding test fails.
#must_use
fn _us_pow_pos_fast(ux, y: f64): (f64, i64) {
    var ui = ux;
    var eb = 0;
    if (ui < 0x0010000000000000) {               # a subnormal x, scaled exactly by 2^54
        var xf: f64 = ui;
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = xf * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var lh, ll, eln = _us_ln_core(ui, eb);
    var zh0: f64 = y * lh;                       # z = y·(lh + ll): Dekker's product, both factors split
    var cy: f64 = 134217729.0 * y;
    var y1: f64 = cy - (cy - y);
    var y2: f64 = y - y1;
    var cl: f64 = 134217729.0 * lh;
    var l1: f64 = cl - (cl - lh);
    var l2: f64 = lh - l1;
    var ze: f64 = ((((y1 * l1) - zh0) + (y1 * l2)) + (y2 * l1)) + (y2 * l2);
    var zl0: f64 = ze + (y * ll);
    var zh: f64 = zh0 + zl0;                     # renormalised (Fast2Sum): |zl| ≤ 2^-44
    var zl: f64 = zl0 - (zh - zh0);
    var azh: f64 = f64_abs(zh);
    if (azh > 708.0) {
        if (zh > 710.0) {
            var inf: f64 = _US_INF;
            return (inf, 1);
        }
        if (zh < -746.0) { return (0.0, 1); }
    }
    var ay: f64 = f64_abs(y);
    var k100: f64 = 0x39B0000000000000;          # 2^-100
    var k69: f64 = 0x3BA0000000000000;           # 2^-69
    var errz: f64 = (ay * eln) + (azh * k100);
    var err: f64 = (errz * 2.0625) + k69;
    var hi, lo, e = _us_exp_core(zh, zl);
    if (e > 0 - 1022 && e < 1024) {             # a normal result: _us_exp_fin's first case, inline
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0.0, 0); }
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var rn: f64 = u * sc;
        return (rn, 1);
    }
    var ok, r = _us_exp_fin(hi, lo, e, err);
    return (r, ok);
}

# The accurate kernel for the same arguments: an exact or midpoint result exactly, else the triple-double path.
#must_use
fn _us_pow_pos_acc(ax: f64, y: f64): f64 {
    var found, rx = _us_pow_exact(ax, y);
    if (found == 1) { return rx; }
    var lb: f64[3];
    _us_ln_acc_td(ax, &lb);
    var z0, z1, z2 = _us_td_mul_d(lb[0], lb[1], lb[2], y);
    if (z0 > 710.0) {
        var inf: f64 = _US_INF;
        return inf;
    }
    if (z0 < -746.0) { return 0.0; }
    var eb: f64[3];
    var e = _us_exp_acc_core(z0, z1, z2, &eb);
    var r: f64 = _us_cr_finish(e, eb[0], eb[1], eb[2]);
    return r;
}

# Every argument outside the fast path's common case (x positive normal, 0 < |y| < 2^64): the special values,
# a negative x (the sign from y's parity), a subnormal x, |y| ≥ 2^64. acc = 0 runs the fast kernel, 1 the
# accurate one; (result, 1), or (0, 0) when the fast kernel's test fails.
#must_use
fn _us_pow_cases(x: f64, y: f64, acc): (f64, i64) {
    if (y == 0.0) { return (1.0, 1); }           # pow(x, ±0) = 1, x NaN included
    if (x == 1.0) { return (1.0, 1); }           # pow(+1, y) = 1, y NaN included
    if (x != x) { return (x, 1); }
    if (y != y) { return (y, 1); }
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    var inf: f64 = _US_INF;
    if (ay == inf) {
        if (ax == 1.0) { return (1.0, 1); }      # pow(−1, ±∞) = 1
        if (ax < 1.0) {
            if (y > 0.0) { return (0.0, 1); }
            return (inf, 1);
        }
        if (y > 0.0) { return (inf, 1); }
        return (0.0, 1);
    }
    var yint, yodd = _us_pow_yclass(y);
    if (ax == 0.0) {
        if (y < 0.0) {
            if (yodd == 1) {
                var pz: f64 = 1.0 / x;           # ±∞ with x's sign
                return (pz, 1);
            }
            return (inf, 1);
        }
        if (yodd == 1) { return (x, 1); }        # ±0
        return (0.0, 1);
    }
    if (ax == inf) {
        var res: f64 = inf;
        if (y < 0.0) { res = 0.0; }
        if (x < 0.0 && yodd == 1) { res = -res; }
        return (res, 1);
    }
    var neg = 0;
    if (x < 0.0) {
        if (yint == 0) {
            var nan: f64 = _us_nan();
            return (nan, 1);
        }
        neg = yodd;
    }
    var r: f64 = 0.0;
    var ok = 1;
    var big: f64 = 0x43F0000000000000;           # 2^64: |y·ln|x|| ≥ 2^64·2^-53 > 746 unless |x| = 1
    if (ay >= big) {
        if (ax == 1.0) {
            r = 1.0;
        } else {
            r = 0.0;
            if ((ax > 1.0) == (y > 0.0)) { r = inf; }
        }
    } else {
        if (acc == 1) {
            r = _us_pow_pos_acc(ax, y);
        } else {
            var rf, okf = _us_pow_pos_fast(load64(&ax), y);
            r = rf;
            ok = okf;
        }
    }
    if (neg == 1) { r = -r; }
    return (r, ok);
}

# pow(x, y) = x^y, correctly rounded, with the special values above. Mirrors `f64::powf`.
#must_use
fn _us_cr_pow(x: f64, y: f64): f64 {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # The common case of _us_cr_pow_fast, dispatched here to save a call: x in [DBL_MIN, DBL_MAX] and
    # 0 < |y| < 2^64.
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _us_pow_pos_fast(ux, y);
            if (ok == 1) { return r; }
            var a: f64 = _us_pow_pos_acc(x, y);
            return a;
        }
    }
    var r2, ok2 = _us_pow_cases(x, y, 0);
    if (ok2 == 1) { return r2; }
    var a2: f64 = _us_cr_pow_acc(x, y);
    return a2;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails.
#must_use
fn _us_cr_pow_fast(x: f64, y: f64): (f64, i64) {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # x in [DBL_MIN, DBL_MAX] and 0 < |y| < 2^64, as unsigned range tests (the trick of _us_cr_exp).
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _us_pow_pos_fast(ux, y);
            return (r, ok);
        }
    }
    var r2, ok2 = _us_pow_cases(x, y, 0);
    return (r2, ok2);
}

# pow by the accurate path alone, for every (x, y).
#must_use
fn _us_cr_pow_acc(x: f64, y: f64): f64 {
    var r, ok = _us_pow_cases(x, y, 1);
    return r;
}

# The fast atan core for n = nh + nl, d = dh + dl with 0 < n ≤ d (1 + 2^-50), dh in [1/2, 2), nh ≥ 2^-62·dh:
# (hi, lo, err) for offset ± atan(n/d) by oct.
#must_use
fn _us_atan_core(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, f64, f64) {
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u: f64 = nh + np1;                    # TwoSum(nh, −c·d1)
        var ub: f64 = u - nh;
        var ue: f64 = (nh - (u - ub)) + (np1 - ub);
        sh = u;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v: f64 = dh + q1;                     # TwoSum(dh, c·n1)
        var vb: f64 = v - dh;
        var ve: f64 = (dh - (v - vb)) + (q1 - vb);
        eh = v;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _US_CR_SC_A3;
    var a5: f64 = _US_CR_SC_A5;
    var a7: f64 = _US_CR_SC_A7;
    var a9: f64 = _US_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_US_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_US_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _US_CR_SC_PIH;
        om = _US_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _US_CR_SC_PIO2H;
        om = _US_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
    var err: f64 = ahi * k68;
    return (hi, lo, err);
}

# The fast atan core with its rounding test: (RN(result), 1) or (0, 0).
#must_use
fn _us_atan_fast(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, i64) {
    var hi, lo, err = _us_atan_core(nh, nl, dh, dl, oct);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u != v) { return (0.0, 0); }
    return (u, 1);
}

# A triple-double renormalised (two bottom-up TwoSum passes): after a cancellation _us_td_add's leading word can
# be far from the sum (its last renormalisation does not see the rounded third-order term), and the corrections
# below need the leading word to be the sum to 2^-52. The sum is unchanged (every step is exact).
#must_use
fn _us_td_norm(a0: f64, a1: f64, a2: f64): (f64, f64, f64) {
    var s, e = _us_two_sum(a1, a2);
    var h, u = _us_two_sum(a0, s);
    var m, l = _us_two_sum(u, e);
    var h2, u2 = _us_two_sum(h, m);
    var m2, l2 = _us_two_sum(u2, l);
    return (h2, m2, l2);
}

# (a0, a1, a2)/(b0, b1, b2) as a triple-double at out[0..2], b ≠ 0 normalised: q0 = a0/b0 (a renormalised first),
# then two corrections from the remainder a − q·b, computed in triple-double (each below 2^-153 of a) and
# renormalised: relative error below 2^-151.
fn _us_td_div(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64, out) {
    var n0, n1, n2 = _us_td_norm(a0, a1, a2);
    var q0: f64 = n0 / b0;
    var t0, t1, t2 = _us_td_mul_d(b0, b1, b2, q0);
    var ra, rb, rc = _us_td_add(n0, n1, n2, -t0, -t1, -t2);
    var r0, r1, r2 = _us_td_norm(ra, rb, rc);
    var q1: f64 = r0 / b0;
    var u0, u1, u2 = _us_td_mul_d(b0, b1, b2, q1);
    var sa, sb, sc = _us_td_add(r0, r1, r2, -u0, -u1, -u2);
    var s0, s1, s2 = _us_td_norm(sa, sb, sc);
    var q2: f64 = s0 / b0;
    var h, m0 = _us_fast_two_sum(q0, q1);
    var m, l = _us_two_sum(m0, q2);
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
}

# The accurate atan core: RN(offset ± atan(n/d)) by oct, for triple-doubles 0 < n ≤ d (1 + 2^-50), n0 ≥ 2^-62·d0.
#must_use
fn _us_atan_acc(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct): f64 {
    var rb: f64[3];
    _us_atan_acc_td(n0, n1, n2, d0, d1, d2, oct, &rb);
    var r: f64 = _us_rn3(rb[0], rb[1], rb[2]);
    return r;
}

# offset ± atan(n/d) as a triple-double at out[0..2] (the accurate atan core before its rounding).
fn _us_atan_acc_td(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct, out) {
    var zh: f64 = n0 / d0;
    var cz: f64 = zh + 26388279066624.0;
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var a0: f64 = n0;
    var a1: f64 = n1;
    var a2: f64 = n2;
    var b0: f64 = d0;
    var b1: f64 = d1;
    var b2: f64 = d2;
    if (j != 0) {                                 # num = n − c·d, den = d + c·n
        var cd0, cd1, cd2 = _us_td_mul_d(d0, d1, d2, c);
        var x0, x1, x2 = _us_td_add(n0, n1, n2, -cd0, -cd1, -cd2);
        var cn0, cn1, cn2 = _us_td_mul_d(n0, n1, n2, c);
        var y0, y1, y2 = _us_td_add(d0, d1, d2, cn0, cn1, cn2);
        a0 = x0;
        a1 = x1;
        a2 = x2;
        b0 = y0;
        b1 = y1;
        b2 = y2;
    }
    var db: f64[3];
    _us_td_div(a0, a1, a2, b0, b1, b2, &db);
    var dh: f64 = db[0];
    var dm: f64 = db[1];
    var dl: f64 = db[2];
    var wh, wm, wl = _us_td_mul(dh, dm, dl, dh, dm, dl);
    var ph: f64 = load64(&_US_CR_ATAN_ACC + 168);  # 1/17 (index 3·(8 − 1))
    var pm: f64 = load64(&_US_CR_ATAN_ACC + 176);
    var pl: f64 = load64(&_US_CR_ATAN_ACC + 184);
    var k = 7;
    while (k >= 1) {                              # (−1)^k/(2k + 1) + w·P
        var th, tm, tl = _us_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 1) * 24;
        var ch: f64 = load64(&_US_CR_ATAN_ACC + off);
        var cm: f64 = load64(&_US_CR_ATAN_ACC + off + 8);
        var cl: f64 = load64(&_US_CR_ATAN_ACC + off + 16);
        var uh, um, ul = _us_td_add(ch, cm, cl, th, tm, tl);
        ph = uh;
        pm = um;
        pl = ul;
        k = k - 1;
    }
    var vh, vm, vl = _us_td_mul(wh, wm, wl, ph, pm, pl);
    var xh, xm, xl = _us_td_mul(vh, vm, vl, dh, dm, dl);
    var th2, tm2, tl2 = _us_td_add(dh, dm, dl, xh, xm, xl);          # atan δ
    var ah: f64 = load64(&_US_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_US_CR_ATAN_T + 24 * j + 8);
    var al: f64 = load64(&_US_CR_ATAN_T + 24 * j + 16);
    var gh, gm, gl = _us_td_add(ah, am, al, th2, tm2, tl2);          # θ
    if (oct == 0) {
        store64(out, gh);
        store64(out + 8, gm);
        store64(out + 16, gl);
        return;
    }
    var oh: f64 = _US_CR_SC_PIO2H;
    var om: f64 = _US_CR_SC_PIO2M;
    var ol: f64 = _US_CR_SC_PIO2L;
    if (oct == 1) {
        oh = _US_CR_SC_PIH;
        om = _US_CR_SC_PIM;
        ol = _US_CR_SC_PIL;
    }
    if (oct != 3) {
        gh = -gh;
        gm = -gm;
        gl = -gl;
    }
    var rh, rm, rl = _us_td_add(oh, om, ol, gh, gm, gl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# A positive finite nonzero double from its bits b as (m, e), b's value = m·2^e with m in [1, 2).
#must_use
fn _us_frexp(b): (f64, i64) {
    var bb = b;
    var eo = 0;
    if ((b >> 52) == 0) {                         # subnormal: scale by 2^54 (exact)
        var v: f64 = b;
        var p54: f64 = 0x4350000000000000;
        var vs: f64 = v * p54;
        bb = load64(&vs);
        eo = 0 - 54;
    }
    var mb = (bb & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var m: f64 = mb;
    return (m, (bb >> 52) - 1023 + eo);
}

# atan2 for |n/d| < 2^-59 (n = mn·2^en, d = md·2^ed, mn and md in [1, 2), en − ed ≤ −60), unsigned:
# π/2 ∓ atan(n/d) rounds to π/2 (the quotient is below 2^-55 and π/2 is 2^-54.15 inside its rounding interval),
# π − atan(n/d) to π (likewise, 2^-52.86 inside); atan(q) itself lies in (q − q³/3, q), with q²/3 < 2^-119
# below any distance from a non-midpoint quotient of two doubles to a rounding boundary (at least 2^-107 of q,
# or 2^-1128 on the subnormal grid), so it rounds as q does unless q is exactly a midpoint (possible only in
# the subnormal range, e.g. 3·2^-1075 = atan2(3·2^-60, 2^1015)), where it rounds toward zero. q = qs·2^(en − ed)
# with qs = mn/md as q0 + q1 + q2 (Dekker's division, the remainders exact): an exact qs (q1 = 0) is lowered by
# q0·2^-100 to break the tie, and _us_cr_finish rounds once, at the subnormal grid when the result is subnormal.
#must_use
fn _us_atan2_tiny(mn: f64, md: f64, e, oct): f64 {
    if (oct >= 2) {
        var p2: f64 = _US_CR_SC_PIO2H;
        return p2;
    }
    if (oct == 1) {
        var pi: f64 = _US_CR_SC_PIH;
        return pi;
    }
    if (e < 0 - 1077) { return 0.0; }             # q < 2^-1076: below half of 2^-1074
    var q0: f64 = mn / md;
    var p, pe = _us_two_prod(q0, md);
    var r1: f64 = (mn - p) - pe;                  # exact
    var q1: f64 = r1 / md;
    var p2b, pe2 = _us_two_prod(q1, md);
    var r2: f64 = (r1 - p2b) - pe2;
    var q2: f64 = r2 / md;
    var tiny: f64 = 0x39B0000000000000;           # 2^-100
    if (r1 == 0.0) {
        q1 = -(q0 * tiny);
        q2 = 0.0;
    }
    var ee = e;
    if (q0 < 1.0) {                               # into [1, 2) for _us_cr_finish: exact
        q0 = q0 * 2.0;
        q1 = q1 * 2.0;
        q2 = q2 * 2.0;
        ee = ee - 1;
    }
    var r: f64 = _us_cr_finish(ee, q0, q1, q2);
    return r;
}

# atan2(y, x) for finite nonzero y and x, |y| = ay, |x| = ax (bits), the sign of x xneg: by the fast path
# (acc = 0: (result, 1) or (0, 0)) or the accurate one (acc = 1), unsigned.
#must_use
fn _us_atan2_pos(ay, ax, xneg, acc): (f64, i64) {
    var nb = ay;
    var db = ax;
    var oct = 0;
    if (xneg == 1) { oct = 1; }
    if (ay > ax) {
        nb = ax;
        db = ay;
        oct = 2;
        if (xneg == 1) { oct = 3; }
    }
    var mn, en = _us_frexp(nb);
    var md, ed = _us_frexp(db);
    if (en - ed <= 0 - 60) {
        var t: f64 = _us_atan2_tiny(mn, md, en - ed, oct);
        return (t, 1);
    }
    var sc: f64 = _us_cr_pow2(en - ed);
    var n: f64 = mn * sc;                         # exact: n/d ≥ 2^-60
    if (acc == 1) {
        var a: f64 = _us_atan_acc(n, 0.0, 0.0, md, 0.0, 0.0, oct);
        return (a, 1);
    }
    var r, ok = _us_atan_fast(n, 0.0, md, 0.0, oct);
    return (r, ok);
}

# The special values of atan2 (C99 Annex F, as glibc and Rust's f64::atan2): (result, 1), or (0, 0) for finite
# nonzero y and x. A NaN argument is returned as it is (y's first).
#must_use
fn _us_atan2_special(y: f64, x: f64): (f64, i64) {
    var uy = load64(&y);
    var ux = load64(&x);
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ay > 0x7FF0000000000000) { return (y, 1); }
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    var r: f64 = 0.0;
    var found = 0;
    if (ay == 0) {                                # atan2(±0, x): ±0 for x ≥ +0, ±π for x ≤ −0
        found = 1;
        if (ux < 0) { r = _US_CR_SC_PIH; }
    } elif (ax == 0) {                            # atan2(y ≠ 0, ±0) = ±π/2
        found = 1;
        r = _US_CR_SC_PIO2H;
    } elif (ax == 0x7FF0000000000000) {
        found = 1;
        if (ay == 0x7FF0000000000000) {           # ±π/4, ±3π/4
            r = _US_CR_SC_PIO4;
            if (ux < 0) { r = _US_CR_SC_PI3O4; }
        } elif (ux < 0) {                         # finite y, x = −∞: ±π; x = +∞: ±0
            r = _US_CR_SC_PIH;
        }
    } elif (ay == 0x7FF0000000000000) {           # y = ±∞, x finite: ±π/2
        found = 1;
        r = _US_CR_SC_PIO2H;
    }
    if (found == 0) { return (0.0, 0); }
    if (uy < 0) { r = -r; }
    return (r, 1);
}

# atan2(y, x), correctly rounded, the angle of (x, y) in [−π, π]. Mirrors `f64::atan2`.
#must_use
fn _us_cr_atan2(y: f64, x: f64): f64 {
    var uy0 = load64(&y);
    var ux0 = load64(&x);
    var ay0 = uy0 & 0x7FFFFFFFFFFFFFFF;
    var ax0 = ux0 & 0x7FFFFFFFFFFFFFFF;
    var ey = ay0 >> 52;
    var ex = ax0 >> 52;
    # Both normal and finite (biased exponents 1 … 2046, an unsigned range test each) with |n/d| ≥ 2^-59: the
    # scaling of _us_atan2_pos done on the bits (n's significand at exponent en − ed, d's at 0: the same
    # doubles), then the fast core and its test, inline.
    if (((ey - 1) ^ 0x8000000000000000) < 0x80000000000007FE) {
        if (((ex - 1) ^ 0x8000000000000000) < 0x80000000000007FE) {
            var nb = ay0;
            var db = ax0;
            var en = ey;
            var ed = ex;
            var oct = 0;
            if (ux0 < 0) { oct = 1; }
            if (ay0 > ax0) {
                nb = ax0;
                db = ay0;
                en = ex;
                ed = ey;
                oct = oct + 2;
            }
            if (ed - en < 60) {
                var nbits = (nb & 0x000FFFFFFFFFFFFF) | ((1023 + en - ed) << 52);
                var dbits = (db & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
                var n: f64 = nbits;
                var d: f64 = dbits;
                var hi, lo, err = _us_atan_core(n, 0.0, d, 0.0, oct);
                var u: f64 = hi + (lo - err);
                var v: f64 = hi + (lo + err);
                if (u != v) { u = _us_atan_acc(n, 0.0, 0.0, d, 0.0, 0.0, oct); }
                if (uy0 < 0) { u = -u; }
                return u;
            }
        }
    }
    var s, sp = _us_atan2_special(y, x);
    if (sp == 1) { return s; }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _us_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 0);
    if (ok == 0) {
        var a, oka = _us_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 1);
        r = a;
    }
    if (uy < 0) { r = -r; }
    return r;
}

# The fast path alone: (atan2(y, x), 1), or (0, 0) when its rounding test fails.
#must_use
fn _us_cr_atan2_fast(y: f64, x: f64): (f64, i64) {
    var s, sp = _us_atan2_special(y, x);
    if (sp == 1) { return (s, 1); }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _us_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 0);
    if (ok == 0) { return (0.0, 0); }
    if (uy < 0) { r = -r; }
    return (r, 1);
}

# atan2(y, x) by the accurate path alone.
#must_use
fn _us_cr_atan2_acc(y: f64, x: f64): f64 {
    var s, sp = _us_atan2_special(y, x);
    if (sp == 1) { return s; }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _us_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 1);
    if (uy < 0) { r = -r; }
    return r;
}

# ══ ushma's own (not vendored): correctly rounded tanh (ADR 0004, M0 part 2c-3) ══════════════════════════════════
#
# tanh(x) = sgn(x)·tanh(a), a = |x|: tanh is odd and RN is symmetric, so RN(tanh(−x)) = −RN(tanh(x)) exactly.
# - NaN gives that NaN; ±0 and every a < 2^-27 give x: 0 < a − tanh a < a³/3, and a³/3 < 2^-54·2^e for a in
#   [2^e, 2^(e+1)) whenever a² < 3·2^-54 (a < √3·2^-27), so tanh a lies strictly inside the rounding interval of a
#   (its half gap below is at least 2^(e−54); subnormals included).
# - a > TANH_ONE (19.061547465398494, src/mathx_data.cyr, MPFR's last double whose tanh rounds below 1) and ±∞ give ±1.
# - Otherwise tanh a = E/(E + 2) with E = expm1(2a) (2a exact). The map E -> E/(E + 2) has relative sensitivity
#   2/(E + 2) ≤ 1, so E's relative error is not amplified.
#   Fast path: E = eh + el in double-double with an absolute bound err (the vendored expm1 fast path's own
#   arithmetic, _us_expm1_dd); D = E + 2 (TwoSum, exact up to el's addition); Q = qh + ql = E/D by one corrected
#   division (qh = RN(eh/dh), the remainder from TwoProduct(qh, dh), each step below 2^-104·Q, so below 2^-101·Q
#   altogether). The bound on Q is err·2/dh² (the sensitivity, D ≥ 2 so dh² ≥ 4) times 1 + 2^-10 (the bound's own
#   rounding), plus 2^-99·qh; the rounding test is expm1's (u = qh + (ql − bound), v = qh + (ql + bound), equal).
#   Accurate path: E in triple-double (the vendored accurate expm1's arithmetic, _us_expm1_td: 2^-152 relative),
#   D = E + 2 (exact renormalisation), Q = E/D by _us_td_div (2^-151), so Q is within 2^-149 of tanh a, then RN3.
# tanh is transcendental at every algebraic x ≠ 0 (otherwise e^(2x) = (1 + t)/(1 − t) would be algebraic), so no
# argument but 0 is exact or a tie. The accurate path is correct whenever no double's tanh lies within 2^-149
# (relative) of a rounding boundary; scripts/oracle/cr_verify.py checks it against MPFR on ≥ 10^6 arguments per
# target with that path forced.

# expm1(x) as a double-double with an absolute error bound, for 2^-53 ≤ |x| ≤ 708: (hi, lo, err) with
# |hi + lo − expm1(x)| ≤ err. The arithmetic of _us_cr_expm1_fast's two branches, without its rounding test.
#must_use
fn _us_expm1_dd(x: f64): (f64, f64, f64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {               # |x| < 2^-6
        var p: f64 = x * x;
        var cx: f64 = 134217729.0 * x;
        var x1: f64 = cx - (cx - x);
        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _US_CR_EXPM1_Q3;
        var k4: f64 = _US_CR_EXPM1_Q4;
        var k5: f64 = _US_CR_EXPM1_Q5;
        var k6: f64 = _US_CR_EXPM1_Q6;
        var k7: f64 = _US_CR_EXPM1_Q7;
        var k8: f64 = _US_CR_EXPM1_Q8;
        var k9: f64 = _US_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
        var hs: f64 = x + hp;
        var ht: f64 = hp - (hs - x);
        var lo: f64 = (ht + (pe * 0.5)) + x3;
        var ex3: f64 = f64_abs(x3);
        var exa: f64 = f64_abs(x);
        var c49: f64 = 0x3CE0000000000000;      # 2^-49
        var c100: f64 = 0x39B0000000000000;     # 2^-100
        var err: f64 = (ex3 * c49) + (exa * c100);
        return (hs, lo, err);
    }
    var hi, lo2, e = _us_exp_core(x, 0.0);
    var hh: f64 = 0.0;
    var ll: f64 = lo2;
    var sc: f64 = 1.0;
    if (e == 0) {
        hh = hi - 1.0;                           # exact: hi in [0.9993, 1.9987]
    } else {
        sc = _us_cr_pow2(e);
        var hsc: f64 = hi * sc;
        if (e > 0) {
            hh = hsc - 1.0;
            var t1: f64 = -1.0 - (hh - hsc);
            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    return (hh, ll, errs);
}

# expm1(x) as a triple-double at out[0..2], for 2^-53 ≤ |x| ≤ 708 and E < 120: the arithmetic of _us_cr_expm1_acc
# without its final rounding (2^-152 relative, as measured there).
fn _us_expm1_td(x: f64, out) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {
        var sh: f64 = load64(&_US_CR_EXP_ACC + 360);   # 1/17! (index 3·(17 − 2))
        var sm: f64 = load64(&_US_CR_EXP_ACC + 368);
        var sl: f64 = load64(&_US_CR_EXP_ACC + 376);
        var n = 16;
        while (n >= 2) {
            var th, tm, tl = _us_td_mul_d(sh, sm, sl, x);
            var off = (n - 2) * 24;
            var ch: f64 = load64(&_US_CR_EXP_ACC + off);
            var cm: f64 = load64(&_US_CR_EXP_ACC + off + 8);
            var cl: f64 = load64(&_US_CR_EXP_ACC + off + 16);
            var uh, um, ul = _us_td_add(ch, cm, cl, th, tm, tl);
            sh = uh;
            sm = um;
            sl = ul;
            n = n - 1;
        }
        var vh, vm, vl = _us_td_mul_d(sh, sm, sl, x);
        var wh, wm, wl = _us_td_add_d(vh, vm, vl, 1.0);
        var ph, pm, pl = _us_td_mul_d(wh, wm, wl, x);
        store64(out, ph);
        store64(out + 8, pm);
        store64(out + 16, pl);
        return 0;
    }
    var buf: f64[3];
    var e = _us_exp_acc_core(x, 0.0, 0.0, &buf);
    var sc: f64 = _us_cr_pow2(e);
    var bh: f64 = buf[0] * sc;
    var bm: f64 = buf[1] * sc;
    var bl: f64 = buf[2] * sc;
    var dh, dm, dl = _us_td_add_d(bh, bm, bl, -1.0);
    store64(out, dh);
    store64(out + 8, dm);
    store64(out + 16, dl);
    return 0;
}

# tanh(x), correctly rounded (the analysis above). Mirrors `f64::tanh`.
#must_use
fn _us_cr_tanh(x: f64): f64 {
    var y, ok = _us_cr_tanh_fast(x);
    if (ok == 1) { return y; }
    var z: f64 = _us_cr_tanh_acc(x);
    return z;
}

# The fast path alone: (RN(tanh x), 1), or (0, 0) when the rounding test fails and the accurate path must decide.
#must_use
fn _us_cr_tanh_fast(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return (x, 1); }   # |x| < 2^-27, ±0, subnormals: tanh x rounds to x
    var a: f64 = ax;                             # |x|
    var one: f64 = _US_CR_TANH_ONE;
    if (a > one) {                               # ±∞ included
        if (x < 0.0) { return (-1.0, 1); }
        return (1.0, 1);
    }
    var y: f64 = a + a;                          # 2a, exact
    var eh0, el0, err = _us_expm1_dd(y);
    var eh, el = _us_fast_two_sum(eh0, el0);     # E = eh + el, normalised (|el0| < |eh0|)
    var dh, dt = _us_two_sum(2.0, eh);
    var dl: f64 = dt + el;                       # D = E + 2 = dh + dl
    var qh: f64 = eh / dh;
    var p, pe = _us_two_prod(qh, dh);
    var r: f64 = (((eh - p) - pe) + el) - (qh * dl);
    var ql: f64 = r / dh;                        # Q = qh + ql = E/D to 2^-101
    var slack: f64 = 1.0009765625;               # 1 + 2^-10
    var c99: f64 = 0x39C0000000000000;           # 2^-99
    var bound: f64 = ((((err * 2.0) / dh) / dh) * slack) + (qh * c99);
    var u: f64 = qh + (ql - bound);
    var v: f64 = qh + (ql + bound);
    if (u != v) { return (0.0, 0); }
    if (x < 0.0) {
        var nu: f64 = 0.0 - u;
        return (nu, 1);
    }
    return (u, 1);
}

# tanh by the accurate path alone, for every x (the fast path's fallback, and a test hook).
#must_use
fn _us_cr_tanh_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return x; }
    var a: f64 = ax;
    var one: f64 = _US_CR_TANH_ONE;
    if (a > one) {
        if (x < 0.0) { return -1.0; }
        return 1.0;
    }
    var y: f64 = a + a;
    var e: f64[3];
    _us_expm1_td(y, &e);
    var dh, dm, dl = _us_td_add_d(e[0], e[1], e[2], 2.0);
    var q: f64[3];
    _us_td_div(e[0], e[1], e[2], dh, dm, dl, &q);
    var r: f64 = _us_rn3(q[0], q[1], q[2]);
    if (x < 0.0) {
        var nr: f64 = 0.0 - r;
        return nr;
    }
    return r;
}
