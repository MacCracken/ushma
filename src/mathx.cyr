}

# e^x for 2^-54 ≤ |x| < 2^-30, where Lefèvre–Muller's bound is 2^-158 (e^x is then 1 + x + x²/2 + …, and
# 1 + x is a short exact number): 1 + x = a + b exactly, q = x²/2 + x³/6 + x⁴/24 + x⁵/120 as a double-double
# to 2^-165 absolute (x² and x³ by TwoProduct, x³/6 by a corrected division; x⁶/720 < 2^-189 dropped), and
# RN(a + b + RO(qh + ql)) by _us_rn3 (the rounding-to-odd argument of _us_cr_finish: ulp(x) is an even
# multiple of ulp(q)).
#must_use
fn _us_exp_tiny_acc(x: f64): f64 {
    var p, pe = _us_two_prod(x, x);
    var a, ae = _us_two_prod(x, p);
    var x3l: f64 = ae + (x * pe);
    var d3h: f64 = a / 6.0;
    var pp, pe2 = _us_two_prod(d3h, 6.0);
    var d3l: f64 = (((a - pp) - pe2) + x3l) / 6.0;
    var ax: f64 = a * x;
    var x4: f64 = ax / 24.0;
    var x5: f64 = (ax * x) / 120.0;
    var hp: f64 = p * 0.5;
    var t, te = _us_two_sum(hp, d3h);
    var lo: f64 = ((((pe * 0.5) + te) + d3l) + x4) + x5;
    var qh, ql = _us_fast_two_sum(t, lo);
    var a1, b1 = _us_fast_two_sum(1.0, x);
    var v: f64 = _us_ro_sum(qh, ql);
    var r: f64 = _us_rn3(a1, b1, v);
    return r;
}

# e^x by the accurate path alone, for every x (the fast path's fallback, and a test hook).
#must_use
fn _us_cr_exp_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return 1.0; }
    var ovf: f64 = _US_CR_EXP_OVF;
    var unf: f64 = _US_CR_EXP_UNF;
