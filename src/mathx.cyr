    var vh, vm, vl = _us_td_mul(r0, r1, r2, sh, sm, sl);
    var wh, wm, wl = _us_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _us_td_mul(r0, r1, r2, wh, wm, wl);     # e^r − 1
    var ta: f64 = load64(&_US_CR_EXP_T + ti);
    var tb: f64 = load64(&_US_CR_EXP_T + ti + 8);
    var tc: f64 = load64(&_US_CR_EXP_T + ti + 16);
    var td: f64 = load64(&_US_CR_EXP_T + ti + 24);
    var t0, t1a = _us_fast_two_sum(ta, tb);
    var t1, t2a = _us_fast_two_sum(t1a, tc);
