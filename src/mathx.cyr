            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    var u2: f64 = hh + (ll - errs);
    var v2: f64 = hh + (ll + errs);
    if (u2 == v2) { return (u2, 1); }
    return (0.0, 0);
}

