# ushma — Cyrius port
# Ported from 11046 lines of Rust

# Stdlib auto-included via cyrius.cyml

# Smoke entry point: initializes the allocator and prints a ready line. The library itself
# ships as the [lib] / [lib.ai] bundles (cyrius distlib); this binary only proves the build links.
fn main() {
    alloc_init();
    println("ushma ready");
    return 0;
}

var r = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(r);
