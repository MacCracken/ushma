# ushma — Cyrius port
# Ported from 11046 lines of Rust

# Stdlib auto-included via cyrius.cyml. The [lib] modules, in cyrius.cyml's order, so `cyrius build` compiles them all.
include "src/constants.cyr"
include "src/constants_private.cyr"
include "src/error.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/validate.cyr"
include "src/logging.cyr"
include "src/json.cyr"
include "src/material_data.cyr"
include "src/material.cyr"
include "src/transfer.cyr"
include "src/state_data.cyr"
include "src/state.cyr"
include "src/phase_data.cyr"
include "src/chem_data.cyr"
include "src/steam_data.cyr"

# Smoke entry point: initializes the allocator and prints a ready line. The library itself
# ships as the [lib] / [lib.ai] bundles (cyrius distlib); this binary only proves the build links.
fn main() {
    alloc_init();
    println("ushma ready");
    return 0;
}

var r = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(r);
