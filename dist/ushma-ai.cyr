# (−1)^k/(2k + 1) for k = 1 … 8 as triple-doubles (index 3·(k − 1)): the accurate atan series.
var _US_CR_ATAN_ACC: i64[24] = {
    0xBFD5555555555555, 0xBC75555555555555, 0xB915555555555555,
    0x3FC999999999999A, 0xBC6999999999999A, 0x390999999999999A,
    0xBFC2492492492492, 0xBC62492492492492, 0xB902492492492492,
    0x3FBC71C71C71C71C, 0x3C5C71C71C71C71C, 0x38FC71C71C71C71C,
    0xBFB745D1745D1746, 0x3C4745D1745D1746, 0xB8D745D1745D1746,
    0x3FB3B13B13B13B14, 0xBC53B13B13B13B14, 0x38F3B13B13B13B14,
    0xBFB1111111111111, 0xBC31111111111111, 0xB8B1111111111111,
    0x3FAE1E1E1E1E1E1E, 0x3C2E1E1E1E1E1E1E, 0x38AE1E1E1E1E1E1E
