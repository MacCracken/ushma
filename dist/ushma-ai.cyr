    store64(out + 8, rm);
    store64(out + 16, rl);
}

# A positive finite nonzero double from its bits b as (m, e), b's value = m·2^e with m in [1, 2).
#must_use
fn _us_frexp(b): (f64, i64) {
    var bb = b;
    var eo = 0;
    if ((b >> 52) == 0) {                         # subnormal: scale by 2^54 (exact)
        var v: f64 = b;
        var p54: f64 = 0x4350000000000000;
        var vs: f64 = v * p54;
        bb = load64(&vs);
        eo = 0 - 54;
    }
    var mb = (bb & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var m: f64 = mb;
    return (m, (bb >> 52) - 1023 + eo);
}

# atan2 for |n/d| < 2^-59 (n = mn·2^en, d = md·2^ed, mn and md in [1, 2), en − ed ≤ −60), unsigned:
# π/2 ∓ atan(n/d) rounds to π/2 (the quotient is below 2^-55 and π/2 is 2^-54.15 inside its rounding interval),
# π − atan(n/d) to π (likewise, 2^-52.86 inside); atan(q) itself lies in (q − q³/3, q), with q²/3 < 2^-119
# below any distance from a non-midpoint quotient of two doubles to a rounding boundary (at least 2^-107 of q,
# or 2^-1128 on the subnormal grid), so it rounds as q does unless q is exactly a midpoint (possible only in
# the subnormal range, e.g. 3·2^-1075 = atan2(3·2^-60, 2^1015)), where it rounds toward zero. q = qs·2^(en − ed)
# with qs = mn/md as q0 + q1 + q2 (Dekker's division, the remainders exact): an exact qs (q1 = 0) is lowered by
# q0·2^-100 to break the tie, and _us_cr_finish rounds once, at the subnormal grid when the result is subnormal.
#must_use
fn _us_atan2_tiny(mn: f64, md: f64, e, oct): f64 {
    if (oct >= 2) {
        var p2: f64 = _US_CR_SC_PIO2H;
        return p2;
    }
    if (oct == 1) {
        var pi: f64 = _US_CR_SC_PIH;
        return pi;
    }
    if (e < 0 - 1077) { return 0.0; }             # q < 2^-1076: below half of 2^-1074
    var q0: f64 = mn / md;
    var p, pe = _us_two_prod(q0, md);
    var r1: f64 = (mn - p) - pe;                  # exact
    var q1: f64 = r1 / md;
    var p2b, pe2 = _us_two_prod(q1, md);
    var r2: f64 = (r1 - p2b) - pe2;
    var q2: f64 = r2 / md;
    var tiny: f64 = 0x39B0000000000000;           # 2^-100
    if (r1 == 0.0) {
        q1 = -(q0 * tiny);
        q2 = 0.0;
    }
    var ee = e;
    if (q0 < 1.0) {                               # into [1, 2) for _us_cr_finish: exact
        q0 = q0 * 2.0;
        q1 = q1 * 2.0;
        q2 = q2 * 2.0;
        ee = ee - 1;
    }
    var r: f64 = _us_cr_finish(ee, q0, q1, q2);
    return r;
}

# atan2(y, x) for finite nonzero y and x, |y| = ay, |x| = ax (bits), the sign of x xneg: by the fast path
# (acc = 0: (result, 1) or (0, 0)) or the accurate one (acc = 1), unsigned.
#must_use
fn _us_atan2_pos(ay, ax, xneg, acc): (f64, i64) {
    var nb = ay;
    var db = ax;
    var oct = 0;
    if (xneg == 1) { oct = 1; }
    if (ay > ax) {
        nb = ax;
        db = ay;
        oct = 2;
        if (xneg == 1) { oct = 3; }
    }
    var mn, en = _us_frexp(nb);
    var md, ed = _us_frexp(db);
    if (en - ed <= 0 - 60) {
        var t: f64 = _us_atan2_tiny(mn, md, en - ed, oct);
        return (t, 1);
    }
    var sc: f64 = _us_cr_pow2(en - ed);
    var n: f64 = mn * sc;                         # exact: n/d ≥ 2^-60
    if (acc == 1) {
        var a: f64 = _us_atan_acc(n, 0.0, 0.0, md, 0.0, 0.0, oct);
        return (a, 1);
    }
    var r, ok = _us_atan_fast(n, 0.0, md, 0.0, oct);
    return (r, ok);
}

# The special values of atan2 (C99 Annex F, as glibc and Rust's f64::atan2): (result, 1), or (0, 0) for finite
# nonzero y and x. A NaN argument is returned as it is (y's first).
#must_use
fn _us_atan2_special(y: f64, x: f64): (f64, i64) {
    var uy = load64(&y);
    var ux = load64(&x);
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ay > 0x7FF0000000000000) { return (y, 1); }
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    var r: f64 = 0.0;
    var found = 0;
    if (ay == 0) {                                # atan2(±0, x): ±0 for x ≥ +0, ±π for x ≤ −0
        found = 1;
        if (ux < 0) { r = _US_CR_SC_PIH; }
    } elif (ax == 0) {                            # atan2(y ≠ 0, ±0) = ±π/2
        found = 1;
        r = _US_CR_SC_PIO2H;
    } elif (ax == 0x7FF0000000000000) {
        found = 1;
        if (ay == 0x7FF0000000000000) {           # ±π/4, ±3π/4
            r = _US_CR_SC_PIO4;
            if (ux < 0) { r = _US_CR_SC_PI3O4; }
        } elif (ux < 0) {                         # finite y, x = −∞: ±π; x = +∞: ±0
            r = _US_CR_SC_PIH;
        }
    } elif (ay == 0x7FF0000000000000) {           # y = ±∞, x finite: ±π/2
        found = 1;
        r = _US_CR_SC_PIO2H;
    }
    if (found == 0) { return (0.0, 0); }
    if (uy < 0) { r = -r; }
    return (r, 1);
}

# atan2(y, x), correctly rounded, the angle of (x, y) in [−π, π]. Mirrors `f64::atan2`.
#must_use
fn _us_cr_atan2(y: f64, x: f64): f64 {
    var uy0 = load64(&y);
    var ux0 = load64(&x);
    var ay0 = uy0 & 0x7FFFFFFFFFFFFFFF;
    var ax0 = ux0 & 0x7FFFFFFFFFFFFFFF;
    var ey = ay0 >> 52;
    var ex = ax0 >> 52;
    # Both normal and finite (biased exponents 1 … 2046, an unsigned range test each) with |n/d| ≥ 2^-59: the
    # scaling of _us_atan2_pos done on the bits (n's significand at exponent en − ed, d's at 0: the same
    # doubles), then the fast core and its test, inline.
    if (((ey - 1) ^ 0x8000000000000000) < 0x80000000000007FE) {
        if (((ex - 1) ^ 0x8000000000000000) < 0x80000000000007FE) {
            var nb = ay0;
            var db = ax0;
            var en = ey;
            var ed = ex;
            var oct = 0;
            if (ux0 < 0) { oct = 1; }
            if (ay0 > ax0) {
                nb = ax0;
                db = ay0;
                en = ex;
                ed = ey;
                oct = oct + 2;
            }
            if (ed - en < 60) {
                var nbits = (nb & 0x000FFFFFFFFFFFFF) | ((1023 + en - ed) << 52);
                var dbits = (db & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
                var n: f64 = nbits;
                var d: f64 = dbits;
                var hi, lo, err = _us_atan_core(n, 0.0, d, 0.0, oct);
                var u: f64 = hi + (lo - err);
                var v: f64 = hi + (lo + err);
                if (u != v) { u = _us_atan_acc(n, 0.0, 0.0, d, 0.0, 0.0, oct); }
                if (uy0 < 0) { u = -u; }
                return u;
            }
        }
    }
    var s, sp = _us_atan2_special(y, x);
    if (sp == 1) { return s; }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _us_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 0);
    if (ok == 0) {
        var a, oka = _us_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 1);
        r = a;
    }
    if (uy < 0) { r = -r; }
    return r;
}

# The fast path alone: (atan2(y, x), 1), or (0, 0) when its rounding test fails.
#must_use
fn _us_cr_atan2_fast(y: f64, x: f64): (f64, i64) {
    var s, sp = _us_atan2_special(y, x);
    if (sp == 1) { return (s, 1); }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _us_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 0);
    if (ok == 0) { return (0.0, 0); }
    if (uy < 0) { r = -r; }
    return (r, 1);
}

# atan2(y, x) by the accurate path alone.
#must_use
fn _us_cr_atan2_acc(y: f64, x: f64): f64 {
    var s, sp = _us_atan2_special(y, x);
    if (sp == 1) { return s; }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _us_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 1);
    if (uy < 0) { r = -r; }
    return r;
}

# ══ ushma's own (not vendored): correctly rounded tanh (ADR 0004, M0 part 2c-3) ══════════════════════════════════
#
# tanh(x) = sgn(x)·tanh(a), a = |x|: tanh is odd and RN is symmetric, so RN(tanh(−x)) = −RN(tanh(x)) exactly.
# - NaN gives that NaN; ±0 and every a < 2^-27 give x: 0 < a − tanh a < a³/3, and a³/3 < 2^-54·2^e for a in
#   [2^e, 2^(e+1)) whenever a² < 3·2^-54 (a < √3·2^-27), so tanh a lies strictly inside the rounding interval of a
#   (its half gap below is at least 2^(e−54); subnormals included).
# - a > TANH_ONE (19.061547465398494, src/mathx_data.cyr, MPFR's last double whose tanh rounds below 1) and ±∞ give ±1.
# - Otherwise tanh a = E/(E + 2) with E = expm1(2a) (2a exact). The map E -> E/(E + 2) has relative sensitivity
#   2/(E + 2) ≤ 1, so E's relative error is not amplified.
#   Fast path: E = eh + el in double-double with an absolute bound err (the vendored expm1 fast path's own
#   arithmetic, _us_expm1_dd); D = E + 2 (TwoSum, exact up to el's addition); Q = qh + ql = E/D by one corrected
#   division (qh = RN(eh/dh), the remainder from TwoProduct(qh, dh), each step below 2^-104·Q, so below 2^-101·Q
#   altogether). The bound on Q is err·2/dh² (the sensitivity, D ≥ 2 so dh² ≥ 4) times 1 + 2^-10 (the bound's own
#   rounding), plus 2^-99·qh; the rounding test is expm1's (u = qh + (ql − bound), v = qh + (ql + bound), equal).
#   Accurate path: E in triple-double (the vendored accurate expm1's arithmetic, _us_expm1_td: 2^-152 relative),
#   D = E + 2 (exact renormalisation), Q = E/D by _us_td_div (2^-151), so Q is within 2^-149 of tanh a, then RN3.
# tanh is transcendental at every algebraic x ≠ 0 (otherwise e^(2x) = (1 + t)/(1 − t) would be algebraic), so no
# argument but 0 is exact or a tie. The accurate path is correct whenever no double's tanh lies within 2^-149
# (relative) of a rounding boundary; scripts/oracle/cr_verify.py checks it against MPFR on ≥ 10^6 arguments per
# target with that path forced.

# expm1(x) as a double-double with an absolute error bound, for 2^-53 ≤ |x| ≤ 708: (hi, lo, err) with
# |hi + lo − expm1(x)| ≤ err. The arithmetic of _us_cr_expm1_fast's two branches, without its rounding test.
#must_use
fn _us_expm1_dd(x: f64): (f64, f64, f64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {               # |x| < 2^-6
        var p: f64 = x * x;
        var cx: f64 = 134217729.0 * x;
        var x1: f64 = cx - (cx - x);
        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _US_CR_EXPM1_Q3;
        var k4: f64 = _US_CR_EXPM1_Q4;
        var k5: f64 = _US_CR_EXPM1_Q5;
        var k6: f64 = _US_CR_EXPM1_Q6;
        var k7: f64 = _US_CR_EXPM1_Q7;
        var k8: f64 = _US_CR_EXPM1_Q8;
        var k9: f64 = _US_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
        var hs: f64 = x + hp;
        var ht: f64 = hp - (hs - x);
        var lo: f64 = (ht + (pe * 0.5)) + x3;
        var ex3: f64 = f64_abs(x3);
        var exa: f64 = f64_abs(x);
        var c49: f64 = 0x3CE0000000000000;      # 2^-49
        var c100: f64 = 0x39B0000000000000;     # 2^-100
        var err: f64 = (ex3 * c49) + (exa * c100);
        return (hs, lo, err);
    }
    var hi, lo2, e = _us_exp_core(x, 0.0);
    var hh: f64 = 0.0;
    var ll: f64 = lo2;
    var sc: f64 = 1.0;
    if (e == 0) {
        hh = hi - 1.0;                           # exact: hi in [0.9993, 1.9987]
    } else {
        sc = _us_cr_pow2(e);
        var hsc: f64 = hi * sc;
        if (e > 0) {
            hh = hsc - 1.0;
            var t1: f64 = -1.0 - (hh - hsc);
            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    return (hh, ll, errs);
}

# expm1(x) as a triple-double at out[0..2], for 2^-53 ≤ |x| ≤ 708 and E < 120: the arithmetic of _us_cr_expm1_acc
# without its final rounding (2^-152 relative, as measured there).
fn _us_expm1_td(x: f64, out) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {
        var sh: f64 = load64(&_US_CR_EXP_ACC + 360);   # 1/17! (index 3·(17 − 2))
        var sm: f64 = load64(&_US_CR_EXP_ACC + 368);
        var sl: f64 = load64(&_US_CR_EXP_ACC + 376);
        var n = 16;
        while (n >= 2) {
            var th, tm, tl = _us_td_mul_d(sh, sm, sl, x);
            var off = (n - 2) * 24;
            var ch: f64 = load64(&_US_CR_EXP_ACC + off);
            var cm: f64 = load64(&_US_CR_EXP_ACC + off + 8);
            var cl: f64 = load64(&_US_CR_EXP_ACC + off + 16);
            var uh, um, ul = _us_td_add(ch, cm, cl, th, tm, tl);
            sh = uh;
            sm = um;
            sl = ul;
            n = n - 1;
        }
        var vh, vm, vl = _us_td_mul_d(sh, sm, sl, x);
        var wh, wm, wl = _us_td_add_d(vh, vm, vl, 1.0);
        var ph, pm, pl = _us_td_mul_d(wh, wm, wl, x);
        store64(out, ph);
        store64(out + 8, pm);
        store64(out + 16, pl);
        return 0;
    }
    var buf: f64[3];
    var e = _us_exp_acc_core(x, 0.0, 0.0, &buf);
    var sc: f64 = _us_cr_pow2(e);
    var bh: f64 = buf[0] * sc;
    var bm: f64 = buf[1] * sc;
    var bl: f64 = buf[2] * sc;
    var dh, dm, dl = _us_td_add_d(bh, bm, bl, -1.0);
    store64(out, dh);
    store64(out + 8, dm);
    store64(out + 16, dl);
    return 0;
}

# tanh(x), correctly rounded (the analysis above). Mirrors `f64::tanh`.
#must_use
fn _us_cr_tanh(x: f64): f64 {
    var y, ok = _us_cr_tanh_fast(x);
    if (ok == 1) { return y; }
    var z: f64 = _us_cr_tanh_acc(x);
    return z;
}

# The fast path alone: (RN(tanh x), 1), or (0, 0) when the rounding test fails and the accurate path must decide.
#must_use
fn _us_cr_tanh_fast(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return (x, 1); }   # |x| < 2^-27, ±0, subnormals: tanh x rounds to x
    var a: f64 = ax;                             # |x|
    var one: f64 = _US_CR_TANH_ONE;
    if (a > one) {                               # ±∞ included
        if (x < 0.0) { return (-1.0, 1); }
        return (1.0, 1);
    }
    var y: f64 = a + a;                          # 2a, exact
    var eh0, el0, err = _us_expm1_dd(y);
    var eh, el = _us_fast_two_sum(eh0, el0);     # E = eh + el, normalised (|el0| < |eh0|)
    var dh, dt = _us_two_sum(2.0, eh);
    var dl: f64 = dt + el;                       # D = E + 2 = dh + dl
    var qh: f64 = eh / dh;
    var p, pe = _us_two_prod(qh, dh);
    var r: f64 = (((eh - p) - pe) + el) - (qh * dl);
    var ql: f64 = r / dh;                        # Q = qh + ql = E/D to 2^-101
    var slack: f64 = 1.0009765625;               # 1 + 2^-10
    var c99: f64 = 0x39C0000000000000;           # 2^-99
    var bound: f64 = ((((err * 2.0) / dh) / dh) * slack) + (qh * c99);
    var u: f64 = qh + (ql - bound);
    var v: f64 = qh + (ql + bound);
    if (u != v) { return (0.0, 0); }
    if (x < 0.0) {
        var nu: f64 = 0.0 - u;
        return (nu, 1);
    }
    return (u, 1);
}

# tanh by the accurate path alone, for every x (the fast path's fallback, and a test hook).
#must_use
fn _us_cr_tanh_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return x; }
    var a: f64 = ax;
    var one: f64 = _US_CR_TANH_ONE;
    if (a > one) {
        if (x < 0.0) { return -1.0; }
        return 1.0;
    }
    var y: f64 = a + a;
    var e: f64[3];
    _us_expm1_td(y, &e);
    var dh, dm, dl = _us_td_add_d(e[0], e[1], e[2], 2.0);
    var q: f64[3];
    _us_td_div(e[0], e[1], e[2], dh, dm, dl, &q);
    var r: f64 = _us_rn3(q[0], q[1], q[2]);
    if (x < 0.0) {
        var nr: f64 = 0.0 - r;
        return nr;
    }
    return r;
}

# --- fmtf.cyr ---

# fmtf.cyr — f64 to text: the shortest round-trip digits, in Rust's Display and serde_json's forms (ADR 0005).
#
# Vendored mechanically from impetus's src/fmtf.cyr (impetus commit 809ea0f, sha256 1d925be3b48c274e…) by
# scripts/vendor_fmtf.py; regenerate it there, never edit it here. The only changes: this header, the `_us_` names,
# and `_us_bits` (impetus takes it from its mathx.cyr).
#
# Both printers give the SHORTEST digits that parse back to the same double, choosing the closest to the exact value
# among them: Rust's `Display` (core's Grisu with a Dragon fallback) and serde_json 1.0.154's zmij (Schubfach). They
# differ only on an exact tie between two closest candidates: core rounds it up, zmij to the even digit. The digits
# come from Burger & Dybvig's free-format algorithm ("Printing Floating-Point Numbers Quickly and Accurately", 1996)
# on a small bignum: exact, with no tables. tests/golden/fmtf.tsv pins both forms against Rust 1.99.1 and serde_json
# 1.0.154 over every binade, the powers of ten, the form thresholds and a seeded sweep (M0 probe 11 checked 160,378
# doubles: no difference). bayan's own printer differs from serde_json on 6,276 of them (filed upstream).
#
# Forms:
# - `_us_fmt_f64_display`: Rust's `{}` — always positional, no ".0" (`100`, `0.1`, `-0`), `NaN`, `inf`, `-inf`.
# - `_us_fmt_f64_json`: serde_json — positional while the decimal exponent is in −5..=15, with ".0" on an integer
#   (`100.0`, `0.00001`); otherwise `d.ddde±x` (`1e+16`, `1.5e-7`); `null` for NaN and ±∞.

# The bits of an f64 as an integer word: an untyped parameter, an i64 return.
#must_use
fn _us_bits(x): i64 {
    return x;
}

include "lib/str.cyr"

# ── bignum ──────────────────────────────────────────────────────────────────────────
# A non-negative integer in 32-bit limbs, little-endian: word 0 the limb count, words 1..40 the limbs.
# 40 limbs hold 2^1280; the algorithm's values stay below 2^1140. No leading zero limbs.
var _US_BN_WORDS = 41;

# a := v, for 0 <= v < 2^63.
fn _us_bn_set(a, v) {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _us_bn_copy(dst, src) {
    var n = load64(src);
    for (var i = 0; i <= n; i = i + 1) { store64(dst + i * 8, load64(src + i * 8)); }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _us_bn_mul_small(a, m) {
    var n = load64(a);
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _us_bn_mul_pow10(a, k) {
    var left = k;
    while (left >= 9) {
        _us_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    for (var i = 0; i < left; i = i + 1) { m = m * 10; }
    if (m > 1) { _us_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _us_bn_shl(a, k) {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        for (var i = 0; i < n; i = i + 1) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var i = n - 1;
        while (i >= 0) {
            store64(a + 8 + (i + q) * 8, load64(a + 8 + i * 8));
            i = i - 1;
        }
        for (var j = 0; j < q; j = j + 1) { store64(a + 8 + j * 8, 0); }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _us_bn_sum(dst, a, b) {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _us_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return 0 - 1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return 0 - 1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _us_bn_sub(a, b) {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    for (var i = 0; i < na; i = i + 1) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# The number of bits in x > 0.
#must_use
fn _us_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# ── shortest digits (Burger & Dybvig, free format) ──────────────────────────────────

# The shortest decimal digits of the positive finite double with bits `bits` that read back to it,
# the closest to its exact value among them: writes the ASCII digits to `digits` (17 bytes is
# enough) and returns (n, k) with value = 0.d1d2…dn × 10^k. When the exact value lies exactly
# halfway between the two closest candidates, `tie_even` 0 takes the upper one (Rust's core
# printer: 2^-25 is 2.9802322387695313e-8) and 1 the even one (serde_json's zmij: …5312e-8).
fn _us_shortest(bits, digits, tie_even) {
    var be = (bits >> 52) & 0x7FF;
    var f = bits & 0xFFFFFFFFFFFFF;
    var e = 0 - 1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != 0x10000000000000) {
            _us_bn_set(&r, f);
            _us_bn_shl(&r, e + 1);
            _us_bn_set(&s, 2);
            _us_bn_set(&mp, 1);
            _us_bn_shl(&mp, e);
            _us_bn_copy(&mm, &mp);
        } else {
            _us_bn_set(&r, f);
            _us_bn_shl(&r, e + 2);
            _us_bn_set(&s, 4);
            _us_bn_set(&mp, 1);
            _us_bn_shl(&mp, e + 1);
            _us_bn_set(&mm, 1);
            _us_bn_shl(&mm, e);
        }
    } else {
        if (e == 0 - 1074 || f != 0x10000000000000) {
            _us_bn_set(&r, f);
            _us_bn_shl(&r, 1);
            _us_bn_set(&s, 1);
            _us_bn_shl(&s, 1 - e);
            _us_bn_set(&mp, 1);
            _us_bn_set(&mm, 1);
        } else {
            _us_bn_set(&r, f);
            _us_bn_shl(&r, 2);
            _us_bn_set(&s, 1);
            _us_bn_shl(&s, 2 - e);
            _us_bn_set(&mp, 2);
            _us_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small
    # (the fixup below adds the one).
    var lg: f64 = f64_from(e + _us_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _us_bn_mul_pow10(&s, k);
    } else {
        _us_bn_mul_pow10(&r, 0 - k);
        _us_bn_mul_pow10(&mp, 0 - k);
        _us_bn_mul_pow10(&mm, 0 - k);
    }
    _us_bn_sum(&t, &r, &mp);
    var c = _us_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _us_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    while (1) {
        _us_bn_mul_small(&r, 10);
        _us_bn_mul_small(&mp, 10);
        _us_bn_mul_small(&mm, 10);
        var d = 0;
        while (_us_bn_cmp(&r, &s) >= 0) {
            _us_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _us_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _us_bn_sum(&t, &r, &mp);
        var hi = _us_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie per `tie_even`.
                _us_bn_copy(&t, &r);
                _us_bn_shl(&t, 1);
                var half = _us_bn_cmp(&t, &s);
                if (half > 0) { d = d + 1; }
                if (half == 0 && (tie_even == 0 || (d & 1) == 1)) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# ── formatting ──────────────────────────────────────────────────────────────────────

# Appends `count` copies of byte c.
fn _us_sb_repeat(sb, c, count) {
    for (var i = 0; i < count; i = i + 1) { str_builder_putc(sb, c); }
    return 0;
}

# Appends digits [from, to) of `digits`.
fn _us_sb_digits(sb, digits, from, to) {
    for (var i = from; i < to; i = i + 1) { str_builder_putc(sb, load8(digits + i)); }
    return 0;
}

# Appends 0.d1…dn × 10^k positionally: "123.45", "0.00012", "12300". With `int_suffix` 1, an integer
# gets ".0" (serde_json's form).
fn _us_sb_positional(sb, digits, n, k, int_suffix) {
    if (k <= 0) {
        str_builder_putc(sb, 48);
        str_builder_putc(sb, 46);
        _us_sb_repeat(sb, 48, 0 - k);
        _us_sb_digits(sb, digits, 0, n);
        return 0;
    }
    if (k >= n) {
        _us_sb_digits(sb, digits, 0, n);
        _us_sb_repeat(sb, 48, k - n);
        if (int_suffix == 1) {
            str_builder_putc(sb, 46);
            str_builder_putc(sb, 48);
        }
        return 0;
    }
    _us_sb_digits(sb, digits, 0, k);
    str_builder_putc(sb, 46);
    _us_sb_digits(sb, digits, k, n);
    return 0;
}

# Appends x as Rust's `Display` (`{}`) writes an f64. Mirrors `<f64 as Display>::fmt`.
fn _us_fmt_f64_display(sb, x: f64) {
    var bits = _us_bits(x);
    if (x != x) {
        str_builder_add_cstr(sb, "NaN");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "inf");
        return 0;
    }
    if (mag == 0) {
        str_builder_putc(sb, 48);
        return 0;
    }
    var digits[24];
    var n, k = _us_shortest(mag, &digits, 0);
    _us_sb_positional(sb, &digits, n, k, 0);
    return 0;
}

# The number of non-finite values _us_fmt_f64_json has written as `null`, as serde_json does. A caller that must not
# lose one (a JSON writer) zeroes it, writes, and checks it.
var _us_json_nonfinite = 0;

# Appends x as serde_json 1.0.154 writes an f64 (zmij's format). Mirrors `serde_json::to_string(&x)`.
fn _us_fmt_f64_json(sb, x: f64) {
    var bits = _us_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag >= 0x7FF0000000000000) {
        _us_json_nonfinite = _us_json_nonfinite + 1;
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _us_shortest(mag, &digits, 1);
    var ex = k - 1;
    if (ex >= 0 - 5 && ex <= 15) {
        _us_sb_positional(sb, &digits, n, k, 1);
        return 0;
    }
    str_builder_putc(sb, load8(&digits));
    if (n > 1) {
        str_builder_putc(sb, 46);
        _us_sb_digits(sb, &digits, 1, n);
    }
    str_builder_putc(sb, 101);
    if (ex >= 0) {
        str_builder_putc(sb, 43);
        str_builder_add_int(sb, ex);
    } else {
        str_builder_putc(sb, 45);
        str_builder_add_int(sb, 0 - ex);
    }
    return 0;
}

# --- validate.cyr ---

# validate.cyr — input predicates and the failure path every fallible ushma function shares.
#
# A plain `x <= 0.0` test lets NaN through (every comparison with NaN is false). `_us_finite_gt` / `_us_finite_ge`
# are 1 only for a finite value that satisfies the bound, so `if (_us_finite_gt(x, 0.0) == 0) { .. }` refuses
# negatives, zero, NaN and ±∞ in one test.
#
# A refusal returns `Err(code)` (src/error.cyr) through `_us_fail*`: when DEBUG is on, it first reports where it
# failed and on what value, as one sakshi event (`us_conduction: negative thermal conductivity`, with
# `conductivity=-1`); otherwise it costs one level test. The value is written by fmtf's Display form into a stack
# buffer, so a refusal never allocates unless a value's text is longer than the buffer.

# The smallest magnitude a divisor may have (Rust's 1e-30, written positionally).
var _US_TINY: f64 = 0.000000000000000000000000000001;

# −∞, a compile-time constant (_US_INF is +∞, src/mathx.cyr).
const _US_NEG_INF = 0.0 - 1.0 / 0.0;

# 1 when x is finite and strictly greater than `bound`, else 0, for any bound: `x > bound` is false for NaN and −∞,
# `x < +∞` for NaN and +∞. One branch-free expression, so #inline takes it: three checks cost 6 ns instead of 21 (M1d's
# review, docs/benchmarks-rust-v-cyrius.md).
#must_use
#pure
#inline
fn _us_finite_gt(x: f64, bound: f64): i64 {
    return (x > bound) & (x < _US_INF);
}

# 1 when x is finite and greater than or equal to `bound`, else 0, for a bound above −∞ (every literal bound: 0, 1,
# 1e-30). For x = bound = −∞ it would answer 1, so a bound that comes from the caller's data uses _us_finite_ge_any.
#must_use
#pure
#inline
fn _us_finite_ge(x: f64, bound: f64): i64 {
    return (x >= bound) & (x < _US_INF);
}

# _us_finite_ge for any bound, −∞ included (a substance's own triple-point temperature): one comparison more, about
# 1 ns.
#must_use
#pure
#inline
fn _us_finite_ge_any(x: f64, bound: f64): i64 {
    return (x >= bound) & (x < _US_INF) & (x > _US_NEG_INF);
}

# A str_builder over a caller's stack buffer: header `hdr` (24 bytes: buf, len, cap) on `buf` of `cap` bytes. It grows
# onto the heap only past `cap`, as any str_builder does.
fn _us_sb_on(hdr, buf, cap): i64 {
    store64(hdr, buf);
    store64(hdr + 8, 0);
    store64(hdr + 16, cap);
    return hdr;
}

# Emits the failure event for `code` in function `fname` (C strings): the message `<fname>: <error message>` with one
# field, `what` = the text in builder `vb`.
fn _us_fail_event(code, fname, what, vb) {
    var mh[24];
    var mbuf[160];
    var mb = _us_sb_on(&mh, &mbuf, 160);
    str_builder_add_cstr(mb, fname);
    str_builder_add_cstr(mb, ": ");
    str_builder_add_cstr(mb, us_error_message(code));
    sakshi_log_kv(SK_DEBUG, load64(mb), load64(mb + 8), what, strlen(what), load64(vb), load64(vb + 8));
    return 0;
}

# The refusal of `fname` with `code`, reporting no value. Returns `code`, for `return Err(_us_fail(..))`.
#must_use
fn _us_fail(code, fname): i64 {
    if (sakshi_get_level() >= SK_DEBUG) {
        var mh[24];
        var mbuf[160];
        var mb = _us_sb_on(&mh, &mbuf, 160);
        str_builder_add_cstr(mb, fname);
        str_builder_add_cstr(mb, ": ");
        str_builder_add_cstr(mb, us_error_message(code));
        sakshi_debug(load64(mb), load64(mb + 8));
    }
    return code;
}

# The refusal of `fname` with `code` on the f64 `x`, named `what` (`"conductivity"`). Returns `code`.
#must_use
fn _us_fail_f(code, fname, what, x: f64): i64 {
    if (sakshi_get_level() >= SK_DEBUG) {
        var vh[24];
        var vbuf[64];
        var vb = _us_sb_on(&vh, &vbuf, 64);
        _us_fmt_f64_display(vb, x);
        _us_fail_event(code, fname, what, vb);
    }
    return code;
}

# The refusal of `fname` with `code` on two f64s, reported as one field `w1=x1, w2=x2` under `what`. Returns `code`.
#must_use
fn _us_fail_ff(code, fname, what, w1, x1: f64, w2, x2: f64): i64 {
    if (sakshi_get_level() >= SK_DEBUG) {
        var vh[24];
        var vbuf[96];
        var vb = _us_sb_on(&vh, &vbuf, 96);
        str_builder_add_cstr(vb, w1);
        str_builder_putc(vb, 61);
        _us_fmt_f64_display(vb, x1);
        str_builder_add_cstr(vb, ", ");
        str_builder_add_cstr(vb, w2);
        str_builder_putc(vb, 61);
        _us_fmt_f64_display(vb, x2);
        _us_fail_event(code, fname, what, vb);
    }
    return code;
}

# The refusal of `fname` with `code` on the text [p, p + n), named `what` (`"name"`). Returns `code`.
#must_use
fn _us_fail_s(code, fname, what, p, n): i64 {
    if (sakshi_get_level() >= SK_DEBUG) {
        var vh[24];
        store64(&vh, p);
        store64(&vh + 8, n);
        store64(&vh + 16, n);
        _us_fail_event(code, fname, what, &vh);
    }
    return code;
}

# The refusal of `fname` with `code` on the integer `n`, named `what` (`"num_nodes"`). Returns `code`.
#must_use
fn _us_fail_i(code, fname, what, n): i64 {
    if (sakshi_get_level() >= SK_DEBUG) {
        var vh[24];
        var vbuf[32];
        var vb = _us_sb_on(&vh, &vbuf, 32);
        str_builder_add_int(vb, n);
        _us_fail_event(code, fname, what, vb);
    }
    return code;
}

# --- logging.cyr ---

# logging.cyr — ushma's logging setup and its spans, on lib/log.cyr and sakshi.
#
# us_log_init / us_log_init_with_level set the level from the USHMA_LOG environment variable, or from a default when
# it is unset. USHMA_LOG takes a level name, `trace` `debug` `info` `warn` `error` or `off` (any case), optionally as
# `ushma=<level>`, ushma being the only target there is. Anything else is refused with one warning, and the default
# applies (ADR 0002 row 5).
#
# Spans: every function Rust 1.4.0 instrumented at DEBUG opens `_us_span_enter("us_<name>", len)` and closes
# `_us_span_exit()` around its work. sakshi's span calls never test the level (M0 probe 8: 192 ns into the ring
# buffer), so these do: with DEBUG off a span costs one level test, about 1.6 ns.

# The LOG_* level a USHMA_LOG word names (`p`, `n` bytes; case-insensitive), or -1. `off` is LOG_FATAL + 1, which no
# event reaches.
#must_use
fn _us_log_level_word(p, n): i64 {
    var buf[8];
    if (n < 3 || n > 5) { return 0 - 1; }
    var k = 0;
    while (k < n) {
        var c = load8(p + k);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(&buf + k, c);
        k = k + 1;
    }
    if (n == 5 && memeq(&buf, "trace", 5) == 1) { return LOG_TRACE; }
    if (n == 5 && memeq(&buf, "debug", 5) == 1) { return LOG_DEBUG; }
    if (n == 4 && memeq(&buf, "info", 4) == 1) { return LOG_INFO; }
    if (n == 4 && memeq(&buf, "warn", 4) == 1) { return LOG_WARN; }
    if (n == 5 && memeq(&buf, "error", 5) == 1) { return LOG_ERROR; }
    if (n == 3 && memeq(&buf, "off", 3) == 1) { return LOG_FATAL + 1; }
    return 0 - 1;
}

# The LOG_* level a USHMA_LOG value names (`p`, `n` bytes): a level word, or `ushma=<level word>`, with surrounding
# spaces and tabs ignored. -1 when it is neither.
#must_use
fn us_log_parse(p, n): i64 {
    var s = 0;
    var e = n;
    while (s < e && (load8(p + s) == 32 || load8(p + s) == 9)) { s = s + 1; }
    while (e > s && (load8(p + e - 1) == 32 || load8(p + e - 1) == 9)) { e = e - 1; }
    if (e - s > 6 && memeq(p + s, "ushma=", 6) == 1) { s = s + 6; }
    return _us_log_level_word(p + s, e - s);
}

# Applies a LOG_* level to lib/log.cyr and sakshi (`off`: sakshi's ERROR threshold, and log.cyr past FATAL).
fn _us_log_apply(level): i64 {
    if (level > LOG_FATAL) {
        log_init(LOG_FATAL);
        sakshi_set_level(SK_ERROR);
        return level;
    }
    log_init(level);
    return level;
}

# Sets ushma's log level from USHMA_LOG, or `default_level` (a level name, as a C string) when USHMA_LOG is unset.
# A USHMA_LOG value that names no level warns once and uses the default; a default that names none is `info`.
# Returns the LOG_* level applied (LOG_FATAL + 1 for `off`).
fn us_log_init_with_level(default_level): i64 {
    var dl = us_log_parse(default_level, strlen(default_level));
    if (dl < 0) { dl = LOG_INFO; }
    var env = getenv("USHMA_LOG");
    if (env == 0) { return _us_log_apply(dl); }
    var lv = us_log_parse(env, strlen(env));
    if (lv < 0) {
        _us_log_apply(dl);
        log_warn("USHMA_LOG names no level (trace/debug/info/warn/error/off, or ushma=<level>): default used");
        return dl;
    }
    return _us_log_apply(lv);
}

# Sets ushma's log level from USHMA_LOG, defaulting to `info`. Returns the LOG_* level applied.
fn us_log_init(): i64 {
    return us_log_init_with_level("info");
}

# Opens a DEBUG span named `name` (`len` bytes) when DEBUG is on.
fn _us_span_enter(name, len) {
    if (sakshi_get_level() >= SK_DEBUG) { sakshi_span_enter(name, len); }
    return 0;
}

# Opens a DEBUG span named `name` (`len` bytes) carrying one field, `key` = the `vlen` bytes at `val`, when DEBUG is
# on. sakshi's spans take no fields, so the field is a DEBUG event (`<name>`, key=value) just inside the span: Rust's
# `#[instrument(fields(substance = %name))]`.
fn _us_span_enter_kv(name, len, key, val, vlen) {
    if (sakshi_get_level() >= SK_DEBUG) {
        sakshi_span_enter(name, len);
        sakshi_log_kv(SK_DEBUG, name, len, key, strlen(key), val, vlen);
    }
    return 0;
}

# Closes the span `_us_span_enter` opened, when DEBUG is on.
fn _us_span_exit() {
    if (sakshi_get_level() >= SK_DEBUG) { sakshi_span_exit(); }
    return 0;
}

# --- json.cyr ---

# json.cyr — the shared JSON helpers behind every ushma type's codec (ADR 0005 and its amendment).
#
# ushma writes and reads the JSON documents serde_json 1.0.154 writes and reads for the Rust crate's 28 serializable
# types, so a Rust program's JSON (soorat's visualization data, stored grids and networks) passes through unchanged.
#
# Writers append to a str_builder: fields in declaration order, f64 through fmtf's serde_json form, strings with
# serde_json's escapes (`\"` `\\` `\b` `\t` `\n` `\f` `\r`, `\u00xx` for the other control bytes, everything else as
# is). Readers parse with bayan's value tree on the caller's allocator (`_a`), so nothing a decode allocates outlives
# what the caller resets, and apply serde's derive rules:
# - a struct reads from an object (by field name; unknown fields ignored) or from an array of exactly its field
#   count (by position, serde's sequence form);
# - a missing field, or a value of the wrong JSON type, refuses the document;
# - an f64 takes a JSON float or integer, never `null`, and never one that parsed to ±∞ (`1e400`);
# - a string must be valid UTF-8, with no raw control byte (U+0000–U+001F unescaped).
# Every refusal is Err(US_ERR_DESERIALIZE). Where bayan is stricter than serde_json (a duplicate key anywhere, nesting
# past 128, an integer ≥ 2^63) the document is refused too, and an integer `-0` reads as +0: ADR 0005's mapped
# divergences, filed upstream.

# ── writer ──────────────────────────────────────────────────────────────────────────

# Appends `"name":` (C string `name`, no escapes needed), preceded by a comma unless `first` is 1.
fn _us_jw_key(sb, name, first) {
    if (first != 1) { str_builder_putc(sb, 44); }
    str_builder_putc(sb, 34);
    str_builder_add_cstr(sb, name);
    str_builder_putc(sb, 34);
    str_builder_putc(sb, 58);
    return 0;
}

# Appends the `n` bytes at `p` as a JSON string, escaped as serde_json escapes it.
fn _us_jw_str(sb, p, n) {
    var t[16];
    store64(&t, p);
    store64(&t + 8, n);
    str_builder_add_json_str(sb, &t);
    return 0;
}

# Appends x as serde_json writes an f64 (`null` for NaN and ±∞).
fn _us_jw_f64(sb, x: f64) {
    _us_fmt_f64_json(sb, x);
    return 0;
}

# ── reader ──────────────────────────────────────────────────────────────────────────

# 1 when the `n` bytes at `p` are well-formed UTF-8 (RFC 3629: no overlong forms, no surrogates, nothing past
# U+10FFFF), else 0.
#must_use
fn _us_utf8_valid(p, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c < 128) {
            i = i + 1;
            continue;
        }
        var need = 0;
        var lo = 128;
        var hi = 191;
        if (c >= 194 && c <= 223) { need = 1; }
        elif (c == 224) { need = 2; lo = 160; }
        elif (c >= 225 && c <= 236) { need = 2; }
        elif (c == 237) { need = 2; hi = 159; }
        elif (c >= 238 && c <= 239) { need = 2; }
        elif (c == 240) { need = 3; lo = 144; }
        elif (c >= 241 && c <= 243) { need = 3; }
        elif (c == 244) { need = 3; hi = 143; }
        else { return 0; }
        if (i + need >= n) { return 0; }
        var c1 = load8(p + i + 1);
        if (c1 < lo || c1 > hi) { return 0; }
        var k = 2;
        while (k <= need) {
            var ck = load8(p + i + k);
            if (ck < 128 || ck > 191) { return 0; }
            k = k + 1;
        }
        i = i + need + 1;
    }
    return 1;
}

# 1 when no string in the `n`-byte document at `buf` holds a raw control byte (RFC 8259 §7; serde_json refuses one,
# bayan 1.11.1 does not, and once decoded it can't be told from its escape), else 0.
#must_use
fn _us_jr_raw_ok(buf, n): i64 {
    var inside = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (inside == 1) {
            if (c < 32) { return 0; }
            if (c == 92) { i = i + 1; }
            elif (c == 34) { inside = 0; }
        } else {
            if (c == 34) { inside = 1; }
        }
        i = i + 1;
    }
    return 1;
}

# The value tree of the `n`-byte document at `buf`, built on allocator `a`, or 0 when it is not one JSON value (or
# holds a raw control byte in a string).
#must_use
fn _us_jr_parse(a, buf, n): i64 {
    if (buf == 0 || n < 0) { return 0; }
    if (_us_jr_raw_ok(buf, n) == 0) { return 0; }
    return bayan_json_v_parse_buf_a(a, buf, n);
}

# The form of struct node `v` with `nfields` fields: 1 an object, 2 an array of exactly `nfields` elements (serde's
# sequence form), 0 anything else.
#must_use
fn _us_jr_form(v, nfields): i64 {
    if (v == 0) { return 0; }
    var t = bayan_json_v_tag(v);
    if (t == JTAG_OBJ) { return 1; }
    if (t == JTAG_ARR && bayan_json_v_arr_len(v) == nfields) { return 2; }
    return 0;
}

# Field `i`, named `name`, of struct node `v` in `form`: its value node, or 0 when absent.
#must_use
fn _us_jr_at(v, form, i, name): i64 {
    if (form == 1) { return bayan_json_v_obj_get_by_cstr(v, name); }
    if (form == 2) { return bayan_json_v_arr_get(v, i); }
    return 0;
}

# A JSON number as a finite-or-not f64 into *out: 1, or 0 for any other value (`null` included) and for a float that
# parsed to ±∞ (serde_json: "number out of range"). An integer converts as serde_json converts it (round to nearest,
# ties to even).
#must_use
fn _us_jr_f64(v, out): i64 {
    if (v == 0) { return 0; }
    var t = bayan_json_v_tag(v);
    if (t == JTAG_FLOAT) {
        var w = bayan_json_v_float(v);
        if ((w & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
        store64(out, w);
        return 1;
    }
    if (t == JTAG_INT) {
        store64(out, bayan_json_v_float(v));
        return 1;
    }
    return 0;
}

# A JSON string, copied onto allocator `a` with a terminating NUL: its pointer into *out_p and its byte length (which
# may hold a decoded U+0000) into *out_n. 1, or 0 for any other value, invalid UTF-8, or a refused allocation.
#must_use
fn _us_jr_str(a, v, out_p, out_n): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_STR) { return 0; }
    var s = bayan_json_v_str(v);
    var p = str_data(s);
    var n = str_len(s);
    if (_us_utf8_valid(p, n) == 0) { return 0; }
    var d = alloc_via(a, n + 1);
    if (d == 0) { return 0; }
    memcpy(d, p, n);
    store8(d + n, 0);
    store64(out_p, d);
    store64(out_n, n);
    return 1;
}

# ── all-f64 structs ─────────────────────────────────────────────────────────────────

# Appends the `n` f64 fields at `p` as one JSON object, named by `field(k)` (a fn returning field k's C-string name):
# the document serde_json writes for a struct of f64 fields only.
fn _us_jw_f64_struct(sb, p, n, field) {
    str_builder_putc(sb, 123);
    var k = 0;
    while (k < n) {
        _us_jw_key(sb, fncall1(field, k), k == 0);
        var x: f64 = load64(p + (8 * k));
        _us_jw_f64(sb, x);
        k = k + 1;
    }
    str_builder_putc(sb, 125);
    return 0;
}

# Reads a struct of `n` f64 fields named by `field(k)` from the `len`-byte document at `buf` (its tree on allocator
# `a`) into the `n` words at `w`, by serde's rules: 1, or 0 when serde would refuse it.
fn _us_jr_f64_struct(a, buf, len, w, n, field): i64 {
    var v = _us_jr_parse(a, buf, len);
    var form = _us_jr_form(v, n);
    if (form == 0) { return 0; }
    var k = 0;
    while (k < n) {
        if (_us_jr_f64(_us_jr_at(v, form, k, fncall1(field, k)), w + (8 * k)) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# --- material_data.cyr ---

# ushma — material data: 10 reference materials at ~300 K
#
# GENERATED by scripts/oracle from ushma 1.4.0 (rust-old/), hisab 1.4.0. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# Rows are in `material::ALL_MATERIALS` order; each preset's row is its index constant.
# f64 cells are the oracle's values as round-trip decimals, and
# tests/golden/material.tsv pins every cell (one `material::<PRESET>` row per preset).

# Thermal properties of a material.
# All built-in materials for iteration.
