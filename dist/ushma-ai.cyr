# --- material.cyr ---

# material.cyr — thermal material properties: conductivity, specific heat, density (Rust 1.4.0 `material`).
#
# A material is a UsMaterial: its name (bytes and length) and five properties. The 10 reference materials at about
# 300 K are generated tables (src/material_data.cyr: one column per property, `US_MATERIAL_<NAME>` indices,
# `US_MATERIAL_COUNT`); us_material_preset fills a UsMaterial from one. A caller's own material is a UsMaterial it
# fills itself.
#
# JSON is serde_json's `ThermalMaterial` document, `{"name":…,"conductivity":…,"specific_heat":…,"density":…,
# "melting_point":…,"boiling_point":…}` (ADR 0005; src/json.cyr has the rules).

struct UsMaterial {
    name;
    name_len;
    conductivity: f64;
    specific_heat: f64;
    density: f64;
    melting_point: f64;
    boiling_point: f64;
}

# The name of reference material `i` (a C string into the generated table), or 0 when `i` is no reference material.
#must_use
fn us_material_name(i): cstring {
    if (i < 0 || i >= US_MATERIAL_COUNT) { return 0; }
    var off = load16(&_US_MATERIAL_NAME_OFF + (2 * i));
    return &_US_MATERIAL_NAME_BYTES + off;
}

# Fills *out with reference material `i` (`US_MATERIAL_COPPER` … `US_MATERIAL_DIAMOND`): Ok(0), or
# Err(US_ERR_INVALID_PARAMETER) when `i` is no reference material.
#must_use
fn us_material_preset(i, out: *UsMaterial): Result {
    if (i < 0 || i >= US_MATERIAL_COUNT) {
        return Err(_us_fail_i(US_ERR_INVALID_PARAMETER, "us_material_preset", "index", i));
    }
    var name = us_material_name(i);
    var k: f64 = US_MATERIAL_CONDUCTIVITY[i];
    var cp: f64 = US_MATERIAL_SPECIFIC_HEAT[i];
    var rho: f64 = US_MATERIAL_DENSITY[i];
    var mp: f64 = US_MATERIAL_MELTING_POINT[i];
    var bp: f64 = US_MATERIAL_BOILING_POINT[i];
    out.name = name;
    out.name_len = strlen(name);
    out.conductivity = k;
    out.specific_heat = cp;
    out.density = rho;
    out.melting_point = mp;
    out.boiling_point = bp;
    return Ok(0);
}

# Thermal diffusivity α = k / (ρ·c_p), in m²/s.
#must_use
#pure
fn us_material_diffusivity(m: *UsMaterial): f64 {
    var k: f64 = m.conductivity;
    var rho: f64 = m.density;
    var cp: f64 = m.specific_heat;
    var r: f64 = k / (rho * cp);
    return r;
}

# Volumetric heat capacity ρ·c_p, in J/(m³·K).
#must_use
#pure
fn us_material_volumetric_heat_capacity(m: *UsMaterial): f64 {
    var rho: f64 = m.density;
    var cp: f64 = m.specific_heat;
    var r: f64 = rho * cp;
    return r;
}

# Appends *m as serde_json writes a `ThermalMaterial`.
fn us_material_to_json(sb, m: *UsMaterial) {
    var k: f64 = m.conductivity;
    var cp: f64 = m.specific_heat;
    var rho: f64 = m.density;
    var mp: f64 = m.melting_point;
    var bp: f64 = m.boiling_point;
    str_builder_putc(sb, 123);
    _us_jw_key(sb, "name", 1);
    _us_jw_str(sb, m.name, m.name_len);
    _us_jw_key(sb, "conductivity", 0);
    _us_jw_f64(sb, k);
    _us_jw_key(sb, "specific_heat", 0);
    _us_jw_f64(sb, cp);
    _us_jw_key(sb, "density", 0);
    _us_jw_f64(sb, rho);
    _us_jw_key(sb, "melting_point", 0);
    _us_jw_f64(sb, mp);
    _us_jw_key(sb, "boiling_point", 0);
    _us_jw_f64(sb, bp);
    str_builder_putc(sb, 125);
    return 0;
}

# One f64 field of a material node into word *w: 1, or 0.
fn _us_material_f64(v, form, i, name, w): i64 {
    return _us_jr_f64(_us_jr_at(v, form, i, name), w);
}

# Reads a `ThermalMaterial` document (`n` bytes at `buf`) into *out, its name copied onto allocator `a`: Ok(0), or
# Err(US_ERR_DESERIALIZE), leaving *out unchanged. The parse tree is on `a` too: reset it when the result is used.
#must_use
fn us_material_from_json_a(a, buf, n, out: *UsMaterial): Result {
    var v = _us_jr_parse(a, buf, n);
    var form = _us_jr_form(v, 6);
    if (form == 0) { return Err(_us_fail(US_ERR_DESERIALIZE, "us_material_from_json")); }
    var np[8];
    var nn[8];
    if (_us_jr_str(a, _us_jr_at(v, form, 0, "name"), &np, &nn) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_material_from_json"));
    }
    var w[40];
    if (_us_material_f64(v, form, 1, "conductivity", &w) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_material_from_json"));
    }
    if (_us_material_f64(v, form, 2, "specific_heat", &w + 8) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_material_from_json"));
    }
    if (_us_material_f64(v, form, 3, "density", &w + 16) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_material_from_json"));
    }
    if (_us_material_f64(v, form, 4, "melting_point", &w + 24) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_material_from_json"));
    }
    if (_us_material_f64(v, form, 5, "boiling_point", &w + 32) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_material_from_json"));
    }
    var k: f64 = load64(&w);
    var cp: f64 = load64(&w + 8);
    var rho: f64 = load64(&w + 16);
    var mp: f64 = load64(&w + 24);
    var bp: f64 = load64(&w + 32);
    out.name = load64(&np);
    out.name_len = load64(&nn);
    out.conductivity = k;
    out.specific_heat = cp;
    out.density = rho;
    out.melting_point = mp;
    out.boiling_point = bp;
    return Ok(0);
}

# us_material_from_json_a on the global heap: for a one-off read (each call's tree and name stay allocated).
#must_use
fn us_material_from_json(buf, n, out: *UsMaterial): Result {
    return us_material_from_json_a(default_alloc(), buf, n, out);
}

# --- transfer.cyr ---

# transfer.cyr — heat transfer: conduction, convection, radiation, resistance networks, dimensionless numbers,
# boundary layers, fins, heat exchangers (LMTD, ε-NTU) and view factors (Rust 1.4.0 `transfer`). All SI: watts,
# meters, kelvins, seconds.
#
# Each function computes in the order Rust 1.4.0 writes, so its arithmetic is bit-identical (class B; Rust's powi(2)
# and powi(4) are x·x and (x·x)·(x·x), the products __powidf2 forms), and its transcendentals (exp, ln, pow, tanh,
# atan) are correctly rounded (ADR 0004, class C). A correlation's exponents (Dittus–Boelter's 0.8 and 0.4,
# Churchill–Chu's 1/6, 9/16 and 8/27, Pohlhausen's 1/3) are the doubles Rust writes (ADR 0002 row 9). A refusal
# returns Err(US_ERR_*) and reports its value at DEBUG (src/validate.cyr). The seven functions Rust instruments open a
# DEBUG span under Rust's span name: conduction, radiation, fin_rectangular_heat, lmtd_parallel, lmtd_counter,
# view_factor_parallel_plates and view_factor_perpendicular_plates.

# Fourier's law: q = k·A·(T_hot − T_cold) / L (W). Err(US_ERR_INVALID_CONDUCTIVITY) when k is negative or not finite,
# Err(US_ERR_DIVISION_BY_ZERO) when |L| < 1e-30 or L is not finite.
#must_use
fn us_conduction(conductivity: f64, area: f64, t_hot: f64, t_cold: f64, thickness: f64): Result {
    _us_span_enter("conduction", 10);
    if (_us_finite_ge(conductivity, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_CONDUCTIVITY, "us_conduction", "conductivity", conductivity));
    }
    var al: f64 = f64_abs(thickness);
    if (_us_finite_ge(al, _US_TINY) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_conduction", "thickness", thickness));
    }
    var q: f64 = conductivity * area * (t_hot - t_cold) / thickness;
    _us_span_exit();
    return Ok(q);
}

# Newton's law of cooling: q = h·A·(T_surface − T_fluid) (W).
#must_use
#pure
fn us_convection(h: f64, area: f64, t_surface: f64, t_fluid: f64): f64 {
    var q: f64 = h * area * (t_surface - t_fluid);
    return q;
}

# The Stefan–Boltzmann law: q = ε·σ·A·(T_s⁴ − T_surr⁴) (W). Err(US_ERR_INVALID_PARAMETER) when ε is outside [0, 1]
# (or NaN), Err(US_ERR_INVALID_TEMPERATURE) when a temperature is negative or not finite.
#must_use
fn us_radiation(emissivity: f64, area: f64, t_surface: f64, t_surrounding: f64): Result {
    _us_span_enter("radiation", 9);
    if (emissivity >= 0.0 && emissivity <= 1.0) {
        if (_us_finite_ge(t_surface, 0.0) == 0) {
            _us_span_exit();
            return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_radiation", "t_surface", t_surface));
        }
        if (_us_finite_ge(t_surrounding, 0.0) == 0) {
            _us_span_exit();
            return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_radiation", "t_surrounding", t_surrounding));
        }
        # Rust's powi(4): __powidf2 squares twice, so T⁴ is (T·T)·(T·T) exactly.
        var ts2: f64 = t_surface * t_surface;
        var ts4: f64 = ts2 * ts2;
        var tr2: f64 = t_surrounding * t_surrounding;
        var tr4: f64 = tr2 * tr2;
        var q: f64 = emissivity * US_STEFAN_BOLTZMANN * area * (ts4 - tr4);
        _us_span_exit();
        return Ok(q);
    }
    _us_span_exit();
    return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_radiation", "emissivity", emissivity));
}

# Conduction resistance R = L / (k·A) (K/W). Err(US_ERR_INVALID_CONDUCTIVITY) unless k > 0;
# Err(US_ERR_INVALID_PARAMETER) unless A > 0 and L ≥ 0; Err(US_ERR_DIVISION_BY_ZERO) when |k·A| < 1e-30.
#must_use
fn us_thermal_resistance_conduction(conductivity: f64, area: f64, thickness: f64): Result {
    if (_us_finite_gt(conductivity, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_CONDUCTIVITY, "us_thermal_resistance_conduction", "conductivity",
            conductivity));
    }
    if (_us_finite_gt(area, 0.0) == 0 || _us_finite_ge(thickness, 0.0) == 0) {
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_thermal_resistance_conduction", "geometry", "area",
            area, "thickness", thickness));
    }
    var denom: f64 = conductivity * area;
    var ad: f64 = f64_abs(denom);
    if (_us_finite_ge(ad, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_thermal_resistance_conduction", "k*A", denom));
    }
    var r: f64 = thickness / denom;
    return Ok(r);
}

# Convection resistance R = 1 / (h·A) (K/W). Err(US_ERR_INVALID_PARAMETER) unless h ≥ 0 and A ≥ 0;
# Err(US_ERR_DIVISION_BY_ZERO) when |h·A| < 1e-30.
#must_use
fn us_thermal_resistance_convection(h: f64, area: f64): Result {
    if (_us_finite_ge(h, 0.0) == 0 || _us_finite_ge(area, 0.0) == 0) {
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_thermal_resistance_convection", "inputs", "h", h,
            "area", area));
    }
    var denom: f64 = h * area;
    var ad: f64 = f64_abs(denom);
    if (_us_finite_ge(ad, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_thermal_resistance_convection", "h*A", denom));
    }
    var r: f64 = 1.0 / denom;
    return Ok(r);
}

# Series resistance: R₁ + R₂ + … of the `n` f64 at `rs` (K/W), summed left to right from −0.0 as Rust's `sum` does
# (so an empty list is −0.0).
#must_use
fn us_thermal_resistance_series(rs, n): f64 {
    var s: f64 = 0.0 - 0.0;
    var k = 0;
    while (k < n) {
        var r: f64 = load64(rs + (8 * k));
        s = s + r;
        k = k + 1;
    }
    return s;
}

# Parallel resistance: 1 / (1/R₁ + 1/R₂ + …) of the `n` f64 at `rs` (K/W). Err(US_ERR_INVALID_PARAMETER) when any R is
# not positive and finite (the first such is reported), Err(US_ERR_DIVISION_BY_ZERO) when the sum of reciprocals is
# below 1e-30 in magnitude (an empty list).
#must_use
fn us_thermal_resistance_parallel(rs, n): Result {
    var k = 0;
    while (k < n) {
        var r: f64 = load64(rs + (8 * k));
        if (_us_finite_gt(r, 0.0) == 0) {
            return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_thermal_resistance_parallel", "resistance", r));
        }
        k = k + 1;
    }
    var s: f64 = 0.0 - 0.0;
    k = 0;
    while (k < n) {
        var r2: f64 = load64(rs + (8 * k));
        var inv: f64 = 1.0 / r2;
        s = s + inv;
        k = k + 1;
    }
    var as: f64 = f64_abs(s);
    if (_us_finite_ge(as, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_thermal_resistance_parallel", "sum", s));
    }
    var rt: f64 = 1.0 / s;
    return Ok(rt);
}

# Heat stored in a body: Q = m·c·ΔT (J).
#must_use
#pure
fn us_heat_stored(mass: f64, specific_heat: f64, delta_t: f64): f64 {
    var q: f64 = mass * specific_heat * delta_t;
    return q;
}

# Thermal diffusivity α = k / (ρ·c_p) (m²/s). Err(US_ERR_INVALID_CONDUCTIVITY), Err(US_ERR_INVALID_PARAMETER) (the
# density) or Err(US_ERR_INVALID_SPECIFIC_HEAT) for a negative or non-finite input, Err(US_ERR_DIVISION_BY_ZERO) when
# |ρ·c_p| < 1e-30.
#must_use
fn us_thermal_diffusivity(conductivity: f64, density: f64, specific_heat: f64): Result {
    if (_us_finite_ge(conductivity, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_CONDUCTIVITY, "us_thermal_diffusivity", "conductivity", conductivity));
    }
    if (_us_finite_ge(density, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_thermal_diffusivity", "density", density));
    }
    if (_us_finite_ge(specific_heat, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_SPECIFIC_HEAT, "us_thermal_diffusivity", "specific_heat",
            specific_heat));
    }
    var denom: f64 = density * specific_heat;
    var ad: f64 = f64_abs(denom);
    if (_us_finite_ge(ad, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_thermal_diffusivity", "rho*cp", denom));
    }
    var a: f64 = conductivity / denom;
    return Ok(a);
}

# Biot number Bi = h·L / k. Err(US_ERR_INVALID_PARAMETER) unless h ≥ 0 and L ≥ 0, Err(US_ERR_DIVISION_BY_ZERO) unless
# k ≥ 1e-30.
#must_use
fn us_biot_number(h: f64, characteristic_length: f64, conductivity: f64): Result {
    if (_us_finite_ge(h, 0.0) == 0 || _us_finite_ge(characteristic_length, 0.0) == 0) {
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_biot_number", "inputs", "h", h, "length",
            characteristic_length));
    }
    if (_us_finite_ge(conductivity, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_biot_number", "conductivity", conductivity));
    }
    var bi: f64 = h * characteristic_length / conductivity;
    return Ok(bi);
}

# Lumped-capacitance cooling: T(t) = T_env + (T₀ − T_env)·e^(−t/τ) (K), valid for Bi < 0.1.
#must_use
fn us_lumped_capacitance(t_initial: f64, t_environment: f64, time: f64, time_constant: f64): f64 {
    var arg: f64 = (0.0 - time) / time_constant;
    var e: f64 = _us_cr_exp(arg);
    var t: f64 = t_environment + (t_initial - t_environment) * e;
    return t;
}

# Reynolds number Re = V·L / ν. Err(US_ERR_INVALID_PARAMETER) unless ν > 0.
#must_use
fn us_reynolds_number(velocity: f64, length: f64, kinematic_viscosity: f64): Result {
    if (_us_finite_gt(kinematic_viscosity, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_reynolds_number", "kinematic_viscosity",
            kinematic_viscosity));
    }
    var re: f64 = velocity * length / kinematic_viscosity;
    return Ok(re);
}

# Prandtl number Pr = ν / α. Err(US_ERR_INVALID_PARAMETER) unless ν > 0, Err(US_ERR_DIVISION_BY_ZERO) unless α > 0.
#must_use
fn us_prandtl_number(kinematic_viscosity: f64, thermal_diffusivity: f64): Result {
    if (_us_finite_gt(kinematic_viscosity, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_prandtl_number", "kinematic_viscosity",
            kinematic_viscosity));
    }
    if (_us_finite_gt(thermal_diffusivity, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_prandtl_number", "thermal_diffusivity",
            thermal_diffusivity));
    }
    var pr: f64 = kinematic_viscosity / thermal_diffusivity;
    return Ok(pr);
}

# Nusselt number (definition) Nu = h·L / k. Err(US_ERR_DIVISION_BY_ZERO) unless k ≥ 1e-30.
#must_use
fn us_nusselt_number(h: f64, length: f64, conductivity: f64): Result {
    if (_us_finite_ge(conductivity, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_nusselt_number", "conductivity", conductivity));
    }
    var nu: f64 = h * length / conductivity;
    return Ok(nu);
}

# Dittus–Boelter: Nu = 0.023·Re^0.8·Pr^0.4 (turbulent flow in smooth tubes, heating). Err(US_ERR_INVALID_PARAMETER)
# unless Re > 0 and Pr > 0.
#must_use
fn us_nusselt_dittus_boelter(re: f64, pr: f64): Result {
    if (_us_finite_gt(re, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_nusselt_dittus_boelter", "reynolds", re));
    }
    if (_us_finite_gt(pr, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_nusselt_dittus_boelter", "prandtl", pr));
    }
    var a: f64 = _us_cr_pow(re, 0.8);
    var b: f64 = _us_cr_pow(pr, 0.4);
    var nu: f64 = 0.023 * a * b;
    return Ok(nu);
}

# Churchill–Chu natural convection on a vertical plate, any Ra:
# Nu = {0.825 + 0.387·Ra^(1/6) / [1 + (0.492/Pr)^(9/16)]^(8/27)}². Err(US_ERR_INVALID_PARAMETER) unless Ra ≥ 0 and
# Pr > 0.
#must_use
fn us_nusselt_natural_vertical(ra: f64, pr: f64): Result {
    if (_us_finite_ge(ra, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_nusselt_natural_vertical", "rayleigh", ra));
    }
    if (_us_finite_gt(pr, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_nusselt_natural_vertical", "prandtl", pr));
    }
    var e916: f64 = 9.0 / 16.0;
    var em827: f64 = (0.0 - 8.0) / 27.0;
    var e16: f64 = 1.0 / 6.0;
    var ratio: f64 = 0.492 / pr;
    var p1: f64 = _us_cr_pow(ratio, e916);
    var psi: f64 = _us_cr_pow(1.0 + p1, em827);
    var r16: f64 = _us_cr_pow(ra, e16);
    var inner: f64 = 0.825 + 0.387 * r16 * psi;
    var nu: f64 = inner * inner;
    return Ok(nu);
}

# Laminar (Blasius) boundary-layer thickness δ = 5·x / √Re_x (m), for Re_x below about 5×10⁵.
# Err(US_ERR_INVALID_PARAMETER) unless x > 0 and Re_x > 0.
#must_use
fn us_boundary_layer_thickness(x: f64, re_x: f64): Result {
    if (_us_finite_gt(x, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_boundary_layer_thickness", "x", x));
    }
    if (_us_finite_gt(re_x, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_boundary_layer_thickness", "re_x", re_x));
    }
    var sr: f64 = f64_sqrt(re_x);
    var d: f64 = 5.0 * x / sr;
    return Ok(d);
}

# Thermal boundary-layer thickness δ_t = δ / Pr^(1/3) (m). Err(US_ERR_INVALID_PARAMETER) unless Pr > 0, then
# us_boundary_layer_thickness's refusals.
#must_use
fn us_thermal_boundary_layer(x: f64, re_x: f64, pr: f64): Result {
    if (_us_finite_gt(pr, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_thermal_boundary_layer", "prandtl", pr));
    }
    var t, v = us_boundary_layer_thickness(x, re_x);
    if (is_err_result(t) == 1) { return Err(v); }
    var delta: f64 = v;
    var e13: f64 = 1.0 / 3.0;
    var p: f64 = _us_cr_pow(pr, e13);
    var dt: f64 = delta / p;
    return Ok(dt);
}

# --- Fins ---

# Fin parameter m = √(h·P / (k·A_c)) (1/m). Err(US_ERR_DIVISION_BY_ZERO) unless k > 0 and A_c > 0;
# Err(US_ERR_INVALID_PARAMETER) unless h ≥ 0 and P > 0.
#must_use
fn us_fin_parameter(h: f64, perimeter: f64, k: f64, cross_area: f64): Result {
    if (_us_finite_gt(k, 0.0) == 0 || _us_finite_gt(cross_area, 0.0) == 0) {
        return Err(_us_fail_ff(US_ERR_DIVISION_BY_ZERO, "us_fin_parameter", "k*A_c", "k", k, "cross_area",
            cross_area));
    }
    if (_us_finite_ge(h, 0.0) == 0 || _us_finite_gt(perimeter, 0.0) == 0) {
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_fin_parameter", "inputs", "h", h, "perimeter",
            perimeter));
    }
    var denom: f64 = k * cross_area;
    var q: f64 = h * perimeter / denom;
    var m: f64 = f64_sqrt(q);
    return Ok(m);
}

# Heat from a rectangular fin with an insulated tip: Q = √(h·P·k·A_c)·(T_base − T_fluid)·tanh(m·L) (W).
# us_fin_parameter's refusals, then Err(US_ERR_INVALID_PARAMETER) unless L > 0.
#must_use
fn us_fin_rectangular_heat(h: f64, perimeter: f64, k: f64, cross_area: f64, length: f64, t_base: f64,
  t_fluid: f64): Result {
    _us_span_enter("fin_rectangular_heat", 20);
    var t, v = us_fin_parameter(h, perimeter, k, cross_area);
    if (is_err_result(t) == 1) {
        _us_span_exit();
        return Err(v);
    }
    var m: f64 = v;
    if (_us_finite_gt(length, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_fin_rectangular_heat", "length", length));
    }
    var hpka: f64 = h * perimeter * k * cross_area;
    var coeff: f64 = f64_sqrt(hpka);
    var ml: f64 = m * length;
    var th: f64 = _us_cr_tanh(ml);
    var q: f64 = coeff * (t_base - t_fluid) * th;
    _us_span_exit();
    return Ok(q);
}

# Efficiency of a rectangular fin with an insulated tip: η = tanh(m·L) / (m·L), and 1 when |m·L| < 1e-30 (a
# zero-length fin). Err(US_ERR_INVALID_PARAMETER) unless m ≥ 0 and L ≥ 0.
#must_use
fn us_fin_efficiency_rectangular(m: f64, length: f64): Result {
    if (_us_finite_ge(m, 0.0) == 0 || _us_finite_ge(length, 0.0) == 0) {
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_fin_efficiency_rectangular", "inputs", "m", m,
            "length", length));
    }
    var ml: f64 = m * length;
    var aml: f64 = f64_abs(ml);
    if (aml < _US_TINY) { return Ok(1.0); }
    var th: f64 = _us_cr_tanh(ml);
    var eta: f64 = th / ml;
    return Ok(eta);
}

# Fin effectiveness ε = Q_fin / (h·A_c·(T_base − T_fluid)), the fin's heat over the bare base's.
# Err(US_ERR_DIVISION_BY_ZERO) when the bare base's heat is below 1e-30 in magnitude or not finite.
#must_use
fn us_fin_effectiveness(q_fin: f64, h: f64, cross_area: f64, t_base: f64, t_fluid: f64): Result {
    var q0: f64 = h * cross_area * (t_base - t_fluid);
    var aq: f64 = f64_abs(q0);
    if (_us_finite_ge(aq, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_fin_effectiveness", "q_no_fin", q0));
    }
    var eps: f64 = q_fin / q0;
    return Ok(eps);
}

# --- Heat exchangers ---

# The LMTD (ΔT₁ − ΔT₂) / ln(ΔT₁/ΔT₂) for `fname`, and the arithmetic mean when |ΔT₁/ΔT₂ − 1| < 1e-10.
# Err(US_ERR_INVALID_PARAMETER) unless ΔT₁ > 0 and ΔT₂ > 0.
fn _us_lmtd(dt1: f64, dt2: f64, fname): Result {
    if (_us_finite_gt(dt1, 0.0) == 0 || _us_finite_gt(dt2, 0.0) == 0) {
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, fname, "temperature differences", "dt1", dt1, "dt2",
            dt2));
    }
    var ratio: f64 = dt1 / dt2;
    var dev: f64 = f64_abs(ratio - 1.0);
    if (dev < 0.0000000001) {
        var mean: f64 = 0.5 * (dt1 + dt2);
        return Ok(mean);
    }
    var lr: f64 = _us_cr_ln(ratio);
    var lm: f64 = (dt1 - dt2) / lr;
    return Ok(lm);
}

# Log mean temperature difference of a parallel-flow exchanger (K), with ΔT₁ = T_h,in − T_c,in and
# ΔT₂ = T_h,out − T_c,out. Err(US_ERR_INVALID_PARAMETER) unless both are positive.
#must_use
fn us_lmtd_parallel(t_h_in: f64, t_h_out: f64, t_c_in: f64, t_c_out: f64): Result {
    _us_span_enter("lmtd_parallel", 13);
    var t, v = _us_lmtd(t_h_in - t_c_in, t_h_out - t_c_out, "us_lmtd_parallel");
    _us_span_exit();
    return (t, v);
}

# Log mean temperature difference of a counter-flow exchanger (K), with ΔT₁ = T_h,in − T_c,out and
# ΔT₂ = T_h,out − T_c,in. Err(US_ERR_INVALID_PARAMETER) unless both are positive.
#must_use
fn us_lmtd_counter(t_h_in: f64, t_h_out: f64, t_c_in: f64, t_c_out: f64): Result {
    _us_span_enter("lmtd_counter", 12);
    var t, v = _us_lmtd(t_h_in - t_c_out, t_h_out - t_c_in, "us_lmtd_counter");
    _us_span_exit();
    return (t, v);
}

# Heat rate by the LMTD method: Q = U·A·LMTD (W).
#must_use
#pure
fn us_heat_exchanger_lmtd(u: f64, area: f64, lmtd: f64): f64 {
    var q: f64 = u * area * lmtd;
    return q;
}

# Number of transfer units NTU = U·A / C_min. Err(US_ERR_DIVISION_BY_ZERO) unless C_min > 0.
#must_use
fn us_ntu(u: f64, area: f64, c_min: f64): Result {
    if (_us_finite_gt(c_min, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_ntu", "c_min", c_min));
    }
    var n: f64 = u * area / c_min;
    return Ok(n);
}

# The ε-NTU inputs' refusal for `fname`, or 0: Err(US_ERR_INVALID_PARAMETER) unless NTU ≥ 0 and 0 ≤ C_r ≤ 1.
fn _us_entu_check(ntu_val: f64, c_ratio: f64, fname): i64 {
    if (_us_finite_ge(ntu_val, 0.0) == 0) {
        return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, "ntu", ntu_val);
    }
    if (c_ratio >= 0.0 && c_ratio <= 1.0) { return 0; }
    return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, "c_ratio", c_ratio);
}

# Effectiveness of a parallel-flow exchanger: ε = (1 − e^(−NTU·(1 + C_r))) / (1 + C_r), and 1 − e^(−NTU) when
# C_r < 1e-30. Err(US_ERR_INVALID_PARAMETER) unless NTU ≥ 0 and 0 ≤ C_r ≤ 1.
#must_use
fn us_effectiveness_parallel(ntu_val: f64, c_ratio: f64): Result {
    var code = _us_entu_check(ntu_val, c_ratio, "us_effectiveness_parallel");
    if (code != 0) { return Err(code); }
    if (c_ratio < _US_TINY) {
        var e0: f64 = _us_cr_exp(0.0 - ntu_val);
        var eps0: f64 = 1.0 - e0;
        return Ok(eps0);
    }
    var cr1: f64 = 1.0 + c_ratio;
    var e: f64 = _us_cr_exp((0.0 - cr1) * ntu_val);
    var eps: f64 = (1.0 - e) / cr1;
    return Ok(eps);
}

# Effectiveness of a counter-flow exchanger: ε = (1 − e^(−NTU·(1 − C_r))) / (1 − C_r·e^(−NTU·(1 − C_r))), with
# 1 − e^(−NTU) when C_r < 1e-30 and NTU / (1 + NTU) when |C_r − 1| < 1e-10. Err(US_ERR_INVALID_PARAMETER) unless
# NTU ≥ 0 and 0 ≤ C_r ≤ 1.
#must_use
fn us_effectiveness_counter(ntu_val: f64, c_ratio: f64): Result {
    var code = _us_entu_check(ntu_val, c_ratio, "us_effectiveness_counter");
    if (code != 0) { return Err(code); }
    if (c_ratio < _US_TINY) {
        var e0: f64 = _us_cr_exp(0.0 - ntu_val);
        var eps0: f64 = 1.0 - e0;
        return Ok(eps0);
    }
    var dev: f64 = f64_abs(c_ratio - 1.0);
    if (dev < 0.0000000001) {
        var eps1: f64 = ntu_val / (1.0 + ntu_val);
        return Ok(eps1);
    }
    var ncr: f64 = 0.0 - (1.0 - c_ratio);
    var e: f64 = _us_cr_exp(ncr * ntu_val);
    var eps: f64 = (1.0 - e) / (1.0 - c_ratio * e);
    return Ok(eps);
}

# Heat rate by the ε-NTU method: Q = ε·C_min·(T_h,in − T_c,in) (W).
#must_use
#pure
fn us_heat_exchanger_ntu(effectiveness: f64, c_min: f64, t_h_in: f64, t_c_in: f64): f64 {
    var q: f64 = effectiveness * c_min * (t_h_in - t_c_in);
    return q;
}

# --- Radiation view factors ---

# The refusal of `fname` on three dimensions: US_ERR_INVALID_PARAMETER, reporting the first that is not positive and
# finite (named by `n1`, `n2`, `n3`), or 0 when all three are. The view factors test the three inline and call this
# only to refuse (6 ns a call, M1d's review).
fn _us_dims_check(fname, n1, a: f64, n2, b: f64, n3, c: f64): i64 {
    if (_us_finite_gt(a, 0.0) == 0) { return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, n1, a); }
    if (_us_finite_gt(b, 0.0) == 0) { return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, n2, b); }
    if (_us_finite_gt(c, 0.0) == 0) { return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, n3, c); }
    return 0;
}

# atan(x), correctly rounded: atan2(x, 1) is atan exactly (ADR 0004).
fn _us_atan(x: f64): f64 {
    var r: f64 = _us_cr_atan2(x, 1.0);
    return r;
}

# View factor F₁₂ between two identical, directly opposed parallel rectangles W × H at distance D (Incropera
# Table 13.2). With X = W/D and Y = H/D both below 0.01 it is the asymptotic XY/π·(1 − (X² + Y²)/3), where the exact
# form cancels. Err(US_ERR_INVALID_PARAMETER) unless W, H and D are positive.
#must_use
fn us_view_factor_parallel_plates(width: f64, height: f64, distance: f64): Result {
    _us_span_enter("view_factor_parallel_plates", 27);
    if ((_us_finite_gt(width, 0.0) & _us_finite_gt(height, 0.0) & _us_finite_gt(distance, 0.0)) == 0) {
        _us_span_exit();
        return Err(_us_dims_check("us_view_factor_parallel_plates", "width", width, "height", height, "distance",
            distance));
    }
    var pi: f64 = F64_PI;
    var x: f64 = width / distance;
    var y: f64 = height / distance;
    var x2: f64 = x * x;
    var y2: f64 = y * y;
    var mxy: f64 = _us_max(x, y);
    if (mxy < 0.01) {
        var fa: f64 = x * y / pi * (1.0 - (x2 + y2) / 3.0);
        _us_span_exit();
        return Ok(fa);
    }
    var q1: f64 = (1.0 + x2) * (1.0 + y2) / (1.0 + x2 + y2);
    var s1: f64 = f64_sqrt(q1);
    var term1: f64 = _us_cr_ln(s1);
    var sy: f64 = f64_sqrt(1.0 + y2);
    var a2: f64 = _us_atan(x / sy);
    var term2: f64 = x * sy * a2;
    var sx: f64 = f64_sqrt(1.0 + x2);
    var a3: f64 = _us_atan(y / sx);
    var term3: f64 = y * sx * a3;
    var a4: f64 = _us_atan(x);
    var term4: f64 = x * a4;
    var a5: f64 = _us_atan(y);
    var term5: f64 = y * a5;
    var f12: f64 = 2.0 / (pi * x * y) * (term1 + term2 + term3 - term4 - term5);
    _us_span_exit();
    return Ok(f12);
}

# View factor F₁₂ from rectangle 1 (W × H₁) to rectangle 2 (W × H₂), perpendicular and sharing the edge W
# (Incropera Table 13.2, Howell C-14), clamped to [0, 1]. The logarithm of the product is a sum of logarithms, so its
# powers can't overflow. Err(US_ERR_INVALID_PARAMETER) unless W, H₁ and H₂ are positive.
#must_use
fn us_view_factor_perpendicular_plates(width: f64, h1: f64, h2: f64): Result {
    _us_span_enter("view_factor_perpendicular_plates", 32);
    if ((_us_finite_gt(width, 0.0) & _us_finite_gt(h1, 0.0) & _us_finite_gt(h2, 0.0)) == 0) {
        _us_span_exit();
        return Err(_us_dims_check("us_view_factor_perpendicular_plates", "width", width, "h1", h1, "h2", h2));
    }
    var pi: f64 = F64_PI;
    var w: f64 = h1 / width;
    var h: f64 = h2 / width;
    var w2: f64 = w * w;
    var hh: f64 = h * h;
    var s: f64 = hh + w2;
    var rs: f64 = f64_sqrt(s);
    var aw: f64 = _us_atan(1.0 / w);
    var ah: f64 = _us_atan(1.0 / h);
    var ar: f64 = _us_atan(1.0 / rs);
    var atan_terms: f64 = w * aw + h * ah - rs * ar;
    var l1: f64 = _us_cr_ln((1.0 + w2) * (1.0 + hh) / (1.0 + s));
    var l2: f64 = _us_cr_ln(w2 * (1.0 + s) / ((1.0 + w2) * s));
    var l3: f64 = _us_cr_ln(hh * (1.0 + s) / ((1.0 + hh) * s));
    var log_terms: f64 = l1 + w2 * l2 + hh * l3;
    var f12: f64 = (atan_terms + 0.25 * log_terms) / (pi * w);
    var fc: f64 = f64_clamp(f12, 0.0, 1.0);
    _us_span_exit();
    return Ok(fc);
}

# View factor F₁₂ from disk 1 (radius r₁) to a coaxial parallel disk 2 (radius r₂) at distance d, as
# 2k² / (S + √(S² − 4k²)) with S = 1 + (1 + R₂²)/R₁², R = r/d and k = r₂/r₁ (the cancellation-free form of
# ½·(S − √(S² − 4k²))). Err(US_ERR_INVALID_PARAMETER) unless r₁, r₂ and d are positive.
#must_use
fn us_view_factor_coaxial_disks(r1: f64, r2: f64, distance: f64): Result {
    if ((_us_finite_gt(r1, 0.0) & _us_finite_gt(r2, 0.0) & _us_finite_gt(distance, 0.0)) == 0) {
        return Err(_us_dims_check("us_view_factor_coaxial_disks", "r1", r1, "r2", r2, "distance", distance));
    }
    var r1d: f64 = r1 / distance;
    var r2d: f64 = r2 / distance;
    var s: f64 = 1.0 + (1.0 + r2d * r2d) / (r1d * r1d);
    var rr: f64 = r2 / r1;
    var k2: f64 = rr * rr;
    var root: f64 = f64_sqrt(s * s - 4.0 * k2);
    var f12: f64 = 2.0 * k2 / (s + root);
    return Ok(f12);
}

