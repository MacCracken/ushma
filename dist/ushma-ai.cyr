# --- state.cyr ---

# state.cyr — equations of state: the ideal gas, van der Waals, Redlich–Kwong and Peng–Robinson, the virial forms, work
# and adiabatic relations, compressibility (Pitzer–Abbott), Kay's mixture rules, reduced coordinates, and the reference
# gases' critical data (Rust 1.4.0 `state`). All SI: pascals, cubic meters, kelvins, moles.
#
# Each function computes in the order Rust 1.4.0 writes, so its arithmetic is bit-identical (class B), and its ln and
# pow are correctly rounded (ADR 0004, class C); Pitzer's fitted exponents 1.6 and 4.2 are the doubles Rust writes
# (ADR 0002 row 9). A refusal returns Err(US_ERR_*) and reports its value at DEBUG (src/validate.cyr). The four
# functions Rust instruments open a DEBUG span under Rust's span name: ideal_gas_pressure, van_der_waals_pressure,
# redlich_kwong_pressure and peng_robinson_pressure. The parameter functions return their pair or triple as multiple
# values; Kay's rules take each list with its own length, so a mismatch is a refusal as in Rust.
#
# A gas is a UsGas: its name (bytes and length), critical temperature and pressure, and acentric factor. The 8
# reference gases are generated tables (src/state_data.cyr: `US_GAS_<NAME>` indices, `US_GAS_COUNT`); us_gas_preset
# fills a UsGas from one. Its JSON is serde_json's `GasData` document, `{"name":…,"critical_t":…,"critical_p":…,
# "acentric_factor":…}` (ADR 0005; src/json.cyr has the rules).

struct UsGas {
    name;
    name_len;
    critical_t: f64;
    critical_p: f64;
    acentric_factor: f64;
}

# --- Ideal gas ---

# The ideal gas law P = nRT / V (Pa). Err(US_ERR_INVALID_PARAMETER) unless n ≥ 0, Err(US_ERR_INVALID_TEMPERATURE)
# unless T ≥ 0, Err(US_ERR_INVALID_VOLUME) unless V > 0.
#must_use
fn us_ideal_gas_pressure(moles: f64, temperature: f64, volume: f64): Result {
    _us_span_enter("ideal_gas_pressure", 18);
    if (_us_finite_ge(moles, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_ideal_gas_pressure", "moles", moles));
    }
    if (_us_finite_ge(temperature, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_ideal_gas_pressure", "temperature", temperature));
    }
    if (_us_finite_gt(volume, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_ideal_gas_pressure", "volume", volume));
    }
    var p: f64 = moles * US_GAS_CONSTANT * temperature / volume;
    _us_span_exit();
    return Ok(p);
}

# The ideal gas volume V = nRT / P (m³). Err(US_ERR_INVALID_PARAMETER) unless n ≥ 0, Err(US_ERR_INVALID_TEMPERATURE)
# unless T ≥ 0, Err(US_ERR_INVALID_PRESSURE) unless P > 0.
#must_use
fn us_ideal_gas_volume(moles: f64, temperature: f64, pressure: f64): Result {
    if (_us_finite_ge(moles, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_ideal_gas_volume", "moles", moles));
    }
    if (_us_finite_ge(temperature, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_ideal_gas_volume", "temperature", temperature));
    }
    if (_us_finite_gt(pressure, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_ideal_gas_volume", "pressure", pressure));
    }
    var v: f64 = moles * US_GAS_CONSTANT * temperature / pressure;
    return Ok(v);
}

# The ideal gas temperature T = PV / (nR) (K). Err(US_ERR_INVALID_PARAMETER) unless n ≥ 0, Err(US_ERR_INVALID_PRESSURE)
# unless P ≥ 0, Err(US_ERR_INVALID_VOLUME) unless V ≥ 0, Err(US_ERR_DIVISION_BY_ZERO) when n < 1e-30.
#must_use
fn us_ideal_gas_temperature(pressure: f64, volume: f64, moles: f64): Result {
    if (_us_finite_ge(moles, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_ideal_gas_temperature", "moles", moles));
    }
    if (_us_finite_ge(pressure, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_ideal_gas_temperature", "pressure", pressure));
    }
    if (_us_finite_ge(volume, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_ideal_gas_temperature", "volume", volume));
    }
    var am: f64 = f64_abs(moles);
    if (_us_finite_ge(am, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_ideal_gas_temperature", "moles", moles));
    }
    var t: f64 = pressure * volume / (moles * US_GAS_CONSTANT);
    return Ok(t);
}

# --- Van der Waals ---

# The van der Waals pressure P = nRT / (V − nb) − a(n/V)² (Pa), with a the attraction (Pa·m⁶/mol²) and b the excluded
# volume (m³/mol). Err(US_ERR_INVALID_PARAMETER) unless n ≥ 0, Err(US_ERR_INVALID_TEMPERATURE) unless T > 0,
# Err(US_ERR_INVALID_VOLUME) unless V > 0, Err(US_ERR_INVALID_PARAMETER) unless a is finite, b ≥ 0 and V − nb > 0.
#must_use
fn us_van_der_waals_pressure(moles: f64, temperature: f64, volume: f64, a: f64, b: f64): Result {
    _us_span_enter("van_der_waals_pressure", 22);
    if (_us_finite_ge(moles, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_van_der_waals_pressure", "moles", moles));
    }
    if (_us_finite_gt(temperature, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_van_der_waals_pressure", "temperature", temperature));
    }
    if (_us_finite_gt(volume, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_van_der_waals_pressure", "volume", volume));
    }
    if (_us_is_finite(a) == 0 || _us_finite_ge(b, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_van_der_waals_pressure", "parameters", "a", a, "b", b));
    }
    var v_eff: f64 = volume - moles * b;
    if (_us_finite_gt(v_eff, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_van_der_waals_pressure", "V-nb", v_eff));
    }
    var density: f64 = moles / volume;
    var p: f64 = moles * US_GAS_CONSTANT * temperature / v_eff - a * density * density;
    _us_span_exit();
    return Ok(p);
}

# --- Work and adiabatic relations ---

# Work of an isothermal ideal-gas expansion W = nRT·ln(V₂/V₁) (J). Err(US_ERR_INVALID_PARAMETER) unless n ≥ 0,
# Err(US_ERR_INVALID_TEMPERATURE) unless T ≥ 0, Err(US_ERR_INVALID_VOLUME) unless V₁ > 0 and V₂ > 0.
#must_use
fn us_isothermal_work(moles: f64, temperature: f64, v1: f64, v2: f64): Result {
    if (_us_finite_ge(moles, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_isothermal_work", "moles", moles));
    }
    if (_us_finite_ge(temperature, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_isothermal_work", "temperature", temperature));
    }
    if (_us_finite_gt(v1, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_isothermal_work", "v1", v1));
    }
    if (_us_finite_gt(v2, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_isothermal_work", "v2", v2));
    }
    var lr: f64 = _us_cr_ln(v2 / v1);
    var w: f64 = moles * US_GAS_CONSTANT * temperature * lr;
    return Ok(w);
}

# Work of an isobaric process W = P(V₂ − V₁) (J).
#must_use
#pure
fn us_isobaric_work(pressure: f64, v1: f64, v2: f64): f64 {
    var w: f64 = pressure * (v2 - v1);
    return w;
}

# The temperature after an adiabatic change of volume, T₂ = T₁(V₁/V₂)^(γ−1) (K). Err(US_ERR_INVALID_TEMPERATURE)
# unless T₁ > 0, Err(US_ERR_INVALID_PARAMETER) unless γ > 1, Err(US_ERR_INVALID_VOLUME) unless V₁ > 0 and V₂ > 0.
#must_use
fn us_adiabatic_temperature(t1: f64, v1: f64, v2: f64, gamma: f64): Result {
    if (_us_finite_gt(t1, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_adiabatic_temperature", "t1", t1));
    }
    if (_us_finite_gt(gamma, 1.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_adiabatic_temperature", "gamma", gamma));
    }
    if (_us_finite_gt(v1, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_adiabatic_temperature", "v1", v1));
    }
    if (_us_finite_gt(v2, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_adiabatic_temperature", "v2", v2));
    }
    var pw: f64 = _us_cr_pow(v1 / v2, gamma - 1.0);
    var t2: f64 = t1 * pw;
    return Ok(t2);
}

# The compressibility factor Z = PV / (nRT): 1 for an ideal gas. Err(US_ERR_INVALID_PRESSURE) unless P > 0,
# Err(US_ERR_INVALID_VOLUME) unless V > 0, Err(US_ERR_INVALID_TEMPERATURE) unless T > 0,
# Err(US_ERR_INVALID_PARAMETER) unless n is finite, Err(US_ERR_DIVISION_BY_ZERO) when |nRT| < 1e-30.
#must_use
fn us_compressibility_factor(pressure: f64, volume: f64, moles: f64, temperature: f64): Result {
    if (_us_finite_gt(pressure, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PRESSURE, "us_compressibility_factor", "pressure", pressure));
    }
    if (_us_finite_gt(volume, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_compressibility_factor", "volume", volume));
    }
    if (_us_finite_gt(temperature, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_compressibility_factor", "temperature", temperature));
    }
    if (_us_is_finite(moles) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_compressibility_factor", "moles", moles));
    }
    var denom: f64 = moles * US_GAS_CONSTANT * temperature;
    var ad: f64 = f64_abs(denom);
    if (_us_finite_ge(ad, _US_TINY) == 0) {
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_compressibility_factor", "nRT", denom));
    }
    var z: f64 = pressure * volume / denom;
    return Ok(z);
}

# --- Reduced coordinates ---

# Reduced temperature T_r = T / T_c.
#must_use
#pure
fn us_reduced_temperature(t: f64, t_critical: f64): f64 {
    var r: f64 = t / t_critical;
    return r;
}

# Reduced pressure P_r = P / P_c.
#must_use
#pure
fn us_reduced_pressure(p: f64, p_critical: f64): f64 {
    var r: f64 = p / p_critical;
    return r;
}

# --- Reference gases ---

# The name of reference gas `i` (a C string into the generated table), or 0 when `i` is no reference gas.
#must_use
fn us_gas_name(i): cstring {
    if (i < 0 || i >= US_GAS_COUNT) { return 0; }
    var off = load16(&_US_GAS_NAME_OFF + (2 * i));
    return &_US_GAS_NAME_BYTES + off;
}

# Fills *out with reference gas `i` (`US_GAS_NITROGEN` … `US_GAS_PROPANE`): Ok(0), or Err(US_ERR_INVALID_PARAMETER)
# when `i` is no reference gas.
#must_use
fn us_gas_preset(i, out: *UsGas): Result {
    if (i < 0 || i >= US_GAS_COUNT) {
        return Err(_us_fail_i(US_ERR_INVALID_PARAMETER, "us_gas_preset", "index", i));
    }
    var name = us_gas_name(i);
    var tc: f64 = US_GAS_CRITICAL_T[i];
    var pc: f64 = US_GAS_CRITICAL_P[i];
    var om: f64 = US_GAS_ACENTRIC_FACTOR[i];
    out.name = name;
    out.name_len = strlen(name);
    out.critical_t = tc;
    out.critical_p = pc;
    out.acentric_factor = om;
    return Ok(0);
}

# Appends *g as serde_json writes a `GasData`.
fn us_gas_to_json(sb, g: *UsGas) {
    var tc: f64 = g.critical_t;
    var pc: f64 = g.critical_p;
    var om: f64 = g.acentric_factor;
    str_builder_putc(sb, 123);
    _us_jw_key(sb, "name", 1);
    _us_jw_str(sb, g.name, g.name_len);
    _us_jw_key(sb, "critical_t", 0);
    _us_jw_f64(sb, tc);
    _us_jw_key(sb, "critical_p", 0);
    _us_jw_f64(sb, pc);
    _us_jw_key(sb, "acentric_factor", 0);
    _us_jw_f64(sb, om);
    str_builder_putc(sb, 125);
    return 0;
}

# Reads a `GasData` document (`n` bytes at `buf`) into *out, its name copied onto allocator `a`: Ok(0), or
# Err(US_ERR_DESERIALIZE), leaving *out unchanged. The parse tree is on `a` too: reset it when the result is used.
#must_use
fn us_gas_from_json_a(a, buf, n, out: *UsGas): Result {
    var v = _us_jr_parse(a, buf, n);
    var form = _us_jr_form(v, 4);
    if (form == 0) { return Err(_us_fail(US_ERR_DESERIALIZE, "us_gas_from_json")); }
    var np[8];
    var nn[8];
    if (_us_jr_str(a, _us_jr_at(v, form, 0, "name"), &np, &nn) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_gas_from_json"));
    }
    var w[24];
    if (_us_jr_f64(_us_jr_at(v, form, 1, "critical_t"), &w) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_gas_from_json"));
    }
    if (_us_jr_f64(_us_jr_at(v, form, 2, "critical_p"), &w + 8) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_gas_from_json"));
    }
    if (_us_jr_f64(_us_jr_at(v, form, 3, "acentric_factor"), &w + 16) == 0) {
        return Err(_us_fail(US_ERR_DESERIALIZE, "us_gas_from_json"));
    }
    var tc: f64 = load64(&w);
    var pc: f64 = load64(&w + 8);
    var om: f64 = load64(&w + 16);
    out.name = load64(&np);
    out.name_len = load64(&nn);
    out.critical_t = tc;
    out.critical_p = pc;
    out.acentric_factor = om;
    return Ok(0);
}

# us_gas_from_json_a on the global heap: for a one-off read (each call's tree and name stay allocated).
#must_use
fn us_gas_from_json(buf, n, out: *UsGas): Result {
    return us_gas_from_json_a(default_alloc(), buf, n, out);
}

# --- Cubic equations of state ---

# The cubic equations' check on the critical constants for `fname`, or 0: Err(US_ERR_INVALID_TEMPERATURE) unless
# T_c > 0, Err(US_ERR_INVALID_PRESSURE) unless P_c > 0.
fn _us_critical_check(tc: f64, pc: f64, fname): i64 {
    if (_us_finite_gt(tc, 0.0) == 0) { return _us_fail_f(US_ERR_INVALID_TEMPERATURE, fname, "tc", tc); }
    if (_us_finite_gt(pc, 0.0) == 0) { return _us_fail_f(US_ERR_INVALID_PRESSURE, fname, "pc", pc); }
    return 0;
}

# Redlich–Kwong's (a, b) from the critical constants: a = 0.42748·R²·T_c^2.5 / P_c, b = 0.08664·R·T_c / P_c.
#must_use
fn us_redlich_kwong_params(tc: f64, pc: f64): (f64, f64) {
    var t25: f64 = _us_cr_pow(tc, 2.5);
    var a: f64 = 0.42748 * US_GAS_CONSTANT * US_GAS_CONSTANT * t25 / pc;
    var b: f64 = 0.08664 * US_GAS_CONSTANT * tc / pc;
    return (a, b);
}

# The Redlich–Kwong pressure P = RT / (V_m − b) − a / (√T·V_m·(V_m + b)) (Pa), at molar volume V_m (m³/mol).
# Err(US_ERR_INVALID_TEMPERATURE) unless T > 0, then the critical constants' refusals, Err(US_ERR_INVALID_VOLUME)
# unless V_m > 0, Err(US_ERR_INVALID_PARAMETER) unless V_m > b.
#must_use
fn us_redlich_kwong_pressure(temperature: f64, molar_volume: f64, tc: f64, pc: f64): Result {
    _us_span_enter("redlich_kwong_pressure", 22);
    if (_us_finite_gt(temperature, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_redlich_kwong_pressure", "temperature", temperature));
    }
    var code = _us_critical_check(tc, pc, "us_redlich_kwong_pressure");
    if (code != 0) {
        _us_span_exit();
        return Err(code);
    }
    if (_us_finite_gt(molar_volume, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_redlich_kwong_pressure", "molar_volume", molar_volume));
    }
    var a, b = us_redlich_kwong_params(tc, pc);
    var vm_b: f64 = molar_volume - b;
    if (_us_finite_gt(vm_b, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_redlich_kwong_pressure", "Vm <= b", "Vm", molar_volume,
            "b", b));
    }
    var repulsive: f64 = US_GAS_CONSTANT * temperature / vm_b;
    var st: f64 = f64_sqrt(temperature);
    var attractive: f64 = a / (st * molar_volume * (molar_volume + b));
    var p: f64 = repulsive - attractive;
    _us_span_exit();
    return Ok(p);
}

# Peng–Robinson's (a, b, κ) from the critical constants and acentric factor: a = 0.45724·R²·T_c² / P_c,
# b = 0.07780·R·T_c / P_c, κ = 0.37464 + 1.54226ω − 0.26992ω².
#must_use
#pure
fn us_peng_robinson_params(tc: f64, pc: f64, omega: f64): (f64, f64, f64) {
    var a: f64 = 0.45724 * US_GAS_CONSTANT * US_GAS_CONSTANT * tc * tc / pc;
    var b: f64 = 0.07780 * US_GAS_CONSTANT * tc / pc;
    var kappa: f64 = 0.37464 + 1.54226 * omega - 0.26992 * omega * omega;
    return (a, b, kappa);
}

# The Peng–Robinson pressure P = RT / (V_m − b) − a·α(T) / (V_m² + 2bV_m − b²) (Pa), α(T) = [1 + κ(1 − √(T/T_c))]².
# Err(US_ERR_INVALID_TEMPERATURE) unless T > 0, then the critical constants' refusals, Err(US_ERR_INVALID_VOLUME)
# unless V_m > 0, Err(US_ERR_INVALID_PARAMETER) unless ω is finite and V_m > b, Err(US_ERR_DIVISION_BY_ZERO) when the
# attractive denominator is below 1e-30 in magnitude.
#must_use
fn us_peng_robinson_pressure(temperature: f64, molar_volume: f64, tc: f64, pc: f64, omega: f64): Result {
    _us_span_enter("peng_robinson_pressure", 22);
    if (_us_finite_gt(temperature, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_peng_robinson_pressure", "temperature", temperature));
    }
    var code = _us_critical_check(tc, pc, "us_peng_robinson_pressure");
    if (code != 0) {
        _us_span_exit();
        return Err(code);
    }
    if (_us_finite_gt(molar_volume, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_peng_robinson_pressure", "molar_volume", molar_volume));
    }
    if (_us_is_finite(omega) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_peng_robinson_pressure", "omega", omega));
    }
    var a, b, kappa = us_peng_robinson_params(tc, pc, omega);
    var vm_b: f64 = molar_volume - b;
    if (_us_finite_gt(vm_b, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_peng_robinson_pressure", "Vm <= b", "Vm", molar_volume,
            "b", b));
    }
    var sr: f64 = f64_sqrt(temperature / tc);
    var alpha_sqrt: f64 = 1.0 + kappa * (1.0 - sr);
    var alpha: f64 = alpha_sqrt * alpha_sqrt;
    var repulsive: f64 = US_GAS_CONSTANT * temperature / vm_b;
    var denom: f64 = molar_volume * molar_volume + 2.0 * b * molar_volume - b * b;
    var ad: f64 = f64_abs(denom);
    if (_us_finite_ge(ad, _US_TINY) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_DIVISION_BY_ZERO, "us_peng_robinson_pressure", "denominator", denom));
    }
    var p: f64 = repulsive - a * alpha / denom;
    _us_span_exit();
    return Ok(p);
}

# --- Virial equations of state ---

# Pitzer's correlation for the second virial coefficient B (m³/mol): B·P_c / (R·T_c) = B⁰ + ω·B¹, with
# B⁰ = 0.083 − 0.422 / T_r^1.6 and B¹ = 0.139 − 0.172 / T_r^4.2 (the fitted exponents Rust writes, ADR 0002 row 9).
#must_use
fn us_pitzer_second_virial(temperature: f64, tc: f64, pc: f64, omega: f64): f64 {
    var tr: f64 = temperature / tc;
    var p16: f64 = _us_cr_pow(tr, 1.6);
    var p42: f64 = _us_cr_pow(tr, 4.2);
    var b0: f64 = 0.083 - 0.422 / p16;
    var b1: f64 = 0.139 - 0.172 / p42;
    var bv: f64 = (b0 + omega * b1) * US_GAS_CONSTANT * tc / pc;
    return bv;
}

# The two-term virial pressure P = RT/V_m · (1 + B/V_m) (Pa). Err(US_ERR_INVALID_TEMPERATURE) unless T > 0,
# Err(US_ERR_INVALID_VOLUME) unless V_m > 0.
#must_use
fn us_virial_pressure_2nd(temperature: f64, molar_volume: f64, b_coeff: f64): Result {
    if (_us_finite_gt(temperature, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_virial_pressure_2nd", "temperature", temperature));
    }
    if (_us_finite_gt(molar_volume, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_virial_pressure_2nd", "molar_volume", molar_volume));
    }
    var z: f64 = 1.0 + b_coeff / molar_volume;
    var p: f64 = z * US_GAS_CONSTANT * temperature / molar_volume;
    return Ok(p);
}

# The three-term virial pressure P = RT/V_m · (1 + B/V_m + C/V_m²) (Pa). Err(US_ERR_INVALID_TEMPERATURE) unless T > 0,
# Err(US_ERR_INVALID_VOLUME) unless V_m > 0.
#must_use
fn us_virial_pressure_3rd(temperature: f64, molar_volume: f64, b_coeff: f64, c_coeff: f64): Result {
    if (_us_finite_gt(temperature, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_virial_pressure_3rd", "temperature", temperature));
    }
    if (_us_finite_gt(molar_volume, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_virial_pressure_3rd", "molar_volume", molar_volume));
    }
    var vm2: f64 = molar_volume * molar_volume;
    var z: f64 = 1.0 + b_coeff / molar_volume + c_coeff / vm2;
    var p: f64 = z * US_GAS_CONSTANT * temperature / molar_volume;
    return Ok(p);
}

# --- Generalized compressibility ---

# The generalized compressibility of the Pitzer–Abbott virial correlation, Z = 1 + (B⁰ + ω·B¹)·P_r / T_r (B⁰ and B¹ as
# us_pitzer_second_virial's), valid where Z is near linear in P_r (V_r ≳ 2). Err(US_ERR_INVALID_PARAMETER) unless
# T_r > 0, P_r ≥ 0 and ω finite, and when the correlation gives Z ≤ 0 (outside its range).
#must_use
fn us_compressibility_pitzer(pr: f64, tr: f64, omega: f64): Result {
    if (_us_finite_gt(tr, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_compressibility_pitzer", "tr", tr));
    }
    if (_us_finite_ge(pr, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_compressibility_pitzer", "pr", pr));
    }
    if (_us_is_finite(omega) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_compressibility_pitzer", "omega", omega));
    }
    var p16: f64 = _us_cr_pow(tr, 1.6);
    var p42: f64 = _us_cr_pow(tr, 4.2);
    var b0: f64 = 0.083 - 0.422 / p16;
    var b1: f64 = 0.139 - 0.172 / p42;
    var z0: f64 = 1.0 + b0 * pr / tr;
    var z1: f64 = b1 * pr / tr;
    var z: f64 = z0 + omega * z1;
    if (_us_finite_gt(z, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_compressibility_pitzer", "z", z));
    }
    return Ok(z);
}

# --- Mixture rules ---

# The mixture check for `fname`, or 0: Err(US_ERR_INVALID_PARAMETER) when the `ny` fractions at `ys` and the `nv`
# values at `vals` differ in length, a fraction is outside [0, 1] (or NaN), a value is not finite, or the fractions'
# sum is more than 1e-10 from 1.
fn _us_mixture_check(ys, ny, vals, nv, fname): i64 {
    if (ny != nv) { return _us_fail_i(US_ERR_INVALID_PARAMETER, fname, "values length", nv); }
    var k = 0;
    while (k < ny) {
        var y: f64 = load64(ys + (8 * k));
        if ((y >= 0.0 && y <= 1.0) == 0) { return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, "mole fraction", y); }
        k = k + 1;
    }
    k = 0;
    while (k < nv) {
        var v: f64 = load64(vals + (8 * k));
        if (_us_is_finite(v) == 0) { return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, "value", v); }
        k = k + 1;
    }
    var s: f64 = 0.0 - 0.0;
    k = 0;
    while (k < ny) {
        var y2: f64 = load64(ys + (8 * k));
        s = s + y2;
        k = k + 1;
    }
    var dev: f64 = f64_abs(s - 1.0);
    if (dev > 0.0000000001) { return _us_fail_f(US_ERR_INVALID_PARAMETER, fname, "fraction sum", s); }
    return 0;
}

# Kay's rule Σ yᵢ·xᵢ over the checked mixture, summed left to right from −0.0 as Rust's `sum` does.
fn _us_kays(ys, ny, vals, nv, fname): Result {
    var code = _us_mixture_check(ys, ny, vals, nv, fname);
    if (code != 0) { return Err(code); }
    var s: f64 = 0.0 - 0.0;
    var k = 0;
    while (k < ny) {
        var y: f64 = load64(ys + (8 * k));
        var v: f64 = load64(vals + (8 * k));
        s = s + y * v;
        k = k + 1;
    }
    return Ok(s);
}

# Kay's rule for the pseudo-critical temperature T_c,mix = Σ yᵢ·T_c,i (K), over the `ny` mole fractions at `ys` and
# the `nv` critical temperatures at `tcs`. Err(US_ERR_INVALID_PARAMETER) when the lengths differ, a fraction is
# outside [0, 1], a value is not finite, or the fractions don't sum to 1 within 1e-10.
#must_use
fn us_kays_rule_tc(ys, ny, tcs, nv): Result {
    return _us_kays(ys, ny, tcs, nv, "us_kays_rule_tc");
}

# Kay's rule for the pseudo-critical pressure P_c,mix = Σ yᵢ·P_c,i (Pa); refusals as us_kays_rule_tc's.
#must_use
fn us_kays_rule_pc(ys, ny, pcs, nv): Result {
    return _us_kays(ys, ny, pcs, nv, "us_kays_rule_pc");
}

# Kay's rule for the pseudo-acentric factor ω_mix = Σ yᵢ·ωᵢ; refusals as us_kays_rule_tc's.
#must_use
fn us_kays_rule_omega(ys, ny, omegas, nv): Result {
    return _us_kays(ys, ny, omegas, nv, "us_kays_rule_omega");
}

# --- entropy.cyr ---

# entropy.cyr — entropy changes, free energies, Carnot limits and the second law (Rust 1.4.0 `entropy`). All SI: joules,
# kelvins, cubic meters, moles.
#
# Each function computes in the order Rust 1.4.0 writes, so its arithmetic is bit-identical (class B), and its ln is
# correctly rounded (ADR 0004, class C). A refusal returns Err(US_ERR_*) and reports its value at DEBUG
# (src/validate.cyr). carnot_efficiency and entropy_of_mixing open a DEBUG span under Rust's span name.
# entropy_of_mixing takes its mole fractions as `n` f64 at `xs`; is_spontaneous's bool is 1 or 0.

# The ideal-gas entropy change ΔS = n·(C_v·ln(T₂/T₁) + R·ln(V₂/V₁)) (J/K). Err(US_ERR_INVALID_PARAMETER) unless n > 0,
# Err(US_ERR_INVALID_SPECIFIC_HEAT) unless C_v > 0, Err(US_ERR_INVALID_TEMPERATURE) unless T₁ > 0 and T₂ > 0,
# Err(US_ERR_INVALID_VOLUME) unless V₁ > 0 and V₂ > 0.
#must_use
fn us_ideal_gas_entropy_change(moles: f64, cv: f64, t1: f64, t2: f64, v1: f64, v2: f64): Result {
    if (_us_finite_gt(moles, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_ideal_gas_entropy_change", "moles", moles));
    }
    if (_us_finite_gt(cv, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_SPECIFIC_HEAT, "us_ideal_gas_entropy_change", "cv", cv));
    }
    if (_us_finite_gt(t1, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_ideal_gas_entropy_change", "t1", t1));
    }
    if (_us_finite_gt(t2, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_ideal_gas_entropy_change", "t2", t2));
    }
    if (_us_finite_gt(v1, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_ideal_gas_entropy_change", "v1", v1));
    }
    if (_us_finite_gt(v2, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_ideal_gas_entropy_change", "v2", v2));
    }
    var lt: f64 = _us_cr_ln(t2 / t1);
    var lv: f64 = _us_cr_ln(v2 / v1);
    var ds: f64 = moles * (cv * lt + US_GAS_CONSTANT * lv);
    return Ok(ds);
}

# The isothermal entropy change ΔS = nR·ln(V₂/V₁) (J/K). Err(US_ERR_INVALID_PARAMETER) unless n > 0,
# Err(US_ERR_INVALID_VOLUME) unless V₁ > 0 and V₂ > 0.
#must_use
fn us_isothermal_entropy_change(moles: f64, v1: f64, v2: f64): Result {
    if (_us_finite_gt(moles, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_isothermal_entropy_change", "moles", moles));
    }
    if (_us_finite_gt(v1, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_isothermal_entropy_change", "v1", v1));
    }
    if (_us_finite_gt(v2, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_VOLUME, "us_isothermal_entropy_change", "v2", v2));
    }
    var lv: f64 = _us_cr_ln(v2 / v1);
    var ds: f64 = moles * US_GAS_CONSTANT * lv;
    return Ok(ds);
}

# The entropy carried by heat Q at temperature T, ΔS = Q / T (J/K). Err(US_ERR_INVALID_PARAMETER) unless Q is finite,
# Err(US_ERR_INVALID_TEMPERATURE) unless T > 0.
#must_use
fn us_heat_transfer_entropy(heat: f64, temperature: f64): Result {
    if (_us_is_finite(heat) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_heat_transfer_entropy", "heat", heat));
    }
    if (_us_finite_gt(temperature, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_heat_transfer_entropy", "temperature", temperature));
    }
    var ds: f64 = heat / temperature;
    return Ok(ds);
}

# The Carnot efficiency η = 1 − T_cold / T_hot. Err(US_ERR_INVALID_TEMPERATURE) unless both temperatures are positive,
# Err(US_ERR_INVALID_PARAMETER) unless T_cold < T_hot.
#must_use
fn us_carnot_efficiency(t_hot: f64, t_cold: f64): Result {
    _us_span_enter("carnot_efficiency", 17);
    if (_us_finite_gt(t_hot, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_carnot_efficiency", "t_hot", t_hot));
    }
    if (_us_finite_gt(t_cold, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_carnot_efficiency", "t_cold", t_cold));
    }
    if (t_cold >= t_hot) {
        _us_span_exit();
        return Err(_us_fail_ff(US_ERR_INVALID_PARAMETER, "us_carnot_efficiency", "T_cold >= T_hot", "t_cold", t_cold,
            "t_hot", t_hot));
    }
    var eta: f64 = 1.0 - t_cold / t_hot;
    _us_span_exit();
    return Ok(eta);
}

# The Carnot refrigeration COP = T_cold / (T_hot − T_cold). Err(US_ERR_INVALID_TEMPERATURE) unless both temperatures
# are positive, Err(US_ERR_INVALID_PARAMETER) unless T_hot − T_cold > 0.
#must_use
fn us_carnot_cop_refrigeration(t_hot: f64, t_cold: f64): Result {
    if (_us_finite_gt(t_hot, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_carnot_cop_refrigeration", "t_hot", t_hot));
    }
    if (_us_finite_gt(t_cold, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_TEMPERATURE, "us_carnot_cop_refrigeration", "t_cold", t_cold));
    }
    var dt: f64 = t_hot - t_cold;
    if (_us_finite_gt(dt, 0.0) == 0) {
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_carnot_cop_refrigeration", "T_hot - T_cold", dt));
    }
    var cop: f64 = t_cold / dt;
    return Ok(cop);
}

# The Helmholtz free energy A = U − TS (J).
#must_use
#pure
fn us_helmholtz(internal_energy: f64, temperature: f64, entropy: f64): f64 {
    var a: f64 = internal_energy - temperature * entropy;
    return a;
}

# The Gibbs free energy G = H − TS (J).
#must_use
#pure
fn us_gibbs(enthalpy: f64, temperature: f64, entropy: f64): f64 {
    var g: f64 = enthalpy - temperature * entropy;
    return g;
}

# The Clausius inequality: 1 when ΔS_total ≥ 0 (a reversible process, ΔS = 0, included), else 0 (NaN is 0).
#must_use
#pure
#inline
fn us_is_spontaneous(delta_s_total: f64): i64 {
    return delta_s_total >= 0.0;
}

# The ideal entropy of mixing ΔS_mix = −nR·Σ xᵢ·ln xᵢ (J/K) over the `n` mole fractions at `xs`, a zero fraction
# contributing nothing. Err(US_ERR_INVALID_PARAMETER) unless the moles are positive, every fraction is in [0, 1], and
# the fractions sum to 1 within 1e-10.
#must_use
fn us_entropy_of_mixing(moles: f64, xs, n): Result {
    _us_span_enter("entropy_of_mixing", 17);
    if (_us_finite_gt(moles, 0.0) == 0) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_entropy_of_mixing", "moles", moles));
    }
    var k = 0;
    while (k < n) {
        var x: f64 = load64(xs + (8 * k));
        if ((x >= 0.0 && x <= 1.0) == 0) {
            _us_span_exit();
            return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_entropy_of_mixing", "mole fraction", x));
        }
        k = k + 1;
    }
    var fs: f64 = 0.0 - 0.0;
    k = 0;
    while (k < n) {
        var x2: f64 = load64(xs + (8 * k));
        fs = fs + x2;
        k = k + 1;
    }
    var dev: f64 = f64_abs(fs - 1.0);
    if (dev > 0.0000000001) {
        _us_span_exit();
        return Err(_us_fail_f(US_ERR_INVALID_PARAMETER, "us_entropy_of_mixing", "fraction sum", fs));
    }
    var s: f64 = 0.0 - 0.0;
    k = 0;
    while (k < n) {
        var x3: f64 = load64(xs + (8 * k));
        if (x3 > 0.0) {
            var lx: f64 = _us_cr_ln(x3);
            s = s + x3 * lx;
        }
        k = k + 1;
    }
    var ds: f64 = (0.0 - moles) * US_GAS_CONSTANT * s;
    _us_span_exit();
    return Ok(ds);
}

# --- phase_data.cyr ---

# ushma — phase data: triple and critical points, latent heats of 8 substances
#
# GENERATED by scripts/oracle from ushma 1.4.0 (rust-old/), hisab 1.4.0. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# Rows are in `phase::ALL_SUBSTANCES` order; each preset's row is its index constant.
# f64 cells are the oracle's values as round-trip decimals, and
# tests/golden/phase.tsv pins every cell (one `phase::<PRESET>` row per preset).

# Phase transition reference data for a substance.
#
# All values at standard conditions unless noted. Sources: NIST Chemistry WebBook.
# All built-in substances for iteration.
# Rust: ushma::phase::ALL_SUBSTANCES (its length).
