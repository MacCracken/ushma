# ushma's own (not in kimiya): TANH_ONE, the largest double a with tanh(a) rounding below 1 (MPFR's
# correctly rounded tanh, bisected over bit patterns); for |x| above it tanh rounds to ±1.
var _US_CR_TANH_ONE = 0x40330FC1931F09C9;   # 19.061547465398494

# --- mathx.cyr ---

# mathx.cyr — ushma's private floating-point helpers and correctly rounded primitives (ADR 0004, port plan P3).
#
# VENDORED from kimiya's src/mathx.cyr (kimiya commit 5b14c85): the closure of the 11 roots ushma calls, plus the
# fast and accurate entry points (_us_cr_<f>_fast, _us_cr_<f>_acc) that scripts/oracle/cr_verify.py forces. It is
# mechanically extracted in kimiya's source order with each item's own comments, and only its identifiers renamed
# (_km_ -> _us_, _KM_ -> _US_). Any `_km_*` still named in a comment is a kimiya function that is not vendored.
# The ADR and milestone references inside the comments (ADR 0006, M3c-2a, …) are kimiya's; ushma's ADR 0004
# adopts kimiya's ADR 0006. The
# tables are src/mathx_data.cyr, regenerated by scripts/oracle/mathx_tables.py and bit-identical to kimiya's.
#
# The roots:
# - Rust semantics where no Cyrius builtin has them (port-parity.md §1): _us_min, _us_max (Rust ignores a NaN operand
#   on either side; on (+0, -0) the second operand, as maxsd / minsd), _us_powi (compiler-builtins' square-and-multiply
#   order), _us_is_finite, _us_is_nan, _us_nan;
# - correctly rounded and target-independent (+ - * /, f64_sqrt and integer bit operations only, so the same bits on
#   every target): _us_cr_exp, _us_cr_expm1, _us_cr_ln, _us_cr_pow, _us_cr_atan2 (atan(x) is _us_cr_atan2(x, 1.0)).
# Each correctly rounded primitive is two-phase (Ziv: a fast path with a proven error bound and a rounding test, then a
# triple-double accurate path). The harness compares them at 0 ulp against the corrected oracle (tests/golden/
# math.cr.tsv); scripts/oracle/cr_verify.py checks them against MPFR on every target. The correctly rounded tanh,
# _us_cr_tanh, is ushma's own (not vendored), at the end of this file.
# The coefficients and constants are bit patterns in typed f64 locals (never a hex `const`).

# +∞ (0x7FF0000000000000), a compile-time constant.
const _US_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _us_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# 1 if x is NaN.
#must_use
fn _us_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# 1 if x is finite: neither ±∞ nor NaN (x − x is 0 exactly for finite x, NaN otherwise; one
# subtract and compare, no call: the M2a guards make several per function). Mirrors
# `f64::is_finite`.
#must_use
fn _us_is_finite(x: f64): i64 {
    var d: f64 = x - x;
    if (d == 0.0) { return 1; }
    return 0;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands,
# +0 and −0 included, give y: what rustc 1.99.1's `x.max(y)` returns (maxsd). Mirrors `f64::max`.
#must_use
fn _us_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# The smaller of x and y, ignoring a NaN operand (NaN only when both are). Equal operands,
# +0 and −0 included, give y (minsd). Mirrors `f64::min`.
#must_use
fn _us_min(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x < y) { return x; }
    return y;
}

# x^n by compiler-builtins' `__powidf2` (float/pow.rs), the loop Rust's `f64::powi` calls:
# square-and-multiply over the bits of |n|, low bit first, then 1/r for a negative n. Rust's n
# is an i32; |n| is taken as an unsigned word here, so i64::MIN is 2^63 as abs_diff gives.
# Mirrors `f64::powi`.
#must_use
fn _us_powi(a: f64, n): f64 {
    var base: f64 = a;
    var p = n;
    var recip = 0;
    if (n < 0) { recip = 1; p = 0 - n; }
    var mul: f64 = 1.0;
    while (1) {
        if ((p & 1) != 0) { mul = mul * base; }
        p = p >> 1;
        if (p == 0) { break; }
        base = base * base;
    }
    if (recip == 1) {
        var r: f64 = 1.0 / mul;
        return r;
    }
    return mul;
}

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _us_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _us_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _us_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _us_ro_sum(a: f64, b: f64): f64 {
    var s, e = _us_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _us_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _us_two_sum(b, c);
    var th, tl = _us_two_sum(a, uh);
    var v: f64 = _us_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _us_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _us_two_sum(a0, b0);
    var s1, e1 = _us_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _us_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _us_two_sum(s0, t1);
    var m, l = _us_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _us_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _us_two_sum(a0, d);
    var t1, f1 = _us_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _us_two_sum(s0, t1);
    var m, l = _us_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _us_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _us_two_prod(a0, b0);
    var p1, q1 = _us_two_prod(a0, b1);
    var p2, q2 = _us_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _us_two_sum(p1, p2);
    var s2, e2 = _us_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _us_two_sum(p0, s2);
    var m, l = _us_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _us_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _us_two_prod(a0, d);
    var p1, q1 = _us_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _us_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _us_two_sum(p0, s);
    var m, l = _us_two_sum(u, t);
    return (h, m, l);
}

# 2^e as a double, for −1022 ≤ e ≤ 1023.
#must_use
fn _us_cr_pow2(e): f64 {
    var b = (e + 1023) << 52;
    var r: f64 = b;
    return r;
}

# RN(2^e·(h + m + l)) for a normalised triple-double h + m + l in [0.99, 2.01], every result range: a normal
# result is RN3 then an exact scale (2^1024 in two steps; a significand that rounds up past DBL_MAX gives
# +∞, as IEEE overflow does). A result below 2^-1022 is rounded ONCE, at the subnormal grid: with
# y = 2^(e + 1022)·(h + m + l) < 1 (each part scaled exactly), RN(1 + y) has its ulp at 2^-52, which is
# 2^-1074 after the final scale, and (RN(1 + y) − 1)·2^-1022 is exact (glibc's specialcase technique). The
# sum 1 + yh + ym + yl is rounded exactly: 1 + yh = a + b (Fast2Sum), and RN(a + b + RO(ym + yl)) =
# RN(a + b + ym + yl) because every breakpoint minus a − b is a multiple of ulp(yh), an even multiple of
# ulp(RO(ym + yl)), and rounding to odd keeps the order against those.
#must_use
fn _us_cr_finish(e, h: f64, m: f64, l: f64): f64 {
    if (e >= 0 - 1021) {
        var z: f64 = _us_rn3(h, m, l);
        if (e > 1023) {
            var s1: f64 = _us_cr_pow2(e - 1);
            var o: f64 = (z * s1) * 2.0;
            return o;
        }
        var s2: f64 = _us_cr_pow2(e);
        var y: f64 = z * s2;
        return y;
    }
    var h1, m1a = _us_fast_two_sum(h, m);    # renormalised, so the sign tests below decide y < 1
    var m1, l1 = _us_two_sum(m1a, l);
    var s: f64 = _us_cr_pow2(e + 1022);
    var yh: f64 = h1 * s;
    var ym: f64 = m1 * s;
    var yl: f64 = l1 * s;
    var normal = 0;
    if (yh > 1.0) { normal = 1; }
    if (yh == 1.0) {
        if (ym > 0.0) { normal = 1; }
        if (ym == 0.0 && yl >= 0.0) { normal = 1; }
    }
    if (normal == 1) {                       # y ≥ 1: the result is at least 2^-1022
        var z2: f64 = _us_rn3(h, m, l);
        var s3: f64 = _us_cr_pow2(e);
        var y2: f64 = z2 * s3;
        return y2;
    }
    var a, b = _us_fast_two_sum(1.0, yh);
    var v: f64 = _us_ro_sum(ym, yl);
    var w: f64 = _us_rn3(a, b, v);
    var dmin: f64 = _us_cr_pow2(0 - 1022);
    var r: f64 = (w - 1.0) * dmin;
    return r;
}

# The fast core for e^(xh + xl), |xh| ≤ 745.2 and |xl| ≤ 2^-42: (hi, lo, E) with hi + lo = e^x/2^E within
# 2^-70. exp passes xl = 0; exp10 passes x·ln 10 as xh + xl (xl folds into the K·L2 term).
#must_use
fn _us_exp_core(xh: f64, xl: f64): (f64, f64, i64) {
    var inv: f64 = _US_CR_EXP_INVLN2N;
    var l1: f64 = _US_CR_EXP_L1;
    var l2: f64 = _US_CR_EXP_L2;
    var tt: f64 = (xh * inv) + 6755399441055744.0;   # 1.5·2^52: rounds x·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = xh - (kd * l1);
    var s: f64 = (kd * l2) - xl;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;                         # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _US_CR_EXP_P3;
    var p4: f64 = _US_CR_EXP_P4;
    var p5: f64 = _US_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_US_CR_EXP_T + ti);
    var b: f64 = load64(&_US_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    return (hi, lo, e);
}

# The fast test with bound err (absolute, on hi + lo) and the scale for any E: (1, RN(2^E·(hi + lo))) or (0, 0)
# when the test fails. Normal results scale
# exactly (2^1024 in two steps). A result that may be subnormal (E ≤ −1022 and 2^(E+1022)·(hi + lo) < 1, decided
# on hi + lo renormalised: the core's lo is not, when r1 = 0) is tested on the subnormal grid, rounding once:
# y = 2^(E+1022)·(hi + lo) (exact), 1 + y = a + b + yl with a + b = 1 + yh exactly, and the ends
# a + ((b + yl) ∓ ε') with ε' = err·2^(E+1022) + 2^-104 (|b + yl| ≤ 2^-52, so the two inner roundings are below
# 2^-104.4 at this scale, where the grid is 2^-52).
#must_use
fn _us_exp_fin(hi: f64, lo: f64, e, err: f64): (i64, f64) {
    if (e >= 0 - 1021) {
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0, 0.0); }
        if (e > 1023) {
            var s1: f64 = _us_cr_pow2(e - 1);
            var o: f64 = (u * s1) * 2.0;
            return (1, o);
        }
        var s2: f64 = _us_cr_pow2(e);
        var y: f64 = u * s2;
        return (1, y);
    }
    var s: f64 = _us_cr_pow2(e + 1022);
    var hn: f64 = hi + lo;                   # hi + lo renormalised: lo can be up to 2^-38 when r1 = 0
    var ln: f64 = lo - (hn - hi);
    var yh: f64 = hn * s;
    if (yh > 1.0 || (yh == 1.0 && ln >= 0.0)) {   # 2^E·(hi + lo) ≥ 2^-1022: a normal result
        var u2: f64 = hi + (lo - err);
        var v2: f64 = hi + (lo + err);
        if (u2 != v2) { return (0, 0.0); }
        var s3: f64 = _us_cr_pow2(e);
        var y2: f64 = u2 * s3;
        return (1, y2);
    }
    var yl: f64 = ln * s;
    var a, b = _us_fast_two_sum(1.0, yh);
    var w: f64 = b + yl;
    var tiny: f64 = 0x3970000000000000;     # 2^-104
    var err2: f64 = (err * s) + tiny;
    var u3: f64 = a + (w - err2);
    var v3: f64 = a + (w + err2);
    if (u3 != v3) { return (0, 0.0); }
    var dmin: f64 = _us_cr_pow2(0 - 1022);
    var r: f64 = (u3 - 1.0) * dmin;
    return (1, r);
}

# e^x, correctly rounded. exp(±0) = 1 (as every |x| < 2^-54: e^x is then within 2^-54 of 1, inside 1's
# rounding interval), exp(+∞) = +∞, exp(−∞) = +0, NaN for NaN; x above 709.782712893384 overflows to +∞, and
# below −745.1332191019411 (e^x < 2^-1075) rounds to +0. e^x is exact only at x = 0 (Lindemann–Weierstrass: e^x
# is transcendental for algebraic x ≠ 0), so no other argument is exact or a tie. The fast path covers
# 2^-54 ≤ |x| ≤ 708 (normal results, one scale), inline; the rest goes through _us_cr_exp_fast.
#must_use
fn _us_cr_exp(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    # |x| < 2^-54, |x| > 708 or NaN, in one compare: ax − bits(2^-54) is above bits(708) − bits(2^-54) as an
    # unsigned word (the sign flip makes the signed compare an unsigned one) exactly then.
    if (((ax - 0x3C90000000000000) ^ 0x8000000000000000) > 0x83F6200000000000) {
        var w, okw = _us_cr_exp_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _us_cr_exp_acc(x);
        return zw;
    }
    var inv: f64 = _US_CR_EXP_INVLN2N;
    var l1: f64 = _US_CR_EXP_L1;
    var l2: f64 = _US_CR_EXP_L2;
    var tt: f64 = (x * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = x - (kd * l1);
    var s: f64 = kd * l2;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _US_CR_EXP_P3;
    var p4: f64 = _US_CR_EXP_P4;
    var p5: f64 = _US_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_US_CR_EXP_T + ti);
    var b: f64 = load64(&_US_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) {
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var y: f64 = u * sc;
        return y;
    }
    var za: f64 = _us_cr_exp_acc(x);
    return za;
}

# The fast path alone, for every x: (RN(e^x), 1), or (0, 0) when the rounding test fails and the accurate path
# must decide. NaN, the tiny end, overflow and underflow first, then the fast core with the general finish
# (708 < x: E up to 1024; x < −708: subnormal results). For 2^-54 ≤ |x| ≤ 708 _us_exp_core and _us_exp_fin
# perform exactly the operations of _us_cr_exp's inline path (E ≥ −1022 there, with hi > 1 at E = −1022), so
# this gives its result and its test.
#must_use
fn _us_cr_exp_fast(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return (1.0, 1); }
    var ovf: f64 = _US_CR_EXP_OVF;
    var unf: f64 = _US_CR_EXP_UNF;
    if (x > ovf) {
        var inf: f64 = _US_INF;
        return (inf, 1);
    }
    if (x < unf) { return (0.0, 1); }
    var hi, lo, e = _us_exp_core(x, 0.0);
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var ok, y = _us_exp_fin(hi, lo, e, err);
    return (y, ok);
}

# The accurate core: e^(y0 + y1 + y2) = 2^E·(h + m + l), (h, m, l) stored at out[0..2], E returned. The same
# K as the fast path; r = y − K·(L1 + L2 + L3 + L4) as a triple-double (K·L1 exact, K·L2 and K·L3
# TwoProducts, K·L4 rounded: below 2^-186 of error); e^r − 1 by Horner in triple-double to r^11/11!
# (truncation 2^-152); T_j = A + B + C + D renormalised (2^-159); h + m + l = T_j + T_j·(e^r − 1). Measured
# relative error 2^-155 against 400-bit MPFR.
#must_use
fn _us_exp_acc_core(y0: f64, y1: f64, y2: f64, out): i64 {
    var inv: f64 = _US_CR_EXP_INVLN2N;
    var l1: f64 = _US_CR_EXP_L1;
    var l2: f64 = _US_CR_EXP_L2;
    var l3: f64 = _US_CR_EXP_L3;
    var l4: f64 = _US_CR_EXP_L4;
    var tt: f64 = (y0 * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = y0 - (kd * l1);
    var a2, a2e = _us_two_prod(kd, l2);
    var a3, a3e = _us_two_prod(kd, l3);
    var a4: f64 = kd * l4;
    var ra0, ra1, ra2 = _us_td_add_d(rh, 0.0, 0.0, -a2);
    var rb0, rb1, rb2 = _us_td_add_d(ra0, ra1, ra2, y1);
    var rc0, rc1, rc2 = _us_td_add_d(rb0, rb1, rb2, -a2e);
    var rd0, rd1, rd2 = _us_td_add_d(rc0, rc1, rc2, -a3);
    var re0, re1, re2 = _us_td_add_d(rd0, rd1, rd2, y2);
    var a34: f64 = a3e + a4;
    var r0, r1, r2 = _us_td_add_d(re0, re1, re2, -a34);
    var sh: f64 = load64(&_US_CR_EXP_ACC + 216);    # 1/11! (index 3·(11 − 2))
    var sm: f64 = load64(&_US_CR_EXP_ACC + 224);
    var sl: f64 = load64(&_US_CR_EXP_ACC + 232);
    var n = 10;
    while (n >= 2) {
        var th, tm, tl = _us_td_mul(r0, r1, r2, sh, sm, sl);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_US_CR_EXP_ACC + off);
        var cm: f64 = load64(&_US_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_US_CR_EXP_ACC + off + 16);
        var uh, um, ul = _us_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _us_td_mul(r0, r1, r2, sh, sm, sl);
    var wh, wm, wl = _us_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _us_td_mul(r0, r1, r2, wh, wm, wl);     # e^r − 1
    var ta: f64 = load64(&_US_CR_EXP_T + ti);
    var tb: f64 = load64(&_US_CR_EXP_T + ti + 8);
    var tc: f64 = load64(&_US_CR_EXP_T + ti + 16);
    var td: f64 = load64(&_US_CR_EXP_T + ti + 24);
    var t0, t1a = _us_fast_two_sum(ta, tb);
    var t1, t2a = _us_fast_two_sum(t1a, tc);
    var t2: f64 = t2a + td;
    var qh, qm, ql = _us_td_mul(t0, t1, t2, ph, pm, pl);
    var zh, zm, zl = _us_td_add(t0, t1, t2, qh, qm, ql);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
    return e;
}

# e^x for 2^-54 ≤ |x| < 2^-30, where Lefèvre–Muller's bound is 2^-158 (e^x is then 1 + x + x²/2 + …, and
# 1 + x is a short exact number): 1 + x = a + b exactly, q = x²/2 + x³/6 + x⁴/24 + x⁵/120 as a double-double
# to 2^-165 absolute (x² and x³ by TwoProduct, x³/6 by a corrected division; x⁶/720 < 2^-189 dropped), and
# RN(a + b + RO(qh + ql)) by _us_rn3 (the rounding-to-odd argument of _us_cr_finish: ulp(x) is an even
# multiple of ulp(q)).
#must_use
fn _us_exp_tiny_acc(x: f64): f64 {
    var p, pe = _us_two_prod(x, x);
    var a, ae = _us_two_prod(x, p);
    var x3l: f64 = ae + (x * pe);
    var d3h: f64 = a / 6.0;
    var pp, pe2 = _us_two_prod(d3h, 6.0);
    var d3l: f64 = (((a - pp) - pe2) + x3l) / 6.0;
    var ax: f64 = a * x;
    var x4: f64 = ax / 24.0;
    var x5: f64 = (ax * x) / 120.0;
    var hp: f64 = p * 0.5;
    var t, te = _us_two_sum(hp, d3h);
    var lo: f64 = ((((pe * 0.5) + te) + d3l) + x4) + x5;
    var qh, ql = _us_fast_two_sum(t, lo);
    var a1, b1 = _us_fast_two_sum(1.0, x);
    var v: f64 = _us_ro_sum(qh, ql);
    var r: f64 = _us_rn3(a1, b1, v);
    return r;
}

# e^x by the accurate path alone, for every x (the fast path's fallback, and a test hook).
#must_use
fn _us_cr_exp_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return 1.0; }
    var ovf: f64 = _US_CR_EXP_OVF;
    var unf: f64 = _US_CR_EXP_UNF;
    if (x > ovf) { return _US_INF; }
    if (x < unf) { return 0.0; }
    if (ax < 0x3E10000000000000) {              # |x| < 2^-30
        var t: f64 = _us_exp_tiny_acc(x);
        return t;
    }
    var buf: f64[3];
    var e = _us_exp_acc_core(x, 0.0, 0.0, &buf);
    var r: f64 = _us_cr_finish(e, buf[0], buf[1], buf[2]);
    return r;
}

# expm1(x) = e^x − 1, correctly rounded. ±0 → ±0 and |x| < 2^-53 → x (x²/2 is then below half an ulp of x,
# on the side that keeps x), +∞ → +∞, −∞ → −1, NaN for NaN; x above 709.782712893384 overflows, below
# −37.42994775023704 (e^x < 2^-54) rounds to −1.
#must_use
fn _us_cr_expm1(x: f64): f64 {
    var y, ok = _us_cr_expm1_fast(x);
    if (ok == 1) { return y; }
    var z: f64 = _us_cr_expm1_acc(x);
    return z;
}

# The fast path alone: (its result, 1), or (0, 0) when its test fails or x > 708 (left to the accurate path).
#must_use
fn _us_cr_expm1_fast(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {               # |x| < 2^-6
        if (ax < 0x3CA0000000000000) { return (x, 1); }   # |x| < 2^-53, ±0, subnormals
        var p: f64 = x * x;                      # x² = p + pe exactly (Dekker, inline)
        var cx: f64 = 134217729.0 * x;
        var x1: f64 = cx - (cx - x);
        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _US_CR_EXPM1_Q3;
        var k4: f64 = _US_CR_EXPM1_Q4;
        var k5: f64 = _US_CR_EXPM1_Q5;
        var k6: f64 = _US_CR_EXPM1_Q6;
        var k7: f64 = _US_CR_EXPM1_Q7;
        var k8: f64 = _US_CR_EXPM1_Q8;
        var k9: f64 = _US_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
        var hs: f64 = x + hp;
        var ht: f64 = hp - (hs - x);
        var lo: f64 = (ht + (pe * 0.5)) + x3;
        var ex3: f64 = f64_abs(x3);
        var exa: f64 = f64_abs(x);
        var c49: f64 = 0x3CE0000000000000;      # 2^-49
        var c100: f64 = 0x39B0000000000000;     # 2^-100
        var err: f64 = (ex3 * c49) + (exa * c100);
        var u: f64 = hs + (lo - err);
        var v: f64 = hs + (lo + err);
        if (u == v) { return (u, 1); }
        return (0.0, 0);
    }
    var m1b = _US_CR_EXPM1_M1 & 0x7FFFFFFFFFFFFFFF;
    if (ax > m1b) {                              # |x| > 37.42994775023704
        if (x < 0.0) { return (-1.0, 1); }       # x < EXPM1_M1 (−∞ included): e^x < 2^-54
        if (ax > 0x4086200000000000) {           # x > 708, +∞, NaN: left to the accurate path (which returns
            return (0.0, 0);                     # the specials at once)
        }
    }
    var hi, lo2, e = _us_exp_core(x, 0.0);
    var hh: f64 = 0.0;
    var ll: f64 = lo2;
    var sc: f64 = 1.0;
    if (e == 0) {
        hh = hi - 1.0;                           # exact: hi in [0.9993, 1.9987]
    } else {
        sc = _us_cr_pow2(e);
        var hsc: f64 = hi * sc;
        if (e > 0) {
            hh = hsc - 1.0;
            var t1: f64 = -1.0 - (hh - hsc);
            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    var u2: f64 = hh + (ll - errs);
    var v2: f64 = hh + (ll + errs);
    if (u2 == v2) { return (u2, 1); }
    return (0.0, 0);
}

# expm1 by the accurate path alone. |x| < 2^-6: x + x²/2 + … + x^17/17! by Horner in triple-double on the
# exact x (truncation below 2^-154 of x; measured 2^-155). Otherwise e^x from exp's accurate core, scaled,
# minus 1 in triple-double (|expm1(x)| ≥ 0.0155: at most 6.1 bits of cancellation; measured 2^-152); for
# E ≥ 120 the −1 is below 2^-114 of e^x, inside exp's own worst-case distance (Lefèvre–Muller: 2^-113 for
# |x| ≥ 2^-30), so it cannot move the rounding and expm1 rounds as exp does.
#must_use
fn _us_cr_expm1_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3CA0000000000000) { return x; }
    var ovf: f64 = _US_CR_EXPM1_OVF;
    var m1: f64 = _US_CR_EXPM1_M1;
    if (x > ovf) { return _US_INF; }
    if (x < m1) { return -1.0; }
    if (ax < 0x3F90000000000000) {
        var sh: f64 = load64(&_US_CR_EXP_ACC + 360);   # 1/17! (index 3·(17 − 2))
        var sm: f64 = load64(&_US_CR_EXP_ACC + 368);
        var sl: f64 = load64(&_US_CR_EXP_ACC + 376);
        var n = 16;
        while (n >= 2) {
            var th, tm, tl = _us_td_mul_d(sh, sm, sl, x);
            var off = (n - 2) * 24;
            var ch: f64 = load64(&_US_CR_EXP_ACC + off);
            var cm: f64 = load64(&_US_CR_EXP_ACC + off + 8);
            var cl: f64 = load64(&_US_CR_EXP_ACC + off + 16);
            var uh, um, ul = _us_td_add(ch, cm, cl, th, tm, tl);
            sh = uh;
            sm = um;
            sl = ul;
            n = n - 1;
        }
        var vh, vm, vl = _us_td_mul_d(sh, sm, sl, x);
        var wh, wm, wl = _us_td_add_d(vh, vm, vl, 1.0);
        var ph, pm, pl = _us_td_mul_d(wh, wm, wl, x);
        var r: f64 = _us_rn3(ph, pm, pl);
        return r;
    }
    var buf: f64[3];
    var e = _us_exp_acc_core(x, 0.0, 0.0, &buf);
    if (e >= 120) {
        var big: f64 = _us_cr_finish(e, buf[0], buf[1], buf[2]);
        return big;
    }
    var sc: f64 = _us_cr_pow2(e);
    var bh: f64 = buf[0] * sc;
    var bm: f64 = buf[1] * sc;
    var bl: f64 = buf[2] * sc;
    var dh, dm, dl = _us_td_add_d(bh, bm, bl, -1.0);
    var r2: f64 = _us_rn3(dh, dm, dl);
    return r2;
}

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _us_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_US_CR_LN_T + ti);
    var lh: f64 = load64(&_US_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_US_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _US_CR_LN_C3;
    var c4: f64 = _US_CR_LN_C4;
    var c5: f64 = _US_CR_LN_C5;
    var c6: f64 = _US_CR_LN_C6;
    var c7: f64 = _US_CR_LN_C7;
    var c8: f64 = _US_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _US_CR_LN_LN2H;
    var ln2m: f64 = _US_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# ln(x), correctly rounded. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞, NaN for NaN and x < 0 (−∞ included).
#must_use
fn _us_cr_ln(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0 (the sign bit), subnormal, ∞ or NaN: ui − bits(DBL_MIN) is at least bits(∞) − bits(DBL_MIN) as an
    # unsigned word (the unsigned range test of _us_cr_exp).
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _us_cr_ln_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _us_cr_ln_acc(x);
        return zw;
    }
    # _us_ln_core's body, inline (a call and its three-value return cost about 4 ns here).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_US_CR_LN_T + ti);
    var lh: f64 = load64(&_US_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_US_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _US_CR_LN_C3;
    var c4: f64 = _US_CR_LN_C4;
    var c5: f64 = _US_CR_LN_C5;
    var c6: f64 = _US_CR_LN_C6;
    var c7: f64 = _US_CR_LN_C7;
    var c8: f64 = _US_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _US_CR_LN_LN2H;
    var ln2m: f64 = _US_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    var u: f64 = s2 + (lo - err);
    var v: f64 = s2 + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _us_cr_ln_acc(x);
    return za;
}

# The fast path alone, for every x (as _us_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _us_cr_ln's inline path.
#must_use
fn _us_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
        }
        if (x < 0.0) {
            var nan: f64 = _us_nan();           # the same quiet NaN on every target
            return (nan, 1);
        }
        if (x == _US_INF) { return (x, 1); }
        var p54: f64 = 0x4350000000000000;      # 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, err = _us_ln_core(ui, eb);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _us_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_US_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_US_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_US_CR_LN_ACC + 344);
    var sl: f64 = load64(&_US_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _us_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_US_CR_LN_ACC + off);
        var cm: f64 = load64(&_US_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_US_CR_LN_ACC + off + 16);
        var uh, um, ul = _us_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _us_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _us_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _us_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_US_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_US_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_US_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _US_CR_LN_LN2H;
    var ln2m: f64 = _US_CR_LN_LN2M;
    var ln2l: f64 = _US_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _us_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _us_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _us_two_sum(u0, a12);
    var bh, bm, bl = _us_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _us_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln by the accurate path alone, for every x.
#must_use
fn _us_cr_ln_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _us_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _US_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _us_ln_acc_td(x, &buf);
    var r: f64 = _us_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# (1 if y is an integer, 1 if y is an odd integer) for a finite y ≠ 0: y = M·2^(f − 1075) with the 53-bit
# significand M; integer when no set bit of M lies below 2^(1075 − f).
#must_use
fn _us_pow_yclass(y: f64): (i64, i64) {
    var uy = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    var f = uy >> 52;
    var m = (uy & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    if (f >= 1075) {
        if (f == 1075) { return (1, m & 1); }
        return (1, 0);                           # |y| ≥ 2^53: even
    }
    if (f < 1023) { return (0, 0); }             # 0 < |y| < 1
    var sh = 1075 - f;
    if ((m & ((1 << sh) - 1)) != 0) { return (0, 0); }
    return (1, (m >> sh) & 1);
}

# RN(mm·2^s) for an integer 1 ≤ mm < 2^62 and an integer |s| < 2^40, by integer rounding: ties to even,
# subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 below half of 2^-1074. Exact, so it rounds exact
# results and exact midpoints right.
#must_use
fn _us_cr_from_int(mm, s): f64 {
    var b = 0;
    var t = mm;
    while (t != 0) {
        t = t >> 1;
        b = b + 1;
    }
    var top = s + b - 1;                         # the exponent of mm·2^s's leading bit
    if (top > 1023) {
        var inf: f64 = _US_INF;
        return inf;
    }
    var lsb = top - 52;                          # the result's last bit, at most 53 bits and not below 2^-1074
    if (lsb < 0 - 1074) { lsb = 0 - 1074; }
    var sh = lsb - s;
    var q = mm;
    if (sh > 0) {
        if (sh > 62) { return 0.0; }
        q = mm >> sh;
        var rem = mm - (q << sh);
        var half = 1 << (sh - 1);
        if (rem > half || (rem == half && (q & 1) == 1)) { q = q + 1; }
    } else {
        lsb = s;
    }
    var qf: f64 = f64_from(q);                   # q ≤ 2^53: exact
    if (lsb >= 0 - 1022) {
        var sc: f64 = _us_cr_pow2(lsb);
        var r: f64 = qf * sc;                    # exact, or +∞ when q·2^lsb = 2^1024
        return r;
    }
    var s1: f64 = _us_cr_pow2(lsb + 1074);       # q·2^lsb = ((q·2^(lsb + 1074))·2^-52)·2^-1022: each step exact
    var s2: f64 = _us_cr_pow2(0 - 52);
    var s3: f64 = _us_cr_pow2(0 - 1022);
    var w: f64 = ((qf * s1) * s2) * s3;
    return w;
}

# M^n for odd integers M ≥ 3 and n ≥ 1, or 0 when it reaches 2^54.
#must_use
fn _us_pow_int54(mm, n): i64 {
    var acc = 1;
    var i = 0;
    while (i < n) {
        if (acc > (0x0040000000000000 / mm)) { return 0; }
        acc = acc * mm;
        i = i + 1;
    }
    if (acc >= 0x0040000000000000) { return 0; }
    return acc;
}

# (1, RN(x^y)) when x^y is an exact double or an exact midpoint (or another value known exactly), else (0, 0);
# x > 0 finite, y finite with 0 < |y| < 2^64. After Lauter and Lefèvre ("An efficient rounding boundary test for
# pow(x, y) in double precision", IEEE TC 2009) and CORE-MATH's pow. Write x = mx·2^ex and y = ±my·2^fy with mx,
# my odd. y is a double, so in lowest terms y = p/2^k (k = max(0, −fy)). If x^y = R is rational then
# R^(2^k) = x^p: when p > 0, unique factorisation makes mx a perfect 2^k-th power, mx = a^(2^k), with 2^k | ex,
# and R = a^p·2^(ex·p/2^k); when p < 0, R's odd part 1/a^|p| is dyadic only for a = 1, mx = 1. A double or a
# midpoint has an odd part below 2^54, so beyond these cases x^y is neither: mx = 1 gives a power of two
# 2^(ex·y) (exact, the tie 2^-1075, or out of range); mx ≥ 3 needs p > 0, a^p < 2^54 (so p ≤ 34) and
# a^(2^k) = mx < 2^53 (so k ≤ 5). In particular y = RN(1/3) has k = 54: x^y is never exact unless x = 1.
#must_use
fn _us_pow_exact(ax: f64, y: f64): (i64, f64) {
    var ux = load64(&ax);
    var mx = ux & 0x000FFFFFFFFFFFFF;
    var ex = 0 - 1074;
    if ((ux >> 52) != 0) {
        mx = mx | 0x0010000000000000;
        ex = (ux >> 52) - 1075;
    }
    while ((mx & 1) == 0) {
        mx = mx >> 1;
        ex = ex + 1;
    }
    var uy = load64(&y);
    var sy = 1;
    if (uy < 0) { sy = 0 - 1; }
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var my = ay & 0x000FFFFFFFFFFFFF;
    var fy = 0 - 1074;
    if ((ay >> 52) != 0) {
        my = my | 0x0010000000000000;
        fy = (ay >> 52) - 1075;
    }
    while ((my & 1) == 0) {
        my = my >> 1;
        fy = fy + 1;
    }
    if (fy >= 0) {                               # y an integer: |y| = my·2^fy
        if (fy >= 12 || my >= 4096) { return (0, 0.0); }   # |y| ≥ 4096: 2^(ex·y) and mx^y are out of reach
        var yi = my << fy;
        if (yi >= 4096) { return (0, 0.0); }
        if (mx == 1) {
            var r1: f64 = _us_cr_from_int(1, ex * yi * sy);
            return (1, r1);
        }
        if (sy < 0) { return (0, 0.0); }
        if (yi > 34) { return (0, 0.0); }
        var mm = _us_pow_int54(mx, yi);
        if (mm == 0) { return (0, 0.0); }
        var r2: f64 = _us_cr_from_int(mm, ex * yi);
        return (1, r2);
    }
    var k = 0 - fy;                              # y = ±my/2^k, k ≥ 1
    var q = 0;
    if (k >= 11) {
        if (ex != 0) { return (0, 0.0); }        # |ex| < 2^11: 2^k ∤ ex
    } else {
        if ((ex & ((1 << k) - 1)) != 0) { return (0, 0.0); }
        q = ex >>> k;
    }
    if (mx == 1) {
        if (q == 0) { return (1, 1.0); }         # x = 1
        if (my >= 4096) { return (0, 0.0); }     # |ex·y| ≥ my: out of range
        var r3: f64 = _us_cr_from_int(1, q * my * sy);
        return (1, r3);
    }
    if (k > 5 || sy < 0 || my > 34) { return (0, 0.0); }
    var a = mx;
    var i = 0;
    while (i < k) {                              # a = mx^(1/2^k), each root exact or none
        var af: f64 = f64_from(a);
        var sf: f64 = f64_sqrt(af);
        var si = f64_to(sf);
        if (si * si != a) { return (0, 0.0); }
        a = si;
        i = i + 1;
    }
    var m2 = _us_pow_int54(a, my);
    if (m2 == 0) { return (0, 0.0); }
    var r4: f64 = _us_cr_from_int(m2, q * my);
    return (1, r4);
}

# The fast kernel for x > 0 finite (bits ux, a subnormal included) and finite y with 0 < |y| < 2^64:
# (RN(x^y), 1), or (0, 0) when the rounding test fails.
#must_use
fn _us_pow_pos_fast(ux, y: f64): (f64, i64) {
    var ui = ux;
    var eb = 0;
    if (ui < 0x0010000000000000) {               # a subnormal x, scaled exactly by 2^54
        var xf: f64 = ui;
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = xf * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var lh, ll, eln = _us_ln_core(ui, eb);
    var zh0: f64 = y * lh;                       # z = y·(lh + ll): Dekker's product, both factors split
    var cy: f64 = 134217729.0 * y;
    var y1: f64 = cy - (cy - y);
    var y2: f64 = y - y1;
    var cl: f64 = 134217729.0 * lh;
    var l1: f64 = cl - (cl - lh);
    var l2: f64 = lh - l1;
    var ze: f64 = ((((y1 * l1) - zh0) + (y1 * l2)) + (y2 * l1)) + (y2 * l2);
    var zl0: f64 = ze + (y * ll);
    var zh: f64 = zh0 + zl0;                     # renormalised (Fast2Sum): |zl| ≤ 2^-44
    var zl: f64 = zl0 - (zh - zh0);
    var azh: f64 = f64_abs(zh);
    if (azh > 708.0) {
        if (zh > 710.0) {
            var inf: f64 = _US_INF;
            return (inf, 1);
        }
        if (zh < -746.0) { return (0.0, 1); }
    }
    var ay: f64 = f64_abs(y);
    var k100: f64 = 0x39B0000000000000;          # 2^-100
    var k69: f64 = 0x3BA0000000000000;           # 2^-69
    var errz: f64 = (ay * eln) + (azh * k100);
    var err: f64 = (errz * 2.0625) + k69;
    var hi, lo, e = _us_exp_core(zh, zl);
    if (e > 0 - 1022 && e < 1024) {             # a normal result: _us_exp_fin's first case, inline
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0.0, 0); }
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var rn: f64 = u * sc;
        return (rn, 1);
    }
    var ok, r = _us_exp_fin(hi, lo, e, err);
    return (r, ok);
}

# The accurate kernel for the same arguments: an exact or midpoint result exactly, else the triple-double path.
#must_use
fn _us_pow_pos_acc(ax: f64, y: f64): f64 {
    var found, rx = _us_pow_exact(ax, y);
    if (found == 1) { return rx; }
    var lb: f64[3];
    _us_ln_acc_td(ax, &lb);
    var z0, z1, z2 = _us_td_mul_d(lb[0], lb[1], lb[2], y);
    if (z0 > 710.0) {
        var inf: f64 = _US_INF;
        return inf;
    }
    if (z0 < -746.0) { return 0.0; }
    var eb: f64[3];
    var e = _us_exp_acc_core(z0, z1, z2, &eb);
    var r: f64 = _us_cr_finish(e, eb[0], eb[1], eb[2]);
    return r;
}

# Every argument outside the fast path's common case (x positive normal, 0 < |y| < 2^64): the special values,
# a negative x (the sign from y's parity), a subnormal x, |y| ≥ 2^64. acc = 0 runs the fast kernel, 1 the
# accurate one; (result, 1), or (0, 0) when the fast kernel's test fails.
#must_use
fn _us_pow_cases(x: f64, y: f64, acc): (f64, i64) {
    if (y == 0.0) { return (1.0, 1); }           # pow(x, ±0) = 1, x NaN included
    if (x == 1.0) { return (1.0, 1); }           # pow(+1, y) = 1, y NaN included
    if (x != x) { return (x, 1); }
    if (y != y) { return (y, 1); }
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    var inf: f64 = _US_INF;
    if (ay == inf) {
        if (ax == 1.0) { return (1.0, 1); }      # pow(−1, ±∞) = 1
        if (ax < 1.0) {
            if (y > 0.0) { return (0.0, 1); }
            return (inf, 1);
        }
        if (y > 0.0) { return (inf, 1); }
        return (0.0, 1);
    }
    var yint, yodd = _us_pow_yclass(y);
    if (ax == 0.0) {
        if (y < 0.0) {
            if (yodd == 1) {
                var pz: f64 = 1.0 / x;           # ±∞ with x's sign
                return (pz, 1);
            }
            return (inf, 1);
        }
        if (yodd == 1) { return (x, 1); }        # ±0
        return (0.0, 1);
    }
    if (ax == inf) {
        var res: f64 = inf;
        if (y < 0.0) { res = 0.0; }
        if (x < 0.0 && yodd == 1) { res = -res; }
        return (res, 1);
    }
    var neg = 0;
    if (x < 0.0) {
        if (yint == 0) {
            var nan: f64 = _us_nan();
            return (nan, 1);
        }
        neg = yodd;
    }
    var r: f64 = 0.0;
    var ok = 1;
    var big: f64 = 0x43F0000000000000;           # 2^64: |y·ln|x|| ≥ 2^64·2^-53 > 746 unless |x| = 1
    if (ay >= big) {
        if (ax == 1.0) {
            r = 1.0;
        } else {
            r = 0.0;
            if ((ax > 1.0) == (y > 0.0)) { r = inf; }
        }
    } else {
        if (acc == 1) {
            r = _us_pow_pos_acc(ax, y);
        } else {
            var rf, okf = _us_pow_pos_fast(load64(&ax), y);
            r = rf;
            ok = okf;
        }
    }
    if (neg == 1) { r = -r; }
    return (r, ok);
}

# pow(x, y) = x^y, correctly rounded, with the special values above. Mirrors `f64::powf`.
#must_use
fn _us_cr_pow(x: f64, y: f64): f64 {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # The common case of _us_cr_pow_fast, dispatched here to save a call: x in [DBL_MIN, DBL_MAX] and
    # 0 < |y| < 2^64.
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _us_pow_pos_fast(ux, y);
            if (ok == 1) { return r; }
            var a: f64 = _us_pow_pos_acc(x, y);
            return a;
        }
    }
    var r2, ok2 = _us_pow_cases(x, y, 0);
    if (ok2 == 1) { return r2; }
    var a2: f64 = _us_cr_pow_acc(x, y);
    return a2;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails.
#must_use
fn _us_cr_pow_fast(x: f64, y: f64): (f64, i64) {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # x in [DBL_MIN, DBL_MAX] and 0 < |y| < 2^64, as unsigned range tests (the trick of _us_cr_exp).
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _us_pow_pos_fast(ux, y);
            return (r, ok);
        }
    }
    var r2, ok2 = _us_pow_cases(x, y, 0);
    return (r2, ok2);
}

# pow by the accurate path alone, for every (x, y).
#must_use
fn _us_cr_pow_acc(x: f64, y: f64): f64 {
    var r, ok = _us_pow_cases(x, y, 1);
    return r;
}

# The fast atan core for n = nh + nl, d = dh + dl with 0 < n ≤ d (1 + 2^-50), dh in [1/2, 2), nh ≥ 2^-62·dh:
# (hi, lo, err) for offset ± atan(n/d) by oct.
#must_use
fn _us_atan_core(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, f64, f64) {
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u: f64 = nh + np1;                    # TwoSum(nh, −c·d1)
        var ub: f64 = u - nh;
        var ue: f64 = (nh - (u - ub)) + (np1 - ub);
        sh = u;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v: f64 = dh + q1;                     # TwoSum(dh, c·n1)
        var vb: f64 = v - dh;
        var ve: f64 = (dh - (v - vb)) + (q1 - vb);
        eh = v;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _US_CR_SC_A3;
    var a5: f64 = _US_CR_SC_A5;
    var a7: f64 = _US_CR_SC_A7;
    var a9: f64 = _US_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_US_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_US_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _US_CR_SC_PIH;
        om = _US_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _US_CR_SC_PIO2H;
        om = _US_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
    var err: f64 = ahi * k68;
    return (hi, lo, err);
}

# The fast atan core with its rounding test: (RN(result), 1) or (0, 0).
#must_use
fn _us_atan_fast(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, i64) {
    var hi, lo, err = _us_atan_core(nh, nl, dh, dl, oct);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u != v) { return (0.0, 0); }
    return (u, 1);
}

# A triple-double renormalised (two bottom-up TwoSum passes): after a cancellation _us_td_add's leading word can
# be far from the sum (its last renormalisation does not see the rounded third-order term), and the corrections
# below need the leading word to be the sum to 2^-52. The sum is unchanged (every step is exact).
#must_use
fn _us_td_norm(a0: f64, a1: f64, a2: f64): (f64, f64, f64) {
    var s, e = _us_two_sum(a1, a2);
    var h, u = _us_two_sum(a0, s);
    var m, l = _us_two_sum(u, e);
    var h2, u2 = _us_two_sum(h, m);
    var m2, l2 = _us_two_sum(u2, l);
    return (h2, m2, l2);
}

# (a0, a1, a2)/(b0, b1, b2) as a triple-double at out[0..2], b ≠ 0 normalised: q0 = a0/b0 (a renormalised first),
# then two corrections from the remainder a − q·b, computed in triple-double (each below 2^-153 of a) and
# renormalised: relative error below 2^-151.
fn _us_td_div(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64, out) {
    var n0, n1, n2 = _us_td_norm(a0, a1, a2);
    var q0: f64 = n0 / b0;
    var t0, t1, t2 = _us_td_mul_d(b0, b1, b2, q0);
    var ra, rb, rc = _us_td_add(n0, n1, n2, -t0, -t1, -t2);
    var r0, r1, r2 = _us_td_norm(ra, rb, rc);
    var q1: f64 = r0 / b0;
    var u0, u1, u2 = _us_td_mul_d(b0, b1, b2, q1);
    var sa, sb, sc = _us_td_add(r0, r1, r2, -u0, -u1, -u2);
    var s0, s1, s2 = _us_td_norm(sa, sb, sc);
    var q2: f64 = s0 / b0;
    var h, m0 = _us_fast_two_sum(q0, q1);
    var m, l = _us_two_sum(m0, q2);
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
}

# The accurate atan core: RN(offset ± atan(n/d)) by oct, for triple-doubles 0 < n ≤ d (1 + 2^-50), n0 ≥ 2^-62·d0.
#must_use
fn _us_atan_acc(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct): f64 {
    var rb: f64[3];
    _us_atan_acc_td(n0, n1, n2, d0, d1, d2, oct, &rb);
    var r: f64 = _us_rn3(rb[0], rb[1], rb[2]);
    return r;
}

# offset ± atan(n/d) as a triple-double at out[0..2] (the accurate atan core before its rounding).
fn _us_atan_acc_td(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct, out) {
    var zh: f64 = n0 / d0;
    var cz: f64 = zh + 26388279066624.0;
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var a0: f64 = n0;
    var a1: f64 = n1;
    var a2: f64 = n2;
    var b0: f64 = d0;
    var b1: f64 = d1;
    var b2: f64 = d2;
    if (j != 0) {                                 # num = n − c·d, den = d + c·n
        var cd0, cd1, cd2 = _us_td_mul_d(d0, d1, d2, c);
        var x0, x1, x2 = _us_td_add(n0, n1, n2, -cd0, -cd1, -cd2);
        var cn0, cn1, cn2 = _us_td_mul_d(n0, n1, n2, c);
        var y0, y1, y2 = _us_td_add(d0, d1, d2, cn0, cn1, cn2);
        a0 = x0;
        a1 = x1;
        a2 = x2;
        b0 = y0;
        b1 = y1;
        b2 = y2;
    }
    var db: f64[3];
    _us_td_div(a0, a1, a2, b0, b1, b2, &db);
    var dh: f64 = db[0];
    var dm: f64 = db[1];
    var dl: f64 = db[2];
    var wh, wm, wl = _us_td_mul(dh, dm, dl, dh, dm, dl);
    var ph: f64 = load64(&_US_CR_ATAN_ACC + 168);  # 1/17 (index 3·(8 − 1))
    var pm: f64 = load64(&_US_CR_ATAN_ACC + 176);
    var pl: f64 = load64(&_US_CR_ATAN_ACC + 184);
    var k = 7;
    while (k >= 1) {                              # (−1)^k/(2k + 1) + w·P
        var th, tm, tl = _us_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 1) * 24;
        var ch: f64 = load64(&_US_CR_ATAN_ACC + off);
        var cm: f64 = load64(&_US_CR_ATAN_ACC + off + 8);
        var cl: f64 = load64(&_US_CR_ATAN_ACC + off + 16);
        var uh, um, ul = _us_td_add(ch, cm, cl, th, tm, tl);
        ph = uh;
        pm = um;
        pl = ul;
        k = k - 1;
    }
    var vh, vm, vl = _us_td_mul(wh, wm, wl, ph, pm, pl);
    var xh, xm, xl = _us_td_mul(vh, vm, vl, dh, dm, dl);
    var th2, tm2, tl2 = _us_td_add(dh, dm, dl, xh, xm, xl);          # atan δ
    var ah: f64 = load64(&_US_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_US_CR_ATAN_T + 24 * j + 8);
    var al: f64 = load64(&_US_CR_ATAN_T + 24 * j + 16);
    var gh, gm, gl = _us_td_add(ah, am, al, th2, tm2, tl2);          # θ
    if (oct == 0) {
        store64(out, gh);
        store64(out + 8, gm);
        store64(out + 16, gl);
        return;
    }
    var oh: f64 = _US_CR_SC_PIO2H;
    var om: f64 = _US_CR_SC_PIO2M;
    var ol: f64 = _US_CR_SC_PIO2L;
    if (oct == 1) {
        oh = _US_CR_SC_PIH;
        om = _US_CR_SC_PIM;
        ol = _US_CR_SC_PIL;
    }
    if (oct != 3) {
        gh = -gh;
        gm = -gm;
        gl = -gl;
    }
    var rh, rm, rl = _us_td_add(oh, om, ol, gh, gm, gl);
