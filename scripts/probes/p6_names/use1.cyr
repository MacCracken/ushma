include "scripts/probes/p6_names/lib_us.cyr"
use us.ideal_gas_pressure;

fn main(): i64 {
    alloc_init();
    var a: f64 = us_ideal_gas_pressure(1.0, 300.0, 1.0);
    var b: f64 = ideal_gas_pressure(1.0, 300.0, 1.0);
    var c: f64 = us_twice(1.0, 300.0, 1.0);
    fmt_hex0x(load64(&a)); println("");
    fmt_hex0x(load64(&b)); println("");
    fmt_hex0x(load64(&c)); println("");
    return 0;
}
var r = main();
sys_exit_group(r);
